enderPending();return;}nav('dashboard');await render();}}catch(err){msg(err.message,'danger')}});
  document.querySelector('#demo-login')?.addEventListener('submit',async e=>{e.preventDefault();const user=await demoSignIn(new FormData(e.target).get('role'));state.user=user;nav('dashboard');await render();});
}
function renderPending(){
  app.innerHTML=`<div class="login-page"><div class="login-card"><div class="brand-mark" style="margin-bottom:16px">CRJ</div><h1>Acesso pendente</h1><p>Sua conta foi criada, mas ainda não recebeu equipe e permissões. A Coordenação Geral ou o Monitoramento precisa atribuir seu perfil.</p><div class="notice warn">Enquanto estiver pendente, nenhum dado de jovem ou atendimento fica disponível.</div><div class="actions" style="margin-top:16px"><button class="btn secondary" id="pending-logout">Sair</button></div></div></div>`;
  document.querySelector('#pending-logout')?.addEventListener('click',async()=>{await signOut();state.user=null;renderLogin();});
}
function fieldHtml(f,value){
  const v=value??''; const req=f.required?'required':''; const help=f.help?`<small>${esc(f.help)}</small>`:'';
  if(f.type==='textarea') return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><textarea name="${f.key}" ${req}>${esc(v)}</textarea>${help}</div>`;
  if(f.type==='select') return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><select name="${f.key}" ${req}><option value="">Selecione</option>${(f.options||[]).map(o=>`<option ${String(v)===o?'selected':''}>${esc(o)}</option>`).join('')}</select>${help}</div>`;
  if(f.type==='multiselect') {const vals=Array.isArray(v)?v:[];return `<div class="field full"><label>${esc(f.label)}</label><div class="check-grid">${(f.options||[]).map(o=>`<label class="check"><input type="checkbox" name="${f.key}" value="${esc(o)}" ${vals.includes(o)?'checked':''}><span>${esc(o)}</span></label>`).join('')}</div>${help}</div>`}
  if(f.type==='rating') return `<div class="field full"><label>${esc(f.label)}</label><div class="check-grid">${RATING_OPTIONS.map(o=>`<label class="check"><input type="radio" name="${f.key}" value="${esc(o)}" ${v===o?'checked':''}><span>${esc(o)}</span></label>`).join('')}</div></div>`;
  return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><input class="input" name="${f.key}" type="${f.type||'text'}" value="${esc(v)}" ${req}>${help}</div>`;
}
function parseForm(form){const fd=new FormData(form),out={}; for(const [k,v] of fd.entries()){if(out[k]!==undefined) out[k]=Array.isArray(out[k])?[...out[k],v]:[out[k],v]; else out[k]=v;} form.querySelectorAll('input[type=checkbox]').forEach(i=>{if(!out[i.name])out[i.name]=[]}); return out;}

async function pageDashboard(){
  const [st,inds]=await Promise.all([dashboardStats(),getIndicators(currentMonth())]); const main=inds.filter(x=>['M2.1_ATENDIMENTOS','M6.1_OFICINAS_HORAS','M6.2_PVIDA_JOVENS','M6.4_PTRAMPO_JOVENS'].includes(x.code));
  return `<div class="page-head"><div><h2>Painel operacional</h2><p>O sistema consolida o trabalho registrado por cada equipe sem exigir que o colaborador “preencha a meta”.</p></div><div class="actions">${permitted('jovens')?'<button class="btn primary" data-nav="novo-jovem">+ Cadastrar jovem</button>':''}</div></div>
  <div class="grid cards"><div class="card kpi"><div class="label">Jovens ativos</div><div class="value">${st.youthActive}</div><div class="meta">cadastros individuais</div></div><div class="card kpi"><div class="label">Atendidos no mês</div><div class="value">${st.served}</div><div class="meta">jovens identificados</div></div><div class="card kpi"><div class="label">Acompanhados no mês</div><div class="value">${st.followups}</div><div class="meta">registros técnicos</div></div><div class="card kpi"><div class="label">Oficinas ativas</div><div class="value">${st.workshops}</div><div class="meta">turmas cadastradas</div></div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><h3>Indicadores-chave — ${currentMonth().split('-').reverse().join('/')}</h3>${main.map(indicatorRow).join('')}</div><div class="card"><h3>Como o dado nasce</h3><div class="timeline"><div class="timeline-item"><div class="timeline-date">1. Execução</div><div class="timeline-body"><strong>Profissional registra o que fez</strong><span class="muted">Aula, presença, atendimento, acompanhamento, mobilização, benefício ou formulário.</span></div></div><div class="timeline-item"><div class="timeline-date">2. Vínculo</div><div class="timeline-body"><strong>Registro é ligado ao jovem</strong><span class="muted">Quando há identificação, o histórico individual é atualizado.</span></div></div><div class="timeline-item"><div class="timeline-date">3. Meta</div><div class="timeline-body"><strong>Evento alimenta indicador</strong><span class="muted">O painel mantém a origem do dado para auditoria.</span></div></div></div></div></div>`;
}
function indicatorRow(i){const mixed=i.dataQuality==='mixed';const base=Number(i.identifiedValue||0),agg=Number(i.aggregateValue||0),usable=mixed?null:base+agg;const pct=i.target&&usable!==null?Math.min(100,Math.round(usable/i.target*100)):0;const status=mixed?'warn':!i.target?'info':i.mode==='ceiling'?'info':usable>=i.target?'success':pct>=80?'warn':'danger';const main=mixed?`${base} + ${agg}`:`${usable??0}`;const windowInfo=i.periodicity&&i.periodicity!=='mensal'&&i.windowStart?` · janela ${fmtDate(i.windowStart)}–${fmtDate(new Date(new Date(i.windowEnd+'T12:00:00').getTime()-86400000).toISOString().slice(0,10))}`:'';const detail=(mixed?'identificado + agregado; conferir sobreposição':agg>0?'somente agregado; sem trajetória nominal':i.uniqueYouth?`${i.uniqueYouth} jovem(ns) único(s) identificado(s)`:'rastreável pela origem')+windowInfo;return `<div class="indicator"><div><div class="code">${esc(i.label)}</div><div class="source">${esc(i.code)}</div><div class="metric-split"><span>Identificado: ${base}</span><span>Agregado: ${agg}</span></div></div><div><strong>${esc(main)}</strong> <span class="muted">${esc(i.unit)}</span><small class="muted" style="display:block">${esc(detail)}</small></div><div>${i.target&&!mixed?`<div class="progress"><span style="width:${pct}%"></span></div><small class="muted">${i.mode==='ceiling'?'limite/referência':'meta'} ${i.target}</small>`:mixed?'<span class="pill warn">não somar sem conferência</span>':'<span class="muted">monitoramento</span>'}</div><span class="pill ${status}">${mixed?'misto':i.target?`${pct}%`:'aco