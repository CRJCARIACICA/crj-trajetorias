enderPending();return;}nav('dashboard');await render();}}catch(err){msg(err.message,'danger')}});
  document.querySelector('#demo-login')?.addEventListener('submit',async e=>{e.preventDefault();const user=await demoSignIn(new FormData(e.target).get('role'));state.user=user;nav('dashboard');await render();});
}
function renderPending(){
  app.innerHTML=`<div class="login-page"><div class="login-card"><div class="brand-mark" style="margin-bottom:16px">CRJ</div><h1>Acesso pendente</h1><p>Sua conta foi criada, mas ainda não recebeu equipe e permissões. A Coordenação Geral ou o Monitoramento precisa atribuir seu perfil.</p><div class="notice warn">Enquanto estiver pendente, nenhum dado de jovem ou atendimento fica disponível.</div><div class="actions" style="margin-top:16px"><button class="btn secondary" id="pending-logout">Sair</button></div></div></div>`;
  document.querySelector('#pending-logout')?.addEventListener('click',async()=>{await signOut();state.user=null;renderLogin();});
}
function fieldHtml(f,value){
  const v=value??''; const req=f.required?'required':''; const help=f.help?`<small>${esc(f.help)}</small>`:'';
  if(f.type==='textarea') return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><textarea name="${f.key}" ${req}>${esc(v)}</textarea>${help}</div>`;
  if(f.type==='select') return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><select name="${f.key}" ${req}><option value="">Selecione</option>${(f.options||[]).map(o=>`<option ${String(v)===o?'selected':''}>${esc(o)}</option>`).join('')}</select>${help}</div>`;
  if(f.type==='multiselect') {const vals=Array.isArray(v)?v:[];return `<div class="field full"><label>${esc(f.label)}</label><div class="check-grid">${(f.options||[]).map(o=>`<label class="check"><input type="checkbox" name="${f.key}" value="${esc(o)}" ${vals.includes(o)?'checked':''}><span>${esc(o)}</span></label>`).join('')}</div>${help}</div>`}
  if(f.type==='rating') return `<div class="field full"><label>${esc(f.label)}</label><div class="check-grid">${RATING_OPTIONS.map(o=>`<label class="check"><input type="radio" name="${f.key}" value="${esc(o)}" ${v===o?'checked':''}><span>${esc(o)}</span></label>`).join('')}</div></div>`;
  const readonly=f.readonly?'readonly':''; const placeholder=f.placeholder?`placeholder="${esc(f.placeholder)}"`:'';
  return `<div class="field ${f.full?'full':''}"><label>${esc(f.label)}</label><input class="input" name="${f.key}" type="${f.type||'text'}" value="${esc(v)}" ${req} ${readonly} ${placeholder}>${help}</div>`;
}
function parseForm(form){const fd=new FormData(form),out={}; for(const [k,v] of fd.entries()){if(out[k]!==undefined) out[k]=Array.isArray(out[k])?[...out[k],v]:[out[k],v]; else out[k]=v;} form.querySelectorAll('input[type=checkbox]').forEach(i=>{if(!out[i.name])out[i.name]=[]}); return out;}
let METHODOLOGY_HEADER_DATA='data:image/jpeg;base64,';
function applyDocumentSettings(settings){return settings;}
const OFFICIAL_FORM_TITLES={
  'formulario-inicial':'FORMULÁRIO INICIAL',
  'lista-presenca-contato':'LISTA DE PRESENÇA E CONTATO',
  'acompanhamento':'FORMULÁRIO DE ACOMPANHAMENTO',
  'pvida':'PLANEJAMENTO DE VIDA (PVIDA)',
  'outras-demandas':'OUTRAS DEMANDAS - ACOMPANHAMENTO',
  'ptrampo':'PLANEJAMENTO DE TRABALHO INDIVIDUAL OU COLETIVO - PTRAMPO',
  'avaliacao-atividades':'AVALIAÇÃO DAS ATIVIDADES - JOVENS',
  'relatorio-mobilizacao':'RELATÓRIO DE MOBILIZAÇÃO DOS JOVENS',
  'emprestimo':'FORMULÁRIO DE EMPRÉSTIMO DE EQUIPAMENTO E/OU ESPAÇO FÍSICO',
  'emprestimo-canhoto':'CANHOTO - EMPRÉSTIMO DE EQUIPAMENTO OU ESPAÇO FÍSICO',
  'cfdh-planejamento':'PLANEJAMENTO DO CIRCUITO FORMATIVO EM DIREITOS HUMANOS',
  'cfdh-avaliacao-jovens':'AVALIAÇÃO FINAL DO CIRCUITO - JOVENS',
  'cfdh-avaliacao-equipe':'AVALIAÇÃO FINAL DO CIRCUITO - EDUCADORES SOCIAIS E OFICINEIROS'
};
const OFFICIAL_ANNEX_TITLES={
  'formulario-inicial':'ANEXO 1 - Formulário Inicial',
  'lista-presenca-contato':'ANEXO 2 - Formulário Lista de Presença e Contato',
  'acompanhamento':'ANEXO 3 - Formulário Acompanhamento',
  'pvida':'ANEXO 4 - Formulário PVIDA',
  'outras-demandas':'ANEXO 5 - Formulário Outras Demandas',
  'ptrampo':'ANEXO 6 - Formulário PTrampo',
  'avaliacao-atividades':'ANEXO 7 - Formulário de Avaliação das Atividades',
  'relatorio-mobilizacao':'ANEXO 8 - Formulário Relatório de Mobilização',
  'emprestimo':'ANEXO 9 - Formulário Empréstimo',
  'emprestimo-canhoto':'ANEXO 10 - Formulário Empréstimo (Canhoto)',
  'cfdh-planejamento':'ANEXO 11 - Formulário CFDH Planejamento',
  'cfdh-avaliacao-jovens':'ANEXO 12 - Formulário CFDH Avaliação Jovens',
  'cfdh-avaliacao-equipe':'ANEXO 13 - Formulário CFDH Avaliação Educadores e Oficineiros'
};
function officialPreviewValue(f,value){
  if(value===null||value===undefined||value==='')return '';
  if(f?.type==='date')return fmtDate(String(value));
  if(Array.isArray(value))return value.join(', ');
  return String(value);
}
function officialPreviewHeader(form){
  return '<div class="methodology-annex-title">'+esc(OFFICIAL_ANNEX_TITLES[form.slug]||form.annex||'')+'</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional da Metodologia dos CRJs"></div>'+
    '<div class="methodology-inner-title">'+esc(OFFICIAL_FORM_TITLES[form.slug]||form.title||'FORMULÁRIO')+'</div>';
}
function officialPreviewField(f,value){
  const val=officialPreviewValue(f,value);
  if(f.type==='select'||f.type==='multiselect'){
    const selected=Array.isArray(value)?value:(value?[String(value)]:[]);
    return '<div class="methodology-row methodology-options"><b>'+esc(f.label)+'</b>'+
      '<div class="methodology-option-list">'+(f.options||[]).map(function(o){return '<span>( '+(selected.includes(o)?'X':'&nbsp;')+' ) '+esc(o)+'</span>';}).join('')+'</div></div>';
  }
  if(f.type==='textarea'){
    return '<div class="methodology-row methodology-row-tall"><b>'+esc(f.label)+'</b><div class="methodology-answer methodology-lines">'+(val?esc(val).replace(/\n/g,'<br>'):'&nbsp;<br>&nbsp;<br>&nbsp;')+'</div></div>';
  }
  return '<div class="methodology-row"><b>'+esc(f.label)+'</b><span class="methodology-inline-answer">'+(val?esc(val):'&nbsp;')+'</span></div>';
}
function officialSectionLabel(form,section){
  const t=String(section?.title||'');
  if(/^bloco/i.test(t))return t.toUpperCase();
  if(form.slug==='formulario-inicial'&&t==='Onde você mora?')return t;
  if(form.slug==='emprestimo'&&(t==='Solicitação'||t==='Devolução'))return t.toUpperCase();
  if(form.slug==='ptrampo'&&t==='Anexo para monitoramento')return 'PLANEJAMENTO TRABALHO (PTRAMPO) - ANEXO PARA O MONITORAMENTO';
  return '';
}
function normalizePresencePreviewRows(value){
  if(Array.isArray(value))return value;
  if(!value)return [];
  return String(value).split(/\r?\n/).filter(Boolean).map(function(line){
    const x=line.split(/\s*[|;]\s*/);
    return {name:x[0]||'',birth_date:x[1]||'',cpf:x[2]||'',contact:x[3]||'',neighborhood:x[4]||''};
  });
}
function methodologyAttendancePreviewHtml(values){
  const rows=normalizePresencePreviewRows(values.participants);
  const count=Math.max(9,rows.length);
  let body='';
  for(let i=0;i<count;i++){
    const r=rows[i]||{};
    const name=String(r.display_name||r.name||r.full_name||'');
    const contact=String(r.contact||[r.phone,r.email].filter(Boolean).join(' / ')||'');
    const signature=r.signature_data?'<img class="methodology-signature" src="'+esc(r.signature_data)+'" alt="Assinatura digital">':'';
    body+='<tr><td>'+(i+1)+'</td><td><div>'+esc(name)+'</div>'+signature+'</td><td>'+esc(r.birth_date?fmtDate(String(r.birth_date)):'')+'</td><td>'+esc(r.cpf||'')+'</td><td>'+esc(contact)+'</td><td>'+esc(r.neighborhood||'')+'</td></tr>';
  }
  const complement=[values.officineiro?'Oficineiro(a): '+values.officineiro:'',values.educator_reference?'Educador(a): '+values.educator_reference:'',(values.start_time||values.end_time)?'Horário: '+String(values.start_time||'').slice(0,5)+(values.end_time?' às '+String(values.end_time).slice(0,5):''):''].filter(Boolean).join(' · ');
  return '<div class="methodology-paper methodology-paper-landscape">'+
    officialPreviewHeader(FORM_MAP['lista-presenca-contato'])+
    '<div class="methodology-row"><b>1. Atividade:</b><span class="methodology-inline-answer">'+esc(values.activity||'')+'</span></div>'+
    '<div class="methodology-row"><b>2. Local de realização da atividade:</b><span class="methodology-inline-answer">'+esc(values.location||'')+'</span></div>'+
    '<div class="methodology-row"><b>3. Data:</b><span class="methodology-inline-answer">'+esc(values.date?fmtDate(String(values.date)):'')+'</span></div>'+
    '<table class="methodology-presence-table"><thead><tr><th>Nº</th><th>Nome</th><th>Data de nascimento</th><th>CPF</th><th>Contato (telefone, E-mail...)</th><th>Bairro</th></tr></thead><tbody>'+body+'</tbody></table>'+
    (complement?'<div class="methodology-system-note"><b>Dados complementares do registro digital:</b> '+esc(complement)+'</div>':'')+
    '</div>';
}
function methodologyRatingMatrix(fields,values){
  return '<table class="methodology-rating-table"><thead><tr><th>O que você achou / avaliação</th>'+RATING_OPTIONS.map(function(o){return '<th>'+esc(o.replace('/Boa',''))+'</th>';}).join('')+'</tr></thead><tbody>'+
    fields.map(function(f){return '<tr><td>'+esc(f.label)+'</td>'+RATING_OPTIONS.map(function(o){return '<td>( '+(String(values[f.key]||'')===o?'X':'&nbsp;')+' )</td>';}).join('')+'</tr>';}).join('')+
    '</tbody></table>';
}
function methodologyPlanningMatrix(value){
  let rows=String(value||'').split(/\r?\n/).filter(Boolean).map(function(line){return line.split(/\s*\|\s*/);});
  while(rows.length<8)rows.push(['','','','','']);
  return '<table class="methodology-planning-table"><thead><tr><th>7. Tema</th><th>8. Objetivo</th><th>9. Atividades propostas</th><th>10. Recursos necessários</th><th>11. Carga horária</th></tr></thead><tbody>'+
    rows.map(function(r){return '<tr>'+[0,1,2,3,4].map(function(i){return '<td>'+esc(r[i]||'')+'</td>';}).join('')+'</tr>';}).join('')+
    '</tbody></table>';
}
function methodologyColumnCellValue(f,value){
  const val=officialPreviewValue(f,value);
  if(f.type==='select'||f.type==='multiselect'){
    const selected=Array.isArray(value)?value:(value?[String(value)]:[]);
    if(!selected.length)return '&nbsp;';
    return selected.map(function(x){return esc(x);}).join('<br>');
  }
  if(f.type==='textarea')return val?esc(val).replace(/\n/g,'<br>'):'&nbsp;';
  return val?esc(val):'&nbsp;';
}
function methodologyFieldsAsColumns(fields,values,maxColumns=4){
  const groups=[];let current=[];
  const flush=()=>{if(current.length){groups.push(current);current=[]}};
  for(const f of fields||[]){
    const independent=Boolean(f.full||f.type==='textarea'||f.type==='multiselect');
    if(independent){flush();groups.push([f]);continue}
    current.push(f);
    if(current.length>=maxColumns)flush();
  }
  flush();
  return groups.map(function(group){
    return '<table class="methodology-record-table"><thead><tr>'+
      group.map(function(f){return '<th>'+esc(f.label)+'</th>';}).join('')+
      '</tr></thead><tbody><tr>'+
      group.map(function(f){return '<td>'+methodologyColumnCellValue(f,values[f.key])+'</td>';}).join('')+
      '</tr></tbody></table>';
  }).join('');
}
function methodologyPreviewHtml(form,values){
  values=values||{};
  if(!form)return '';
  if(form.slug==='lista-presenca-contato')return methodologyAttendancePreviewHtml(values);
  const fields=form.sections.flatMap(function(s){return s.fields||[];});
  let body='';
  if(fields.some(function(f){return f.type==='rating';})){
    const first=fields.findIndex(function(f){return f.type==='rating';});
    let last=first;while(last+1<fields.length&&fields[last+1].type==='rating')last++;
    fields.slice(0,first).forEach(function(f){body+=officialPreviewField(f,values[f.key]);});
    body+=methodologyRatingMatrix(fields.slice(first,last+1),values);
    fields.slice(last+1).forEach(function(f){body+=officialPreviewField(f,values[f.key]);});
  }else if(form.slug==='cfdh-planejamento'){
    const topicIndex=fields.findIndex(function(f){return f.key==='topics';});
    fields.slice(0,topicIndex).forEach(function(f){body+=officialPreviewField(f,values[f.key]);});
    body+=methodologyPlanningMatrix(values.topics);
    fields.slice(topicIndex+1).forEach(function(f){body+=officialPreviewField(f,values[f.key]);});
  }else{
    form.sections.forEach(function(section){
      const sectionLabel=officialSectionLabel(form,section);
      if(sectionLabel)body+='<div class="methodology-section-title">'+esc(sectionLabel)+'</div>';
      body+=methodologyFieldsAsColumns(section.fields||[],values,4);
    });
  }
  const paper='<div class="methodology-paper methodology-paper-landscape">'+officialPreviewHeader(form)+body+'</div>';
  if(form.slug==='emprestimo-canhoto')return paper.replace('</div>','</div>')+'<div class="methodology-cut-line">recorte aqui</div>'+paper;
  return paper;
}


async function pageDashboard(){
  const [st,inds]=await Promise.all([dashboardStats(),getIndicators(currentMonth())]); const main=inds.filter(x=>['M2.1_ATENDIMENTOS','M6.1_OFICINAS_HORAS','M6.2_PVIDA_JOVENS','M6.4_PTRAMPO_JOVENS'].includes(x.code));
  return `<div class="page-head"><div><h2>Painel operacional</h2><p>O sistema consolida o trabalho registrado por cada equipe sem exigir que o colaborador “preencha a meta”.</p></div><div class="actions">${permitted('jovens')?'<button class="btn primary" data-nav="novo-jovem">+ Cadastrar jovem</button>':''}</div></div>
  <div class="grid cards"><div class="card kpi"><div class="label">Jovens ativos</div><div class="value">${st.youthActive}</div><div class="meta">cadastros individuais</div></div><div class="card kpi"><div class="label">Atendidos no mês</div><div class="value">${st.served}</div><div class="meta">jovens identificados</div></div><div class="card kpi"><div class="label">Acompanhados no mês</div><div class="value">${st.followups}</div><div class="meta">registros técnicos</div></div><div class="card kpi"><div class="label">Oficinas ativas</div><div class="value">${st.workshops}</div><div class="meta">turmas cadastradas</div></div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><h3>Indicadores-chave — ${currentMonth().split('-').reverse().join('/')}</h3>${main.map(indicatorRow).join('')}</div><div class="card"><h3>Como o dado nasce</h3><div class="timeline"><div class="timeline-item"><div class="timeline-date">1. Execução</div><div class="timeline-body"><strong>Profissional registra o que fez</strong><span class="muted">Aula, presença, atendimento, acompanhamento, mobilização, benefício ou formulário.</span></div></div><div class="timeline-item"><div class="timeline-date">2. Vínculo</div><div class="timeline-body"><strong>Registro é ligado ao jovem</strong><span class="muted">Quando há identificação, o histórico individual é atualizado.</span></div></div><div class="timeline-item"><div class="timeline-date">3. Meta</div><div class="timeline-body"><strong>Evento alimenta indicador</strong><span class="muted">O painel mantém a origem do dado para auditoria.</span></div></div></div></div></div>`;
}
function indicatorRow(i){const mixed=i.dataQuality==='mixed';const base=Number(i.identifiedValue||0),agg=Number(i.aggregateValue||0),usable=mixed?null:base+agg;const pct=i.target&&usable!==null?Math.min(100,Math.round(usable/i.target*100)):0;const status=mixed?'warn':!i.target?'info':i.mode==='ceiling'?'info':usable>=i.target?'success':pct>=80?'warn':'danger';const main=mixed?`${base} + ${agg}`:`${usable??0}`;const windowInfo=i.periodicity&&i.periodicity!=='mensal'&&i.windowStart?` · janela ${fmtDate(i.windowStart)}–${fmtDate(new Date(new Date(i.windowEnd+'T12:00:00').getTime()-86400000).toISOString().slice(0,10))}`:'';const detail=(mixed?'identificado + agregado; conferir sobreposição':agg>0?'somente agregado; sem trajetória nominal':i.uniqueYouth?`${i.uniqueYouth} jovem(ns) único(s) identificado(s)`:'rastreável pela origem')+windowInfo;return `<div class="indicator"><div><div class="code">${esc(i.label)}</div><div class="source">${esc(i.code)}</div><div class="metric-split"><span>Identificado: ${base}</span><span>Agregado: ${agg}</span></div></div><div><strong>${esc(main)}</strong> <span class="muted">${esc(i.unit)}</span><small class="muted" style="display:block">${esc(detail)}</small></div><div>${i.target&&!mixed?`<div class="progress"><span style="width:${pct}%"></span></div><small class="muted">${i.mode==='ceiling'?'limite/referência':'meta'} ${i.target}</small>`:mixed?'<span class="pill warn">não somar sem conferência</span>':'<span class="muted">monitoramento</span>'}</div><span class="pill ${status}">${mixed?'misto':i.target?`${pct}%`:'aco