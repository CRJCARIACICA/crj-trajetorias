/* LABPOCA_WORKSHOP_FORM_GUARD_20261022 */
(()=>{
let timer=null;
async function enhance(){
  const f=document.querySelector('#workshop-device-form');
  if(!f||f.dataset.lpGuarded==='1')return;
  f.dataset.lpGuarded='1';
  const loc=f.querySelector('[name=location_type]');
  if(loc&&!loc.querySelector('[value="LABStudio"]')){
    const o=document.createElement('option');o.value='LABStudio';o.textContent='LABStudio';
    const before=loc.querySelector('[value="Sala de computadores"]');loc.insertBefore(o,before||null);
  }
  const generic=f.querySelector('[name="methodology_devices"][value="labpoca"]');
  if(generic){const label=generic.closest('label');if(label)label.style.display='none'}
  f.querySelector('[data-lp-workshop-class]')?.remove();
}
function schedule(){clearTimeout(timer);timer=setTimeout(()=>enhance().catch(()=>{}),40)}
new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});
document.addEventListener('click',schedule,true);window.addEventListener('hashchange',schedule);schedule();
})();