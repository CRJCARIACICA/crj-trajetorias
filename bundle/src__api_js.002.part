export async function listWorkshopInstructorDashboard(month=monthKey()){
  const [yy,mm]=String(month).split('-').map(Number);
  const start=`${yy}-${String(mm).padStart(2,'0')}-01`;
  const end=new Date(Date.UTC(yy,mm,1)).toISOString().slice(0,10);
  if(mode==='mock'){
    const s=mock(),profiles=(s.team||[]),workshops=s.workshops||[],sessions=(s.sessions||[]).filter(x=>x.session_date>=start&&x.session_date<end);
    const attendance=s.attendance||[],guests=s.guestParticipations||[],records=s.workshopInstructorRecords||[],edu=s.educatorRecords||[];
    return buildInstructorDashboard(profiles,workshops,sessions,attendance,guests,records,edu);
  }
  const [profilesQ,workshopsQ,sessionsQ,attendanceQ,guestsQ,recordsQ,eduQ]=await Promise.all([
    supabase.from('profiles').select('id,display_name,role,active').eq('active',true).order('display_name'),
    supabase.from('workshops').select('*').order('name'),
    supabase.from('workshop_sessions').select('*').gte('session_date',start).lt('session_date',end).order('session_date',{ascending:false}),
    supabase.from('attendance').select('session_id,workshop_id,attendance_date,present').gte('attendance_date',start).lt('attendance_date',end).eq('present',true),
    supabase.from('workshop_guest_participations').select('session_id,workshop_id,participation_date').gte('participation_date',start).lt('participation_date',end),
    supabase.from('workshop_instructor_records').select('*').gte('record_date',start).lt('record_date',end).order('record_date',{ascending:false}).limit(500),
    supabase.from('educator_records').select('workshop_id,record_date,record_type,title,description').eq('record_type','acompanhamento_oficina').gte('record_date',start).lt('record_date',end)
  ]);
  for(const q of [profilesQ,workshopsQ,sessionsQ,attendanceQ,guestsQ,recordsQ,eduQ])if(q.error)throw q.error;
  return buildInstructorDashboard(profilesQ.data||[],workshopsQ.data||[],sessionsQ.data||[],attendanceQ.data||[],guestsQ.data||[],recordsQ.data||[],eduQ.data||[]);
}
function buildInstructorDashboard(profiles,workshops,sessions,attendance,guests,records,educatorRecords){
  const assignedIds=new Set(workshops.map(w=>w.oficineiro_user_id).filter(Boolean));
  const instructors=profiles.filter(p=>p.role==='oficineiro'||assignedIds.has(p.id));
  const attendanceBySession=new Map();
  for(const a of attendance||[]){if(!a.session_id)continue;attendanceBySession.set(a.session_id,(attendanceBySession.get(a.session_id)||0)+1);}
  for(const g of guests||[]){if(!g.session_id)continue;attendanceBySession.set(g.session_id,(attendanceBySession.get(g.session_id)||0)+1);}
  return instructors.map(p=>{
    const linked=workshops.filter(w=>w.oficineiro_user_id===p.id);
    const ids=new Set(linked.map(w=>w.id));
    const ss=sessions.filter(s=>ids.has(s.workshop_id));
    const confirmed=ss.filter(s=>(attendanceBySession.get(s.id)||0)>0);
    const hours=arr=>arr.reduce((sum,x)=>sum+Number(x.duration_hours||0),0);
    const participationRecords=ss.reduce((sum,s)=>sum+(attendanceBySession.get(s.id)||0),0);
    const followups=(educatorRecords||[]).filter(r=>ids.has(r.workshop_id));
    const instructorRecords=(records||[]).filter(r=>r.instructor_user_id===p.id);
    return {
      id:p.id,display_name:p.display_name,workshops:linked,
      metrics:{classes_registered:ss.length,classes_with_attendance:confirmed.length,hours_registered:hours(ss),hours_confirmed:hours(confirmed),participation_records:participationRecords,workshop_followups:followups.length},
      recent_classes:ss.slice(0,12).map(s=>({...s,workshop_name:linked.find(w=>w.id===s.workshop_id)?.name||'',attendance_count:attendanceBySession.get(s.id)||0,confirmed:(attendanceBySession.get(s.id)||0)>0})),
      followups:followups.slice(0,12),
      records:instructorRecords.slice(0,30)
    };
  }).sort((a,b)=>String(a.display_name).localeCompare(String(b.display_name),'pt-BR'));
}

export async function createWorkshopInstructorAccount(row){
  if(mode==='mock'){
    const s=mock();s.workshopInstructorProfiles||=[];
    const id=uid('ofiuser');
    const member={id,display_name:row.name,role:'oficineiro',team:'Oficineiros',active:true};
    s.team.push(member);
    s.workshopInstructorProfiles.push({user_id:id,email:row.email||'',cpf:row.cpf||'',phone:row.phone||'',specialty:row.specialty||'',contracted_weekly_hours:Number(row.contracted_weekly_hours||0),notes:row.notes||''});
    save(s);return member;
  }
  const sessionData=(await supabase.auth.getSession()).data;
  const token=sessionData.session?.access_token;
  if(!token)throw new Error('Sessão expirada. Entre novamente.');
  const res=await fetch(CONFIG.supabaseUrl+'/functions/v1/crj-register',{
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+token,'apikey':CONFIG.supabasePublishableKey},
    body:JSON.stringify({internal_instructor:true,name:row.name,email:row.email,password:row.password,cpf:row.cpf||null,phone:row.phone||null,specialty:row.specialty||null,contracted_weekly_hours:row.contracted_weekly_hours||null,notes:row.notes||null})
  });
  const body=await res.json().catch(()=>({}));
  if(!res.ok)throw new Error(body.error||'Não foi possível criar o cadastro do oficineiro.');
  return body.user;
}
export async function listWorkshopInstructorProfiles(){
  if(mode==='mock'){
    const s=mock(),ext=new Map((s.workshopInstructorProfiles||[]).map(x=>[x.user_id,x]));
    return (s.team||[]).filter(x=>x.role==='oficineiro').map(x=>({...x,...(ext.get(x.id)||{})}));
  }
  const pq=await supabase.from('profiles').select('id,display_name,role,team,active').eq('role','oficineiro').order('display_name');
  const eq=await supabase.from('workshop_instructor_profiles').select('*');
  if(pq.error)throw pq.error;if(eq.error)throw eq.error;
  const ext=new Map((eq.data||[]).map(x=>[x.user_id,x]));
  return (pq.data||[]).map(x=>({...x,...(ext.get(x.id)||{})}));
}
export async function updateWorkshopInstructorProfile(userId,row){
  const payload={updated_at:now()};
  for(const k of ['email','cpf','phone','specialty','contracted_weekly_hours','notes'])if(row[k]!==undefined)payload[k]=row[k]===''?null:row[k];
  if(mode==='mock'){
    const s=mock();s.workshopInstructorProfiles||=[];
    let r=s.workshopInstructorProfiles.find(x=>x.user_id===userId);
    if(!r){r={user_id:userId};s.workshopInstructorProfiles.push(r)}
    Object.assign(r,payload);save(s);return r;
  }
  const q=await supabase.from('workshop_instructor_profiles').upsert({user_id:userId,...payload},{onConflict:'user_id'}).select('*').single();
  if(q.error)throw q.error;return q.data;
}


export async function listWorkshopMonthlyPlans(month=monthKey(),workshopId=null){
  const planMonth=String(month).slice(0,7)+'-01';
  if(mode==='mock'){
    const s=mock();let rows=(s.workshopMonthlyPlans||[]).filter(x=>x.plan_month===planMonth);
    if(workshopId)rows=rows.filter(x=>x.workshop_id===workshopId);
    return rows;
  }
  let q=supabase.from('workshop_monthly_plans').select('*').eq('plan_month',planMonth).order('created_at',{ascending:false});
  if(workshopId)q=q.eq('workshop_id',workshopId);
  const out=await q;if(out.error)throw out.error;return out.data||[];
}
export async function getWorkshopMonthlyPlan(planId){
  if(mode==='mock'){
    const s=mock(),plan=(s.workshopMonthlyPlans||[]).find(x=>x.id===planId);
    if(!plan)throw new Error('Planejamento não encontrado.');
    const lessons=(s.workshopPlanLessons||[]).filter(x=>x.plan_id===planId).sort((a,b)=>a.lesson_number-b.lesson_number);
    return {plan,lessons};
  }
  const p=await supabase.from('workshop_monthly_plans').select('*').eq('id',planId).single();
  const l=await supabase.from('workshop_plan_lessons').select('*').eq('plan_id',planId).order('lesson_number');
  if(p.error)throw p.error;if(l.error)throw l.error;
  return {plan:p.data,lessons:l.data||[]};
}
export async function syncWorkshopMonthlyPlan(workshopId,month=monthKey()){
  const key=String(month).slice(0,7),planMonth=key+'-01';
  const parts=key.split('-').map(Number),yy=parts[0],mm=parts[1];
  const start=planMonth,end=new Date(Date.UTC(yy,mm,1)).toISOString().slice(0,10);
  if(mode==='mock'){
    const s=mock(),w=s.workshops.find(x=>x.id===workshopId);if(!w)throw new Error('Oficina não encontrada.');
    if(w.schedule_mode==='semanal_fixa')await generateWorkshopFixedCalendar(w);
    s.workshopMonthlyPlans||=[];s.workshopPlanLessons||=[];
    let plan=s.workshopMonthlyPlans.find(x=>x.workshop_id===workshopId&&x.plan_month===planMonth);
    if(!plan){plan={id:uid('wplan'),workshop_id:workshopId,plan_month:planMonth,instructor_user_id:w.oficineiro_user_id||null,educator_user_id:w.educator_user_id||null,status:'rascunho',created_at:now(),updated_at:now()};s.workshopMonthlyPlans.push(plan)}
    const entries=(s.workshopCalendar||[]).filter(x=>x.workshop_id===workshopId&&x.scheduled_date>=start&&x.scheduled_date<end&&x.status!=='cancelada').sort((a,b)=>String(a.scheduled_date+a.start_time).localeCompare(String(b.scheduled_date+b.start_time)));
    for(const x of s.workshopPlanLessons.filter(x=>x.plan_id===plan.id))x.included=false;
    entries.forEach((e,i)=>{let x=s.workshopPlanLessons.find(z=>z.plan_id===plan.id&&z.calendar_entry_id===e.id);if(!x){x={id:uid('wlesson'),plan_id:plan.id,calendar_entry_id:e.id,theme:'Aula '+(i+1)};s.workshopPlanLessons.push(x)}else if(/^Aula\s+\d+$/i.test(String(x.theme||'')))x.theme='Aula '+(i+1);Object.assign(x,{lesson_number:i+1,scheduled_date:e.scheduled_date,start_time:e.start_time,end_time:e.end_time,location_type:e.location_type||w.location_type||null,location_other:e.location_other||w.location_other||null,included:true,updated_at:now()})});
    save(s);return {plan,lessons:s.workshopPlanLessons.filter(x=>x.plan_id===plan.id&&x.included).sort((a,b)=>a.lesson_number-b.lesson_number)};
  }
  const wq=await supabase.from('workshops').select('*').eq('id',workshopId).single();if(wq.error)throw wq.error;
  const w=wq.data;
  if(w.schedule_mode==='semanal_fixa')await generateWorkshopFixedCalendar(w);
  let pq=await supabase.from('workshop_monthly_plans').select('*').eq('workshop_id',workshopId).eq('plan_month',planMonth).maybeSingle();
  if(pq.error)throw pq.error;
  let plan=pq.data;
  if(!plan){
    const ins=await supabase.from('workshop_monthly_plans').insert({workshop_id:workshopId,plan_month:planMonth,instructor_user_id:w.oficineiro_user_id||null,educator_user_id:w.educator_user_id||null,status:'rascunho'}).select('*').single();
    if(ins.error)throw ins.error;plan=ins.data;
  }else{
    const upd=await supabase.from('workshop_monthly_plans').update({instructor_user_id:w.oficineiro_user_id||plan.instructor_user_id||null,educator_user_id:w.educator_user_id||plan.educator_user_id||null,updated_at:now()}).eq('id',plan.id).select('*').single();
    if(upd.error)throw upd.error;plan=upd.data;
  }
  const calQ=await supabase.from('workshop_calendar').select('*').eq('workshop_id',workshopId).gte('scheduled_date',start).lt('scheduled_date',end).neq('status','cancelada').order('scheduled_date').order('start_time');
  const lessQ=await supabase.from('workshop_plan_lessons').select('*').eq('plan_id',plan.id);
  if(calQ.error)throw calQ.error;if(lessQ.error)throw lessQ.error;
  const existing=new Map((lessQ.data||[]).filter(x=>x.calendar_entry_id).map(x=>[x.calendar_entry_id,x]));
  const disable=await supabase.from('workshop_plan_lessons').update({included:false,updated_at:now()}).eq('plan_id',plan.id);
  if(disable.error)throw disable.error;
  const rows=(calQ.data||[]).map((e,i)=>{
    const old=existing.get(e.id)||{};
    return {plan_id:plan.id,calendar_entry_id:e.id,lesson_number:i+1,scheduled_date:e.scheduled_date,start_time:e.start_time||w.start_time||null,end_time:e.end_time||w.end_time||null,location_type:e.location_type||w.location_type||null,location_other:e.location_other||w.location_other||null,theme:(old.theme&&!/^Aula\s+\d+$/i.test(String(old.theme)))?old.theme:('Aula '+(i+1)),objective:old.objective||null,proposed_activities:old.proposed_activities||null,resources:old.resources||null,cfdh_transversal:old.cfdh_transversal||null,observations:old.observations||null,included:true,updated_at:now()};
  });
  if(rows.length){
    const up=await supabase.from('workshop_plan_lessons').upsert(rows,{onConflict:'plan_id,calendar_entry_id'}).select('*');
    if(up.error)throw up.error;
  }
  const finalQ=await supabase.from('workshop_plan_lessons').select('*').eq('plan_id',plan.id).eq('included',true).order('lesson_number');
  if(finalQ.error)throw finalQ.error;
  return {plan,lessons:finalQ.data||[]};
}
export async function saveWorkshopMonthlyPlan(planId,header={},lessons=[]){
  const planPatch={updated_at:now()};
  for(const k of ['general_objective','general_methodology','expected_results','general_resources','observations','status'])if(header[k]!==undefined)planPatch[k]=header[k]===''?null:header[k];
  if(mode==='mock'){
    const s=mock(),plan=(s.workshopMonthlyPlans||[]).find(x=>x.id===planId);if(!plan)throw new Error('Planejamento não encontrado.');Object.assign(plan,planPatch);
    for(const row of lessons){const x=(s.workshopPlanLessons||[]).find(z=>z.id===row.id&&z.plan_id===planId);if(x)for(const k of ['theme','objective','proposed_activities','resources','cfdh_transversal','observations'])if(row[k]!==undefined)x[k]=row[k]}
    save(s);return {plan,lessons:(s.workshopPlanLessons||[]).filter(x=>x.plan_id===planId&&x.included)};
  }
  const p=await supabase.from('workshop_monthly_plans').update(planPatch).eq('id',planId).select('*').single();if(p.error)throw p.error;
  if(lessons.length){
    for(const row of lessons){
      const patch={theme:row.theme||'',objective:row.objective||null,proposed_activities:row.proposed_activities||null,resources:row.resources||null,cfdh_transversal:row.cfdh_transversal||null,observations:row.observations||null,updated_at:now()};
      const l=await supabase.from('workshop_plan_lessons').update(patch).eq('id',row.id).eq('plan_id',planId);
      if(l.error)throw l.error;
    }
  }
  return getWorkshopMonthlyPlan(planId);
}


async function downloadCrjDocumentRequest(body,defaultBase){
  if(mode==='mock')throw new Error('Exportação de documentos requer o banco conectado.');
  const sessionData=(await supabase.auth.getSession()).data;
  const token=sessionData.session?.access_token;
  if(!token)throw new Error('Sessão expirada. Entre novamente.');
  const res=await fetch(CONFIG.supabaseUrl+'/functions/v1/crj-export-document',{
    method:'POST',cache:'no-store',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+token,'apikey':CONFIG.supabasePublishableKey},
    body:JSON.stringify(body)
  });
  if(!res.ok){
    const err=await res.json().catch(()=>({}));
    throw new Error(err.error||'Não foi possível gerar o documento.');
  }
  const blob=await res.blob();
  if(!blob||blob.size<20)throw new Error('O servidor gerou um arquivo vazio.');
  const format=String(body.format||'pdf').toLowerCase();
  let filename=defaultBase+'.'+(format==='docx'?'docx':'pdf');
  const cd=res.headers.get('content-disposition')||'';
  const match=cd.match(/filename="?([^";]+)"?/i);
  if(match?.[1])filename=match[1].trim();
  const url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;a.download=filename;a.style.display='none';document.body.appendChild(a);
  try{a.click()}finally{setTimeout(()=>{a.remove();URL.revokeObjectURL(url)},30000)}
  return {filename,size:blob.size,type:blob.type};
}
export async function downloadWorkshopMonthlyPlan(planId,format='pdf'){
  return downloadCrjDocumentRequest({plan_id:planId,format},'Planejamento_Oficina');
}
export async function downloadWorkshopPlannedAttendance(planLessonId,format='pdf'){
  return downloadCrjDocumentRequest({plan_lesson_id:planLessonId,format},'Lista_Presenca_Planejada');
}

export async function enrollYouth(workshopId,youthId){
  if(mode==='mock'){ const s=mock(); if(!s.enrollments.some(x=>x.workshop_id===workshopId&&x.youth_id===youthId&&x.status==='ativo')) s.enrollments.push({id:uid('en'),workshop_id:workshopId,youth_id:youthId,status:'ativo',enrolled_at:now()}); s.journey.push({id:uid('ev'),youth_id:youthId,event_type:'oficina',title:'Inscrição em oficina',details:s.workshops.find(w=>w.id===workshopId)?.name||'',visibility:'general',event_date:now(),created_by:s.currentUser.id}); save(s); return; }
  const {error}=await supabase.from('workshop_enrollments').insert({workshop_id:workshopId,youth_id:youthId}); if(error) throw error;
  const w=(await supabase.from('workshops').select('name').eq('id',workshopId).single()).data; await addJourney(youthId,'oficina','Inscrição em oficina',w?.name||'','general');
}
export async function workshopRoster(workshopId){
  if(mode==='mock'){ const s=mock(); return s.enrollments.filter(e=>e.workshop_id===workshopId&&e.status==='ativo').map(e=>({...e,youth:s.youth.find(y=>y.id===e.youth_id)})); }
  const {data,error}=await supabase.from('workshop_enrollments').select('*, young_people(*)').eq('workshop_id',workshopId).eq('status','ativo'); if(error) throw error; return (data||[]).map(x=>({...x,youth:x.young_people}));
}
export async function createWorkshopSession(row){
  const hrs=Number(row.duration_hours||durationHours(row.start_time,row.end_time));
  const payload={...row,duration_hours:hrs,location_type:row.location_type||null,location_other:row.location_other||null,calendar_entry_id:row.calendar_entry_id||null,plan_lesson_id:row.plan_lesson_id||null,educator_user_id:row.educator_user_id||null};
  if(mode==='mock'){ const s=mock(), rec={id:uid('sess'),...payload,created_by:s.currentUser.id}; s.sessions.push(rec); s.indicatorEvents.push({id:uid('met'),indicator_code:'M6.1_OFICINAS_HORAS',event_date:rec.session_date,quantity:hrs,source_type:'workshop_session',source_id:rec.id,source_mode:'identified'}); if(rec.calendar_entry_id){const ce=(s.workshopCalendar||[]).find(x=>x.id===rec.calendar_entry_id);if(ce){ce.status='realizada';ce.session_id=rec.id}} save(s); return rec; }
  const {data,error}=await supabase.from('workshop_sessions').insert(payload).select('*').single(); if(error) throw error;
  if(data.calendar_entry_id){
    const {error:ce}=await supabase.from('workshop_calendar').update({status:'realizada',session_id:data.id,updated_at:now()}).eq('id',data.calendar_entry_id);
    if(ce)throw ce;
  }
  return data;
}
export async function updateWorkshopSession(id,patch){
  const allowed={};
  for(const k of ['session_date','start_time','end_time','content','notes','cfdh_minutes','location_type','location_other','educator_user_id']){
    if(patch[k]!==undefined)allowed[k]=patch[k]||null;
  }
  if(patch.start_time!==undefined||patch.end_time!==undefined){
    allowed.duration_hours=Number(patch.duration_hours||durationHours(patch.start_time,patch.end_time));
  }
  if(mode==='mock'){const s=mock(),rec=(s.sessions||[]).find(x=>x.id===id);if(!rec)throw new Error('Aula não encontrada');Object.assign(rec,allowed);save(s);return rec;}
  const {data,error}=await supabase.from('workshop_sessions').update(allowed).eq('id',id).select('*').single();
  if(error)throw error;return data;
}

export async function saveAttendance(sessionId,workshopId,date,youthIds){
  if(mode==='mock'){
    const s=mock(); s.attendance=s.attendance.filter(a=>a.session_id!==sessionId);
    for(const y of youthIds){ const id=uid('pre'); s.attendance.push({id,session_id:sessionId,workshop_id:workshopId,youth_id:y,date,present:true}); s.indicatorEvents.push({id:uid('met'),indicator_code:'M2.1_ATENDIMENTOS',youth_id:y,event_date:date,quantity:1,source_type:'attendance',source_id:id,source_mode:'identified'}); s.journey.push({id:uid('ev'),youth_id:y,event_type:'presenca',title:'Presença em oficina',details:s.workshops.find(w=>w.id===workshopId)?.name||'',visibility:'general',event_date:new Date(date).toISOString(),created_by:s.currentUser.id}); } save(s); return;
  }
  const adHoc=String(sessionId||'').startsWith('manual_');
  if(adHoc) await supabase.from('attendance').delete().eq('workshop_id',workshopId).eq('attendance_date',date).is('session_id',null);
  else await supabase.from('attendance').delete().eq('session_id',sessionId);
  if(youthIds.length){
    const {error}=await supabase.from('attendance').insert(youthIds.map(youth_id=>({session_id:adHoc?null:sessionId,workshop_id:workshopId,youth_id,present:true,attendance_date:date}))); if(error) throw error;
    const w=(await supabase.from('workshops').select('name').eq('id',workshopId).single()).data;
    for(const youthId of youthIds) await addJourney(youthId,'presenca','Presença em oficina',w?.name||'','general',new Date(`${date}T12:00:00`).toISOString());
  }
}

export async function createAggregate(row){
  if(mode==='mock'){ const s=mock(), rec={id:uid('agg'),...row,created_at:now(),created_by:s.currentUser.id}; s.aggregate.push(rec); s.indicatorEvents.push({id:uid('met'),indicator_code:row.indicator_code,event_date:row.date,quantity:Number(row.quantity||0),source_type:'aggregate_record',source_id:rec.id,source_mode:'aggregate'}); save(s); return rec; }
  const {data,error}=await supabase.from('aggregate_records').insert({record_date:row.date,indicator_code:row.indicator_code,quantity:row.quantity,description:row.description,evidence_ref:row.evidence_ref}).select('*').single(); if(error) throw error; return data;
}


function periodMonths(periodicity='mensal'){
  return ({bimestral:2,trimestral:3,semestral:6,anual:12})[periodicity] || 1;
}
function indicatorWindow(month,periodicity='mensal'){
  const [y,m]=String(month).split('-').map(Number);
  const [cy,cm]=String(CONFIG.contractStart||'2025-10-01').slice(0,7).split('-').map(Number);
  const n=periodMonths(periodicity), diff=(y-cy)*12+(m-cm), block=Math.floor(diff/n);
  const start=new Date(Date.UTC(cy,cm-1+block*n,1));
  const end=new Date(Date.UTC(cy,cm-1+(block+1)*n,1));
  return {start:start.toISOString().slice(0,10),end:end.toISOString().slice(0,10),months:n};
}
export async function listIndicatorCatalog(){
 