function workshopPayload(row){
  const out={};
  for(const k of ['name','category','workshop_type','schedule_mode','planned_start_date','planned_end_date','location_type','location_other','planning_notes','start_time','end_time','oficineiro_user_id','educator_user_id']){
    if(row[k]!==undefined) out[k]=row[k]===''?null:row[k];
  }
  if(row.active!==undefined) out.active=row.active===true||row.active==='true'||row.active==='1'||row.active==='on';
  const weekdays=row.fixed_weekdays;
  out.fixed_weekdays=Array.isArray(weekdays)?weekdays.map(Number).filter(n=>Number.isInteger(n)&&n>=0&&n<=6):weekdays===''||weekdays==null?[]:[Number(weekdays)].filter(n=>Number.isInteger(n)&&n>=0&&n<=6);
  const dayNames=['domingo','segunda','terça','quarta','quinta','sexta','sábado'];
  out.days=out.schedule_mode==='semanal_fixa'&&out.fixed_weekdays.length?out.fixed_weekdays.map(n=>dayNames[n]).join(', '):(row.days||null);
  return out;
}
export async function createWorkshop(row){
  const payload=workshopPayload(row);
  if(mode==='mock'){ const s=mock(), rec={id:uid('ofi'),active:true,...payload}; s.workshops.push(rec); save(s); return rec; }
  const {data,error}=await supabase.from('workshops').insert(payload).select('*').single(); if(error) throw error; return data;
}
export async function updateWorkshop(id,row){
  const payload={...workshopPayload(row),updated_at:now()};
  if(mode==='mock'){const s=mock(),w=s.workshops.find(x=>x.id===id);if(!w)throw new Error('Oficina não encontrada');Object.assign(w,payload);save(s);return w;}
  const {data,error}=await supabase.from('workshops').update(payload).eq('id',id).select('*').single();if(error)throw error;return data;
}
export async function listWorkshopCalendar(fromDate=null,toDate=null,workshopId=null){
  if(mode==='mock'){
    const s=mock();let rows=s.workshopCalendar||[];
    if(fromDate)rows=rows.filter(x=>x.scheduled_date>=fromDate);
    if(toDate)rows=rows.filter(x=>x.scheduled_date<toDate);
    if(workshopId)rows=rows.filter(x=>x.workshop_id===workshopId);
    return rows.sort((a,b)=>String(a.scheduled_date+a.start_time).localeCompare(String(b.scheduled_date+b.start_time)));
  }
  let q=supabase.from('workshop_calendar').select('*, workshops(id,name,workshop_type,schedule_mode,location_type,location_other,oficineiro_user_id)').order('scheduled_date').order('start_time');
  if(fromDate)q=q.gte('scheduled_date',fromDate);
  if(toDate)q=q.lt('scheduled_date',toDate);
  if(workshopId)q=q.eq('workshop_id',workshopId);
  const {data,error}=await q;if(error)throw error;return data||[];
}
export async function createWorkshopCalendarEntry(row){
  const payload={
    workshop_id:row.workshop_id,scheduled_date:row.scheduled_date,start_time:row.start_time||null,end_time:row.end_time||null,
    location_type:row.location_type||null,location_other:row.location_other||null,source:row.source||'manual',
    status:row.status||'planejada',notes:row.notes||null
  };
  if(mode==='mock'){const s=mock();s.workshopCalendar||=[];const rec={id:uid('cal'),...payload};s.workshopCalendar.push(rec);save(s);return rec;}
  const {data,error}=await supabase.from('workshop_calendar').upsert(payload,{onConflict:'workshop_id,scheduled_date,start_time',ignoreDuplicates:false}).select('*').single();if(error)throw error;return data;
}
export async function updateWorkshopCalendarEntry(id,patch){
  const payload={updated_at:now()};
  for(const k of ['scheduled_date','start_time','end_time','location_type','location_other','status','notes','session_id'])if(patch[k]!==undefined)payload[k]=patch[k]||null;
  if(mode==='mock'){const s=mock(),r=(s.workshopCalendar||[]).find(x=>x.id===id);if(!r)throw new Error('Data não encontrada');Object.assign(r,payload);save(s);return r;}
  const {data,error}=await supabase.from('workshop_calendar').update(payload).eq('id',id).select('*').single();if(error)throw error;return data;
}
export async function generateWorkshopFixedCalendar(workshop,horizonDays=90){
  if(!workshop||workshop.schedule_mode!=='semanal_fixa')return [];
  const weekdays=(workshop.fixed_weekdays||[]).map(Number);
  if(!weekdays.length||!workshop.planned_start_date)return [];
  const start=new Date(workshop.planned_start_date+'T12:00:00Z');
  let end=workshop.planned_end_date?new Date(workshop.planned_end_date+'T12:00:00Z'):new Date(start.getTime()+Number(horizonDays||90)*86400000);
  if(workshop.workshop_type==='pontual')end=new Date(start);
  const today=new Date();today.setUTCHours(12,0,0,0);
  const rows=[];
  for(let d=new Date(start);d<=end;d.setUTCDate(d.getUTCDate()+1)){
    if(weekdays.includes(d.getUTCDay())){
      rows.push({
        workshop_id:workshop.id,scheduled_date:d.toISOString().slice(0,10),start_time:workshop.start_time||null,end_time:workshop.end_time||null,
        location_type:workshop.location_type||null,location_other:workshop.location_other||null,source:'regra_fixa',status:'planejada'
      });
    }
  }
  if(mode==='mock'){
    const s=mock();s.workshopCalendar=(s.workshopCalendar||[]).filter(x=>!(x.workshop_id===workshop.id&&x.source==='regra_fixa'&&x.status==='planejada'));
    save(s);const out=[];for(const row of rows)out.push(await createWorkshopCalendarEntry(row));return out;
  }
  const {error:clearError}=await supabase.from('workshop_calendar').delete().eq('workshop_id',workshop.id).eq('source','regra_fixa').eq('status','planejada');
  if(clearError)throw clearError;
  if(!rows.length)return [];
  const {data,error}=await supabase.from('workshop_calendar').upsert(rows,{onConflict:'workshop_id,scheduled_date,start_time',ignoreDuplicates:true}).select('*');if(error)throw error;return data||[];
}
