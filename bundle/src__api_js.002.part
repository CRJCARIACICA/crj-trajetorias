export async function listWorkshopInstructorDashboard(month=monthKey()){
  const [yy,mm]=String(month).split('-').map(Number);
  const start=`${yy}-${String(mm).padStart(2,'0')}-01`;
  const end=new Date(Date.UTC(yy,mm,1)).toISOString().slice(0,10);
  if(mode==='mock'){
    const s=mock(),profiles=(s.team||[]),workshops=s.workshops||[],sessions=(s.sessions||[]).filter(x=>x.session_date>=start&&x.session_date<end);
    const attendance=s.attendance||[],guests=s.guestParticipations||[],records=s.workshopInstructorRecords||[],edu=s.educatorRecords||[];
    return buildInstructorDashboard(profiles,workshops,sessions,attendance,guests,records,edu);
  }
  const [profilesQ,workshopsQ,sessionsQ,attendanceQ,guestsQ,recordsQ,eduQ]=await Promise.all([
    supabase.from('profiles').select('id,display_name,role,active').eq('active',true).order('display_name'),
    supabase.from('workshops').select('*').order('name'),
    supabase.from('workshop_sessions').select('*').gte('session_date',start).lt('session_date',end).order('session_date',{ascending:false}),
    supabase.from('attendance').select('session_id,workshop_id,attendance_date,present').gte('attendance_date',start).lt('attendance_date',end).eq('present',true),
    supabase.from('workshop_guest_participations').select('session_id,workshop_id,participation_date').gte('participation_date',start).lt('participation_date',end),
    supabase.from('workshop_instructor_records').select('*').gte('record_date',start).lt('record_date',end).order('record_date',{ascending:false}).limit(500),
    supabase.from('educator_records').select('workshop_id,record_date,record_type,title,description').eq('record_type','acompanhamento_oficina').gte('record_date',start).lt('record_date',end)
  ]);
  for(const q of [profilesQ,workshopsQ,sessionsQ,attendanceQ,guestsQ,recordsQ,eduQ])if(q.error)throw q.error;
  return buildInstructorDashboard(profilesQ.data||[],workshopsQ.data||[],sessionsQ.data||[],attendanceQ.data||[],guestsQ.data||[],recordsQ.data||[],eduQ.data||[]);
}
function buildInstructorDashboard(profiles,workshops,sessions,attendance,guests,records,educatorRecords){
  const assignedIds=new Set(workshops.map(w=>w.oficineiro_user_id).filter(Boolean));
  const instructors=profiles.filter(p=>p.role==='oficineiro'||assignedIds.has(p.id));
  const attendanceBySession=new Map();
  for(const a of attendance||[]){if(!a.session_id)continue;attendanceBySession.set(a.session_id,(attendanceBySession.get(a.session_id)||0)+1);}
  for(const g of guests||[]){if(!g.session_id)continue;attendanceBySession.set(g.session_id,(attendanceBySession.get(g.session_id)||0)+1);}
  return instructors.map(p=>{
    const linked=workshops.filter(w=>w.oficineiro_user_id===p.id);
    const ids=new Set(linked.map(w=>w.id));
    const ss=sessions.filter(s=>ids.has(s.workshop_id));
    const confirmed=ss.filter(s=>(attendanceBySession.get(s.id)||0)>0);
    const hours=arr=>arr.reduce((sum,x)=>sum+Number(x.duration_hours||0),0);
    const participationRecords=ss.reduce((sum,s)=>sum+(attendanceBySession.get(s.id)||0),0);
    const followups=(educatorRecords||[]).filter(r=>ids.has(r.workshop_id));
    const instructorRecords=(records||[]).filter(r=>r.instructor_user_id===p.id);
    return {
      id:p.id,display_name:p.display_name,workshops:linked,
      metrics:{classes_registered:ss.length,classes_with_attendance:confirmed.length,hours_registered:hours(ss),hours_confirmed:hours(confirmed),participation_records:participationRecords,workshop_followups:followups.length},
      recent_classes:ss.slice(0,12).map(s=>({...s,workshop_name:linked.find(w=>w.id===s.workshop_id)?.name||'',attendance_count:attendanceBySession.get(s.id)||0,confirmed:(attendanceBySession.get(s.id)||0)>0})),
      followups:followups.slice(0,12),
      records:instructorRecords.slice(0,30)
    };
  }).sort((a,b)=>String(a.display_name).localeCompare(String(b.display_name),'pt-BR'));
}
export async function enrollYouth(workshopId,youthId){
  if(mode==='mock'){ const s=mock(); if(!s.enrollments.some(x=>x.workshop_id===workshopId&&x.youth_id===youthId&&x.status==='ativo')) s.enrollments.push({id:uid('en'),workshop_id:workshopId,youth_id:youthId,status:'ativo',enrolled_at:now()}); s.journey.push({id:uid('ev'),youth_id:youthId,event_type:'oficina',title:'Inscrição em oficina',details:s.workshops.find(w=>w.id===workshopId)?.name||'',visibility:'general',event_date:now(),created_by:s.currentUser.id}); save(s); return; }
  const {error}=await supabase.from('workshop_enrollments').insert({workshop_id:workshopId,youth_id:youthId}); if(error) throw error;
  const w=(await supabase.from('workshops').select('name').eq('id',workshopId).single()).data; await addJourney(youthId,'oficina','Inscrição em oficina',w?.name||'','general');
}
export async function workshopRoster(workshopId){
  if(mode==='mock'){ const s=mock(); return s.enrollments.filter(e=>e.workshop_id===workshopId&&e.status==='ativo').map(e=>({...e,youth:s.youth.find(y=>y.id===e.youth_id)})); }
  const {data,error}=await supabase.from('workshop_enrollments').select('*, young_people(*)').eq('workshop_id',workshopId).eq('status','ativo'); if(error) throw error; return (data||[]).map(x=>({...x,youth:x.young_people}));
}
export async function createWorkshopSession(row){
  const hrs=Number(row.duration_hours||durationHours(row.start_time,row.end_time));
  const payload={...row,duration_hours:hrs,location_type:row.location_type||null,location_other:row.location_other||null,calendar_entry_id:row.calendar_entry_id||null};
  if(mode==='mock'){ const s=mock(), rec={id:uid('sess'),...payload,created_by:s.currentUser.id}; s.sessions.push(rec); s.indicatorEvents.push({id:uid('met'),indicator_code:'M6.1_OFICINAS_HORAS',event_date:rec.session_date,quantity:hrs,source_type:'workshop_session',source_id:rec.id,source_mode:'identified'}); if(rec.calendar_entry_id){const ce=(s.workshopCalendar||[]).find(x=>x.id===rec.calendar_entry_id);if(ce){ce.status='realizada';ce.session_id=rec.id}} save(s); return rec; }
  const {data,error}=await supabase.from('workshop_sessions').insert(payload).select('*').single(); if(error) throw error;
  if(data.calendar_entry_id){
    const {error:ce}=await supabase.from('workshop_calendar').update({status:'realizada',session_id:data.id,updated_at:now()}).eq('id',data.calendar_entry_id);
    if(ce)throw ce;
  }
  return data;
}
export async function saveAttendance(sessionId,workshopId,date,youthIds){
  if(mode==='mock'){
    const s=mock(); s.attendance=s.attendance.filter(a=>a.session_id!==sessionId);
    for(const y of youthIds){ const id=uid('pre'); s.attendance.push({id,session_id:sessionId,workshop_id:workshopId,youth_id:y,date,present:true}); s.indicatorEvents.push({id:uid('met'),indicator_code:'M2.1_ATENDIMENTOS',youth_id:y,event_date:date,quantity:1,source_type:'attendance',source_id:id,source_mode:'identified'}); s.journey.push({id:uid('ev'),youth_id:y,event_type:'presenca',title:'Presença em oficina',details:s.workshops.find(w=>w.id===workshopId)?.name||'',visibility:'general',event_date:new Date(date).toISOString(),created_by:s.currentUser.id}); } save(s); return;
  }
  const adHoc=String(sessionId||'').startsWith('manual_');
  if(adHoc) await supabase.from('attendance').delete().eq('workshop_id',workshopId).eq('attendance_date',date).is('session_id',null);
  else await supabase.from('attendance').delete().eq('session_id',sessionId);
  if(youthIds.length){
    const {error}=await supabase.from('attendance').insert(youthIds.map(youth_id=>({session_id:adHoc?null:sessionId,workshop_id:workshopId,youth_id,present:true,attendance_date:date}))); if(error) throw error;
    const w=(await supabase.from('workshops').select('name').eq('id',workshopId).single()).data;
    for(const youthId of youthIds) await addJourney(youthId,'presenca','Presença em oficina',w?.name||'','general',new Date(`${date}T12:00:00`).toISOString());
  }
}

export async function createAggregate(row){
  if(mode==='mock'){ const s=mock(), rec={id:uid('agg'),...row,created_at:now(),created_by:s.currentUser.id}; s.aggregate.push(rec); s.indicatorEvents.push({id:uid('met'),indicator_code:row.indicator_code,event_date:row.date,quantity:Number(row.quantity||0),source_type:'aggregate_record',source_id:rec.id,source_mode:'aggregate'}); save(s); return rec; }
  const {data,error}=await supabase.from('aggregate_records').insert({record_date:row.date,indicator_code:row.indicator_code,quantity:row.quantity,description:row.description,evidence_ref:row.evidence_ref}).select('*').single(); if(error) throw error; return data;
}


function periodMonths(periodicity='mensal'){
  return ({bimestral:2,trimestral:3,semestral:6,anual:12})[periodicity] || 1;
}
function indicatorWindow(month,periodicity='mensal'){
  const [y,m]=String(month).split('-').map(Number);
  const [cy,cm]=String(CONFIG.contractStart||'2025-10-01').slice(0,7).split('-').map(Number);
  const n=periodMonths(periodicity), diff=(y-cy)*12+(m-cm), block=Math.floor(diff/n);
  const start=new Date(Date.UTC(cy,cm-1+block*n,1));
  const end=new Date(Date.UTC(cy,cm-1+(block+1)*n,1));
  return {start:start.toISOString().slice(0,10),end:end.toISOString().slice(0,10),months:n};
}
export async function listIndicatorCatalog(){
 