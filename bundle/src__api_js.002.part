  for(const k of ['technical_target_total_services','technical_target_unique_youth','technical_target_collective_services','technical_target_pvida','technical_target_ptrampo_youth','technical_target_ptrampo_activities','technical_target_other_demands']){
    if(patch[k]!==undefined)allowed[k]=patch[k];
  }
  if(mode==='mock'){const s=mock();s.documentSettings={...(s.documentSettings||{id:1}),...allowed};save(s);return s.documentSettings;}
  const {data,error}=await supabase.from('crj_document_settings').update(allowed).eq('id',1).select('*').single();
  if(error)throw error;return data;
}
export async function createTechnicalService(row){
  const youthIds=Array.isArray(row.youth_ids)?row.youth_ids:row.youth_ids?[row.youth_ids]:row.youth_id?[row.youth_id]:[];
  const professionalIds=Array.isArray(row.professional_ids)?row.professional_ids:row.professional_ids?[row.professional_ids]:[];
  if(!youthIds.length)throw new Error('Selecione ao menos um jovem atendido.');
  if(!professionalIds.length)throw new Error('Selecione ao menos um técnico responsável.');
  if(mode==='mock'){
    const s=mock();s.technicalServices||=[];
    const rec={id:uid('ts'),service_date:row.service_date||new Date().toISOString().slice(0,10),service_type:row.service_type||'individual',program_type:row.program_type||'atendimento',reason:row.reason||'Atendimento técnico',summary:row.summary||'',status:row.status||'realizado',created_by:s.currentUser.id,created_at:now(),youth_ids:youthIds,professional_ids:professionalIds};
    s.technicalServices.push(rec);save(s);return rec;
  }
  const ins=await supabase.from('technical_service_records').insert({
    service_date:row.service_date||new Date().toISOString().slice(0,10),
    service_type:row.service_type||'individual',
    program_type:row.program_type||'atendimento',
    reason:row.reason||'Atendimento técnico',
    summary:row.summary||null,
    status:row.status||'realizado'
  }).select('*').single();
  if(ins.error)throw ins.error;
  const serviceId=ins.data.id;
  const yRows=youthIds.map(youth_id=>({service_id:serviceId,youth_id}));
  const pRows=professionalIds.map(professional_id=>({service_id:serviceId,professional_id,responsibility:'Técnico responsável'}));
  const [yr,pr]=await Promise.all([
    supabase.from('technical_service_youth').insert(yRows),
    supabase.from('technical_service_professionals').insert(pRows)
  ]);
  if(yr.error)throw yr.error;if(pr.error)throw pr.error;
  const category={pvida:'PVida',ptrampo:'PTrampo','outras-demandas':'Outras Demandas',acompanhamento:'Acompanhamento técnico',atendimento:'Atendimento técnico'}[row.program_type]||'Atendimento técnico';
  for(const youth_id of youthIds){
    const legacy=await supabase.from('service_records').insert({youth_id,service_date:ins.data.service_date,category,description:row.reason||row.summary||category,status:row.status||'realizado'}).select('id').single();
    if(!legacy.error){
      await addJourney(youth_id,'atendimento',category,row.reason||row.summary||'','technical',new Date(ins.data.service_date).toISOString());
    }
  }
  return ins.data;
}
export async function maybeMirrorTechnicalService(service,row){
  try{
    if(!service?.id)return service;
    const profile=await currentTechnicalProfile();
    if(!profile||!['assistente_social','psicologo','terapeuta_ocupacional'].includes(profile.role))return service;
    const exists=await supabase.from('technical_service_records').select('id').eq('legacy_service_record_id',service.id).maybeSingle();
    if(exists.data)return service;
    const program=String(row.category||'').toLowerCase().includes('pvida')?'pvida':String(row.category||'').toLowerCase().includes('ptrampo')?'ptrampo':String(row.category||'').toLowerCase().includes('outras')?'outras-demandas':String(row.category||'').toLowerCase().includes('acompanh')?'acompanhamento':'atendimento';
    const tr=await supabase.from('technical_service_records').insert({
      service_date:service.service_date||row.date,
      service_type:'individual',
      program_type:program,
      reason:row.category||'Atendimento técnico',
      summary:row.description||null,
      status:row.status||'realizado',
      legacy_service_record_id:service.id
    }).select('*').single();
    if(tr.error)throw tr.error;
    await supabase.from('technical_service_youth').insert({service_id:tr.data.id,youth_id:row.youth_id});
    await supabase.from('technical_service_professionals').insert({service_id:tr.data.id,professional_id:profile.id,responsibility:'Técnico responsável'});
  }catch(err){console.warn('Falha ao espelhar atendimento técnico:',err)}
  return service;
}
export async function listTechnicalTeamDashboard(month=monthKey()){
  const key=String(month).slice(0,7),start=key+'-01';
  const parts=key.split('-').map(Number),end=new Date(Date.UTC(parts[0],parts[1],1)).toISOString().slice(0,10);
  if(mode==='mock'){
    const s=mock(),records=(s.technicalServices||[]).filter(x=>x.service_date>=start&&x.service_date<end),youthMap=new Map((s.youth||[]).map(x=>[x.id,x])),teamMap=new Map((s.team||[]).map(x=>[x.id,x]));
    const details=records.map(r=>({...r,youth:(r.youth_ids||[]).map(id=>youthMap.get(id)).filter(Boolean),professionals:(r.professional_ids||[]).map(id=>teamMap.get(id)).filter(Boolean)}));
    return buildTechnicalDashboard(details,await getDocumentSettings());
  }
  const [rq,yq,pq,youngQ,teamQ,settings]=await Promise.all([
    supabase.from('technical_service_records').select('*').gte('service_date',start).lt('service_date',end).order('service_date',{ascending:false}).order('created_at',{ascending:false}),
    supabase.from('technical_service_youth').select('*'),
    supabase.from('technical_service_professionals').select('*'),
    supabase.from('young_people').select('id,full_name,preferred_name'),
    supabase.from('profiles').select('id,display_name,role,active'),
    getDocumentSettings()
  ]);
  for(const q of [rq,yq,pq,youngQ,teamQ])if(q.error)throw q.error;
  const youthByService=new Map(),profByService=new Map(),youngMap=new Map((youngQ.data||[]).map(x=>[x.id,x])),teamMap=new Map((teamQ.data||[]).map(x=>[x.id,x]));
  for(const y of yq.data||[]){const a=youthByService.get(y.service_id)||[];const yp=youngMap.get(y.youth_id);if(yp)a.push(yp);youthByService.set(y.service_id,a)}
  for(const p of pq.data||[]){const a=profByService.get(p.service_id)||[];const pp=teamMap.get(p.professional_id);if(pp)a.push(pp);profByService.set(p.service_id,a)}
  const details=(rq.data||[]).map(r=>({...r,youth:youthByService.get(r.id)||[],professionals:profByService.get(r.id)||[]}));
  return buildTechnicalDashboard(details,settings);
}
function buildTechnicalDashboard(records,settings){
  records=(records||[]).filter(r=>r.status!=='cancelado');
  const youthIds=new Set(),byProfessional=new Map();
  for(const r of records){
    for(const y of r.youth||[])youthIds.add(y.id);
    for(const p of r.professionals||[]){const row=byProfessional.get(p.id)||{id:p.id,display_name:p.display_name,role:p.role,services:0,unique_youth:new Set()};row.services++;for(const y of r.youth||[])row.unique_youth.add(y.id);byProfessional.set(p.id,row)}
  }
  const countProgram=t=>records.filter(r=>r.program_type===t);
  const uniqueProgram=t=>new Set(countProgram(t).flatMap(r=>(r.youth||[]).map(y=>y.id))).size;
  const metrics={
    total_services:records.length,
    unique_youth:youthIds.size,
    individual_services:records.filter(r=>r.service_type==='individual').length,
    collective_services:records.filter(r=>r.service_type==='coletivo').length,
    pvida_services:countProgram('pvida').length,
    pvida_unique_youth:uniqueProgram('pvida'),
    ptrampo_services:countProgram('ptrampo').length,
    ptrampo_unique_youth:uniqueProgram('ptrampo'),
    other_demands:countProgram('outras-demandas').length,
    other_unique_youth:uniqueProgram('outras-demandas')
  };
  const evidence=[];
  for(const r of records){
    const professionals=(r.professionals||[]).map(p=>p.display_name).join(', ');
    for(const y of r.youth||[]) evidence.push({
      service_id:r.id,date:r.service_date,youth_id:y.id,youth_name:y.preferred_name||y.full_name,
      reason:r.reason,professional_names:professionals,service_type:r.service_type,program_type:r.program_type,status:r.status
    });
  }
  return {records,metrics,evidence,settings,professionals:[...byProfessional.values()].map(x=>({...x,unique_youth:x.unique_youth.size})).sort((a,b)=>b.services-a.services)};
}

export async function listWorkshops(){
  if(mode==='mock') return mock().workshops;
  const {data,error}=await supabase.from('workshops').select('*').order('name'); if(error) throw error; return data||[];
}
function workshopPayload(row){
  const out={};
  for(const k of ['name','category','workshop_type','schedule_mode','planned_start_date','planned_end_date','location_type','location_other','planning_notes','start_time','end_time','oficineiro_user_id','educator_user_id']){
    if(row[k]!==undefined) out[k]=row[k]===''?null:row[k];
  }
  if(row.active!==undefined) out.active=row.active===true||row.active==='true'||row.active==='1'||row.active==='on';
  const weekdays=row.fixed_weekdays;
  out.fixed_weekdays=Array.isArray(weekdays)?weekdays.map(Number).filter(n=>Number.isInteger(n)&&n>=0&&n<=6):weekdays===''||weekdays==null?[]:[Number(weekdays)].filter(n=>Number.isInteger(n)&&n>=0&&n<=6);
  const dayNames=['domingo','segunda','terça','quarta','quinta','sexta','sábado'];
  out.days=out.schedule_mode==='semanal_fixa'&&out.fixed_weekdays.length?out.fixed_weekdays.map(n=>dayNames[n]).join(', '):(row.days||null);
  return out;
}
export async function createWorkshop(row){
  const payload=workshopPayload(row);
  if(mode==='mock'){ const s=mock(), rec={id:uid('ofi'),active:true,...payload}; s.workshops.push(rec); save(s); return rec; }
  const {data,error}=await supabase.from('workshops').insert(payload).select('*').single(); if(error) throw error; return data;
}
export async function updateWorkshop(id,row){
  const payload={...workshopPayload(row),updated_at:now()};
  if(mode==='mock'){const s=mock(),w=s.workshops.find(x=>x.id===id);if(!w)throw new Error('Oficina não encontrada');Object.assign(w,payload);if(w.schedule_mode!=='semanal_fixa')s.workshopCalendar=(s.workshopCalendar||[]).filter(x=>!(x.workshop_id===id&&x.source==='regra_fixa'&&x.status==='planejada'));save(s);return w;}
  const {data,error}=await supabase.from('workshops').update(payload).eq('id',id).select('*').single();if(error)throw error;
  if(data.schedule_mode!=='semanal_fixa'){const {error:ce}=await supabase.from('workshop_calendar').delete().eq('workshop_id',id).eq('source','regra_fixa').eq('status','planejada');if(ce)throw ce;}
  return data;
}
export async function listWorkshopCalendar(fromDate=null,toDate=null,workshopId=null){
  if(mode==='mock'){
    const s=mock();let rows=s.workshopCalendar||[];
    if(fromDate)rows=rows.filter(x=>x.scheduled_date>=fromDate);
    if(toDate)rows=rows.filter(x=>x.scheduled_date<toDate);
    if(workshopId)rows=rows.filter(x=>x.workshop_id===workshopId);
    return rows.sort((a,b)=>String(a.scheduled_date+a.start_time).localeCompare(String(b.scheduled_date+b.start_time)));
  }
  let q=supabase.from('workshop_calendar').select('*, workshops(id,name,workshop_type,schedule_mode,location_type,location_other,oficineiro_user_id)').order('scheduled_date').order('start_time');
  if(fromDate)q=q.gte('scheduled_date',fromDate);
  if(toDate)q=q.lt('scheduled_date',toDate);
  if(workshopId)q=q.eq('workshop_id',workshopId);
  const {data,error}=await q;if(error)throw error;return data||[];
}
export async function createWorkshopCalendarEntry(row){
  const payload={
    workshop_id:row.workshop_id,scheduled_date:row.scheduled_date,start_time:row.start_time||null,end_time:row.end_time||null,
    location_type:row.location_type||null,location_other:row.location_other||null,source:row.source||'manual',
    status:row.status||'planejada',notes:row.notes||null
  };
  if(mode==='mock'){const s=mock();s.workshopCalendar||=[];const rec={id:uid('cal'),...payload};s.workshopCalendar.push(rec);save(s);return rec;}
  const {data,error}=await supabase.from('workshop_calendar').upsert(payload,{onConflict:'workshop_id,scheduled_date,start_time',ignoreDuplicates:false}).select('*').single();if(error)throw error;return data;
}
export async function updateWorkshopCalendarEntry(id,patch){
  const payload={updated_at:now()};
  for(const k of ['scheduled_date','start_time','end_time','location_type','location_other','status','notes','session_id'])if(patch[k]!==undefined)payload[k]=patch[k]||null;
  if(mode==='mock'){const s=mock(),r=(s.workshopCalendar||[]).find(x=>x.id===id);if(!r)throw new Error('Data não encontrada');Object.assign(r,payload);save(s);return r;}
  const {data,error}=await supabase.from('workshop_calendar').update(payload).eq('id',id).select('*').single();if(error)throw error;return data;
}
export async function generateWorkshopFixedCalendar(workshop,horizonDays=90){
  if(!workshop||workshop.schedule_mode!=='semanal_fixa')return [];
  const weekdays=(workshop.fixed_weekdays||[]).map(Number);
  if(!weekdays.length||!workshop.planned_start_date)return [];
  let start=new Date(workshop.planned_start_date+'T12:00:00Z');
  const today=new Date();today.setUTCHours(12,0,0,0);
  if(workshop.workshop_type==='permanente'&&!workshop.planned_end_date&&today>start)start=new Date(today);
  let end=workshop.planned_end_date?new Date(workshop.planned_end_date+'T12:00:00Z'):new Date(start.getTime()+Number(horizonDays||90)*86400000);
  if(workshop.workshop_type==='pontual')end=new Date(start);
  const rows=[];
  for(let d=new Date(start);d<=end;d.setUTCDate(d.getUTCDate()+1)){
    if(weekdays.includes(d.getUTCDay())){
      rows.push({
        workshop_id:workshop.id,scheduled_date:d.toISOString().slice(0,10),start_time:workshop.start_time||null,end_time:workshop.end_time||null,
        location_type:workshop.location_type||null,location_other:workshop.location_other||null,source:'regra_fixa',status:'planejada'
      });
    }
  }
  if(mode==='mock'){
    const s=mock();s.workshopCalendar=(s.workshopCalendar||[]).filter(x=>!(x.workshop_id===workshop.id&&x.source==='regra_fixa'&&x.status==='planejada'));
    save(s);const out=[];for(const row of rows)out.push(await createWorkshopCalendarEntry(row));return out;
  }
  const {error:clearError}=await supabase.from('workshop_calendar').delete().eq('workshop_id',workshop.id).eq('source','regra_fixa').eq('status','planejada');
  if(clearError)throw clearError;
  if(!rows.length)return [];
  const {data,error}=await supabase.from('workshop_calendar').upsert(rows,{onConflict:'workshop_id,scheduled_date,start_time',ignoreDuplicates:true}).select('*');if(error)throw error;return data||[];
}
