eturn await maybeMirrorTechnicalService(data,row);
}
export async function createFollowup(row){
  if(mode==='mock'){
    const s=mock(), rec={id:uid('aco'),...row,date:row.date||new Date().toISOString().slice(0,10),created_by:s.currentUser.id}; s.followups.push(rec);
    s.journey.push({id:uid('ev'),youth_id:row.youth_id,event_type:'acompanhamento',title:`Acompanhamento — ${row.followup_type||'Técnico'}`,details:row.summary||'',visibility:'technical',event_date:new Date(rec.date).toISOString(),created_by:s.currentUser.id});
    s.indicatorEvents.push({id:uid('met'),indicator_code:'ACOMPANHAMENTOS',youth_id:row.youth_id,event_date:rec.date,quantity:Number(row.duration_hours||1),source_type:'followup',source_id:rec.id,source_mode:'identified'}); save(s); return rec;
  }
  const {data,error}=await supabase.from('followups').insert({youth_id:row.youth_id,followup_date:row.date,followup_type:row.followup_type,summary:row.summary,duration_hours:row.duration_hours||1,status:row.status||'ativo'}).select('*').single(); if(error) throw error;
  await addJourney(row.youth_id,'acompanhamento',`Acompanhamento — ${row.followup_type||'Técnico'}`,row.summary||'','technical',new Date(row.date).toISOString()); return data;
}


