 if(mode==='mock') return INDICATORS;
  const {data,error}=await supabase.from('indicator_catalog').select('code,label,goal_stage,target,unit,target_mode,periodicity,active').eq('active',true).order('goal_stage',{ascending:true}).order('code',{ascending:true});
  if(error) throw error;
  return (data||[]).map(x=>({code:x.code,label:x.label,goalStage:x.goal_stage,target:x.target==null?null:Number(x.target),unit:x.unit,mode:x.target_mode,periodicity:x.periodicity||'mensal'}));
}

