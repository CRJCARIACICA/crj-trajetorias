

function educatorExecutionTypeLabel(t){
  return ({
    mobilizacao:'Mobilização',
    evento_programacao:'Evento / programação',
    mostra:'Mostra',
    acompanhamento_oficina:'Acompanhamento de oficina',
    trampo_labpoca:'Trampo Coletivo / LABPoca',
    mediacao_convivencia:'Mediação / convivência',
    ficaadica_orientacao:'#FicaAdica / orientação',
    outra_acao_educativa:'Outra ação educativa',
    estudo_caso:'Estudo de caso',
    aula_extra:'Aula / atividade extra da oficina'
  })[t]||eduTypeLabel(t)||t;
}
function workshopReportSnapshot(bundle){
  return {
    metrics:bundle?.metrics||{},
    lesson_execution:bundle?.lesson_execution||[],
    complementary_actions:bundle?.complementary_actions||[]
  };
}
function workshopReportDraft(bundle,form=null){
  const base=bundle?.report||{},get=name=>form?.querySelector('[name="'+name+'"]')?.value;
  const v=name=>form?get(name):(base[name]??'');
  return {
    ...base,
    plan_id:bundle?.plan?.id||base.plan_id||'',
    report_date:v('report_date')||new Date().toISOString().slice(0,10),
    execution_status:v('execution_status')||'realizado',
    actual_description:v('actual_description')||'',
    actual_participants:Number(bundle?.metrics?.unique_participants||0),
    actual_duration_hours:Number(bundle?.metrics?.executed_hours||0),
    methodology_applied:v('methodology_applied')||'',
    results_achieved:v('results_achieved')||'',
    resources_used:v('resources_used')||'',
    actions_performed:v('actions_performed')||'',
    unplanned_actions:v('unplanned_actions')||'',
    youth_feedback:v('youth_feedback')||'',
    positive_points:v('positive_points')||'',
    difficulties:v('difficulties')||'',
    next_steps:v('next_steps')||'',
    justification:v('justification')||'',
    evidence_ref:v('evidence_ref')||'',
    observations:v('observations')||'',
    execution_snapshot:workshopReportSnapshot(bundle)
  };
}
function workshopReportPreviewHtml(bundle,draft=null){
  const r=draft||workshopReportDraft(bundle),p=bundle?.plan||{},w=bundle?.workshop||{},m=bundle?.metrics||{};
  const teamMap=new Map((bundle?.team||[]).map(x=>[x.id,x.display_name]));
  const educator=teamMap.get(p.educator_user_id)||'Não definido';
  const instructor=teamMap.get(p.instructor_user_id)||'Não definido';
  const month=String(p.plan_month||'').slice(0,7).split('-').reverse().join('/');
  const lessonRows=(bundle?.lesson_execution||[]).map(x=>{
    const planned=esc((x.planned_theme||'')+(x.planned_objective?'\nObjetivo: '+x.planned_objective:''));
    const executed=x.executed
      ?esc((x.actual_content||'Execução registrada')+(x.actual_notes?'\nObs.: '+x.actual_notes:''))
      :'<span class="muted">Não executada / ainda não registrada</span>';
    const actualWhen=x.executed
      ?esc(fmtDate(x.actual_date)+' · '+String(x.actual_start||'').slice(0,5)+'–'+String(x.actual_end||'').slice(0,5)+' · '+Number(x.actual_hours||0).toLocaleString('pt-BR')+'h')
      :esc(fmtDate(x.planned_date)+' · '+String(x.planned_start||'').slice(0,5)+'–'+String(x.planned_end||'').slice(0,5));
    return '<tr><td><b>Aula '+esc(x.lesson_number)+'</b><br>'+actualWhen+'</td><td>'+planned.replace(/\n/g,'<br>')+'</td><td>'+String(executed).replace(/\n/g,'<br>')+'</td><td>'+Number(x.participant_count||0)+'</td><td>'+esc(x.educator_name||educator)+'</td><td>'+Number(x.cfdh_minutes||0)+' min</td></tr>';
  }).join('');
  const actionRows=(bundle?.complementary_actions||[]).map(a=>'<tr><td>'+esc(fmtDate(a.date))+'</td><td>'+esc(educatorExecutionTypeLabel(a.type))+'</td><td><b>'+esc(a.title||'')+'</b>'+(a.description?'<br>'+esc(a.description):'')+'</td><td>'+Number(a.duration_hours||0).toLocaleString('pt-BR')+'h</td><td>'+(a.participants_count??'—')+'</td></tr>').join('');
  const pair=(plannedLabel,plannedValue,actualLabel,actualValue)=>
    '<div class="methodology-report-pair"><div><b>'+esc(plannedLabel)+'</b><p>'+esc(plannedValue||'—')+'</p></div><div><b>'+esc(actualLabel)+'</b><p>'+esc(actualValue||'—')+'</p></div></div>';
  return '<div class="methodology-paper methodology-paper-landscape workshop-report-paper">'+
    '<div class="methodology-annex-title">CRJ CARIACICA · RELATÓRIO MENSAL DE EXECUÇÃO</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div>'+
    '<div class="methodology-inner-title">RELATÓRIO DE EXECUÇÃO DA OFICINA</div>'+
    '<div class="methodology-row"><b>Oficina:</b><span class="methodology-inline-answer">'+esc(w.name||'')+'</span></div>'+
    '<div class="methodology-row"><b>Mês de referência:</b><span class="methodology-inline-answer">'+esc(month)+'</span></div>'+
    '<div class="methodology-row"><b>Oficineiro(a):</b><span class="methodology-inline-answer">'+esc(instructor)+'</span></div>'+
    '<div class="methodology-row"><b>Educador(a) de referência:</b><span class="methodology-inline-answer">'+esc(educator)+'</span></div>'+
    '<div class="methodology-row"><b>Data do relatório:</b><span class="methodology-inline-answer">'+esc(fmtDate(r.report_date))+'</span> <b style="margin-left:18px">Situação:</b><span class="methodology-inline-answer">'+esc(r.execution_status||'')+'</span></div>'+
    '<table class="methodology-planning-table report-kpi-table"><thead><tr><th>Aulas previstas</th><th>Aulas executadas</th><th>CH prevista</th><th>CH executada</th><th>Participações</th><th>Jovens/participantes únicos</th><th>CFDH transversal</th></tr></thead><tbody><tr><td>'+Number(m.planned_lessons||0)+'</td><td>'+Number(m.executed_lessons||0)+'</td><td>'+Number(m.planned_hours||0).toLocaleString('pt-BR')+'h</td><td>'+Number(m.executed_hours||0).toLocaleString('pt-BR')+'h</td><td>'+Number(m.participation_records||0)+'</td><td>'+Number(m.unique_participants||0)+'</td><td>'+Number(m.cfdh_minutes||0)+' min</td></tr></tbody></table>'+
    '<div class="methodology-section-title">AULAS · PLANEJADO × EXECUTADO</div>'+
    '<table class="methodology-planning-table workshop-report-table"><thead><tr><th>Aula / execução</th><th>Planejado</th><th>Executado</th><th>Participantes</th><th>Educador acompanhando</th><th>CFDH</th></tr></thead><tbody>'+(lessonRows||'<tr><td colspan="6">Nenhuma aula prevista neste planejamento.</td></tr>')+'</tbody></table>'+
    '<div class="methodology-section-title">AÇÕES, ATIVIDADES, PASSEIOS E EVENTOS REGISTRADOS NO MÊS</div>'+
    '<table class="methodology-planning-table workshop-report-actions"><thead><tr><th>Data</th><th>Tipo</th><th>Registro</th><th>Duração</th><th>Participantes</th></tr></thead><tbody>'+(actionRows||'<tr><td colspan="5">Nenhuma ação complementar registrada para o Educador no mês.</td></tr>')+'</tbody></table>'+
    pair('Objetivo geral planejado',p.general_objective,'Síntese do que foi executado',r.actual_description)+
    pair('Metodologia planejada',p.general_methodology,'Metodologia aplicada / adaptações',r.methodology_applied)+
    pair('Resultados esperados',p.expected_results,'Resultados alcançados',r.results_achieved)+
    pair('Recursos previstos',p.general_resources,'Recursos efetivamente utilizados',r.resources_used)+
    '<div class="methodology-row methodology-row-tall"><b>Ações realizadas / ajustes durante a execução:</b><div class="methodology-answer">'+esc(r.actions_performed||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Ações, atividades, passeios ou eventos não previstos / complementação:</b><div class="methodology-answer">'+esc(r.unplanned_actions||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Retorno, participação e percepção dos jovens:</b><div class="methodology-answer">'+esc(r.youth_feedback||'')+'</div></div>'+
    pair('Pontos positivos','', 'Pontos positivos observados',r.positive_points)+
    pair('Dificuldades','', 'Dificuldades encontradas',r.difficulties)+
    '<div class="methodology-row methodology-row-tall"><b>Próximos passos / encaminhamentos:</b><div class="methodology-answer">'+esc(r.next_steps||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Justificativa para execução parcial, alteração ou não realização:</b><div class="methodology-answer">'+esc(r.justification||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Evidências / referências:</b><div class="methodology-answer">'+esc(r.evidence_ref||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Observações finais:</b><div class="methodology-answer">'+esc(r.observations||'')+'</div></div>'+
    '<div class="methodology-system-note">Dados quantitativos de aulas, carga horária e participações são preenchidos a partir dos registros do sistema. O relatório responde ao planejamento mensal e registra diferenças entre o previsto e o executado.</div>'+
  '</div>';
}
function workshopReportEditorHtml(bundle,canWrite=true){
  const r=bundle?.report||{},m=bundle?.metrics||{},p=bundle?.plan||{},w=bundle?.workshop||{};
  const value=(k,fallback='')=>r[k]??fallback;
  const status=value('execution_status','realizado');
  return '<div class="page-head"><div><h2>Relatório · '+esc(w.name||'Oficina')+'</h2><p>Responda ao planejamento de '+esc(String(p.plan_month||'').slice(0,7).split('-').reverse().join('/'))+' com base na execução efetivamente registrada.</p></div><div class="actions"><button class="btn" data-nav="educador?view=relatorios&month='+esc(String(p.plan_month||'').slice(0,7))+'">Voltar aos relatórios</button></div></div>'+
    '<form id="workshop-monthly-report-form" data-plan-id="'+esc(p.id||'')+'" data-report-id="'+esc(r.id||'')+'">'+
    '<div class="methodology-form-workspace preview-open" data-workshop-report-workspace>'+
      '<div class="methodology-form-editor stack">'+
        '<div class="card"><div class="notice info"><b>Execução capturada automaticamente</b><br>'+Number(m.executed_lessons||0)+' de '+Number(m.planned_lessons||0)+' aula(s) executada(s) · '+Number(m.executed_hours||0).toLocaleString('pt-BR')+'h de '+Number(m.planned_hours||0).toLocaleString('pt-BR')+'h previstas · '+Number(m.unique_participants||0)+' participante(s) único(s). Esses totais não são digitados manualmente.</div>'+
          '<div class="form-grid"><div class="field"><label>Data do relatório</label><input class="input" type="date" name="report_date" value="'+esc(value('report_date',new Date().toISOString().slice(0,10)))+'" required '+(canWrite?'':'disabled')+'></div><div class="field"><label>Situação geral da execução</label><select name="execution_status" '+(canWrite?'':'disabled')+'><option value="realizado" '+(status==='realizado'?'selected':'')+'>Realizado</option><option value="parcial" '+(status==='parcial'?'selected':'')+'>Parcial</option><option value="nao_realizado" '+(status==='nao_realizado'?'selected':'')+'>Não realizado</option></select></div></div>'+
          '<div class="field"><label>Síntese do que foi executado</label><textarea name="actual_description" required '+(canWrite?'':'disabled')+'>'+esc(value('actual_description'))+'</textarea><small>Descreva o resultado geral da oficina no período, respondendo ao objetivo do planejamento.</small></div>'+
          '<div class="field"><label>Metodologia aplicada e adaptações realizadas</label><textarea name="methodology_applied" '+(canWrite?'':'disabled')+'>'+esc(value('methodology_applied'))+'</textarea></div>'+
          '<div class="field"><label>Resultados alcançados</label><textarea name="results_achieved" '+(canWrite?'':'disabled')+'>'+esc(value('results_achieved'))+'</textarea></div>'+
          '<div class="field"><label>Recursos efetivamente utilizados</label><textarea name="resources_used" '+(canWrite?'':'disabled')+'>'+esc(value('resources_used'))+'</textarea></div>'+
          '<div class="field"><label>Ações realizadas / ajustes durante a execução</label><textarea name="actions_performed" '+(canWrite?'':'disabled')+'>'+esc(value('actions_performed'))+'</textarea></div>'+
          '<div class="field"><label>Ações, atividades, passeios e eventos não previstos / complementação</label><textarea name="unplanned_actions" '+(canWrite?'':'disabled')+'>'+esc(value('unplanned_actions'))+'</textarea><small>Use somente para complementar o que não foi capturado nos registros automáticos exibidos abaixo.</small></div>'+
          '<div class="field"><label>Retorno, participação e percepção dos jovens</label><textarea name="youth_feedback" '+(canWrite?'':'disabled')+'>'+esc(value('youth_feedback'))+'</textarea></div>'+
          '<div class="form-grid"><div class="field"><label>Pontos positivos</label><textarea name="positive_points" '+(canWrite?'':'disabled')+'>'+esc(value('positive_points'))+'</textarea></div><div class="field"><label>Dificuldades encontradas</label><textarea name="difficulties" '+(canWrite?'':'disabled')+'>'+esc(value('difficulties'))+'</textarea></div></div>'+
          '<div class="field"><label>Próximos passos / encaminhamentos</label><textarea name="next_steps" '+(canWrite?'':'disabled')+'>'+esc(value('next_steps'))+'</textarea></div>'+
          '<div class="field"><label>Justificativa para execução parcial, alteração ou não realização</label><textarea name="justification" '+(canWrite?'':'disabled')+'>'+esc(value('justification'))+'</textarea></div>'+
          '<div class="field"><label>Evidências / referências</label><textarea name="evidence_ref" '+(canWrite?'':'disabled')+'>'+esc(value('evidence_ref'))+'</textarea><small>Ex.: listas de presença, registros fotográficos, formulários, links, atas ou outros meios de verificação.</small></div>'+
          '<div class="field"><label>Observações finais</label><textarea name="observations" '+(canWrite?'':'disabled')+'>'+esc(value('observations'))+'</textarea></div>'+
        '</div>'+
        '<div class="card"><div class="page-head compact"><div><h3>Aulas executadas a partir do planejamento</h3><p>Leitura automática das aulas, presenças e responsável pelo acompanhamento.</p></div><span class="pill success">'+Number(m.executed_lessons||0)+' executada(s)</span></div>'+
          '<div class="educator-planned-lists">'+(bundle.lesson_execution||[]).map(x=>'<div class="educator-planned-list-row"><div><b>Aula '+esc(x.lesson_number)+' · '+esc(fmtDate(x.planned_date))+'</b><span>'+esc(x.planned_theme||'')+'</span><small>'+(x.executed?esc('Executada em '+fmtDate(x.actual_date)+' · '+Number(x.participant_count||0)+' participação(ões) · '+Number(x.actual_hours||0).toLocaleString('pt-BR')+'h'):'Ainda não registrada como executada')+'</small></div><span class="pill '+(x.executed?'success':'warn')+'">'+(x.executed?'Executada':'Pendente')+'</span></div>').join('')+'</div></div>'+
        '<div class="card"><div class="page-head compact"><div><h3>Outras ações do Educador no período</h3><p>Registros que podem compor o relatório: atividades, mobilizações, eventos, mostras e acompanhamentos.</p></div></div>'+
          '<div class="educator-planned-lists">'+(bundle.complementary_actions||[]).map(a=>'<div class="educator-planned-list-row"><div><b>'+esc(fmtDate(a.date))+' · '+esc(educatorExecutionTypeLabel(a.type))+'</b><span>'+esc(a.title||'')+'</span><small>'+esc(a.description||'')+'</small></div><span class="pill info">'+Number(a.duration_hours||0).toLocaleString('pt-BR')+'h</span></div>').join('')+'</div></div>'+
        (canWrite?'<div class="card"><div class="actions"><button class="btn primary" type="submit">Salvar relatório</button></div></div>':'<div class="notice info">Este relatório pertence a outro Educador e está disponível somente para consulta.</div>')+
      '</div>'+
      '<aside class="methodology-preview-pane"><div class="methodology-preview-toolbar"><div><b>Pré-visualização do relatório</b><span>Atualização em tempo real</span></div><div class="actions"><button type="button" class="btn ghost" data-toggle-workshop-report-preview>Ocultar</button></div></div><div class="methodology-preview-scroll" data-workshop-report-preview>'+workshopReportPreviewHtml(bundle)+'</div></aside>'+
    '</div></form>';
}
function educatorReferralPreviewHtml(rec,receipts,teamMap,youthMap,workshopMap){
  const youth=youthMap.get(rec.youth_id),workshop=workshopMap.get(rec.workshop_id),from=teamMap.get(rec.educator_user_id);
  const recipientRows=(receipts||[]).filter(x=>x.educator_record_id===rec.id).map(x=>{
    const p=teamMap.get(x.recipient_user_id);
    return '<tr><td>'+esc(p?.display_name||'Colaborador')+'</td><td>'+esc(roleLabel(p?.role))+'</td><td>'+esc(x.status==='ciente'?'Ciente':'Pendente')+'</td><td>'+esc(x.viewed_at?fmtDateTime(x.viewed_at):'—')+'</td></tr>';
  }).join('');
  return '<div class="methodology-paper educator-referral-paper">'+
    '<div class="methodology-annex-title">CRJ CARIACICA · ENCAMINHAMENTO INTERNO</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div>'+
    '<div class="methodology-inner-title">REGISTRO DE ENCAMINHAMENTO DO EDUCADOR</div>'+
    '<div class="methodology-row"><b>Data:</b><span class="methodology-inline-answer">'+esc(fmtDate(rec.record_date))+'</span></div>'+
    '<div class="methodology-row"><b>Educador responsável:</b><span class="methodology-inline-answer">'+esc(from?.display_name||'')+'</span></div>'+
    '<div class="methodology-row"><b>Jovem / participante:</b><span class="methodology-inline-answer">'+esc(youth?.preferred_name||youth?.full_name||'Não vinculado')+'</span></div>'+
    '<div class="methodology-row"><b>Oficina / atividade relacionada:</b><span class="methodology-inline-answer">'+esc(workshop?.name||'Não vinculada')+'</span></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Título / síntese:</b><div class="methodology-answer">'+esc(rec.title||educatorExecutionTypeLabel(rec.record_type))+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Descrição da demanda / motivo:</b><div class="methodology-answer">'+esc(rec.description||'')+'</div></div>'+
    '<div class="methodology-row"><b>Destino do encaminhamento:</b><span class="methodology-inline-answer">'+esc(rec.referral_target||'')+'</span></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Observações:</b><div class="methodology-answer">'+esc(rec.notes||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Evidência / referência:</b><div class="methodology-answer">'+esc(rec.evidence_ref||'')+'</div></div>'+
    '<div class="methodology-section-title">CIÊNCIA DOS DESTINATÁRIOS</div>'+
    '<table class="methodology-planning-table"><thead><tr><th>Profissional</th><th>Função</th><th>Situação</th><th>Data/hora da ciência</th></tr></thead><tbody>'+(recipientRows||'<tr><td colspan="4">Nenhum destinatário nominal registrado.</td></tr>')+'</tbody></table>'+
  '</div>';
}

function openPrintableDocument(title,html){
  const win=window.open('','_blank','noopener,noreferrer,width=1200,height=850');
  if(!win){toast('O navegador bloqueou a janela de impressão.','danger');return}
  win.document.open();
  win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'+esc(title)+'</title><style>@page{size:A4 landscape;margin:10mm}*{box-sizing:border-box}body{font-family:Arial,Helvetica,sans-serif;color:#111;margin:0;background:#fff}.methodology-paper{width:100%;max-width:none;margin:0;background:#fff;color:#111;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:9px;line-height:1.25;box-shadow:none;border:0}.methodology-annex-title{text-align:center;font-weight:700;font-size:11px;margin-bottom:12px}.methodology-institutional-header{text-align:center;margin:0 auto 9px}.methodology-institutional-header img{display:block;width:330px;height:auto;margin:auto}.methodology-inner-title{text-align:center;font-size:10px;font-weight:800;border:1px solid #222;padding:5px 7px;margin-bottom:-1px}.methodology-row{border:1px solid #222;margin-top:-1px;min-height:24px;padding:6px 8px}.methodology-row b{font-size:9px}.methodology-inline-answer{margin-left:6px}.methodology-answer{margin-top:5px}.methodology-row-tall{min-height:48px}.methodology-planning-table,.methodology-presence-table,.methodology-record-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:7px}.methodology-planning-table th,.methodology-planning-table td,.methodology-presence-table th,.methodology-presence-table td,.methodology-record-table th,.methodology-record-table td{border:1px solid #222;padding:4px;vertical-align:top;overflow-wrap:anywhere;word-break:break-word;white-space:pre-wrap}.methodology-planning-table th,.methodology-presence-table th,.methodology-record-table th{text-align:center;font-weight:700;background:#f7f7f7}.methodology-planning-table thead,.methodology-presence-table thead,.methodology-record-table thead{display:table-header-group}.methodology-planning-table tr,.methodology-presence-table tr,.methodology-record-table tr{break-inside:avoid;page-break-inside:avoid}.methodology-presence-table td{height:29px}.methodology-system-note{font-size:7px;margin-top:5px;color:#555}.workshop-plan-table th:nth-child(1){width:18%}.workshop-plan-table th:nth-child(2){width:20%}.workshop-plan-table th:nth-child(3){width:28%}.workshop-plan-table th:nth-child(4){width:24%}.workshop-plan-table th:nth-child(5){width:10%}.workshop-plan-extra-table th{width:20%}.methodology-report-pair{display:grid;grid-template-columns:1fr 1fr;border:1px solid #222;margin-top:-1px}.methodology-report-pair>div{min-height:58px;padding:6px 8px}.methodology-report-pair>div+div{border-left:1px solid #222}.methodology-report-pair p{white-space:pre-wrap;margin:5px 0 0}.report-kpi-table th,.report-kpi-table td{text-align:center}.workshop-report-table th:nth-child(1){width:14%}.workshop-report-table th:nth-child(2){width:22%}.workshop-report-table th:nth-child(3){width:27%}.workshop-report-table th:nth-child(4){width:9%}.workshop-report-table th:nth-child(5){width:18%}.workshop-report-table th:nth-child(6){width:10%}.workshop-report-actions th:nth-child(1){width:12%}.workshop-report-actions th:nth-child(2){width:18%}.workshop-report-actions th:nth-child(3){width:45%}.workshop-report-actions th:nth-child(4){width:12%}.workshop-report-actions th:nth-child(5){width:13%}.cfdh-plan-table th:nth-child(1){width:8%}.cfdh-plan-table th:nth-child(2){width:16%}.cfdh-plan-table th:nth-child(3){width:18%}.cfdh-plan-table th:nth-child(4){width:25%}.cfdh-plan-table th:nth-child(5){width:23%}.cfdh-plan-table th:nth-child(6){width:10%}.cfdh-extra-table th:nth-child(1){width:9%}.action-ref{font-weight:800;text-align:center!important;white-space:nowrap!important;background:#fafafa}.cfdh-report-table th:nth-child(1){width:11%}.cfdh-report-table th:nth-child(2){width:16%}.cfdh-report-table th:nth-child(3){width:20%}.cfdh-report-table th:nth-child(4){width:10%}.cfdh-report-table th:nth-child(5){width:27%}.cfdh-report-table th:nth-child(6){width:8%}.cfdh-report-table th:nth-child(7){width:8%}.methodology-presence-table th:nth-child(1){width:5%}.methodology-presence-table th:nth-child(2){width:27%}.methodology-presence-table th:nth-child(3){width:15%}.methodology-presence-table th:nth-child(4){width:15%}.methodology-presence-table th:nth-child(5){width:23%}.methodology-presence-table th:nth-child(6){width:15%}</style></head><body>'+html+'<script>window.addEventListener("load",()=>setTimeout(()=>window.print(),180));<\/script></body></html>');
  win.document.close();
}
async function printEducatorWorkshopPlan(planId){
  const [bundle,workshops,team]=await Promise.all([getWorkshopMonthlyPlan(planId),listWorkshops(),listTeam()]);
  const w=workshops.find(x=>x.id===bundle.plan.workshop_id);
  if(!w)throw new Error('Oficina não encontrada.');
  const teamMap=new Map(team.map(x=>[x.id,x.display_name]));
  openPrintableDocument('Planejamento · '+w.name,workshopPlanPreviewHtml(bundle,w,teamMap));
}
async function printEducatorPlannedAttendance(planId,lessonId){
  const [bundle,workshops,team]=await Promise.all([getWorkshopMonthlyPlan(planId),listWorkshops(),listTeam()]);
  const w=workshops.find(x=>x.id===bundle.plan.workshop_id),lesson=(bundle.lessons||[]).find(x=>x.id===lessonId);
  if(!w||!lesson)throw new Error('Aula planejada não encontrada.');
  const teamMap=new Map(team.map(x=>[x.id,x.display_name]));
  const html=methodologyAttendancePreviewHtml({
    activity:w.name||'',
    location:workshopLocationLabel({location_type:lesson.location_type,location_other:lesson.location_other}),
    date:lesson.scheduled_date||'',
    start_time:String(lesson.start_time||'').slice(0,5),
    end_time:String(lesson.end_time||'').slice(0,5),
    officineiro:teamMap.get(bundle.plan.instructor_user_id)||'',
    educator_reference:teamMap.get(bundle.plan.educator_user_id)||'',
    participants:[]
  });
  openPrintableDocument('Lista de Presença · '+w.name+' · '+fmtDate(lesson.scheduled_date),html);
}



const CFDH_MONTH_TARGET=20,CFDH_STRUCTURAL_MIN=10,CFDH_ACTION_COUNT_MIN_HOURS=2,CRJ_OPEN_START='10:00',CRJ_OPEN_END='21:00',CRJ_ACTION_START='14:00',CRJ_ACTION_END='19:00',CRJ_MONDAY_MEETING_START='13:00',CRJ_MONDAY_MEETING_END='16:30';
function cfdhTypeLabel(t){return t==='cfdh_transversal'?'CFDH transversal':'CFDH estrutural'}
function cfdhThemeText(plan,themes=[]){
  return plan?.cfdh_theme_custom||themes.find(x=>Number(x.code)===Number(plan?.cfdh_theme_code))?.theme||'Tema não definido';
}
function cfdhMonthlyThemeState(bundle){
  const cfg=bundle?.month_theme||null,p=bundle?.plan||{};
  return {
    code:cfg?.theme_code??p.cfdh_theme_code??null,
    custom:cfg?.theme_custom??p.cfdh_theme_custom??'',
    source_plan_id:cfg?.source_plan_id||null,
    locked:Boolean(cfg)
  };
}
function cfdhMonthlyThemeText(bundle){
  const x=cfdhMonthlyThemeState(bundle),themes=bundle?.themes||[];
  return x.custom||themes.find(t=>Number(t.code)===Number(x.code))?.theme||'Tema mensal ainda não definido';
}
function cfdhClassificationOptions(catalog,action={}){
  const nuclei=[...new Map(catalog.map(x=>[x.nucleus_code,{code:x.nucleus_code,name:x.nucleus_name}])).values()];
  const axes=[...new Map(catalog.filter(x=>x.nucleus_code===action.nucleus_code).map(x=>[x.axis_code,{code:x.axis_code,name:x.axis_name}])).values()];
  const items=catalog.filter(x=>x.axis_code===action.axis_code&&x.item_code);
  return {
    nuclei:nuclei.map(x=>'<option value="'+esc(x.code)+'" '+(x.code===action.nucleus_code?'selected':'')+'>'+esc(x.name)+'</option>').join(''),
    axes:axes.map(x=>'<option value="'+esc(x.code)+'" '+(x.code===action.axis_code?'selected':'')+'>'+esc(x.name)+'</option>').join(''),
    items:items.map(x=>'<option value="'+esc(x.item_code)+'" '+(x.item_code===action.item_code?'selected':'')+'>'+esc(x.item_code)+') '+esc(x.item_label)+'</option>').join('')
  };
}
function cfdhActionCountableHours(a,actual=false){
  const h=Number(actual?a.actual_duration_hours:a.planned_duration_hours||0);
  return h>=CFDH_ACTION_COUNT_MIN_HOURS?h:0;
}
function cfdhActionGoalLinks(bundle,a){
  const defs=bundle?.indicators||[],links=[],seen=new Set(),p=bundle?.plan||{};
  const add=(code,reason,evidence)=>{
    if(seen.has(code))return;
    const ind=defs.find(x=>x.code===code);
    if(!ind)return;
    seen.add(code);
    links.push({
      code:ind.code,
      label:ind.label,
      goal_stage:ind.goalStage||'',
      target:ind.target,
      unit:ind.unit||'',
      periodicity:ind.periodicity||'',
      reason,
      evidence
    });
  };
  const structural=p.plan_type==='cfdh_estrutural';
  add('M6.1_CFDH_HORAS',
    structural
      ?'A execução desta ação pode contabilizar carga horária de CFDH quando registrada conforme a regra operacional.'
      :'Comprova a transversalidade do CFDH dentro da oficina; a contabilização ocorre pela execução registrada sem duplicar a carga da oficina.',
    'Planejamento + registro de execução da ação + lista nominal de presença.'
  );
  add('M2.1_ATENDIMENTOS',
    'Quando houver presença nominal, as participações desta ação colaboram com o registro de atendimentos do mês.',
    'Lista de presença nominal vinculada à ação.'
  );
  add('M9.1_MONITORAMENTO',
    'O planejamento, a execução, as presenças e o relatório desta ação geram informação rastreável para monitoramento.',
    'Planejamento, relatório, lista de presença e demais referências anexadas.'
  );

  if(a.nucleus_code==='N1') add('M4.2_ATIVIDADES_PERCENTUAL',
    'A ação está classificada no Núcleo Socioafirmativo e de Acesso e colabora com a execução das atividades previstas desse núcleo.',
    'Execução da ação identificada por Núcleo, Eixo e Item, com lista/relatório.'
  );
  if(a.nucleus_code==='N2') add('M4.3_ATIVIDADES_PERCENTUAL',
    'A ação está classificada no Núcleo Economia Criativa, Trabalho e Renda e colabora com a execução das atividades previstas desse núcleo.',
    'Execução da ação identificada por Núcleo, Eixo e Item, com lista/relatório.'
  );
  if(a.nucleus_code==='N3') add('M4.4_ACOES',
    'A ação está classificada no Núcleo de Parcerias e pode comprovar ação desenvolvida em articulação com parceiros.',
    'Registro da ação, parceiro envolvido, relatório e evidências.'
  );

  const key=(a.axis_code||'')+'|'+(a.item_code||'');
  if(key==='N1.E1|A') add('M6.1_EMPRESTIMOS','Quando a ação envolver empréstimo/agendamento, o registro colabora com esse acompanhamento.','Solicitação/agendamento e comprovante de uso/devolução.');
  if(key==='N1.E1|B') add('M6.1_OFICINAS_HORAS','Quando executada no contexto de oficina permanente, a ação qualifica a comprovação da oferta e da transversalidade, sem dupla contagem.','Sessão/aula, lista nominal e execução do CFDH.');
  if(key==='N1.E1|E') add('M6.1_EVENTOS','Quando a ação constituir evento ou programação, sua execução pode comprovar a programação mensal.','Programação, relatório, lista de presença e registro fotográfico.');
  if(key==='N1.E1|G'||key==='N1.E1|H') add('M6.1_MOSTRAS','Quando a ação constituir mostra, sua execução pode comprovar a realização prevista.','Programação da mostra, relatório, lista e registros.');
  if(key==='N1.E2|A'){
    add('M6.2_PVIDA_HORAS','Se a ação for parte do PVida, a execução pode colaborar com as atividades mensais do PVida.','Registro da atividade PVida e participantes vinculados.');
    add('M6.2_PVIDA_PARTICIPACOES','As presenças vinculadas à ação podem comprovar participações individuais/coletivas em PVida.','Lista nominal vinculada ao PVida.');
  }
  if(key==='N1.E2|B') add('M6.2_OUTRAS_DEMANDAS','Se a ação responder a outras demandas acompanhadas, o registro colabora com esse monitoramento.','Registro da demanda e encaminhamento/acompanhamento.');
  if(a.axis_code==='N1.E3') add('M6.3_CONSULTAS','Se a ação funcionar como orientação ou subsídio #FicaADica, pode comprovar consulta/orientação realizada.','Registro da orientação/consulta e referência utilizada.');
  if(key==='N2.E1|A'){
    add('M4.1_PTRAMPO_ATIVIDADES','Quando vinculada ao PTrampo, a execução colabora com o quantitativo de atividades relacionadas ao PTrampo.','Registro PTrampo, execução e participantes.');
    add('M6.4_PTRAMPO_ATIVIDADES','Quando vinculada ao PTrampo, a execução também colabora com o indicador operacional de atividades do PTrampo.','Registro PTrampo, execução e participantes.');
  }
  if(key==='N2.E1|B'){
    add('M4.6_CURSO_HORAS','Quando a ação integra curso/oficina profissionalizante, sua execução qualifica a comprovação da carga horária correspondente.','Planejamento da oficina, sessão, lista nominal e execução.');
    add('M6.4_CURSO_HORAS','Quando a ação integra curso/oficina profissionalizante, colabora com o acompanhamento operacional da oferta.','Planejamento da oficina, sessão, lista nominal e execução.');
  }
  if(key==='N2.E1|C'){
    add('M4.5_MOSTRAS','Quando a ação compõe a Mostra de Profissões, sua execução colabora com a meta semestral.','Programação da mostra, relatório, lista e registros.');
    add('M6.4_MOSTRAS','A mesma execução pode comprovar a Mostra de Profissões no quadro operacional.','Programação da mostra, relatório, lista e registros.');
  }
  if(a.axis_code==='N3.E1'){
    add('M6.7_ENCONTROS_REDE','Quando a ação envolver reunião/encontro com a rede, pode colaborar com o acompanhamento dos encontros realizados.','Ata, lista, registro da reunião/encontro e encaminhamentos.');
    add('M6.7_PARCERIAS','Quando resultar em parceria formalizada, pode colaborar com o indicador de parcerias.','Documento, e-mail, termo, ata ou outro registro da formalização.');
  }
  return links;
}
function cfdhActionGoalFlyoutContent(bundle,a,index){
  const links=cfdhActionGoalLinks(bundle,a);
  const catalog=bundle?.classification||[];
  const n=catalog.find(x=>x.nucleus_code===a.nucleus_code),ax=catalog.find(x=>x.axis_code===a.axis_code),it=catalog.find(x=>x.axis_code===a.axis_code&&x.item_code===a.item_code);
  const classification=[n?.nucleus_name||a.nucleus_code,ax?.axis_name||a.axis_code,it?(it.item_code+') '+it.item_label):''].filter(Boolean).join(' → ')||'Classificação ainda não definida';
  return '<div class="cfdh-goal-flyout-head"><div><b>Ação '+(index+1)+' · Metas e Etapas</b><span>'+esc(classification)+'</span></div><span class="pill info">'+links.length+' vínculo(s)</span></div>'+
    (links.length?'<div class="cfdh-goal-link-list">'+links.map(x=>{
      const stage=x.goal_stage?('Meta '+String(x.goal_stage).split('.')[0]+' · Etapa '+x.goal_stage):'Indicador de acompanhamento';
      const target=x.target!=null?(' · referência '+Number(x.target).toLocaleString('pt-BR')+' '+esc(x.unit||'')):'';
      return '<div class="cfdh-goal-link"><strong>'+esc(stage)+'</strong><b>'+esc(x.label)+'</b><small>'+esc(x.reason)+'</small><em><b>Meio de verificação:</b> '+esc(x.evidence)+'</em><span>'+esc(x.code)+(x.periodicity?' · '+esc(x.periodicity):'')+target+'</span></div>';
    }).join('')+'</div>':'<div class="notice warn compact">Defina Núcleo, Eixo e Item para o sistema completar os vínculos desta ação.</div>')+
    '<div class="cfdh-goal-rule"><b>Regra:</b> o planejamento demonstra intenção e enquadramento. A meta só é contabilizada quando existir a execução/evidência exigida pelo respectivo indicador.</div>';
}
function cfdhActionGoalFlyoutHtml(bundle,a,index){
  const links=cfdhActionGoalLinks(bundle,a);
  return '<div class="cfdh-action-goal-zone" data-cfdh-action-goals><span class="cfdh-action-goal-badge">Metas e etapas · '+links.length+'</span><div class="cfdh-action-goal-flyout" role="tooltip">'+cfdhActionGoalFlyoutContent(bundle,a,index)+'</div></div>';
}
function cfdhMonthlyPlanningStatus(bundle,actionsOverride=null){
  const dash=bundle?.month_dashboard||{plans:[],actions:[]},p=bundle?.plan||{},current=actionsOverride||bundle?.actions||[];
  const planType=new Map((dash.plans||[]).map(x=>[x.id,x.plan_type]));
  const rows=(dash.actions||[]).filter(x=>x.plan_id!==p.id).map(x=>({...x,_plan_type:planType.get(x.plan_id)}));
  for(const a of current)rows.push({...a,_plan_type:p.plan_type});
  const countable=a=>cfdhActionCountableHours(a);
  const structural=Number(rows.filter(x=>x._plan_type==='cfdh_estrutural').reduce((n,x)=>n+countable(x),0).toFixed(2));
  const transversal=Number(rows.filter(x=>x._plan_type==='cfdh_transversal').reduce((n,x)=>n+countable(x),0).toFixed(2));
  const total=Number((structural+transversal).toFixed(2));
  return {
    structural,transversal,total,
    structural_ok:structural>=CFDH_STRUCTURAL_MIN,
    total_ok:total>=CFDH_MONTH_TARGET,
    structural_missing:Number(Math.max(0,CFDH_STRUCTURAL_MIN-structural).toFixed(2)),
    total_missing:Number(Math.max(0,CFDH_MONTH_TARGET-total).toFixed(2))
  };
}
function cfdhTimeMinutes(v){
  const m=String(v||'').match(/^(\d{1,2}):(\d{2})/);if(!m)return null;
  return Number(m[1])*60+Number(m[2]);
}
function cfdhMinutesTime(m){
  if(m==null||m<0||m>=24*60)return '';
  return String(Math.floor(m/60)).padStart(2,'0')+':'+String(Math.round(m%60)).padStart(2,'0');
}
function cfdhAutoEndTime(start,hours){
  const s=cfdhTimeMinutes(start),mins=Math.round(Number(hours||0)*60);
  if(s==null||!mins)return '';
  return cfdhMinutesTime(s+mins);
}
function cfdhWeekday(date){
  const d=new Date(String(date||'')+'T12:00:00Z');return Number.isNaN(d.getTime())?null:d.getUTCDay();
}
function cfdhSpecialDay(bundle,date){
  return (bundle?.special_days||[]).find(x=>x.calendar_date===date)||null;
}
function cfdhSpecialDayState(bundle,date){
  const day=cfdhSpecialDay(bundle,date);
  if(!day)return {day:null,closed:false,pending:false,open:true};
  const closed=day.closure_policy==='auto_closed'||day.approval_status==='closed';
  const pending=day.closure_policy==='approval_required'&&day.approval_status==='pending';
  return {day,closed,pending,open:!closed};
}
function cfdhStructuralWindow(date){
  const dow=cfdhWeekday(date);
  if(dow==null||dow===0||dow===6)return null;
  if(dow===1)return {start:CRJ_MONDAY_MEETING_END,end:CRJ_ACTION_END,note:'Segunda-feira: reunião geral das 13:00 às 16:30; ações estruturais somente após 16:30.'};
  return {start:CRJ_ACTION_START,end:CRJ_ACTION_END,note:'Ações estruturais entre 14:00 e 19:00.'};
}
function cfdhStructuralScheduleIssue(bundle,a){
  if(bundle?.plan?.plan_type!=='cfdh_estrutural'||!a?.scheduled_date)return null;
  const special=cfdhSpecialDayState(bundle,a.scheduled_date);
  if(special.closed)return 'CRJ fechado em '+fmtDate(a.scheduled_date)+' — '+(special.day?.name||'feriado/fechamento confirmado')+'.';
  const win=cfdhStructuralWindow(a.scheduled_date);
  if(!win)return 'Ações estruturais devem ser planejadas de segunda a sexta-feira.';
  if(!a.start_time||!a.end_time)return null;
  const s=cfdhTimeMinutes(a.start_time),e=cfdhTimeMinutes(a.end_time),ws=cfdhTimeMinutes(win.start),we=cfdhTimeMinutes(win.end);
  if(s<ws||e>we)return 'Horário estrutural inválido para '+fmtDate(a.scheduled_date)+'. Janela permitida: '+win.start+'–'+win.end+'.';
  return null;
}
function cfdhSpecialDayBadge(day){
  if(!day)return '';
  if(day.closure_policy==='auto_closed'||day.approval_status==='closed')return 'fechado';
  if(day.approval_status==='open')return 'aberto';
  return 'aprovação';
}
function cfdhCalendarEntriesForDay(bundle,date,action={}){
  return (bundle?.crj_calendar||[]).filter(x=>{
    if(x.date!==date)return false;
    if(x.source==='cfdh'&&bundle?.plan?.id&&x.plan_id===bundle.plan.id)return false;
    if(x.source==='cfdh'&&action.id&&x.id===action.id)return false;
    if(x.source==='workshop'&&action.workshop_calendar_id&&x.id===action.workshop_calendar_id)return false;
    return true;
  }).sort((a,b)=>String(a.start||'').localeCompare(String(b.start||'')));
}
function cfdhCalendarFreeWindows(entries,start=CRJ_OPEN_START,end=CRJ_OPEN_END){
  const floor=cfdhTimeMinutes(start),ceil=cfdhTimeMinutes(end);
  const ranges=(entries||[]).map(x=>[cfdhTimeMinutes(x.start),cfdhTimeMinutes(x.end)]).filter(x=>x[0]!=null&&x[1]!=null&&x[1]>x[0]).sort((a,b)=>a[0]-b[0]);
  const merged=[];
  for(const r of ranges){
    const a=Math.max(floor,r[0]),b=Math.min(ceil,r[1]);if(b<=floor||a>=ceil)continue;
    const last=merged[merged.length-1];if(last&&a<=last[1])last[1]=Math.max(last[1],b);else merged.push([a,b]);
  }
  const free=[];let cur=floor;
  for(const [a,b] of merged){if(a>cur)free.push([cur,a]);cur=Math.max(cur,b)}
  if(cur<ceil)free.push([cur,ceil]);
  return free.map(([a,b])=>cfdhMinutesTime(a)+'–'+cfdhMinutesTime(b));
}
function cfdhCalendarDayDetailHtml(bundle,date,action={}){
  if(!date)return '<div class="cfdh-calendar-day-empty">Selecione um dia para consultar a agenda do CRJ.</div>';
  const rows=cfdhCalendarEntriesForDay(bundle,date,action),free=cfdhCalendarFreeWindows(rows),special=cfdhSpecialDayState(bundle,date),win=cfdhStructuralWindow(date);
  const specialHtml=special.day?'<div class="notice '+(special.closed?'danger':special.pending?'warn':'success')+' compact"><b>'+esc(special.day.name)+'</b> · '+esc(special.day.day_type==='holiday'?'Feriado':'Ponto facultativo')+'<br><small>'+(special.closed?'CRJ fechado nesta data.':special.pending?'Fechamento depende de aprovação; decisão ainda pendente.':'Funcionamento mantido por decisão registrada.')+'</small></div>':'';
  const actionRule=win?'<div class="notice info compact"><b>Funcionamento do CRJ:</b> '+CRJ_OPEN_START+'–'+CRJ_OPEN_END+' · <b>janela para ação estrutural:</b> '+win.start+'–'+win.end+(cfdhWeekday(date)===1?' · reunião geral '+CRJ_MONDAY_MEETING_START+'–'+CRJ_MONDAY_MEETING_END:'')+'</div>':'<div class="notice warn compact">Ações estruturais não são distribuídas aos fins de semana.</div>';
  return specialHtml+actionRule+
    '<div class="cfdh-calendar-day-title"><b>'+esc(fmtDate(date))+'</b><span>'+(rows.length?rows.length+' compromisso(s) registrado(s)':'sem compromissos registrados')+'</span></div>'+
    '<div class="cfdh-calendar-busy-list">'+(rows.map(x=>'<div class="cfdh-calendar-busy"><span>'+esc((x.start||'--:--')+(x.end?'–'+x.end:''))+'</span><b>'+esc(x.title||'Atividade CRJ')+'</b><small>'+esc(x.location||'CRJ Cariacica')+'</small></div>').join('')||'<div class="notice success compact">Dia livre no calendário registrado.</div>')+'</div>'+
    '<div class="cfdh-calendar-free"><b>Janelas sem atividade registrada</b><small>Funcionamento cadastrado do CRJ: '+CRJ_OPEN_START+'–'+CRJ_OPEN_END+'.</small><div>'+free.map(x=>'<span class="pill success">'+esc(x)+'</span>').join('')+'</div></div>';
}
function cfdhCalendarPickerHtml(bundle,a,index){
  const month=String(bundle?.plan?.planned_start||currentMonth()).slice(0,7),[y,m]=month.split('-').map(Number),last=new Date(y,m,0).getDate();
  const firstDow=(new Date(y,m-1,1).getDay()+6)%7,selected=a.scheduled_date||'',cells=[];
  for(let i=0;i<firstDow;i++)cells.push('<span class="cfdh-calendar-pad"></span>');
  for(let d=1;d<=last;d++){
    const date=month+'-'+String(d).padStart(2,'0'),entries=cfdhCalendarEntriesForDay(bundle,date,a),busy=entries.length,special=cfdhSpecialDayState(bundle,date),weekend=[0,6].includes(cfdhWeekday(date)),closed=special.closed,blocked=closed||(bundle?.plan?.plan_type==='cfdh_estrutural'&&weekend);
    const dayClass=closed?'closed':special.pending?'pending':weekend?'weekend':busy?'busy':'free';
    const label=closed?'fechado':special.pending?'aprovação':weekend?'fim semana':busy?busy+' ocup.':'livre';
    cells.push('<button type="button" class="cfdh-calendar-day '+(selected===date?'selected ':'')+dayClass+'" data-cfdh-calendar-day="'+date+'" '+(blocked?'disabled':'')+'><b>'+d+'</b><small>'+esc(label)+'</small></button>');
  }
  return '<div class="cfdh-calendar-picker" data-cfdh-calendar-picker>'+
    '<div class="page-head compact"><div><label>Data pelo calendário do CRJ</label><small>Escolha o dia visualizando oficinas, CFDHs, agenda técnica e eventos já registrados.</small></div><button type="button" class="btn secondary" data-cfdh-toggle-calendar>'+(selected?'Trocar data':'Escolher data')+'</button></div>'+
    '<input type="hidden" name="scheduled_date" value="'+esc(selected)+'" required>'+
    '<div class="cfdh-calendar-panel '+(selected?'hidden':'')+'" data-cfdh-calendar-panel>'+
      '<div class="cfdh-calendar-month-title">'+esc(month.split('-').reverse().join('/'))+'</div>'+
      '<div class="cfdh-calendar-weekdays"><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span></div>'+
      '<div class="cfdh-calendar-grid">'+cells.join('')+'</div>'+
      '<div class="cfdh-calendar-day-detail" data-cfdh-calendar-day-detail>'+cfdhCalendarDayDetailHtml(bundle,selected,a)+'</div>'+
    '</div>'+
    '<div class="cfdh-calendar-selected '+(selected?'':'hidden')+'" data-cfdh-calendar-selected><b>Dia selecionado:</b> <span>'+esc(selected?fmtDate(selected):'')+'</span></div>'+
  '</div>';
}
function cfdhActionCalendarConflicts(bundle,a,draftActions=[]){
  if(!a.scheduled_date||!a.start_time||!a.end_time)return [];
  const s=cfdhTimeMinutes(a.start_time),e=cfdhTimeMinutes(a.end_time);if(s==null||e==null||e<=s)return [];
  const conflicts=[];
  for(const x of cfdhCalendarEntriesForDay(bundle,a.scheduled_date,a)){
    const xs=cfdhTimeMinutes(x.start),xe=cfdhTimeMinutes(x.end);if(xs==null||xe==null)continue;
    if(s<xe&&e>xs)conflicts.push(x);
  }
  for(const other of draftActions||[]){
    if(other===a||other.action_number===a.action_number||other.scheduled_date!==a.scheduled_date)continue;
    const os=cfdhTimeMinutes(other.start_time),oe=cfdhTimeMinutes(other.end_time);if(os==null||oe==null)continue;
    if(s<oe&&e>os)conflicts.push({source:'draft',title:'CFDH · Ação '+other.action_number,start:other.start_time,end:other.end_time,location:other.location_other||other.location_type||'CRJ Cariacica'});
  }
  return conflicts;
}
function cfdhLocalToday(){
  try{return new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}
  catch{return new Date().toISOString().slice(0,10)}
}
function cfdhSmartDistributionConfidence(signals={}){
  const s=signals.samples||{},history=Number(s.structural_actions||0),attendance=Number(s.attendance||0),visitors=Number(s.visitors||0),participants=Number(s.educator_participants||0);
  const strength=history*3+Math.min(30,attendance)*0.5+Math.min(10,visitors)+Math.min(30,participants)*0.15;
  if(strength>=25)return {level:'alta',className:'success',text:'Há histórico suficiente para dar peso relevante ao comportamento observado.'};
  if(strength>=8)return {level:'média',className:'warn',text:'Há sinais úteis, mas o calendário atual ainda tem peso maior que o histórico.'};
  return {level:'baixa',className:'info',text:'O histórico ainda é pequeno; a sugestão prioriza disponibilidade do calendário e usa os registros existentes apenas como tendência.'};
}
function cfdhDateDistance(a,b){
  const da=new Date(a+'T12:00:00Z'),db=new Date(b+'T12:00:00Z');
  return Math.abs(Math.round((da-db)/86400000));
}
function cfdhSmartDistribution(bundle,actions=[]){
  const month=String(bundle?.plan?.planned_start||currentMonth()).slice(0,7),[y,m]=month.split('-').map(Number),last=new Date(y,m,0).getDate(),today=cfdhLocalToday(),signals=bundle?.smart_signals||{};
  const flow=signals.weekday_flow||Array(7).fill(0),hourFlow=signals.hour_flow||Array(24).fill(0),freeUse=signals.free_use_weekday||Array(7).fill(0),freeUseHour=signals.free_use_hour||Array(24).fill(0),history=signals.historical_success||[];
  const maxFlow=Math.max(1,...flow),maxHour=Math.max(1,...hourFlow),maxFreeUse=Math.max(1,...freeUse),maxFreeUseHour=Math.max(1,...freeUseHour),successByDow=Array(7).fill(0);
  for(const h of history)if(h.weekday!=null)successByDow[h.weekday]+=Number(h.score||0);
  const maxSuccess=Math.max(1,...successByDow),candidateDates=[];
  for(let d=1;d<=last;d++){
    const date=month+'-'+String(d).padStart(2,'0');
    if(month===today.slice(0,7)&&date<today)continue;
    const dow=new Date(date+'T12:00:00Z').getUTCDay(),special=cfdhSpecialDayState(bundle,date),win=cfdhStructuralWindow(date);
    if(!win||special.closed||special.pending)continue;
    const entries=cfdhCalendarEntriesForDay(bundle,date,{});
    const occupied=entries.reduce((n,x)=>{
      const a=cfdhTimeMinutes(x.start),b=cfdhTimeMinutes(x.end);return n+(a!=null&&b!=null&&b>a?Math.max(0,Math.min(b,cfdhTimeMinutes(CRJ_OPEN_END))-Math.max(a,cfdhTimeMinutes(CRJ_OPEN_START))):0)
    },0);
    const capacity=Math.max(0,1-Math.min(1,occupied/((cfdhTimeMinutes(CRJ_OPEN_END)-cfdhTimeMinutes(CRJ_OPEN_START)))));
    const peopleEvents=entries.filter(x=>x.source==='workshop'||x.source==='evento'||x.source==='cfdh').length;
    let score=capacity*32+(Number(flow[dow]||0)/maxFlow)*20+(Number(successByDow[dow]||0)/maxSuccess)*18+Math.min(8,peopleEvents*2);
    if(signals.free_use_list_available)score+=(Number(freeUse[dow]||0)/maxFreeUse)*28;
    if(dow===0)score-=18;else if(dow===6)score-=3;
    candidateDates.push({date,dow,entries,occupied,flow:Number(flow[dow]||0),historical:Number(successByDow[dow]||0),baseScore:score,window:win});
  }
  const selected=[],usedDates=new Set();
  for(const action of actions){
    const duration=Math.max(.25,Number(action.planned_duration_hours||2)),minutes=Math.round(duration*60);
    let best=null;
    for(const day of candidateDates){
      let dayScore=day.baseScore;
      if(usedDates.has(day.date))dayScore-=45;
      for(const prev of selected){
        const dist=cfdhDateDistance(day.date,prev.date);
        if(dist===0)dayScore-=35;else if(dist===1)dayScore-=12;else if(dist===2)dayScore-=5;
      }
      const timeCandidates=[];
      for(let min=cfdhTimeMinutes(day.window.start);min<=cfdhTimeMinutes(day.window.end);min+=30)timeCandidates.push(min);
      for(const startMin of timeCandidates){
        const endMin=startMin+minutes;if(endMin>cfdhTimeMinutes(day.window.end))continue;
        const start=cfdhMinutesTime(startMin),end=cfdhMinutesTime(endMin);
        const busy=[...day.entries,...selected.filter(x=>x.date===day.date).map(x=>({start:x.start,end:x.end,title:'Outra ação sugerida'}))];
        if(busy.some(x=>cfdhApiOverlapLocal(start,end,x.start,x.end)))continue;
        const hour=Math.floor(startMin/60),hourSignal=Number(hourFlow[hour]||0)/maxHour;
        let timeScore=hourSignal*14;
        if(signals.free_use_list_available)timeScore+=(Number(freeUseHour[hour]||0)/maxFreeUseHour)*18;
        const nearby=day.entries.filter(x=>{
          const xs=cfdhTimeMinutes(x.start),xe=cfdhTimeMinutes(x.end);
          if(xs==null||xe==null)return false;
          return Math.min(Math.abs(startMin-xe),Math.abs(endMin-xs))<=60;
        }).length;
        timeScore+=Math.min(10,nearby*3);
        const histMatches=history.filter(h=>h.weekday===day.dow&&h.start).reduce((n,h)=>{
          const hm=cfdhTimeMinutes(h.start);return n+(hm!=null&&Math.abs(hm-startMin)<=90?Number(h.score||0):0)
        },0);
        timeScore+=Math.min(14,histMatches);
        if(!Number(signals.samples?.attendance||0)&&!Number(signals.samples?.structural_actions||0)){
          if(startMin>=15*60&&startMin<=19*60)timeScore+=5;
        }
        const score=dayScore+timeScore;
        if(!best||score>best.score){
          const reasons=[];
          if(day.occupied<=180)reasons.push('baixa sobrecarga do calendário');
          else if(day.occupied<=360)reasons.push('carga moderada no dia');
          if(day.flow>=maxFlow*.6&&day.flow>0)reasons.push('bom fluxo identificado');
          if(signals.free_use_list_available&&Number(freeUse[day.dow]||0)>=maxFreeUse*.6)reasons.push('alto fluxo de uso livre');
          if(day.historical>0)reasons.push('histórico favorável de CFDH estrutural');
          if(nearby>0)reasons.push('janela livre próxima de atividades com público');
          if(!reasons.length)reasons.push('melhor janela livre encontrada no mês');
          best={date:day.date,start,end,score:Number(score.toFixed(1)),reasons,occupied_minutes:day.occupied,flow_signal:day.flow,historical_signal:day.historical};
        }
      }
    }
    if(best){selected.push({...best,action_number:action.action_number,title:action.title||('Ação '+action.action_number),duration});usedDates.add(best.date)}
  }
  return selected;
}
function cfdhApiOverlapLocal(aStart,aEnd,bStart,bEnd){
  const as=cfdhTimeMinutes(aStart),ae=cfdhTimeMinutes(aEnd),bs=cfdhTimeMinutes(bStart),be=cfdhTimeMinutes(bEnd);
  return as!=null&&ae!=null&&bs!=null&&be!=null&&as<be&&ae>bs;
}
function cfdhSmartDistributionModalHtml(bundle,suggestions){
  const confidence=cfdhSmartDistributionConfidence(bundle?.smart_signals||{}),s=bundle?.smart_signals?.samples||{};
  return '<div class="stack cfdh-smart-distribution">'+
    '<div class="notice '+confidence.className+'"><b>Confiança da distribuição: '+esc(confidence.level)+'</b><br>'+esc(confidence.text)+'</div>'+
    '<div class="cfdh-smart-criteria"><b>Critérios usados</b><div class="grid two">'+
      '<span>✓ Menor sobrecarga de oficinas e compromissos</span><span>✓ Maior fluxo identificado nos registros disponíveis</span>'+
      '<span>✓ Histórico de CFDHs estruturais executados</span><span>✓ Janelas livres próximas de atividades com público</span>'+
      '<span>✓ Espaçamento entre as ações</span><span>✓ Ausência de conflito de horário</span>'+
      '<span>✓ Funcionamento do CRJ: 10:00–21:00</span><span>✓ Ações estruturais: 14:00–19:00; segunda após 16:30</span>'+
      '<span>✓ Feriados nacionais/estaduais bloqueados</span><span>✓ Datas municipais/pontos facultativos pendentes não são sugeridos</span></div></div>'+
    '<div class="notice info compact"><b>Base analisada:</b> '+Number(s.attendance||0)+' presença(s) de oficina · '+Number(s.visitors||0)+' registro(s) de visitante · '+Number(s.services||0)+' atendimento(s) · '+Number(s.educator_participants||0)+' participante(s) em registros educativos · '+Number(s.structural_actions||0)+' CFDH(s) estrutural(is) anterior(es).<br>'+
      '<small>'+(bundle?.smart_signals?.free_use_list_available?'O fluxo de <b>uso livre</b> está ativo como um dos critérios da distribuição.':'O indicador específico de <b>uso livre</b> ainda não possui uma lista própria no sistema. Esse peso já está reservado no algoritmo e permanece neutro até a futura lista começar a gerar registros.')+'</small></div>'+
    '<div class="cfdh-smart-suggestions">'+suggestions.map(x=>'<div class="cfdh-smart-suggestion"><div><span class="pill info">Ação '+x.action_number+'</span><b>'+esc(x.title)+'</b></div><strong>'+esc(fmtDate(x.date))+' · '+esc(x.start)+'–'+esc(x.end)+'</strong><small>'+esc(x.duration.toLocaleString('pt-BR'))+'h · '+esc(x.reasons.join(' · '))+'</small><em>pontuação '+x.score.toLocaleString('pt-BR')+'</em></div>').join('')+'</div>'+
    '<div class="notice warn compact">Ao aplicar, somente <b>data, horário inicial e término calculado</b> serão preenchidos. Conteúdo, objetivo, responsáveis, classificação e recursos não serão alterados. Depois você poderá editar qualquer data ou horário manualmente.</div>'+
    '<div class="actions"><button type="button" class="btn primary" data-cfdh-apply-smart-distribution>Aplicar distribuição inteligente</button><button type="button" class="btn ghost" data-cfdh-cancel-smart-distribution>Cancelar</button></div>'+
  '</div>';
}
function cfdhOperatingCalendarPanelHtml(specialDays=[],month=currentMonth()){
  const days=(specialDays||[]).filter(x=>String(x.calendar_date||'').slice(0,7)===month),canDecide=state.user?.role==='coordenacao_geral';
  const rows=days.map(x=>{
    const auto=x.closure_policy==='auto_closed',closed=auto||x.approval_status==='closed',pending=!auto&&x.approval_status==='pending',open=!auto&&x.approval_status==='open';
    const status=closed?'Fechado':pending?'Aprovação pendente':'Funcionamento mantido';
    const cls=closed?'danger':pending?'warn':'success';
    const scope=x.jurisdiction==='national'?'Nacional':x.jurisdiction==='state_es'?'Estadual · ES':x.jurisdiction==='municipal_cariacica'?'Municipal · Cariacica':'Nacional/estadual/municipal';
    const actions=(!auto&&canDecide)?'<div class="actions"><button class="btn danger" data-crj-special-close="'+x.id+'">Aprovar fechamento</button><button class="btn secondary" data-crj-special-open="'+x.id+'">Manter aberto</button></div>':'';
    return '<div class="crj-special-day-row"><div><b>'+esc(fmtDate(x.calendar_date))+' · '+esc(x.name)+'</b><span>'+esc(scope)+' · '+esc(x.day_type==='holiday'?'Feriado':'Ponto facultativo')+'</span>'+(x.approval_note?'<small>'+esc(x.approval_note)+'</small>':'')+'</div><div><span class="pill '+cls+'">'+status+'</span>'+actions+'</div></div>';
  }).join('');
  return '<div class="card crj-operating-calendar-card" style="margin-top:16px"><div class="page-head compact"><div><h3>Calendário operacional do CRJ</h3><p>Funcionamento geral: '+CRJ_OPEN_START+'–'+CRJ_OPEN_END+' · ações estruturais: '+CRJ_ACTION_START+'–'+CRJ_ACTION_END+' de segunda a sexta · segunda-feira com reunião geral '+CRJ_MONDAY_MEETING_START+'–'+CRJ_MONDAY_MEETING_END+'.</p></div></div>'+
    '<div class="notice info compact"><b>Regra de fechamento:</b> feriados nacionais e estaduais do Espírito Santo fecham automaticamente. Feriados municipais de Cariacica e pontos facultativos só fecham após aprovação registrada.'+(canDecide?' Como Coordenação, você pode registrar a decisão abaixo.':'')+'</div>'+
    '<div class="crj-special-days">'+(rows||'<div class="empty">Nenhum feriado ou ponto facultativo cadastrado para este mês.</div>')+'</div></div>';
}
function cfdhPlanAlerts(bundle){
  const p=bundle?.plan||{},actions=bundle?.actions||[],selected=bundle?.workshop_ids||[],calendar=bundle?.calendar||[],evals=bundle?.evaluations||[],alerts=[],themeState=cfdhMonthlyThemeState(bundle,actions);
  if(!themeState.code&&!String(themeState.custom||'').trim())alerts.push('Defina o tema mensal ao criar o circuito CFDH.');
  if(!actions.length)alerts.push('Crie ao menos uma ação para o circuito.');
  if(Number(p.cfdh_action_count||actions.length)!==actions.length)alerts.push('A quantidade de ações informada não corresponde às ações estruturadas.');
  if(p.plan_type==='cfdh_estrutural'&&selected.length)alerts.push('CFDH estrutural não pode possuir oficina vinculada.');
  if(p.plan_type==='cfdh_transversal'&&!selected.length)alerts.push('CFDH transversal precisa estar vinculado a uma ou mais oficinas.');
  for(const a of actions){
    if(!(a.responsible_user_ids||[]).length)alerts.push('Ação '+a.action_number+': selecione ao menos um responsável entre Educadores e Equipe Técnica.');
    if(!a.scheduled_date)alerts.push('Ação '+a.action_number+': informe a data.');
    if(!a.start_time)alerts.push('Ação '+a.action_number+': informe o horário de início.');
    if(a.start_time&&!a.end_time)alerts.push('Ação '+a.action_number+': a carga horária informada ultrapassa o limite do dia ou não permitiu calcular o término.');
    if(!a.nucleus_code||!a.axis_code)alerts.push('Ação '+a.action_number+': classifique Núcleo e Eixo.');
    const hasItems=Boolean((bundle?.classification||[]).find(x=>x.axis_code===a.axis_code&&x.item_code));
    if(hasItems&&!a.item_code)alerts.push('Ação '+a.action_number+': selecione o Item da Metodologia.');
    if(Number(a.planned_duration_hours||0)<CFDH_ACTION_COUNT_MIN_HOURS)alerts.push('Ação '+a.action_number+': duração menor que 2h; ficará registrada, mas não contará na referência mínima deste fluxo.');
    if(p.plan_type==='cfdh_estrutural'){
      const scheduleIssue=cfdhStructuralScheduleIssue(bundle,a);
      if(scheduleIssue)alerts.push('Ação '+a.action_number+': '+scheduleIssue);
      const special=cfdhSpecialDayState(bundle,a.scheduled_date);
      if(special.pending)alerts.push('AVISO DE CALENDÁRIO · Ação '+a.action_number+': '+special.day.name+' depende de aprovação para fechamento do CRJ. Enquanto não houver decisão, a data não é considerada fechamento confirmado.');
    }
    if(p.plan_type==='cfdh_transversal'){
      if(!a.workshop_id)alerts.push('Ação '+a.action_number+': selecione a oficina.');
      if(a.schedule_mode==='workshop_planned'&&!a.workshop_calendar_id)alerts.push('Ação '+a.action_number+': selecione um dia planejado da oficina.');
      if(a.schedule_mode==='atypical'&&(!a.start_time||!a.end_time))alerts.push('Ação '+a.action_number+': complete o dia/horário atípico.');
    }
    if(['realizada','parcial'].includes(a.execution_status)&&!(bundle.attendance_counts?.[a.id]>0))alerts.push('Ação '+a.action_number+': execução registrada sem presença nominal.');
  }
  const monthly=cfdhMonthlyPlanningStatus(bundle,actions);
  if(!monthly.structural_ok)alerts.push('ALERTA DE META: o planejamento mensal soma '+monthly.structural.toLocaleString('pt-BR')+'h de CFDH estrutural. Faltam '+monthly.structural_missing.toLocaleString('pt-BR')+'h para o mínimo de '+CFDH_STRUCTURAL_MIN+'h.');
  if(!monthly.total_ok)alerts.push('ALERTA DE META: estrutural + transversal somam '+monthly.total.toLocaleString('pt-BR')+'h. Com o planejamento atual, a meta mínima mensal de '+CFDH_MONTH_TARGET+'h não será batida; faltam '+monthly.total_missing.toLocaleString('pt-BR')+'h.');
  const conflicts=actions.flatMap(a=>cfdhActionCalendarConflicts(bundle,a,actions).map(x=>'Ação '+a.action_number+': conflito de horário com '+(x.title||'atividade do CRJ')+' ('+(x.start||'--:--')+'–'+(x.end||'--:--')+').'));
  alerts.push(...conflicts);
    if(actions.some(x=>x.execution_status==='realizada')&&!evals.some(x=>x.form_slug==='cfdh-avaliacao-jovens'))alerts.push('Há ação realizada sem aplicação registrada da Avaliação dos Jovens (Anexo 12).');
  if(actions.some(x=>x.execution_status==='realizada')&&!evals.some(x=>x.form_slug==='cfdh-avaliacao-equipe'))alerts.push('Há ação realizada sem Avaliação de Educadores e Oficineiros (Anexo 13).');
  if(actions.length>1){
    const dates=actions.map(x=>x.scheduled_date).filter(Boolean),uniqueDates=new Set(dates);
    if(dates.length===actions.length&&uniqueDates.size<actions.length)alerts.push('Separe as ações em dias distintos. Há duas ou mais ações CFDH planejadas para a mesma data.');
  }
  if(p.plan_type==='cfdh_transversal'&&selected.length>1&&actions.length>=selected.length){
    const covered=new Set(actions.map(x=>x.workshop_id).filter(Boolean));
    for(const id of selected)if(!covered.has(id))alerts.push('Distribuição sugerida: a oficina '+(bundle.workshops?.find(w=>w.id===id)?.name||'selecionada')+' ainda não possui ação CFDH.');
  }
  return [...new Set(alerts)];
}
function cfdhPlanPreviewHtml(bundle,draft=null){
  const p=draft?.plan||bundle?.plan||{},actions=draft?.actions||bundle?.actions||[],themes=bundle?.themes||[],workshops=bundle?.workshops||[],catalog=bundle?.classification||[],team=bundle?.team||[];
  const selected=draft?.workshop_ids||bundle?.workshop_ids||[],themeBundle={...bundle,plan:p};
  const theme=cfdhMonthlyThemeText(themeBundle,actions),planned=actions.reduce((n,a)=>n+Number(a.planned_duration_hours||0),0),countable=actions.reduce((n,a)=>n+cfdhActionCountableHours(a),0);
  const mainRows=[],extraRowsA=[],extraRowsB=[];
  for(const a of actions){
    const w=workshops.find(x=>x.id===a.workshop_id),n=catalog.find(x=>x.nucleus_code===a.nucleus_code),ax=catalog.find(x=>x.axis_code===a.axis_code),it=catalog.find(x=>x.axis_code===a.axis_code&&x.item_code===a.item_code);
    const responsibleNames=(a.responsible_names?.length?a.responsible_names:(a.responsible_user_ids||[]).map(id=>team.find(t=>t.id===id)?.display_name).filter(Boolean));
    mainRows.push('<tr><td class="action-ref"><b>Ação '+esc(a.action_number)+'</b></td><td>'+esc(a.action_theme||theme)+'</td><td>'+esc(a.objective||'')+'</td><td>'+esc(a.activities||'')+'</td><td>'+esc(a.resources||'')+'</td><td>'+Number(a.planned_duration_hours||0).toLocaleString('pt-BR')+'h'+(Number(a.planned_duration_hours||0)<2?'<br><small>não contabiliza</small>':'')+'</td></tr>');
    extraRowsA.push('<tr><td class="action-ref"><b>Ação '+esc(a.action_number)+'</b></td><td>'+esc(a.title||'')+'</td><td>'+esc(fmtDate(a.scheduled_date))+'</td><td>'+esc(String(a.start_time||'').slice(0,5))+'–'+esc(String(a.end_time||'').slice(0,5))+'</td><td>'+esc(responsibleNames.join(', ')||'Não definido')+'</td><td>'+esc(w?.name||(p.plan_type==='cfdh_estrutural'?'Ação própria / sem oficina':'—'))+'</td></tr>');
    extraRowsB.push('<tr><td class="action-ref"><b>Ação '+esc(a.action_number)+'</b></td><td>'+esc(n?.nucleus_name||a.nucleus_code||'')+'</td><td>'+esc(ax?.axis_name||a.axis_code||'')+'</td><td>'+(it?esc(it.item_code)+') '+esc(it.item_label):'—')+'</td><td>'+esc(a.schedule_mode==='atypical'?'Dia/horário atípico':a.schedule_mode==='workshop_planned'?'Dia planejado da oficina':'Estrutural')+'</td><td>'+esc(workshopLocationLabel({location_type:a.location_type,location_other:a.location_other})||'')+'</td></tr>');
  }
  return '<div class="methodology-paper methodology-paper-landscape cfdh-plan-paper">'+
    '<div class="methodology-annex-title">ANEXO 11 · CFDH — PLANEJAMENTO</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div>'+
    '<div class="methodology-inner-title">CIRCUITO FORMATIVO EM DIREITOS HUMANOS</div>'+
    '<table class="methodology-record-table"><thead><tr><th>Modalidade</th><th>Tema mensal</th><th>Título do circuito</th><th>Oficinas vinculadas</th></tr></thead><tbody><tr><td>'+esc(cfdhTypeLabel(p.plan_type))+'</td><td>'+esc(theme)+'</td><td>'+esc(p.activity_title||'')+'</td><td>'+esc(p.plan_type==='cfdh_estrutural'?'Não se aplica':selected.map(id=>workshops.find(w=>w.id===id)?.name).filter(Boolean).join(', ')||'Nenhuma selecionada')+'</td></tr></tbody></table>'+
    '<table class="methodology-record-table"><thead><tr><th>Objetivo geral</th><th>Ações planejadas</th></tr></thead><tbody><tr><td>'+esc(p.description_objective||'')+'</td><td>'+actions.length+' · '+planned.toLocaleString('pt-BR')+'h previstas · '+countable.toLocaleString('pt-BR')+'h contabilizáveis</td></tr></tbody></table>'+
    '<div class="methodology-section-title">ESTRUTURA PRINCIPAL DA METODOLOGIA</div>'+
    '<table class="methodology-planning-table cfdh-plan-table"><thead><tr><th>Ação</th><th>7. Tema</th><th>8. Objetivo</th><th>9. Atividades propostas</th><th>10. Recursos necessários</th><th>11. Carga horária</th></tr></thead><tbody>'+(mainRows.join('')||'<tr><td colspan="6">Nenhuma ação estruturada.</td></tr>')+'</tbody></table>'+
    '<div class="methodology-section-title">CAMPOS ADICIONAIS DO REGISTRO</div>'+
    '<table class="methodology-record-table cfdh-extra-table"><thead><tr><th>Ação</th><th>Título</th><th>Data</th><th>Horário</th><th>Responsável(is)</th><th>Oficina vinculada</th></tr></thead><tbody>'+(extraRowsA.join('')||'<tr><td colspan="6">Sem campos adicionais.</td></tr>')+'</tbody></table>'+
    '<table class="methodology-record-table cfdh-extra-table"><thead><tr><th>Ação</th><th>Núcleo</th><th>Eixo</th><th>Item</th><th>Agenda / modalidade</th><th>Local</th></tr></thead><tbody>'+(extraRowsB.join('')||'<tr><td colspan="6">Sem campos adicionais.</td></tr>')+'</tbody></table>'+
    '<table class="methodology-record-table"><thead><tr><th>Equipe prevista</th><th>Parceiros</th><th>Mobilização / divulgação</th><th>Resultados esperados</th></tr></thead><tbody><tr><td>'+esc(p.team_text||'')+'</td><td>'+esc(p.partners||'')+'</td><td>'+esc(p.mobilization_plan||'')+'</td><td>'+esc(p.expected_results||'')+'</td></tr></tbody></table>'+
    '<table class="methodology-record-table"><thead><tr><th>Observações</th></tr></thead><tbody><tr><td>'+esc(p.cfdh_monthly_notes||'')+'</td></tr></tbody></table>'+
    '<div class="methodology-system-note">A coluna primária "Ação" identifica obrigatoriamente a referência de cada linha. Os cinco campos da estrutura principal permanecem iguais aos títulos previstos na metodologia. Dados operacionais adicionais ficam em tabelas independentes, sempre repetindo a mesma referência da ação.</div>'+
  '</div>';
}
function cfdhActionEditorCard(bundle,a,index){
  const p=bundle.plan,workshops=bundle.workshops||[],catalog=bundle.classification||[],selected=bundle.workshop_ids||[],calendar=bundle.calendar||[],opts=cfdhClassificationOptions(catalog,a),themes=bundle.themes||[];
  const selectedWorkshops=workshops.filter(w=>selected.includes(w.id));
  const dates=calendar.filter(x=>x.workshop_id===a.workshop_id);
  const hasItems=Boolean(catalog.find(x=>x.axis_code===a.axis_code&&x.item_code));
  const eligibleTeam=(bundle.team||[]).filter(x=>x.active!==false&&['educador','assistente_social','psicologo','terapeuta_ocupacional'].includes(x.role));
  const responsibleSet=new Set(a.responsible_user_ids||[]);
  const actionTheme=a.action_theme||cfdhMonthlyThemeText(bundle);
  const responsibleChecks=eligibleTeam.map(t=>'<label class="check cfdh-responsible-option"><input type="checkbox" name="responsible_user_id" value="'+t.id+'" '+(responsibleSet.has(t.id)?'checked':'')+'><span><b>'+esc(t.display_name)+'</b><small>'+esc(roleLabel(t.role))+'</small></span></label>').join('');

  return '<div class="card cfdh-action-card" data-cfdh-action-card data-action-id="'+esc(a.id||'')+'" data-action-number="'+(index+1)+'">'+
    cfdhActionGoalFlyoutHtml(bundle,a,index)+
    '<div class="page-head compact"><div><span class="pill info">Ação '+(index+1)+'</span><h4>'+esc(a.title||('Ação '+(index+1)))+'</h4><p>Planeje cada encontro separadamente.</p></div><div class="actions"><span class="pill '+(Number(a.planned_duration_hours||0)>=2?'success':'warn')+'" data-cfdh-count-status>'+(Number(a.planned_duration_hours||0)>=2?'Contabilizável':'Menos de 2h')+'</span></div></div>'+
    '<div class="field"><label>Tema desta ação</label><textarea name="action_theme" required>'+esc(actionTheme)+'</textarea><small>O tema oficial do mês é repetido automaticamente como ponto de partida. Você pode adaptar a descrição desta ação sem alterar o tema mensal do circuito.</small></div>'+
    '<div class="field"><label>Título da ação</label><input class="input" name="title" value="'+esc(a.title||'')+'" required></div>'+
    '<div class="field"><div class="page-head compact cfdh-field-head"><div><label>Responsável(is) pela ação</label><small>Educadores e Equipe Técnica podem compartilhar a responsabilidade</small></div></div><div class="check-grid cfdh-responsible-grid">'+(responsibleChecks||'<div class="notice warn compact">Nenhum Educador ou profissional da Equipe Técnica ativo encontrado.</div>')+'</div><small>Selecione ao menos uma pessoa. Os nomes serão registrados no planejamento e no relatório desta ação.</small></div>'+
    '<div class="field"><div class="page-head compact cfdh-field-head"><div><label>Objetivo específico</label></div>'+(p.plan_type==='cfdh_transversal'?'<button type="button" class="cfdh-inline-tool" data-cfdh-copy-objective>↗ Repetir objetivo</button>':'')+'</div><textarea name="objective">'+esc(a.objective||'')+'</textarea>'+(p.plan_type==='cfdh_transversal'?'<small>Use o botão para repetir este objetivo específico somente nas ações selecionadas.</small>':'')+'</div>'+
    '<div class="field cfdh-classification-block"><div class="page-head compact cfdh-field-head"><div><label>Classificação metodológica</label><small>Núcleo → Eixo → Item</small></div>'+(p.plan_type==='cfdh_transversal'?'<button type="button" class="cfdh-inline-tool" data-cfdh-link-classification>'+(a.classification_group_id?'🔗 Gerenciar vínculo':'🔗 Vincular ações')+'</button>':'')+'</div>'+
    '<input type="hidden" name="classification_group_id" value="'+esc(a.classification_group_id||'')+'">'+
    (a.classification_group_id?'<div class="cfdh-linked-hint" data-cfdh-linked-hint>Classificação vinculada: alterações em Núcleo, Eixo ou Item serão sincronizadas com as outras ações deste grupo.</div>':'<div class="cfdh-linked-hint hidden" data-cfdh-linked-hint></div>')+
    '<div class="form-grid three"><div class="field"><label>Núcleo</label><select name="nucleus_code" data-cfdh-nucleus required><option value="">Selecione</option>'+opts.nuclei+'</select></div>'+
    '<div class="field"><label>Eixo</label><select name="axis_code" data-cfdh-axis required><option value="">Selecione o Núcleo</option>'+opts.axes+'</select></div>'+
    '<div class="field"><label>Item A/B/C...</label><select name="item_code" data-cfdh-item '+(hasItems?'required':'')+'><option value="">'+(hasItems?'Selecione o Item':'Sem subdivisão por Item')+'</option>'+opts.items+'</select><input type="hidden" name="item_label" value="'+esc(a.item_label||'')+'"></div></div></div>'+
    (p.plan_type==='cfdh_transversal'
      ?'<div class="cfdh-transversal-schedule"><div class="form-grid"><div class="field"><label>Oficina vinculada</label><select name="workshop_id" data-cfdh-action-workshop required><option value="">Selecione</option>'+selectedWorkshops.map(w=>'<option value="'+w.id+'" '+(w.id===a.workshop_id?'selected':'')+'>'+esc(w.name)+'</option>').join('')+'</select></div><div class="field"><label>Vínculo com a agenda da oficina</label><div class="input read-only" data-cfdh-schedule-link-status>'+(a.schedule_mode==='workshop_planned'?'Dentro de uma aula planejada da oficina':'Dia/horário atípico ou ainda não identificado')+'</div><input type="hidden" name="schedule_mode" value="'+esc(a.schedule_mode||'atypical')+'"><input type="hidden" name="workshop_calendar_id" value="'+esc(a.workshop_calendar_id||'')+'"></div></div><small>Ao escolher data e horário, o sistema identifica automaticamente se a ação cabe dentro de uma aula já planejada da oficina.</small></div>'
      :'<div class="notice info compact"><b>CFDH estrutural:</b> a oficina vinculada fica indisponível. Esta é uma ação própria do circuito.</div>')+
    cfdhCalendarPickerHtml(bundle,a,index)+
    '<div class="form-grid three"><div class="field"><label>Duração planejada (h)</label><input class="input" type="number" min="0.25" step="0.25" name="planned_duration_hours" value="'+esc(a.planned_duration_hours??2)+'" required><small>Referência mínima operacional para contabilização: 2h por ação.</small></div><div class="field"><label>Horário de início</label><input class="input" type="time" name="start_time" value="'+esc(String(a.start_time||'').slice(0,5))+'" required><small>Preencha somente o início.</small></div><div class="field"><label>Término calculado</label><input class="input read-only" type="time" name="end_time" value="'+esc(String(a.end_time||cfdhAutoEndTime(a.start_time,a.planned_duration_hours)||'').slice(0,5))+'" readonly><small>Calculado automaticamente pela carga horária.</small></div></div>'+
    '<div class="cfdh-calendar-conflict hidden" data-cfdh-calendar-conflict></div>'+
    '<div class="form-grid"><div class="field"><label>Local</label><select name="location_type"><option value="" '+(!a.location_type?'selected':'')+'>CRJ Cariacica</option><option value="LABPoca" '+(a.location_type==='LABPoca'?'selected':'')+'>LABPoca</option><option value="Sala de computadores" '+(a.location_type==='Sala de computadores'?'selected':'')+'>Sala de computadores</option><option value="Sala de dança" '+(a.location_type==='Sala de dança'?'selected':'')+'>Sala de dança</option><option value="Trampo Coletivo" '+(a.location_type==='Trampo Coletivo'?'selected':'')+'>Trampo Coletivo</option><option value="Externa" '+(a.location_type==='Externa'?'selected':'')+'>Externa</option><option value="Outro" '+(a.location_type==='Outro'?'selected':'')+'>Outro</option></select></div></div>'+
    '<div class="field"><label>Local externo / outro — descrição</label><input class="input" name="location_other" value="'+esc(a.location_other||'')+'"></div>'+
    '<div class="field"><div class="page-head compact cfdh-field-head"><div><label>Atividades propostas</label></div>'+(p.plan_type==='cfdh_transversal'?'<button type="button" class="cfdh-inline-tool" data-cfdh-copy-activities>↗ Repetir dinâmica</button>':'')+'</div><textarea name="activities">'+esc(a.activities||'')+'</textarea>'+(p.plan_type==='cfdh_transversal'?'<small>Use o botão para repetir esta mesma dinâmica somente nas ações que você selecionar.</small>':'')+'</div>'+
    '<div class="field"><div class="page-head compact cfdh-field-head"><div><label>Recursos necessários</label></div>'+(p.plan_type==='cfdh_transversal'?'<button type="button" class="cfdh-inline-tool" data-cfdh-copy-resources>↗ Repetir recursos</button>':'')+'</div><textarea name="resources">'+esc(a.resources||'')+'</textarea>'+(p.plan_type==='cfdh_transversal'?'<small>Copie apenas os recursos para as ações selecionadas.</small>':'')+'</div>'+
  '</div>';
}
function cfdhOperationsHtml(bundle){
  const p=bundle.plan,workshops=bundle.workshops||[],evals=bundle.evaluations||[];
  const youthEval=evals.filter(x=>x.form_slug==='cfdh-avaliacao-jovens').length;
  const teamEval=evals.filter(x=>x.form_slug==='cfdh-avaliacao-equipe').length;
  const actions=(bundle.actions||[]).map(a=>{
    const w=workshops.find(x=>x.id===a.workshop_id),presence=Number(bundle.attendance_counts?.[a.id]||0),done=['realizada','parcial'].includes(a.execution_status),responsibles=(a.responsible_names||[]).join(', ');
    return '<div class="card cfdh-operation-card"><div class="page-head compact"><div><div class="actions"><span class="pill '+(done?'success':'warn')+'">'+esc(a.execution_status||'planejada')+'</span><span class="pill">Ação '+a.action_number+'</span></div><h3>'+esc(a.title||'Ação CFDH')+'</h3><p>'+fmtDate(a.scheduled_date)+' · '+esc(String(a.start_time||'').slice(0,5))+'–'+esc(String(a.end_time||'').slice(0,5))+(w?' · '+esc(w.name):' · Estrutural')+'</p><p class="muted"><b>Responsável(is):</b> '+esc(responsibles||'Não definido')+'</p></div><div class="actions"><span class="pill info">'+presence+' presença(s)</span></div></div>'+
      '<div class="actions"><button class="btn primary" data-cfdh-execute="'+a.id+'">'+(done?'Editar execução':'Registrar execução')+'</button><button class="btn secondary" data-cfdh-open-checkin="'+a.id+'">Abrir lista de presença</button><button class="btn" data-cfdh-list-preview="'+a.id+'">Prévia lista</button>'+(presence?'<button class="btn ghost" data-cfdh-list-pdf="'+a.id+'">PDF</button><button class="btn ghost" data-cfdh-list-docx="'+a.id+'">DOCX</button><button class="btn ghost" data-cfdh-list-print="'+a.id+'">Imprimir</button>':'')+'</div>'+
      (done?'<div class="notice success compact" style="margin-top:10px"><b>Execução registrada:</b> '+Number(a.actual_duration_hours||0).toLocaleString('pt-BR')+'h · '+esc(a.execution_description||'Sem descrição.')+(Number(a.actual_duration_hours||0)<2?'<br><b>Atenção:</b> ação abaixo de 2h — registrada, mas fora da contagem operacional mínima deste fluxo.':'')+'</div>':'')+
    '</div>';
  }).join('');
  return '<div class="page-head educator-subhead" style="margin-top:24px"><div><h3>Execução, presença e avaliação</h3><p>Cada ação gera sua própria execução e lista nominal. A inscrição no circuito pode ser feita pela própria lista.</p></div><div class="actions"><button class="btn primary" data-nav="cfdh?month='+esc(String(p.planned_start||currentMonth()).slice(0,7))+'&plan='+p.id+'&view=relatorio">'+(bundle.report?'Editar relatório CFDH':'Responder relatório CFDH')+'</button></div></div>'+
    '<div class="stack">'+(actions||'<div class="card empty">Salve ao menos uma ação para iniciar a execução.</div>')+'</div>'+
    '<div class="page-head educator-subhead" style="margin-top:20px"><div><h3>Avaliações do circuito</h3><p>O sistema mantém a pendência visível enquanto as avaliações necessárias ainda não estiverem registradas.</p></div></div>'+
    '<div class="grid two"><div class="card"><div class="actions"><span class="pill">Anexo 12</span><span class="pill '+(youthEval?'success':'warn')+'">'+youthEval+' aplicação(ões)</span></div><h3>Avaliação dos Jovens</h3><p class="muted">Pode ser aplicada periodicamente e ao final do circuito.</p><button class="btn primary" data-nav="formulario/cfdh-avaliacao-jovens?cfdh_plan='+p.id+'&month='+esc(String(p.planned_start||currentMonth()).slice(0,7))+'">Aplicar avaliação dos jovens</button></div>'+
    '<div class="card"><div class="actions"><span class="pill">Anexo 13</span><span class="pill '+(teamEval?'success':'warn')+'">'+teamEval+' aplicação(ões)</span></div><h3>Avaliação Educadores e Oficineiros</h3><p class="muted">Preenchimento reservado aos Educadores e Coordenação Geral.</p>'+(permitted('workshop_education_docs')?'<button class="btn primary" data-nav="formulario/cfdh-avaliacao-equipe?cfdh_plan='+p.id+'&month='+esc(String(p.planned_start||currentMonth()).slice(0,7))+'">Aplicar avaliação da equipe</button>':'<button class="btn" disabled>Exclusivo Educadores</button>')+'</div></div>';
}
function cfdhPlanEditorHtml(bundle){
  const p=bundle.plan,workshops=bundle.workshops||[],alerts=cfdhPlanAlerts(bundle),themeText=cfdhMonthlyThemeText(bundle),themes=bundle.themes||[];
  const isThemeSource=Boolean(bundle.month_theme?.source_plan_id&&bundle.month_theme.source_plan_id===p.id);
  const themeOptions=themes.map(t=>'<option value="'+t.code+'" '+(Number(t.code)===Number(bundle.month_theme?.theme_code??p.cfdh_theme_code)?'selected':'')+'>'+esc(t.code+'. '+t.theme)+'</option>').join('');
  const themeNotice=bundle.month_theme
    ?(isThemeSource
      ?'<div class="notice info"><b>Este é o primeiro planejamento CFDH do mês e define o tema oficial.</b><br>O tema pode ser alterado posteriormente quando a realidade do território exigir. Os demais circuitos do mês herdam a alteração automaticamente.</div><div class="form-grid"><div class="field"><label>Tema mensal da metodologia</label><select name="cfdh_theme_code"><option value="">Selecione</option>'+themeOptions+'</select></div><div class="field"><label>Outro tema / adaptação territorial</label><input class="input" name="cfdh_theme_custom" value="'+esc(bundle.month_theme?.theme_custom||p.cfdh_theme_custom||'')+'" placeholder="Descreva apenas quando necessário"></div></div>'
      :'<div class="notice success"><b>Tema oficial do mês: '+esc(themeText)+'</b><br>Este planejamento herda o tema definido no primeiro CFDH do mês. O tema é alterado no planejamento de referência quando houver necessidade pontual.</div>')
    :'<div class="notice warn"><b>Tema mensal ainda não definido.</b><br>Volte ao CFDH compartilhado e use <b>Novo circuito CFDH</b> para definir o tema do mês.</div>';
  const workshopChecks=workshops.map(w=>'<label class="check cfdh-workshop-check"><input type="checkbox" name="cfdh_workshop_id" value="'+w.id+'" '+(bundle.workshop_ids.includes(w.id)?'checked':'')+'><span><b>'+esc(w.name)+'</b><small>'+esc(workshopScheduleLabel(w))+' · '+esc(String(w.start_time||'').slice(0,5))+(w.end_time?'–'+esc(String(w.end_time).slice(0,5)):'')+'</small></span></label>').join('');
  return '<div class="page-head"><div><h2>Planejamento CFDH · '+esc(p.activity_title||'Circuito Formativo')+'</h2><p>'+esc(cfdhTypeLabel(p.plan_type))+' · planejamento por ações, agenda, presença e avaliação.</p></div><div class="actions"><button class="btn" data-nav="cfdh?month='+esc(String(p.planned_start||currentMonth()).slice(0,7))+'">Voltar</button><button class="btn" data-cfdh-plan-print="'+p.id+'">Imprimir</button><button class="btn secondary" data-cfdh-plan-pdf="'+p.id+'">PDF</button><button class="btn secondary" data-cfdh-plan-docx="'+p.id+'">DOCX</button></div></div>'+
    '<div class="cfdh-alerts" data-cfdh-alerts>'+(alerts.length?alerts.map(x=>'<div class="notice warn compact">⚠ '+esc(x)+'</div>').join(''):'<div class="notice success compact">Planejamento sem pendências estruturais.</div>')+'</div>'+
    '<form id="cfdh-plan-editor" data-plan-id="'+p.id+'">'+
    '<div class="methodology-form-workspace preview-open" data-cfdh-plan-workspace>'+
      '<div class="methodology-form-editor stack">'+
        '<div class="card"><div class="form-grid"><div class="field"><label>Modalidade CFDH</label><select name="plan_type" data-cfdh-type required><option value="cfdh_estrutural" '+(p.plan_type==='cfdh_estrutural'?'selected':'')+'>Estrutural</option><option value="cfdh_transversal" '+(p.plan_type==='cfdh_transversal'?'selected':'')+'>Transversal</option></select></div><div class="field"><label>Mês de referência</label><input class="input" type="month" value="'+esc(String(p.planned_start||currentMonth()).slice(0,7))+'" disabled></div></div>'+
        themeNotice+
        '<div class="field"><label>Título do circuito</label><input class="input" name="activity_title" value="'+esc(p.activity_title||'')+'" required></div>'+
        '<div class="field"><label>Objetivo geral</label><textarea name="description_objective" required>'+esc(p.description_objective||'')+'</textarea></div>'+
        '<div class="form-grid"><div class="field"><label>Quantidade de ações planejadas</label><input class="input" type="number" min="1" max="60" name="cfdh_action_count" data-cfdh-action-count value="'+esc(p.cfdh_action_count||bundle.actions.length||1)+'" required></div><div class="field"><label>Público previsto</label><input class="input" type="number" min="0" name="expected_participants" value="'+esc(p.expected_participants??'')+'"></div></div>'+
        '<div class="field"><label>Equipe prevista / colaboração geral</label><input class="input" name="team_text" value="'+esc(p.team_text||'')+'"><small>Os responsáveis formais por cada ação são selecionados individualmente dentro de cada Ação.</small></div>'+
        '<div class="field"><label>Parceiros</label><input class="input" name="partners" value="'+esc(p.partners||'')+'"></div>'+
        '<div class="field"><label>Mobilização / divulgação</label><textarea name="mobilization_plan">'+esc(p.mobilization_plan||'')+'</textarea></div>'+
        '<div class="field"><label>Resultados esperados</label><textarea name="expected_results">'+esc(p.expected_results||'')+'</textarea></div>'+
        '<div class="field"><label>Observações do mês</label><textarea name="cfdh_monthly_notes">'+esc(p.cfdh_monthly_notes||'')+'</textarea></div></div>'+
        '<div class="card '+(p.plan_type==='cfdh_estrutural'?'':'hidden')+'" data-cfdh-structural-smart-block><div class="page-head compact"><div><h3>Distribuição inteligente das ações estruturais</h3><p>Analisa calendário, sobrecarga, fluxo identificado e histórico para sugerir datas e horários sem impedir ajustes manuais.</p></div><button type="button" class="btn primary" data-cfdh-smart-distribute>Distribuir ações de maneira inteligente</button></div><small class="muted">A sugestão não substitui decisão da equipe. O sistema mostra os critérios e o nível de confiança antes de aplicar.</small></div>'+
        '<div class="card '+(p.plan_type==='cfdh_estrutural'?'hidden':'')+'" data-cfdh-workshops-block><div class="page-head compact"><div><h3>Oficinas vinculadas</h3><p>Selecione uma ou mais. As ações serão distribuídas entre datas planejadas ou dias atípicos.</p></div><button type="button" class="btn secondary" data-cfdh-auto-distribute>Distribuir ações automaticamente</button></div><div class="check-grid cfdh-workshop-grid">'+workshopChecks+'</div></div>'+
        '<div data-cfdh-actions>'+bundle.actions.map((a,i)=>cfdhActionEditorCard(bundle,a,i)).join('')+'</div>'+
        '<div class="card"><div class="actions"><button class="btn primary" type="submit">Salvar planejamento CFDH</button></div></div>'+
      '</div>'+
      '<aside class="methodology-preview-pane"><div class="methodology-preview-toolbar"><div><b>Pré-visualização · Anexo 11</b><span>Atualização em tempo real</span></div><button type="button" class="btn ghost" data-toggle-cfdh-plan-preview>Ocultar</button></div><div class="methodology-preview-scroll" data-cfdh-plan-preview>'+cfdhPlanPreviewHtml(bundle)+'</div></aside>'+
    '</div></form>'+cfdhOperationsHtml(bundle);
}
function cfdhReportSnapshot(bundle){
  return {
    actions:(bundle.actions||[]).map(a=>({...a,attendance_count:Number(bundle.attendance_counts?.[a.id]||0),goal_links:cfdhActionGoalLinks(bundle,a)})),
    attendance_counts:bundle.attendance_counts||{}
  };
}
function cfdhReportDraft(bundle,form=null){
  const r=bundle.report||{},get=n=>form?.querySelector('[name="'+n+'"]')?.value;
  const v=n=>form?get(n):(r[n]??'');
  const executed=(bundle.actions||[]).filter(a=>['realizada','parcial'].includes(a.execution_status));
  const youthUnique=Number(bundle.unique_participants||0);
  return {...r,plan_id:bundle.plan.id,report_date:v('report_date')||new Date().toISOString().slice(0,10),
    execution_status:v('execution_status')||'realizado',
    actual_description:v('actual_description')||'',actual_participants:youthUnique,
    actual_start:executed.map(x=>x.actual_date||x.scheduled_date).filter(Boolean).sort()[0]||null,
    actual_end:executed.map(x=>x.actual_date||x.scheduled_date).filter(Boolean).sort().slice(-1)[0]||null,
    actual_duration_hours:Number(executed.reduce((n,x)=>n+Number(x.actual_duration_hours||0),0).toFixed(2)),
    methodology_applied:v('methodology_applied')||'',results_achieved:v('results_achieved')||'',
    youth_feedback:v('youth_feedback')||'',positive_points:v('positive_points')||'',
    negative_points:v('negative_points')||'',actions_performed:v('actions_performed')||'',
    next_steps:v('next_steps')||'',justification:v('justification')||'',evidence_ref:v('evidence_ref')||'',
    observations:v('observations')||'',execution_snapshot:cfdhReportSnapshot(bundle)};
}
function cfdhReportPreviewHtml(bundle,draft=null){
  const p=bundle.plan,r=draft||cfdhReportDraft(bundle),theme=cfdhMonthlyThemeText(bundle),workshops=bundle.workshops||[];
  const rows=(bundle.actions||[]).map(a=>'<tr><td><b>Ação '+a.action_number+'</b><br>'+esc(fmtDate(a.scheduled_date))+'</td><td>'+esc((a.responsible_names||[]).join(', ')||'Não definido')+'</td><td><b>'+esc(a.title||'')+'</b><br><small>Tema: '+esc(a.action_theme||theme)+'</small><br><small>'+esc(workshops.find(w=>w.id===a.workshop_id)?.name||'Estrutural')+'</small></td><td>'+esc(a.execution_status||'planejada')+'</td><td>'+esc(a.execution_description||'')+'</td><td>'+Number(a.actual_duration_hours||0).toLocaleString('pt-BR')+'h</td><td>'+Number(bundle.attendance_counts?.[a.id]||0)+'</td></tr>').join('');
  const plannedCount=(bundle.actions||[]).reduce((n,a)=>n+cfdhActionCountableHours(a),0),actualCount=(bundle.actions||[]).reduce((n,a)=>n+cfdhActionCountableHours(a,true),0);
  return '<div class="methodology-paper methodology-paper-landscape cfdh-report-paper"><div class="methodology-annex-title">CRJ CARIACICA · RELATÓRIO DE EXECUÇÃO CFDH</div><div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div><div class="methodology-inner-title">CIRCUITO FORMATIVO EM DIREITOS HUMANOS</div>'+
    '<div class="methodology-row"><b>Modalidade:</b><span class="methodology-inline-answer">'+esc(cfdhTypeLabel(p.plan_type))+'</span></div><div class="methodology-row"><b>Tema:</b><span class="methodology-inline-answer">'+esc(theme)+'</span></div><div class="methodology-row"><b>Circuito:</b><span class="methodology-inline-answer">'+esc(p.activity_title||'')+'</span></div>'+
    '<div class="methodology-row"><b>Planejado:</b><span class="methodology-inline-answer">'+bundle.actions.length+' ação(ões) · '+plannedCount.toLocaleString('pt-BR')+'h contabilizáveis</span> <b style="margin-left:18px">Executado:</b><span class="methodology-inline-answer">'+actualCount.toLocaleString('pt-BR')+'h contabilizáveis</span></div>'+
    '<table class="methodology-planning-table cfdh-report-table"><thead><tr><th>Ação</th><th>Responsável(is)</th><th>Planejado</th><th>Situação</th><th>Executado</th><th>CH real</th><th>Presenças</th></tr></thead><tbody>'+(rows||'<tr><td colspan="7">Sem ações.</td></tr>')+'</tbody></table>'+
    '<div class="methodology-row methodology-row-tall"><b>Síntese da execução:</b><div class="methodology-answer">'+esc(r.actual_description||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Metodologia aplicada / adaptações:</b><div class="methodology-answer">'+esc(r.methodology_applied||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Resultados alcançados:</b><div class="methodology-answer">'+esc(r.results_achieved||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Percepção dos jovens:</b><div class="methodology-answer">'+esc(r.youth_feedback||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Pontos positivos:</b><div class="methodology-answer">'+esc(r.positive_points||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Dificuldades:</b><div class="methodology-answer">'+esc(r.negative_points||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Próximos passos:</b><div class="methodology-answer">'+esc(r.next_steps||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Justificativas:</b><div class="methodology-answer">'+esc(r.justification||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Evidências:</b><div class="methodology-answer">'+esc(r.evidence_ref||'')+'</div></div><div class="methodology-row methodology-row-tall"><b>Observações:</b><div class="methodology-answer">'+esc(r.observations||'')+'</div></div></div>';
}
function cfdhReportEditorHtml(bundle){
  const r=bundle.report||{},status=r.execution_status||'realizado';
  return '<div class="page-head"><div><h2>Relatório CFDH · '+esc(bundle.plan.activity_title||'Circuito Formativo')+'</h2><p>Responda ao planejado com base nas ações, execução e presenças registradas.</p></div><div class="actions"><button class="btn" data-nav="cfdh?month='+esc(String(bundle.plan.planned_start||currentMonth()).slice(0,7))+'&plan='+bundle.plan.id+'">Voltar ao planejamento</button>'+(r.id?'<button class="btn secondary" data-cfdh-report-pdf="'+r.id+'">PDF</button><button class="btn secondary" data-cfdh-report-docx="'+r.id+'">DOCX</button>':'')+'<button class="btn" data-cfdh-report-print="'+bundle.plan.id+'">Imprimir</button></div></div>'+
  '<form id="cfdh-report-editor" data-plan-id="'+bundle.plan.id+'"><div class="methodology-form-workspace preview-open" data-cfdh-report-workspace><div class="methodology-form-editor stack"><div class="card"><div class="form-grid"><div class="field"><label>Data do relatório</label><input class="input" type="date" name="report_date" value="'+esc(r.report_date||new Date().toISOString().slice(0,10))+'" required></div><div class="field"><label>Situação geral</label><select name="execution_status"><option value="realizado" '+(status==='realizado'?'selected':'')+'>Realizado</option><option value="parcial" '+(status==='parcial'?'selected':'')+'>Parcial</option><option value="nao_realizado" '+(status==='nao_realizado'?'selected':'')+'>Não realizado</option></select></div></div><div class="field"><label>Síntese do que foi executado</label><textarea name="actual_description" required>'+esc(r.actual_description||'')+'</textarea></div><div class="field"><label>Metodologia aplicada / adaptações</label><textarea name="methodology_applied">'+esc(r.methodology_applied||'')+'</textarea></div><div class="field"><label>Resultados alcançados</label><textarea name="results_achieved">'+esc(r.results_achieved||'')+'</textarea></div><div class="field"><label>Retorno e percepção dos jovens</label><textarea name="youth_feedback">'+esc(r.youth_feedback||'')+'</textarea></div><div class="form-grid"><div class="field"><label>Pontos positivos</label><textarea name="positive_points">'+esc(r.positive_points||'')+'</textarea></div><div class="field"><label>Dificuldades / pontos negativos</label><textarea name="negative_points">'+esc(r.negative_points||'')+'</textarea></div></div><div class="field"><label>Ações realizadas / ajustes</label><textarea name="actions_performed">'+esc(r.actions_performed||'')+'</textarea></div><div class="field"><label>Próximos passos / encaminhamentos</label><textarea name="next_steps">'+esc(r.next_steps||'')+'</textarea></div><div class="field"><label>Justificativa</label><textarea name="justification">'+esc(r.justification||'')+'</textarea></div><div class="field"><label>Evidências / referências</label><textarea name="evidence_ref">'+esc(r.evidence_ref||'')+'</textarea></div><div class="field"><label>Observações finais</label><textarea name="observations">'+esc(r.observations||'')+'</textarea></div></div><div class="card"><button class="btn primary" type="submit">Salvar relatório CFDH</button></div></div><aside class="methodology-preview-pane"><div class="methodology-preview-toolbar"><div><b>Pré-visualização do relatório CFDH</b><span>Planejado × executado</span></div><button type="button" class="btn ghost" data-toggle-cfdh-report-preview>Ocultar</button></div><div class="methodology-preview-scroll" data-cfdh-report-preview>'+cfdhReportPreviewHtml(bundle)+'</div></aside></div></form>';
}

async function pageCfdhShared(){
  if(!permitted('cfdh_shared'))return '<div class="notice danger">Seu perfil não possui acesso ao CFDH compartilhado.</div>';
  const rr=route(),month=rr.params.get('month')||currentMonth(),planId=rr.params.get('plan')||'',view=rr.params.get('view')||'planejamento';
  if(planId){
    const [bundle,themes,classification,indicators,monthDashboard,crjCalendar,smartSignals,specialDays]=await Promise.all([getCfdhPlanBundle(planId),listCfdhThemes(),listMethodologyClassificationCatalog(),listIndicatorCatalog(),listCfdhMonthDashboard(month),listCrjPlanningCalendar(month),getCfdhStructuralDistributionSignals(month),listCrjSpecialDays(Number(month.slice(0,4)))]);
    bundle.themes=themes;bundle.classification=classification;bundle.indicators=indicators;bundle.month_dashboard=monthDashboard;bundle.crj_calendar=crjCalendar;bundle.smart_signals=smartSignals;bundle.special_days=specialDays;
    if(view==='relatorio')return cfdhReportEditorHtml(bundle);
    return cfdhPlanEditorHtml(bundle);
  }
  const [dash,themes,specialDays]=await Promise.all([listCfdhMonthDashboard(month),listCfdhThemes(),listCrjSpecialDays(Number(month.slice(0,4)))]);
  const monthThemeText=dash.month_theme?(dash.month_theme.theme_custom||themes.find(t=>Number(t.code)===Number(dash.month_theme.theme_code))?.theme||'Tema definido'):'Ainda não definido — será definido ao criar o primeiro circuito CFDH do mês';
  const target=Math.min(100,(Number(dash.metrics.countable_executed_hours||0)/CFDH_MONTH_TARGET)*100),struct=Math.min(100,(Number(dash.metrics.structural_hours||0)/CFDH_STRUCTURAL_MIN)*100);
  const plannedTotal=Number(dash.metrics.countable_planned_hours||0),plannedStructural=Number(dash.metrics.structural_planned_hours||0),plannedTransversal=Number(dash.metrics.transversal_planned_hours||0);
  const plannedOk=plannedTotal>=CFDH_MONTH_TARGET&&plannedStructural>=CFDH_STRUCTURAL_MIN;
  const plannedGoalNotice='<div class="notice '+(plannedOk?'success':'danger')+'" style="margin-top:16px"><b>'+(plannedOk?'Planejamento mensal atende os mínimos de CFDH.':'Meta mensal não será batida com o planejamento atual.')+'</b><br>CFDH estrutural: <b>'+plannedStructural.toLocaleString('pt-BR')+'h / '+CFDH_STRUCTURAL_MIN+'h mínimas</b> · CFDH transversal: <b>'+plannedTransversal.toLocaleString('pt-BR')+'h</b> · Total planejado contabilizável: <b>'+plannedTotal.toLocaleString('pt-BR')+'h / '+CFDH_MONTH_TARGET+'h mínimas</b>'+(plannedOk?'':'<br><small>Inclua ou amplie ações planejadas antes do fechamento do mês.</small>')+'</div>';
  const reportMap=new Map((dash.reports||[]).map(x=>[x.plan_id,x]));
  const cards=(dash.plans||[]).map(p=>{
    const aa=(dash.actions||[]).filter(x=>x.plan_id===p.id),rep=reportMap.get(p.id),count=aa.reduce((n,a)=>n+cfdhActionCountableHours(a,true),0),pending=aa.filter(a=>!['realizada','parcial'].includes(a.execution_status)).length,isSource=dash.month_theme?.source_plan_id===p.id;
    return '<div class="card cfdh-dashboard-card"><div class="actions"><span class="pill '+(p.plan_type==='cfdh_estrutural'?'success':'info')+'">'+esc(cfdhTypeLabel(p.plan_type))+'</span><span class="pill">'+aa.length+' ação(ões)</span>'+(isSource?'<span class="pill warn">Define o tema do mês</span>':'')+'</div><h3>'+esc(p.activity_title||cfdhThemeText(p,themes))+'</h3><p>'+esc(cfdhThemeText(p,themes))+'</p><div class="cfdh-card-stats"><span><b>'+count.toLocaleString('pt-BR')+'h</b><small>executadas e contabilizáveis</small></span><span><b>'+pending+'</b><small>ações pendentes</small></span></div><div class="actions"><button class="btn primary" data-nav="cfdh?month='+month+'&plan='+p.id+'">Editar CFDH</button>'+(isSource?'<button class="btn secondary" data-cfdh-edit-theme="'+p.id+'">Editar tema do mês</button>':'')+'<button class="btn secondary" data-nav="cfdh?month='+month+'&plan='+p.id+'&view=relatorio">'+(rep?'Editar relatório':'Responder relatório')+'</button><button class="btn danger" data-cfdh-delete-plan="'+p.id+'" data-cfdh-delete-title="'+esc(p.activity_title||'Circuito CFDH')+'">Excluir CFDH</button></div></div>';
  }).join('');
  return '<div class="page-head"><div><h2>CFDH compartilhado</h2><p>Tema mensal → planejamento por ações → execução → presença → avaliação → relatório.</p></div><div class="actions"><button class="btn primary" data-new-cfdh-plan>+ Novo circuito CFDH</button></div></div>'+
    '<div class="card"><div class="form-grid"><div class="field"><label>Mês de referência</label><input class="input" type="month" data-cfdh-month value="'+esc(month)+'"></div><div class="field"><label>Participação na construção</label><div class="input read-only">Educadores · Psicologia · Serviço Social · Terapia Ocupacional</div></div></div><div class="notice '+(dash.month_theme?'success':'warn')+'" style="margin-top:12px"><b>Tema oficial do mês:</b> '+esc(monthThemeText)+'<br><small>'+(dash.month_theme?'Usa como referência o primeiro planejamento CFDH criado no mês. O tema pode ser alterado depois quando houver necessidade pontual, e a mudança passa a valer para os demais circuitos do mês.':'Clique em <b>Novo circuito CFDH</b> para definir o tema inicial deste mês.')+'</small></div></div>'+
    cfdhOperatingCalendarPanelHtml(specialDays,month)+
    plannedGoalNotice+
    '<div class="grid cards cfdh-progress-grid" style="margin-top:16px"><div class="card kpi"><div class="label">CFDH executado</div><div class="value">'+Number(dash.metrics.countable_executed_hours||0).toLocaleString('pt-BR')+'h</div><div class="progress"><span style="width:'+target+'%"></span></div><div class="meta">Referência mensal: '+CFDH_MONTH_TARGET+'h</div></div><div class="card kpi"><div class="label">CFDH estrutural</div><div class="value">'+Number(dash.metrics.structural_hours||0).toLocaleString('pt-BR')+'h</div><div class="progress"><span style="width:'+struct+'%"></span></div><div class="meta">Referência mínima estrutural: '+CFDH_STRUCTURAL_MIN+'h</div></div><div class="card kpi"><div class="label">Pendências</div><div class="value">'+Number(dash.metrics.pending||0)+'</div><div class="meta">relatórios, avaliações ou execução</div></div></div>'+
    '<div class="page-head educator-subhead"><div><h3>Circuitos do mês</h3><p>Ações com menos de 2h permanecem registradas, mas ficam sinalizadas fora da contagem operacional mínima configurada.</p></div></div><div class="grid two">'+(cards||'<div class="card empty">Nenhum planejamento CFDH neste mês.</div>')+'</div>'+
    '<div class="page-head educator-subhead" style="margin-top:20px"><div><h3>Formulários de avaliação do CFDH</h3><p>As avaliações também ficam disponíveis dentro de cada circuito, já contextualizadas ao planejamento.</p></div></div><div class="grid three"><div class="card"><span class="pill">Anexo 11</span><h3>Planejamento CFDH</h3><p class="muted">O editor do circuito estrutura as mesmas informações em ações e mantém pré-visualização documental.</p></div><div class="card"><span class="pill">Anexo 12</span><h3>Avaliação dos Jovens</h3><p class="muted">Aplicação periódica e ao final do circuito.</p></div><div class="card"><div class="actions"><span class="pill">Anexo 13</span><span class="pill warn">Exclusivo Educadores</span></div><h3>Avaliação Educadores e Oficineiros</h3><p class="muted">Avaliação da execução e condução do CFDH pela equipe de referência.</p></div></div>';
}

async function pageEducatorV2(){
  if(!permitted('educador_area'))return '<div class="notice danger">Seu perfil nao possui acesso a Area do Educador.</div>';
  const rr=route(),month=rr.params.get('month')||currentMonth(),view=rr.params.get('view')||'responsabilidades',reportPlanId=rr.params.get('report')||'';
  const team=await listTeam(),educators=team.filter(x=>x.role==='educador'&&x.active);
  const requestedUser=rr.params.get('user');
  const defaultUser=state.user?.role==='educador'?state.user.id:'all';
  const selectedKey=requestedUser||defaultUser;
  const selectedId=selectedKey==='all'?'':selectedKey;
  const selected=educators.find(x=>x.id===selectedId)||null;
  const [records,contrib,workshops,youth,plans,reports,receipts,workshopPlans,workshopReports]=await Promise.all([listEducatorRecords(month,selectedId||null),educatorContributionSummary(month,selectedId||null),listWorkshops(),listYouth(''),listEducatorPlans(month,selectedId||null),listEducatorReports(selectedId||null),listEducatorReferralReceipts(),listWorkshopMonthlyPlans(month),listWorkshopMonthlyReports()]);
  const sum=t=>contrib.filter(x=>x.event_type===t).reduce((a,x)=>a+Number(x.quantity||0),0),reportByPlan=new Map(reports.map(x=>[x.plan_id,x])),myWorkshops=selectedId?workshops.filter(w=>w.educator_user_id===selectedId):workshops.filter(w=>w.active),visibleWorkshops=myWorkshops.length?myWorkshops:workshops.filter(w=>w.active);
  const filter=`<div class="card educator-filter"><div class="form-grid"><div class="field"><label>Educador</label><select data-educator-filter-user><option value="all" ${!selectedId?'selected':''}>Todos os educadores</option>${educators.map(e=>`<option value="${e.id}" ${e.id===selectedId?'selected':''}>${esc(e.display_name)}</option>`).join('')}</select></div><div class="field"><label>Mes</label><input class="input" type="month" data-educator-filter-month value="${esc(month)}"></div></div></div>`;
  const head=`<div class="page-head"><div><h2>Area do Educador Social</h2><p>Planejar → executar → registrar → comprovar → avaliar. As metas sao alimentadas a partir do trabalho realizado.</p></div>${view==='responsabilidades'?`<button class="btn primary" data-educator-new="acolhimento_educativo">+ Registrar contribuicao ${eduGoalInfo('acolhimento_educativo')}</button>`:''}</div>${filter}${eduTabs(view,month,selectedKey)}`;
  if(view==='planejamento'){
    const linkedHeaders=(workshopPlans||[]).filter(p=>!selectedId||p.educator_user_id===selectedId||workshops.find(w=>w.id===p.workshop_id)?.educator_user_id===selectedId);
    const bundles=await Promise.all(linkedHeaders.map(async p=>{try{return await getWorkshopMonthlyPlan(p.id)}catch{return null}}));
    const linkedBundles=bundles.filter(Boolean),workshopMap=new Map(workshops.map(w=>[w.id,w])),teamMap=new Map(team.map(x=>[x.id,x.display_name]));
    const workshopCards=linkedBundles.map(bundle=>{
      const p=bundle.plan,w=workshopMap.get(p.workshop_id)||{},lessons=(bundle.lessons||[]).filter(x=>x.included!==false),hours=lessons.reduce((a,l)=>a+workshopLessonDurationHours(l),0);
      const lessonRows=lessons.map(l=>'<div class="educator-planned-list-row"><div><b>Aula '+l.lesson_number+' · '+esc(fmtDate(l.scheduled_date))+'</b><span>'+esc(String(l.start_time||'').slice(0,5))+'–'+esc(String(l.end_time||'').slice(0,5))+' · '+esc(workshopLocationLabel({location_type:l.location_type,location_other:l.location_other}))+'</span><small>'+esc(l.theme||('Aula '+l.lesson_number))+'</small></div><div class="actions"><span class="pill success">Lista criada</span><button class="btn ghost" data-edu-list-print="'+l.id+'" data-plan="'+p.id+'">Imprimir</button><button class="btn ghost" data-edu-list-pdf="'+l.id+'">PDF</button><button class="btn ghost" data-edu-list-docx="'+l.id+'">DOCX</button></div></div>').join('');
      const canEditPlan=state.user?.role==='coordenacao_geral'||p.educator_user_id===state.user?.id||p.created_by===state.user?.id;
      return '<div class="card educator-workshop-plan-card"><div class="page-head compact"><div><div class="actions"><span class="pill info">Planejamento de oficina</span><span class="pill '+(p.status==='finalizado'?'success':'warn')+'">'+esc(p.status||'rascunho')+'</span></div><h3>'+esc(w.name||'Oficina')+'</h3><p>'+lessons.length+' aula(s) prevista(s) · '+hours.toLocaleString('pt-BR')+'h · '+esc(String(p.plan_month||'').slice(0,7).split('-').reverse().join('/'))+'</p></div><div class="actions"><button class="btn '+(canEditPlan?'primary':'secondary')+'" data-edu-workshop-plan-open="'+p.id+'">'+(canEditPlan?'Abrir / editar':'Visualizar')+'</button><button class="btn" data-edu-workshop-plan-print="'+p.id+'">Imprimir</button><button class="btn secondary" data-edu-workshop-plan-pdf="'+p.id+'">PDF</button><button class="btn secondary" data-edu-workshop-plan-docx="'+p.id+'">DOCX</button></div></div><div class="notice info"><b>Oficineiro(a):</b> '+esc(teamMap.get(p.instructor_user_id)||'Não definido')+' · <b>Educador(a):</b> '+esc(teamMap.get(p.educator_user_id)||'Não definido')+'<br>As listas abaixo são geradas automaticamente pelas aulas planejadas e usam a data, horário e local vinculados ao calendário.</div><div class="educator-planned-lists">'+(lessonRows||'<div class="empty">Nenhuma aula prevista. Sincronize o planejamento com o calendário da oficina.</div>')+'</div></div>';
    }).join('');
    const legacy=plans.filter(p=>!['oficina','cfdh_estrutural','cfdh_transversal'].includes(p.plan_type));
    const legacyCards=legacy.map(p=>'<div class="card"><div class="actions"><span class="pill">'+esc(eduPlanLabel(p.plan_type))+'</span><span class="pill info">'+esc(p.status)+'</span></div><h3>'+esc(p.activity_title)+'</h3><p>'+esc(p.description_objective||'')+'</p><div class="muted">'+fmtDate(p.planned_start)+' · '+(p.expected_participants??'—')+' jovens · '+(p.planned_duration_hours||0)+'h</div><div class="actions" style="margin-top:12px">'+(reportByPlan.has(p.id)?'<span class="pill success">Relatório registrado</span>':'<button class="btn secondary" data-report-plan="'+p.id+'">Relatar execução</button>')+eduGoalInfo('planejamento_'+p.plan_type)+'</div></div>').join('');
    return head+'<div class="page-head educator-subhead"><div><h3>Planejamento</h3><p>Os planejamentos de oficina abaixo são os mesmos registros salvos em Oficinas e Presenças. Não existe cópia paralela.</p></div><div class="actions"><button class="btn primary" data-nav="oficinas?view=planejamento&month='+month+'">Criar / editar planejamento de oficina</button><button class="btn secondary" data-new-educator-plan>+ Planejamento complementar</button></div></div><div class="stack educator-workshop-plans">'+(workshopCards||'<div class="card empty">Nenhum planejamento de oficina vinculado a este educador no mês.</div>')+'</div><div class="page-head educator-subhead" style="margin-top:20px"><div><h3>Outros planejamentos</h3><p>CFDH agora é construído na área compartilhada com a Equipe Técnica. Aqui permanecem os planejamentos complementares do Educador.</p></div><div class="actions"><button class="btn secondary" data-nav="cfdh?month='+month+'">Abrir CFDH compartilhado</button></div></div><div class="grid two">'+(legacyCards||'<div class="card empty">Nenhum planejamento complementar registrado.</div>')+'</div>';
  }
  if(view==='relatorios'&&reportPlanId){
    const bundle=await getWorkshopMonthlyReportBundle(reportPlanId);
    const p=bundle.plan||{},r=bundle.report||null;
    const canWrite=permitted('workshop_education_docs')&&(state.user?.role==='coordenacao_geral'||p.educator_user_id===state.user?.id||p.created_by===state.user?.id);
    const exportBar=r?'<div class="card" style="margin-bottom:14px"><div class="page-head compact"><div><h3>Documento do relatório</h3><p>O arquivo usa o cabeçalho institucional fixo e o mesmo conteúdo da pré-visualização.</p></div><div class="actions"><button class="btn primary" data-workshop-report-pdf="'+r.id+'">PDF</button><button class="btn secondary" data-workshop-report-docx="'+r.id+'">DOCX</button><button class="btn" data-workshop-report-print="'+reportPlanId+'">Imprimir</button></div></div></div>':'<div class="card" style="margin-bottom:14px"><div class="page-head compact"><div><h3>Prévia do relatório</h3><p>Você pode imprimir a pré-visualização durante o preenchimento. Salve uma vez para liberar PDF e DOCX oficiais.</p></div><div class="actions"><button class="btn" data-workshop-report-print="'+reportPlanId+'">Imprimir prévia</button></div></div></div>';
    return head+exportBar+workshopReportEditorHtml(bundle,canWrite);
  }
  if(view==='relatorios'){
    const workshopMap=new Map(workshops.map(w=>[w.id,w])),reportMap=new Map((workshopReports||[]).map(r=>[r.plan_id,r]));
    const selectedWorkshopPlans=(workshopPlans||[]).filter(p=>!selectedId||p.educator_user_id===selectedId||workshopMap.get(p.workshop_id)?.educator_user_id===selectedId);
    const workshopCards=selectedWorkshopPlans.map(p=>{const w=workshopMap.get(p.workshop_id)||{},rep=reportMap.get(p.id),canWrite=permitted('workshop_education_docs')&&(state.user?.role==='coordenacao_geral'||p.educator_user_id===state.user?.id||p.created_by===state.user?.id);const q=new URLSearchParams({view:'relatorios',month:String(p.plan_month||'').slice(0,7),report:p.id});if(selectedKey)q.set('user',selectedKey);return `<div class="card"><div class="actions"><span class="pill info">Relatório de oficina</span><span class="pill">${esc(String(p.plan_month||'').slice(0,7).split('-').reverse().join('/'))}</span></div><h3>${esc(w.name||'Oficina')}</h3><p class="muted">Planejamento mensal vinculado · Educador: ${esc(educators.find(e=>e.id===p.educator_user_id)?.display_name||'Não definido')}</p>${rep?`<div class="notice ${rep.execution_status==='nao_realizado'?'danger':rep.execution_status==='parcial'?'warn':'success'}"><b>${esc(rep.execution_status)}</b> · ${rep.actual_participants??0} participantes · ${rep.actual_duration_hours??0}h<br>${esc(rep.actual_description||'')}</div><div class="actions" style="margin-top:10px"><button class="btn ${canWrite?'primary':'secondary'}" data-nav="educador?${q.toString()}">${canWrite?'Abrir / editar relatório':'Visualizar relatório'}</button><button class="btn ghost" data-workshop-report-pdf="${rep.id}">PDF</button><button class="btn ghost" data-workshop-report-docx="${rep.id}">DOCX</button><button class="btn ghost" data-workshop-report-print="${p.id}">Imprimir</button></div>`:(canWrite?`<button class="btn primary" data-nav="educador?${q.toString()}">Responder relatório da oficina</button>`:'<div class="notice">Relatório ainda não registrado pelo Educador responsável.</div>')}</div>`}).join('');
    const otherPlans=plans.filter(p=>!['cfdh_estrutural','cfdh_transversal','oficina'].includes(p.plan_type));
    const otherCards=otherPlans.map(p=>{const rep=reportByPlan.get(p.id);return `<div class="card"><span class="pill">${esc(eduPlanLabel(p.plan_type))}</span><h3>${esc(p.activity_title)}</h3><p class="muted">Planejado: ${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</p>${rep?`<div class="notice ${rep.execution_status==='nao_realizado'?'danger':rep.execution_status==='parcial'?'warn':'success'}"><b>${esc(rep.execution_status)}</b> · ${rep.actual_participants??0} participantes · ${rep.actual_duration_hours??0}h<br>${esc(rep.actual_description||'')}</div>`:`<button class="btn primary" data-report-plan="${p.id}">Responder relatório</button>`}</div>`}).join('');
    return head+'<div class="page-head educator-subhead"><div><h3>Relatórios de oficinas</h3><p>Documento exclusivo dos Educadores e vinculado ao planejamento mensal oficial da oficina.</p></div></div><div class="grid two">'+(workshopCards||'<div class="card empty">Nenhum planejamento mensal de oficina neste período.</div>')+'</div><div class="page-head educator-subhead" style="margin-top:20px"><div><h3>Outros relatórios</h3><p>CFDH é tratado na área compartilhada entre Educadores e Equipe Técnica.</p></div></div><div class="grid two">'+(otherCards||'<div class="card empty">Nenhum outro relatório pendente.</div>')+'</div>';
  }
  if(view==='oficinas')return head+`<div class="page-head educator-subhead"><div><h3>Oficinas e presencas</h3><p>Presencas, participantes nao cadastrados, alertas e inscricao formal ficam concentrados por oficina.</p></div></div><div class="grid three">${visibleWorkshops.map(w=>`<div class="card"><span class="pill success">${w.active?'Ativa':'Inativa'}</span><h3>${esc(w.name)}</h3><p class="muted">${esc(w.category||'')} · ${esc(w.days||'')}</p><button class="btn primary" data-nav="oficina/${w.id}?month=${month}">Acompanhar turma ${eduGoalInfo('presenca')}</button></div>`).join('')||'<div class="card empty">Nenhuma oficina disponivel.</div>'}</div>`;
  if(view==='encaminhamentos'){const pm=new Map(team.map(x=>[x.id,x])),ym=new Map(youth.map(x=>[x.id,x])),wm=new Map(workshops.map(x=>[x.id,x])),referrals=records.filter(r=>r.record_type==='encaminhamento_interno'||r.referral_target);return head+`<div class="page-head educator-subhead"><div><h3>Encaminhamentos e ciência</h3><p>Cada encaminhamento pode ser visualizado como documento e gerado em PDF, DOCX ou impressão.</p></div></div><div class="stack">${referrals.map(rec=>{const rr=receipts.filter(x=>x.educator_record_id===rec.id),aware=rr.filter(x=>x.status==='ciente').length;return `<div class="card"><div class="page-head compact"><div><h3>${esc(rec.title||eduTypeLabel(rec.record_type))}</h3><p>${fmtDate(rec.record_date)} · ${esc(wm.get(rec.workshop_id)?.name||'Sem oficina vinculada')} · ${aware}/${rr.length} ciência(s)</p></div><div class="actions"><button class="btn secondary" data-referral-preview="${rec.id}">Pré-visualizar</button><button class="btn ghost" data-referral-pdf="${rec.id}">PDF</button><button class="btn ghost" data-referral-docx="${rec.id}">DOCX</button><button class="btn ghost" data-referral-print="${rec.id}">Imprimir</button></div></div><div class="notice">${esc(rec.description||'Sem descrição.')}</div><div class="actions">${rr.map(x=>{const p=pm.get(x.recipient_user_id);return `<span class="pill ${x.status==='ciente'?'success':'warn'}">${esc(p?.display_name||'Destinatário')} · ${x.status==='ciente'?'Ciente':'Pendente'}</span>`}).join('')}</div></div>`}).join('')||'<div class="card empty">Nenhum encaminhamento do período.</div>'}</div>`}
  const btns=[['acolhimento_educativo','Acolhimento educativo'],['demanda_identificada','Demanda identificada'],['encaminhamento_interno','Encaminhamento interno'],['acompanhamento_oficina','Acompanhamento de oficina'],['mediacao_convivencia','Mediacao / convivencia'],['ficaadica_orientacao','#FicaAdica / orientacao'],['trampo_labpoca','Trampo Coletivo / LABPoca'],['mobilizacao','Mobilizacao'],['evento_programacao','Evento / programacao'],['passeio_visita','Passeio / visita externa'],['atividade_externa','Atividade externa'],['mostra','Mostra'],['estudo_caso','Estudo de caso'],['outra_acao_educativa','Outra acao']];
  return head+`<div class="grid cards" style="margin-top:16px"><div class="card kpi"><div class="label">Horas de aula</div><div class="value">${sum('aula').toFixed(1)}</div><div class="meta">${eduGoalInfo('aula')}</div></div><div class="card kpi"><div class="label">Presencas</div><div class="value">${sum('presenca')}</div><div class="meta">${eduGoalInfo('presenca')}</div></div><div class="card kpi"><div class="label">Registros educativos</div><div class="value">${records.length}</div></div></div><div class="grid two" style="margin-top:16px"><div class="card"><h3>Responsabilidades</h3><div class="check-grid educator-duty-grid"><div class="check"><span><b>Referencia cotidiana</b><small>Acolher, construir vinculo e perceber demandas.</small></span>${eduGoalInfo('acolhimento_educativo')}</div><div class="check"><span><b>Planejamento e relatorio</b><small>Planejar, registrar execucao, avaliar e comprovar.</small></span>${eduGoalInfo('planejamento_oficina')}</div><div class="check"><span><b>Oficinas</b><small>Acompanhar turmas, presencas e faltas.</small></span>${eduGoalInfo('acompanhamento_oficina')}</div><div class="check"><span><b>CFDH</b><small>Organizar acoes estruturais e transversais.</small></span>${eduGoalInfo('cfdh_estrutural')}</div><div class="check"><span><b>Encaminhar demandas</b><small>Direcionar ao profissional/equipe competente.</small></span>${eduGoalInfo('encaminhamento_interno')}</div></div></div><div class="card"><h3>Registrar contribuicao</h3><div class="educator-action-grid">${btns.map(([k,l])=>`<button class="btn" data-educator-new="${k}">${l} ${eduGoalInfo(k)}</button>`).join('')}</div><div class="notice" style="margin-top:14px"><b>Limite:</b> PVida, PTrampo, Outras Demandas e Acompanhamento tecnico permanecem exclusivos da Equipe Tecnica.</div></div></div><div class="card" style="margin-top:16px"><h3>Contribuicoes do mes</h3>${records.map(rec=>{const y=youth.find(x=>x.id===rec.youth_id),w=workshops.find(x=>x.id===rec.workshop_id);return `<div class="agenda-row"><div><b>${esc(eduTypeLabel(rec.record_type))} ${eduGoalInfo(rec.record_type)}</b><span>${fmtDate(rec.record_date)}${y?' · '+esc(y.preferred_name||y.full_name):''}${w?' · '+esc(w.name):''}</span><span>${esc(rec.title||rec.description||'')}</span></div>${state.user?.id===rec.educator_user_id||state.user?.role==='coordenacao_geral'?`<button class="btn ghost" data-educator-delete="${rec.id}">Excluir</button>`:''}</div>`}).join('')||'<div class="empty">Nenhuma contribuicao neste mes.</div>'}</div>`;
}
