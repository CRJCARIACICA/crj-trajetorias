async function pageEducatorV2(){
  if(!permitted('educador_area'))return '<div class="notice danger">Seu perfil nao possui acesso a Area do Educador.</div>';
  const rr=route(),month=rr.params.get('month')||currentMonth(),view=rr.params.get('view')||'responsabilidades';
  const team=await listTeam(),educators=team.filter(x=>x.role==='educador'&&x.active),selectedId=state.user?.role==='educador'?state.user.id:(rr.params.get('user')||educators[0]?.id||''),selected=educators.find(x=>x.id===selectedId)||state.user;
  const [records,contrib,workshops,youth,plans,reports,receipts]=await Promise.all([listEducatorRecords(month,selectedId||null),educatorContributionSummary(month,selectedId||null),listWorkshops(),listYouth(''),listEducatorPlans(month,selectedId||null),listEducatorReports(selectedId||null),listEducatorReferralReceipts()]);
  const sum=t=>contrib.filter(x=>x.event_type===t).reduce((a,x)=>a+Number(x.quantity||0),0),reportByPlan=new Map(reports.map(x=>[x.plan_id,x])),myWorkshops=workshops.filter(w=>w.educator_user_id===selectedId),visibleWorkshops=myWorkshops.length?myWorkshops:workshops.filter(w=>w.active);
  const filter=`<div class="card educator-filter"><div class="form-grid">${state.user?.role==='educador'?`<div class="field"><label>Educador</label><div class="input read-only">${esc(selected?.display_name||'Meu perfil')}</div></div>`:`<div class="field"><label>Educador</label><select data-educator-filter-user>${educators.map(e=>`<option value="${e.id}" ${e.id===selectedId?'selected':''}>${esc(e.display_name)}</option>`).join('')}</select></div>`}<div class="field"><label>Mes</label><input class="input" type="month" data-educator-filter-month value="${esc(month)}"></div></div></div>`;
  const head=`<div class="page-head"><div><h2>Area do Educador Social</h2><p>Planejar → executar → registrar → comprovar → avaliar. As metas sao alimentadas a partir do trabalho realizado.</p></div>${view==='responsabilidades'?`<button class="btn primary" data-educator-new="acolhimento_educativo">+ Registrar contribuicao ${eduGoalInfo('acolhimento_educativo')}</button>`:''}</div>${filter}${eduTabs(view,month,state.user?.role==='educador'?'':selectedId)}${documentHeaderSettingsCard(state.documentSettings||{},permitted('document_settings'),'educador')}`;
  if(view==='planejamento')return head+`<div class="page-head educator-subhead"><div><h3>Planejamento</h3><p>Baseado nos campos do relatorio: atividade, descricao, nucleo/eixo, publico, duracao, equipe, parceiros, mobilizacao e acoes.</p></div><button class="btn primary" data-new-educator-plan>+ Novo planejamento ${eduGoalInfo('planejamento_oficina')}</button></div><div class="grid two">${plans.map(p=>`<div class="card"><div class="actions"><span class="pill">${esc(eduPlanLabel(p.plan_type))}</span><span class="pill info">${esc(p.status)}</span></div><h3>${esc(p.activity_title)}</h3><p>${esc(p.description_objective||'')}</p><div class="muted">${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</div><div class="actions" style="margin-top:12px">${reportByPlan.has(p.id)?'<span class="pill success">Relatorio registrado</span>':`<button class="btn secondary" data-report-plan="${p.id}">Relatar execucao</button>`}${eduGoalInfo('planejamento_'+p.plan_type)}</div></div>`).join('')||'<div class="card empty">Nenhum planejamento registrado.</div>'}</div>`;
  if(view==='relatorios')return head+`<div class="page-head educator-subhead"><div><h3>Relatorios</h3><p>O relatorio responde ao planejamento e registra somente o que efetivamente ocorreu.</p></div></div><div class="grid two">${plans.map(p=>{const rep=reportByPlan.get(p.id);return `<div class="card"><span class="pill">${esc(eduPlanLabel(p.plan_type))}</span><h3>${esc(p.activity_title)}</h3><p class="muted">Planejado: ${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</p>${rep?`<div class="notice ${rep.execution_status==='nao_realizado'?'danger':rep.execution_status==='parcial'?'warn':'success'}"><b>${esc(rep.execution_status)}</b> · ${rep.actual_participants??0} participantes · ${rep.actual_duration_hours??0}h<br>${esc(rep.actual_description||'')}</div>`:`<button class="btn primary" data-report-plan="${p.id}">Responder relatorio</button>`}</div>`}).join('')||'<div class="card empty">Crie um planejamento antes do relatorio.</div>'}</div>`;
  if(view==='oficinas')return head+`<div class="page-head educator-subhead"><div><h3>Oficinas e presencas</h3><p>Presencas, participantes nao cadastrados, alertas e inscricao formal ficam concentrados por oficina.</p></div></div><div class="grid three">${visibleWorkshops.map(w=>`<div class="card"><span class="pill success">${w.active?'Ativa':'Inativa'}</span><h3>${esc(w.name)}</h3><p class="muted">${esc(w.category||'')} · ${esc(w.days||'')}</p><button class="btn primary" data-nav="oficina/${w.id}">Acompanhar turma ${eduGoalInfo('presenca')}</button></div>`).join('')||'<div class="card empty">Nenhuma oficina disponivel.</div>'}</div>`;
  if(view==='encaminhamentos'){const rm=new Map(records.map(x=>[x.id,x])),pm=new Map(team.map(x=>[x.id,x])),out=receipts.filter(x=>rm.has(x.educator_record_id));return head+`<div class="page-head educator-subhead"><div><h3>Encaminhamentos e ciencia</h3><p>Cada destinatario recebe a mensagem detalhada. Ao visualizar, a ciencia retorna automaticamente.</p></div></div><div class="card">${out.map(x=>{const rec=rm.get(x.educator_record_id),p=pm.get(x.recipient_user_id);return `<div class="referral-status-row"><div><b>${esc(rec?.title||eduTypeLabel(rec?.record_type))}</b><span>${esc(p?.display_name||'Colaborador')} · ${esc(roleLabel(p?.role))}</span></div><span class="pill ${x.status==='ciente'?'success':'warn'}">${x.status==='ciente'?'Ciente em '+fmtDateTime(x.viewed_at):'Aguardando ciencia'}</span></div>`}).join('')||'<div class="empty">Nenhum encaminhamento do periodo.</div>'}</div>`}
  const btns=[['acolhimento_educativo','Acolhimento educativo'],['demanda_identificada','Demanda identificada'],['encaminhamento_interno','Encaminhamento interno'],['acompanhamento_oficina','Acompanhamento de oficina'],['mediacao_convivencia','Mediacao / convivencia'],['ficaadica_orientacao','#FicaAdica / orientacao'],['trampo_labpoca','Trampo Coletivo / LABPoca'],['mobilizacao','Mobilizacao'],['evento_programacao','Evento / programacao'],['mostra','Mostra'],['estudo_caso','Estudo de caso'],['outra_acao_educativa','Outra acao']];
  return head+`<div class="grid cards" style="margin-top:16px"><div class="card kpi"><div class="label">Horas de aula</div><div class="value">${sum('aula').toFixed(1)}</div><div class="meta">${eduGoalInfo('aula')}</div></div><div class="card kpi"><div class="label">Presencas</div><div class="value">${sum('presenca')}</div><div class="meta">${eduGoalInfo('presenca')}</div></div><div class="card kpi"><div class="label">Registros educativos</div><div class="value">${records.length}</div></div></div><div class="grid two" style="margin-top:16px"><div class="card"><h3>Responsabilidades</h3><div class="check-grid educator-duty-grid"><div class="check"><span><b>Referencia cotidiana</b><small>Acolher, construir vinculo e perceber demandas.</small></span>${eduGoalInfo('acolhimento_educativo')}</div><div class="check"><span><b>Planejamento e relatorio</b><small>Planejar, registrar execucao, avaliar e comprovar.</small></span>${eduGoalInfo('planejamento_oficina')}</div><div class="check"><span><b>Oficinas</b><small>Acompanhar turmas, presencas e faltas.</small></span>${eduGoalInfo('acompanhamento_oficina')}</div><div class="check"><span><b>CFDH</b><small>Organizar acoes estruturais e transversais.</small></span>${eduGoalInfo('cfdh_estrutural')}</div><div class="check"><span><b>Encaminhar demandas</b><small>Direcionar ao profissional/equipe competente.</small></span>${eduGoalInfo('encaminhamento_interno')}</div></div></div><div class="card"><h3>Registrar contribuicao</h3><div class="educator-action-grid">${btns.map(([k,l])=>`<button class="btn" data-educator-new="${k}">${l} ${eduGoalInfo(k)}</button>`).join('')}</div><div class="notice" style="margin-top:14px"><b>Limite:</b> PVida, PTrampo, Outras Demandas e Acompanhamento tecnico permanecem exclusivos da Equipe Tecnica.</div></div></div><div class="card" style="margin-top:16px"><h3>Contribuicoes do mes</h3>${records.map(rec=>{const y=youth.find(x=>x.id===rec.youth_id),w=workshops.find(x=>x.id===rec.workshop_id);return `<div class="agenda-row"><div><b>${esc(eduTypeLabel(rec.record_type))} ${eduGoalInfo(rec.record_type)}</b><span>${fmtDate(rec.record_date)}${y?' · '+esc(y.preferred_name||y.full_name):''}${w?' · '+esc(w.name):''}</span><span>${esc(rec.title||rec.description||'')}</span></div>${state.user?.id===rec.educator_user_id||state.user?.role==='coordenacao_geral'?`<button class="btn ghost" data-educator-delete="${rec.id}">Excluir</button>`:''}</div>`}).join('')||'<div class="empty">Nenhuma contribuicao neste mes.</div>'}</div>`;
}
