/* LABPOCA_WORKSPACE_ACTIONS_20261022 */
(()=>{
const L=()=>window.CRJLabpoca,D=()=>window.CRJLabpocaData,esc=v=>L()?.esc(v)||String(v??''),close=()=>document.querySelector('.lp-modal-bg')?.remove();
function style(){if(document.querySelector('#lp-modal-css'))return;const s=document.createElement('style');s.id='lp-modal-css';s.textContent='.lp-modal-bg{position:fixed;inset:0;background:rgba(5,24,19,.68);display:grid;place-items:center;padding:12px;z-index:2147483000}.lp-modal{width:min(760px,96vw);max-height:94vh;overflow:auto;background:#fff;border-radius:18px;padding:18px;box-shadow:0 24px 80px rgba(0,0,0,.3)}.lp-question{border:1px solid #dde8e4;border-radius:12px;padding:10px;margin:9px 0}.lp-question label{display:block;font-weight:700;font-size:12px;margin-bottom:6px}';document.head.appendChild(s)}
function toast(m,type='success'){const e=document.createElement('div');e.className=`pill ${type}`;e.textContent=m;Object.assign(e.style,{position:'fixed',right:'20px',bottom:'20px',zIndex:'2147483647',padding:'12px 16px'});document.body.appendChild(e);setTimeout(()=>e.remove(),3500)}
const ratings=v=>`<option value="">Selecione</option>${[[1,'1 · Péssimo'],[2,'2 · Ruim'],[3,'3 · Regular'],[4,'4 · Bom'],[5,'5 · Ótimo']].map(([n,t])=>`<option value="${n}" ${Number(v)===n?'selected':''}>${t}</option>`).join('')}`;
function survey(yid,area){style();const l=L(),d=D();if(!l||!d)return;const a=l.sub(d,area),y=d.ym.get(yid),old=a.re.find(x=>x.youth_id===yid),bg=document.createElement('div');bg.className='lp-modal-bg';bg.innerHTML=`<div class="lp-modal"><h3>Pesquisa mensal · ${esc(l.area(area))}</h3><p class="lp-muted">Jovem: <b>${esc(y?.preferred_name||y?.full_name||'')}</b> · ${esc(d.m)}</p><form><div class="field"><label>Oficina de referência</label><select class="input" name="workshop_id" required>${a.w.map(w=>`<option value="${w.id}" ${old?.workshop_id===w.id?'selected':''}>${esc(w.name)}</option>`).join('')}</select></div>${[['tech_score','Os equipamentos e recursos tecnológicos disponíveis atenderam às necessidades da atividade?'],['materials_score','Os materiais e insumos disponíveis foram adequados para a atividade?'],['availability_score','A quantidade e disponibilidade dos recursos foram suficientes?'],['condition_score','O estado de conservação e funcionamento dos recursos foi satisfatório?'],['overall_score','De forma geral, qual seu nível de satisfação com os recursos tecnológicos e materiais do LABPOCA/LABSTUDIO?']].map(([n,q])=>`<div class="lp-question"><label>${esc(q)}</label><select class="input" name="${n}" required>${ratings(old?.[n])}</select></div>`).join('')}<div class="field"><label>O que funcionou bem?</label><textarea class="input" name="positive_notes">${esc(old?.positive_notes||'')}</textarea></div><div class="field"><label>O que precisa melhorar?</label><textarea class="input" name="improvement_notes">${esc(old?.improvement_notes||'')}</textarea></div><div class="field"><label>Observações / sugestões</label><textarea class="input" name="comments">${esc(old?.comments||'')}</textarea></div><div class="lp-actions"><button class="btn secondary" type="button" data-lp-close>Cancelar</button><button class="btn primary" type="submit">Salvar pesquisa</button></div></form></div>`;document.body.appendChild(bg);bg.onclick=e=>{if(e.target===bg||e.target.closest('[data-lp-close]'))close()};bg.querySelector('form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,fd=new FormData(f),b=f.querySelector('button[type=submit]');b.disabled=true;try{const c=await l.db(),r=await c.rpc('labpoca_staff_submit_satisfaction',{p_month:d.s,p_area:area,p_workshop_id:String(fd.get('workshop_id')),p_youth_id:yid,p_tech_score:Number(fd.get('tech_score')),p_materials_score:Number(fd.get('materials_score')),p_availability_score:Number(fd.get('availability_score')),p_condition_score:Number(fd.get('condition_score')),p_overall_score:Number(fd.get('overall_score')),p_positive_notes:String(fd.get('positive_notes')||''),p_improvement_notes:String(fd.get('improvement_notes')||''),p_comments:String(fd.get('comments')||'')});if(r.error)throw r.error;close();toast('Pesquisa salva e indicador 6.6 recalculado.');document.querySelector('.content').dataset.lpKey='';l.render()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false}}}
function access(wid){style();const l=L(),d=D();if(!l||!d)return;const w=d.w.find(x=>x.id===wid),old=d.cr.find(x=>x.workshop_id===wid),slug=s=>String(s||'labpoca').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,35),login=old?.login||slug(w?.name),url=new URL('./demanda.html',location.href.split('#')[0]);url.searchParams.set('mode','labpoca');url.searchParams.set('month',d.m);url.searchParams.set('login',login);const bg=document.createElement('div');bg.className='lp-modal-bg';bg.innerHTML=`<div class="lp-modal"><h3>Acesso remoto · ${esc(w?.name||'Oficina')}</h3><p class="lp-muted">O jovem usa login e senha da oficina. O CPF valida a participação sem expor a lista de participantes.</p><form><div class="field"><label>Login da oficina</label><input class="input" name="login" value="${esc(login)}" minlength="4" required></div><div class="field"><label>${old?'Nova senha (deixe em branco para manter)':'Senha da oficina'}</label><input class="input" name="password" type="password" minlength="4" ${old?'':'required'}></div><div class="field"><label>Link mensal</label><input class="input" readonly data-lp-link value="${esc(url.toString())}"></div><div class="lp-actions"><button class="btn secondary" type="button" data-lp-copy>Copiar link</button><button class="btn secondary" type="button" data-lp-close>Fechar</button><button class="btn primary" type="submit">Salvar acesso</button></div></form></div>`;document.body.appendChild(bg);const f=bg.querySelector('form'),link=f.querySelector('[data-lp-link]');f.querySelector('[name=login]').oninput=e=>{const u=new URL(link.value);u.searchParams.set('login',e.target.value);link.value=u.toString()};f.querySelector('[data-lp-copy]').onclick=()=>navigator.clipboard.writeText(link.value).then(()=>toast('Link copiado.')).catch(()=>toast('Não foi possível copiar automaticamente.','danger'));bg.onclick=e=>{if(e.target===bg||e.target.closest('[data-lp-close]'))close()};f.onsubmit=async e=>{e.preventDefault();const fd=new FormData(f),b=f.querySelector('button[type=submit]');b.disabled=true;try{const c=await l.db(),r=await c.rpc('labpoca_set_workshop_access',{p_workshop_id:wid,p_login:String(fd.get('login')||''),p_password:String(fd.get('password')||''),p_active:true});if(r.error)throw r.error;close();toast('Acesso da pesquisa atualizado.');document.querySelector('.content').dataset.lpKey='';l.render()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false}}}
async function download(id,format){const l=L();if(!l)throw Error('LABPOCA indisponível.');const [c,{CONFIG}]=await Promise.all([l.db(),import('./config.js')]),{data:{session}}=await c.auth.getSession();if(!session)throw Error('Sessão expirada.');const r=await fetch(`${CONFIG.supabaseUrl}/functions/v1/crj-export-document`,{method:'POST',headers:{Authorization:`Bearer ${session.access_token}`,apikey:CONFIG.supabasePublishableKey,'Content-Type':'application/json'},body:JSON.stringify({submission_id:id,format})});if(!r.ok){let m='Falha ao gerar arquivo.';try{m=(await r.json()).error||m}catch{}throw Error(m)}const blob=await r.blob(),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=`LABPOCA_${l.mon()}.${format}`;a.click();setTimeout(()=>URL.revokeObjectURL(u),10000)}
document.addEventListener('change',e=>{const m=e.target.closest?.('[data-lp-month]');if(m)location.hash=`labpoca?month=${m.value}`});
document.addEventListener('click',async e=>{const l=L(),d=D();if(!l||!d)return;const s=e.target.closest?.('[data-lp-survey]');if(s){e.preventDefault();survey(s.dataset.lpSurvey,s.dataset.lpArea);return}const a=e.target.closest?.('[data-lp-access]');if(a){e.preventDefault();access(a.dataset.lpAccess);return}if(e.target.closest?.('[data-lp-refresh]')){document.querySelector('.content').dataset.lpKey='';l.render();return}const rep=e.target.closest?.('[data-lp-report]');if(rep){rep.disabled=true;try{const c=await l.db(),r=await c.rpc('labpoca_generate_monthly_report',{p_month:d.s});if(r.error)throw r.error;toast('Resultado mensal gerado como evidência.');await download(r.data,'pdf');document.querySelector('.content').dataset.lpKey='';l.render()}catch(err){toast(err.message||String(err),'danger')}finally{rep.disabled=false}return}if(e.target.closest?.('[data-lp-pdf]'))download(d.mr.submission_id,'pdf').catch(x=>toast(x.message,'danger'));if(e.target.closest?.('[data-lp-docx]'))download(d.mr.submission_id,'docx').catch(x=>toast(x.message,'danger'))},true);
style();
})();