import { CONFIG } from './config.js';
import { roleLabel } from './permissions.js';

const LS = 'crj_trajetorias_demo_v1';
let supabase = null;
let mode = 'mock';

function uid(prefix='id'){ return `${prefix}_${crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2)}`; }
function now(){ return new Date().toISOString(); }
function monthKey(d=new Date()){ return new Date(d).toISOString().slice(0,7); }
function durationHours(start,end){ if(!start || !end) return 0; const [sh,sm]=start.split(':').map(Number); const [eh,em]=end.split(':').map(Number); return Math.max(0, ((eh*60+em)-(sh*60+sm))/60); }

