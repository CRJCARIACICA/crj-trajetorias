      ...s.attendance.filter(x=>x.present && monthKey(x.date)===mk).map(x=>x.youth_id)
    ]).size;
    const follow=new Set(s.followups.filter(x=>monthKey(x.date)===mk).map(x=>x.youth_id)).size;
    return {youthActive,served,followups:follow,workshops:s.workshops.filter(x=>x.active).length,forms:s.forms.length};
  }
