/* LABPOCA_WORKSHOP_MANAGER_20261022 */
(()=>{
const ALLOWED=new Set(['coordenacao_geral','coordenacao_articulacao','educador','assistente_social','psicologo','terapeuta_ocupacional']);
let timer=null,userCache=null;
const esc=(v='')=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const params=()=>new URLSearchParams((location.hash.split('?')[1]||''));
const month=()=>params().get('month')||new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).format(new Date());
const monthDate=()=>month()+'-01';
const label=a=>a==='estetica'?'Estética (LABPOCA)':a==='audiovisual'?'Audiovisual (LABSTUDIO)':'Não vinculada';
function css(){if(document.querySelector('#lp-workshop-manager-css'))return;const s=document.createElement('style');s.id='lp-workshop-manager-css';s.textContent='.lp-manager-bg{position:fixed;inset:0;z-index:2147483000;background:rgba(5,24,19,.68);display:grid;place-items:center;padding:14px}.lp-manager{width:min(880px,97vw);max-height:94vh;overflow:auto;background:#fff;border-radius:18px;box-shadow:0 24px 80px rgba(0,0,0,.3)}.lp-manager-head,.lp-manager-body,.lp-manager-actions{padding:18px}.lp-manager-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border-bottom:1px solid #e2ebe7}.lp-manager-body{display:grid;gap:9px}.lp-manager-row{display:grid;grid-template-columns:minmax(220px,1fr) minmax(240px,.8fr);gap:12px;align-items:center;border:1px solid #dce8e3;border-radius:13px;padding:12px;background:#fbfdfc}.lp-manager-row b,.lp-manager-row small{display:block}.lp-manager-row small{color:#66776f;margin-top:3px}.lp-manager-actions{position:sticky;bottom:0;background:#fff;border-top:1px solid #e2ebe7;display:flex;justify-content:flex-end;gap:8px}.lp-manager-status{display:inline-flex;margin-top:6px;padding:3px 7px;border-radius:999px;background:#edf4f1;color:#315e53;font-size:10px;font-weight:700}.lp-manager-status.on{background:#def3e9;color:#165b49}@media(max-width:680px){.lp-manager-row{grid-template-columns:1fr}.lp-manager-actions{flex-wrap:wrap}.lp-manager-actions .btn{flex:1}}';document.head.appendChild(s)}
function toast(msg,type='success'){const d=document.createElement('div');d.className=`pill ${type}`;d.textContent=msg;Object.assign(d.style,{position:'fixed',right:'20px',bottom:'20px',zIndex:'2147483647',padding:'12px 16px',boxShadow:'0 12px 35px rgba(0,0,0,.22)'});document.body.appendChild(d);setTimeout(()=>d.remove(),3600)}
function close(){document.querySelector('.lp-manager-bg')?.remove()}
async function me(){if(userCache)return userCache;try{const m=await import('./api.js?v=20261016-hours1'),s=await m.getSession();userCache=s?.user||null}catch{}return userCache}
async function picker(){
  css();const lp=window.CRJLabpoca;if(!lp)throw Error('Área LABPOCA ainda não carregou.');
  const c=await lp.db(),q=await c.rpc('list_workshops_for_month',{p_month:monthDate()});if(q.error)throw q.error;
  const rows=(q.data||[]).filter(x=>x.active!==false).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'pt-BR'));
  const bg=document.createElement('div');bg.className='lp-manager-bg';
  bg.innerHTML=`<div class="lp-manager"><div class="lp-manager-head"><div><h3 style="margin:0">Configurar oficinas nos LABs</h3><p class="lp-muted" style="margin:5px 0 0">Competência ${esc(month().split('-').reverse().join('/'))}. Defina aqui qual oficina integra o <b>LABPOCA (Estética)</b>, o <b>LABSTUDIO (Audiovisual)</b> ou nenhum LAB.</p></div><button class="btn ghost" type="button" data-lpm-close>✕</button></div><div class="lp-manager-body">${rows.length?rows.map(w=>{const area=(w.is_labpoca===true||String(w.is_labpoca)==='true')?String(w.labpoca_area||''):'';return `<div class="lp-manager-row" data-lpm-row="${esc(w.id)}" data-lpm-original="${esc(area)}"><div><b>${esc(w.name||'Oficina')}</b><small>${esc(w.category||'Sem categoria')}</small><span class="lp-manager-status ${area?'on':''}" data-lpm-status>${esc(label(area))}</span></div><div class="field"><label>Vinculação ao LAB</label><select class="input" data-lpm-area><option value="" ${!area?'selected':''}>Não vinculada</option><option value="estetica" ${area==='estetica'?'selected':''}>Estética (LABPOCA)</option><option value="audiovisual" ${area==='audiovisual'?'selected':''}>Audiovisual (LABSTUDIO)</option></select></div></div>`}).join(''):'<div class="empty">Nenhuma oficina ativa nesta competência.</div>'}</div><div class="lp-manager-actions"><button class="btn secondary" type="button" data-lpm-close>Cancelar</button><button class="btn primary" type="button" data-lpm-save ${rows.length?'':'disabled'}>Salvar configurações</button></div></div>`;
  document.body.appendChild(bg);
  bg.addEventListener('change',e=>{const s=e.target.closest('[data-lpm-area]');if(!s)return;const row=s.closest('[data-lpm-row]'),st=row?.querySelector('[data-lpm-status]');if(st){st.textContent=label(s.value);st.classList.toggle('on',Boolean(s.value))}});
  bg.addEventListener('click',async e=>{if(e.target===bg||e.target.closest('[data-lpm-close]')){close();return}const save=e.target.closest('[data-lpm-save]');if(!save)return;const changed=[...bg.querySelectorAll('[data-lpm-row]')].filter(r=>r.querySelector('[data-lpm-area]')?.value!==r.dataset.lpmOriginal);if(!changed.length){close();toast('Nenhuma alteração na vinculação das oficinas.');return}save.disabled=true;save.textContent='Salvando...';try{for(const row of changed){const area=row.querySelector('[data-lpm-area]').value||null,r=await c.rpc('labpoca_set_workshop_classification',{p_workshop_id:row.dataset.lpmRow,p_month:monthDate(),p_area:area});if(r.error)throw r.error}close();toast('Vinculações LABPOCA/LABSTUDIO atualizadas.');const content=document.querySelector('.content');if(content)content.dataset.lpKey='';await lp.render()}catch(err){toast(err.message||String(err),'danger');save.disabled=false;save.textContent='Salvar configurações'}});
}
async function enhance(){if(!location.hash.startsWith('#labpoca'))return;const u=await me();if(!u||!ALLOWED.has(u.role))return;const page=document.querySelector('[data-lp-page]');if(!page||page.querySelector('[data-lpm-open]'))return;const head=page.querySelector('.lp-head');if(!head)return;let actions=head.querySelector('.lp-actions');if(!actions){actions=document.createElement('div');actions.className='lp-actions';head.appendChild(actions)}const b=document.createElement('button');b.type='button';b.className='btn secondary';b.dataset.lpmOpen='1';b.textContent='◈ Configurar oficinas nos LABs';actions.prepend(b);b.addEventListener('click',async()=>{b.disabled=true;try{await picker()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false}})}
function schedule(){clearTimeout(timer);timer=setTimeout(()=>enhance().catch(()=>{}),70)}
new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('hashchange',schedule);window.addEventListener('crj:route-rendered',schedule);window.addEventListener('crj:features-ready',schedule);css();schedule();
})();