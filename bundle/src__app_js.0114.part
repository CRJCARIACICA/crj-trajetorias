/* LABPOCA_WORKSHOP_EXTERNAL_LINKER_20261022 */
(()=>{
const ALLOWED=new Set(['coordenacao_geral','coordenacao_articulacao','educador','administrativo']);
let apiP=null,timer=null,userCache=null;
const api=()=>apiP||(apiP=import('./api.js?v=20261016-hours1'));
const esc=(v='')=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const params=()=>new URLSearchParams((location.hash.split('?')[1]||''));
const month=()=>params().get('month')||new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).format(new Date());
const areaLabel=a=>a==='audiovisual'?'Audiovisual (LABSTUDIO)':a==='estetica'?'Estética (LABPOCA)':'Não vinculada';
async function me(){if(userCache)return userCache;try{const m=await api(),s=await m.getSession();userCache=s?.user||null}catch{}return userCache}
function css(){if(document.querySelector('#lp-workshop-linker-css'))return;const s=document.createElement('style');s.id='lp-workshop-linker-css';s.textContent='.lp-linker-modal-bg{position:fixed;inset:0;z-index:2147482900;background:rgba(6,26,21,.68);display:grid;place-items:center;padding:14px}.lp-linker-modal{width:min(760px,96vw);max-height:92vh;overflow:auto;background:#fff;border-radius:18px;box-shadow:0 26px 80px rgba(0,0,0,.28);padding:18px}.lp-linker-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.lp-linker-list{display:grid;gap:9px;margin-top:14px}.lp-linker-row{display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid #dce8e3;border-radius:13px;padding:12px;background:#fbfdfc}.lp-linker-row b,.lp-linker-row small{display:block}.lp-linker-row small{color:#65766f;margin-top:3px}.lp-linker-status{display:inline-flex;margin-top:6px;border-radius:999px;padding:3px 7px;background:#eef5f2;color:#315f54;font-size:10px;font-weight:700}.lp-linker-status.on{background:#dff3ea;color:#155a48}.lp-linker-empty{padding:18px;text-align:center;color:#71807b}.lp-linker-focus{animation:lpLinkPulse 1.2s ease 2}@keyframes lpLinkPulse{0%,100%{box-shadow:none}50%{box-shadow:0 0 0 5px rgba(11,107,88,.18)}}@media(max-width:640px){.lp-linker-row{align-items:stretch;flex-direction:column}.lp-linker-row .btn{width:100%}}';document.head.appendChild(s)}
function close(){document.querySelector('.lp-linker-modal-bg')?.remove()}
function toast(msg,type='danger'){const d=document.createElement('div');d.className=`pill ${type}`;d.textContent=msg;Object.assign(d.style,{position:'fixed',right:'20px',bottom:'20px',zIndex:'2147483647',padding:'12px 16px',boxShadow:'0 12px 35px rgba(0,0,0,.22)'});document.body.appendChild(d);setTimeout(()=>d.remove(),3400)}
async function picker(){css();const m=await api(),rows=(await m.listWorkshops()).filter(x=>x.active!==false).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'pt-BR')),bg=document.createElement('div');bg.className='lp-linker-modal-bg';bg.innerHTML=`<div class="lp-linker-modal"><div class="lp-linker-head"><div><h3 style="margin:0">Vincular oficina ao LABPOCA</h3><p class="muted" style="margin:5px 0 0">Competência ${esc(month().split('-').reverse().join('/'))}. Escolha a oficina. Em seguida serão abertas todas as configurações da oficina, incluindo o vínculo com Estética (LABPOCA) ou Audiovisual (LABSTUDIO).</p></div><button class="btn ghost" type="button" data-lp-link-close>✕</button></div><div class="lp-linker-list">${rows.length?rows.map(w=>{const on=w.is_labpoca===true||String(w.is_labpoca)==='true',label=on?areaLabel(w.labpoca_area):'Não vinculada ao LABPOCA';return `<div class="lp-linker-row"><div><b>${esc(w.name||'Oficina')}</b><small>${esc(w.category||'Sem categoria')}</small><span class="lp-linker-status ${on?'on':''}">${esc(label)}</span></div><button class="btn ${on?'secondary':'primary'}" type="button" data-lp-link-workshop="${esc(w.id)}">${on?'Alterar vínculo':'Vincular ao LABPOCA'}</button></div>`}).join(''):'<div class="lp-linker-empty">Nenhuma oficina disponível nesta competência.</div>'}</div></div>`;document.body.appendChild(bg);bg.addEventListener('click',e=>{if(e.target===bg||e.target.closest('[data-lp-link-close]')){close();return}const pick=e.target.closest('[data-lp-link-workshop]');if(!pick)return;const id=pick.dataset.lpLinkWorkshop,edit=[...document.querySelectorAll('[data-edit-workshop]')].find(x=>x.dataset.editWorkshop===id);if(!edit){toast('Não foi possível abrir a configuração desta oficina. Atualize a aba Oficinas e tente novamente.');return}close();edit.click();let tries=0;const focus=setInterval(()=>{tries++;const box=document.querySelector('[data-lp-workshop-class]');if(box){clearInterval(focus);box.classList.add('lp-linker-focus');box.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>box.classList.remove('lp-linker-focus'),2600)}else if(tries>20)clearInterval(focus)},90)})}
async function enhance(){if(!location.hash.startsWith('#oficinas'))return;const view=params().get('view');if(view&&view!=='oficinas')return;const u=await me();if(!u||!ALLOWED.has(u.role))return;const anchor=document.querySelector('[data-action="new-workshop"]');if(!anchor)return;if(document.querySelector('[data-lp-external-workshop-link]'))return;const b=document.createElement('button');b.type='button';b.className='btn secondary';b.dataset.lpExternalWorkshopLink='1';b.innerHTML='◈ Vincular oficina ao LABPOCA';const host=anchor.closest('.actions')||anchor.parentElement;host?.appendChild(b);b.addEventListener('click',async()=>{b.disabled=true;try{await picker()}catch(err){toast(err.message||String(err))}finally{b.disabled=false}})}
function schedule(){clearTimeout(timer);timer=setTimeout(()=>enhance().catch(()=>{}),80)}
new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});
window.addEventListener('hashchange',schedule);window.addEventListener('crj:route-rendered',schedule);window.addEventListener('crj:features-ready',schedule);css();schedule();
})();