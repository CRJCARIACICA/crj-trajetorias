/* LABPOCA_CFDH_INTEGRATION_20261022 */
(()=>{
let cache={planId:null,plan:null,workshops:[],links:new Map()},busy=false,timer=null;
const esc=(v='')=>window.CRJLabpoca?.esc(v)||String(v??''),params=()=>new URLSearchParams((location.hash.split('?')[1]||'')),planId=()=>location.hash.startsWith('#cfdh')?(params().get('plan')||''):'';
function css(){if(document.querySelector('#lp-cfdh-css'))return;const s=document.createElement('style');s.id='lp-cfdh-css';s.textContent='[data-cfdh-program-option="labpoca"]{display:none!important}.lp-cfdh-link{margin-top:12px;padding:12px;border:1px solid #acd2c5;border-radius:12px;background:#f5faf8}.lp-cfdh-link .field{margin-top:8px}.lp-cfdh-link small{display:block;color:#60746d;margin-top:5px}.lp-cfdh-note{font-size:11px;color:#526a62;line-height:1.45;padding:8px 9px;border-radius:9px;background:#eaf4f0;margin-top:8px}';document.head.appendChild(s)}
async function context(force=false){const id=planId(),lp=window.CRJLabpoca;if(!id||!lp)return null;if(!force&&cache.planId===id)return cache;const c=await lp.db(),pq=await c.from('educator_plans').select('id,plan_type,planned_start').eq('id',id).single();if(pq.error)throw pq.error;const month=String(pq.data.planned_start||'').slice(0,7)||lp.mon(),wq=await c.rpc('list_workshops_for_month',{p_month:month+'-01'});if(wq.error)throw wq.error;const workshops=(wq.data||[]).filter(w=>w.active!==false&&(w.is_labpoca===true||String(w.is_labpoca)==='true')&&['estetica','audiovisual'].includes(w.labpoca_area));const ids=[...document.querySelectorAll('#cfdh-plan-editor [data-cfdh-action-card]')].map(x=>x.dataset.actionId).filter(Boolean);let links=[];if(ids.length){const lq=await c.from('labpoca_cfdh_links').select('*').in('action_id',ids);if(!lq.error)links=lq.data||[]}cache={planId:id,plan:pq.data,workshops,links:new Map(links.map(x=>[x.action_id,x]))};return cache}
function cleanLegacyStatus(card){const st=card.querySelector('[data-cfdh-program-status]'),trampo=card.querySelector('[data-cfdh-program="trampo_coletivo"]');if(st&&/satisfa/i.test(st.textContent||'')&&!trampo?.checked)st.textContent='Vínculos metodológicos salvos. O vínculo LABPOCA demonstra contribuição ao desenvolvimento do espaço; a Meta 6.6 é calculada exclusivamente pela pesquisa mensal de satisfação.'}
async function save(actionId,workshopId,contributes){const lp=window.CRJLabpoca;if(!lp||!actionId||!workshopId)return;const c=await lp.db(),r=await c.rpc('labpoca_set_cfdh_link',{p_action_id:actionId,p_workshop_id:workshopId,p_contributes:Boolean(contributes)});if(r.error)throw r.error;const row=Array.isArray(r.data)?r.data[0]:r.data;cache.links.set(actionId,row);window.dispatchEvent(new CustomEvent('crj:labpoca-cfdh-linked',{detail:row}))}
function renderCard(card,ctx){const aid=card.dataset.actionId;if(!aid)return;let box=card.querySelector('[data-lp-cfdh-link]');if(!box){box=document.createElement('div');box.className='lp-cfdh-link';box.dataset.lpCfdhLink='1';card.appendChild(box)}const old=ctx.links.get(aid)||null,isTrans=ctx.plan.plan_type==='cfdh_transversal',normal=card.querySelector('[data-cfdh-action-workshop]'),normalId=normal?.value||'',normalW=ctx.workshops.find(w=>w.id===normalId),refId=isTrans?normalId:(box.querySelector('[data-lp-ref-workshop]')?.value||old?.workshop_id||''),refW=ctx.workshops.find(w=>w.id===refId),same=Boolean(old&&old.workshop_id===refId),contributes=same&&old.contributes===true;
if(isTrans&&!normalW){box.innerHTML='<b>Desenvolvimento do LABPOCA</b><div class="lp-cfdh-note">Esta ação está vinculada a uma oficina que não está classificada como LABPOCA/LABSTUDIO. Quando a oficina selecionada for LABPOCA, a pergunta de contribuição aparecerá automaticamente.</div>';normal?.addEventListener('change',schedule,{once:true});cleanLegacyStatus(card);return}
const refSelect=isTrans?'':`<div class="field"><label>Oficina LABPOCA de referência</label><select class="input" data-lp-ref-workshop><option value="">Selecione</option>${ctx.workshops.map(w=>`<option value="${w.id}" ${refId===w.id?'selected':''}>${esc(w.name)} · ${esc(window.CRJLabpoca.area(w.labpoca_area))}</option>`).join('')}</select><small>No CFDH estrutural, este vínculo é metodológico e não transforma a ação em aula da oficina.</small></div>`;
const question=refW?`<div class="field"><label>Este CFDH contribui para o desenvolvimento do ${esc(window.CRJLabpoca.area(refW.labpoca_area))}?</label><select class="input" data-lp-contributes><option value="false" ${!contributes?'selected':''}>Não</option><option value="true" ${contributes?'selected':''}>Sim</option></select></div><div class="lp-cfdh-note"><b>Regra:</b> esta resposta vincula a ação ao painel LABPOCA e às evidências de desenvolvimento do espaço. <b>Não alimenta o indicador 6.6.</b> A Meta 6.6 recebe somente as respostas da pesquisa mensal de satisfação.</div>`:'<div class="lp-cfdh-note">Selecione uma oficina LABPOCA/LABSTUDIO para informar se esta ação contribui para o desenvolvimento do espaço.</div>';
box.innerHTML=`<b>Desenvolvimento do LABPOCA</b>${refSelect}${question}`;
const rs=box.querySelector('[data-lp-ref-workshop]');if(rs)rs.onchange=async e=>{const wid=e.target.value;if(!wid){box.querySelector('[data-lp-contributes]')?.remove();return}try{await save(aid,wid,false);renderCard(card,ctx)}catch(err){console.warn('Falha ao salvar referência LABPOCA do CFDH:',err)}};
const cs=box.querySelector('[data-lp-contributes]');if(cs)cs.onchange=async e=>{const wid=isTrans?(normal?.value||''):(box.querySelector('[data-lp-ref-workshop]')?.value||refId);if(!wid)return;cs.disabled=true;try{await save(aid,wid,e.target.value==='true');renderCard(card,ctx)}catch(err){console.warn('Falha ao salvar contribuição LABPOCA do CFDH:',err);cs.value=contributes?'true':'false'}finally{cs.disabled=false}};
if(normal&&!normal.dataset.lpCfdhWatch){normal.dataset.lpCfdhWatch='1';normal.addEventListener('change',async()=>{const wid=normal.value,w=ctx.workshops.find(x=>x.id===wid);if(w){try{await save(aid,wid,false);ctx.links.set(aid,{action_id:aid,workshop_id:wid,area:w.labpoca_area,contributes:false})}catch(err){console.warn(err)}}schedule()})}cleanLegacyStatus(card)}
async function enhance(){if(busy||!location.hash.startsWith('#cfdh')||!window.CRJLabpoca)return;busy=true;try{css();const ctx=await context();if(!ctx)return;document.querySelectorAll('#cfdh-plan-editor [data-cfdh-action-card]').forEach(card=>renderCard(card,ctx))}catch(err){console.warn('Integração LABPOCA/CFDH:',err)}finally{busy=false}}
function schedule(){clearTimeout(timer);timer=setTimeout(()=>enhance(),70)}new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('hashchange',()=>{cache={planId:null,plan:null,workshops:[],links:new Map()};schedule()});window.addEventListener('crj:route-rendered',schedule);window.addEventListener('crj:features-ready',schedule);css();schedule();
})();