d);font-size:12px;margin:16px 0}.divider:before,.divider:after{content:"";height:1px;background:var(--line);flex:1}.modal-backdrop{position:fixed;inset:0;background:rgba(7,30,25,.48);z-index:50;display:grid;place-items:center;padding:20px}.modal{width:min(900px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:20px;padding:22px;box-shadow:0 30px 90px rgba(0,0,0,.22)}.modal-head{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:16px}.modal-head h3{margin:0}.empty{text-align:center;padding:34px 18px;color:var(--muted)}.metric-split{display:flex;gap:10px;font-size:12px;margin-top:8px}.metric-split span{padding:4px 8px;background:#f1f5f4;border-radius:999px}.badge-dot{width:8px;height:8px;border-radius:50%;background:var(--success);display:inline-block}.print-only{display:none}
@media (max-width:1100px){.grid.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:1fr 1fr}.app-shell{grid-template-columns:220px 1fr}}
@media (max-width:820px){.app-shell{display:block}.sidebar{position:static;height:auto}.nav{grid-template-columns:repeat(2,minmax(0,1fr))}.sidebar-footer{display:none}.topbar{position:static;padding:0 16px}.content{padding:18px}.grid.cards,.grid.two,.grid.three,.form-grid{grid-template-columns:1fr}.page-head{display:block}.actions{margin-top:14px}.timeline-item{grid-template-columns:1fr}.timeline-body{border-left:0;border-top:2px solid #d8e5e1;padding:10px 0}.indicator{grid-template-columns:1fr}.check-grid{grid-template-columns:1fr}}
@media print{.sidebar,.topbar,.no-print,.actions{display:none!important}.app-shell{display:block}.content{padding:0}.card{box-shadow:none}.print-only{display:block}}


.auth-switcher{display:grid;grid-template-columns:1fr 1fr;gap:6px;background:#eef4f2;border:1px solid var(--line);border-radius:14px;padding:5px;margin:18px 0 14px}
.auth-switch{border:0;background:transparent;border-radius:10px;padding:10px 12px;font-weight:800;color:var(--muted)}
.auth-switch.active{background:#fff;color:var(--brand);box-shadow:0 4px 14px rgba(15,72,59,.08)}
.auth-register-only{display:none!important}

.timeline-edit .timeline-body{border-left-color:#f1c75b}
.audit-hover{position:relative;display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#fff6d8;border:1px solid #efd181;color:#7a5600;font-size:12px;font-weight:800;cursor:help;outline:none}
.audit-hover:hover,.audit-hover:focus{background:#ffefbd}
.audit-tooltip{position:absolute;left:0;bottom:calc(100% + 10px);z-index:40;width:min(380px,80vw);display:none;background:#17322c;color:#fff;border-radius:14px;padding:13px 14px;box-shadow:0 18px 45px rgba(13,43,36,.28);font-weight:500;text-align:left}
.audit-tooltip:after{content:"";position:absolute;left:18px;top:100%;border:7px solid transparent;border-top-color:#17322c}
.audit-hover:hover .audit-tooltip,.audit-hover:focus .audit-tooltip,.audit-hover:focus-within .audit-tooltip{display:block}
.audit-tooltip-title,.audit-tooltip-meta,.audit-tooltip-list{display:block}
.audit-tooltip-title{font-weight:800;font-size:13px;margin-bottom:5px}
.audit-tooltip-meta{font-size:11px;color:#cfe0dc;margin-top:2px}
.audit-tooltip-list{margin-top:9px;display:grid;gap:7px}
.audit-tooltip-change{display:grid;gap:2px;padding-top:6px;border-top:1px solid rgba(255,255,255,.14);font-size:11px}
.audit-tooltip-change b{font-size:11px}
.audit-tooltip-change span{color:#e7f0ed;line-height:1.35}
@media(max-width:820px){.audit-tooltip{position:fixed;left:16px;right:16px;bottom:18px;width:auto;max-height:55vh;overflow:auto}.audit-tooltip:after{display:none}}


.agenda-filter{display:grid;grid-template-columns:1.1fr 1.5fr 1fr .9fr .9fr auto;gap:12px;align-items:end}
.agenda-week{display:grid;grid-template-columns:repeat(7,minmax(150px,1fr));gap:10px;overflow:auto;padding-bottom:4px}
.agenda-day{min-width:150px;border:1px solid var(--line);border-radius:14px;background:#fbfdfc;padding:10px}
.agenda-day-head{display:flex;justify-content:space-between;gap:8px;align-items:center;padding-bottom:8px;border-bottom:1px solid var(--line);margin-bottom:8px}
.agenda-day-head b{font-size:12px}.agenda-day-head span{font-size:11px;color:var(--muted)}
.agenda-block{display:grid;gap:3px;padding:8px;border-radius:10px;margin-top:7px;border:1px solid var(--line);background:#fff}
.agenda-block small{font-size:10px;color:var(--muted)}.agenda-block b{font-size:12px}.agenda-block span{font-size:10px;color:var(--muted)}
.agenda-block.event{border-left:4px solid var(--brand)}.agenda-block.exception{background:#fff8e7;border-color:#efd48e;border-left:4px solid #d4a017}
.agenda-empty{font-size:11px;color:#92a39e;padding:10px 2px;text-align:center}
.slot-list{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.slot-chip{border:1px solid #cfe3dd;background:#f2faf7;color:var(--ink);border-radius:12px;padding:9px 11px;text-align:left;display:grid;gap:3px}
.slot-chip:hover{border-color:var(--brand);background:#e7f5f0}.slot-chip b{font-size:11px}.slot-chip span{font-size:10px;color:var(--muted)}
.agenda-row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.agenda-row:last-child{border-bottom:0}.agenda-row>div{display:grid;gap:3px}.agenda-row b{font-size:12px}.agenda-row span{font-size:11px;color:var(--muted)}
.request-card{border:1px solid var(--line);border-radius:13px;padding:12px;margin-top:10px;background:#fff}
.request-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.request-top>div{display:grid;gap:3px}.request-top b{font-size:13px}.request-top span:not(.pill){font-size:11px;color:var(--muted)}
.request-time{font-size:12px;font-weight:700;color:#345a51;margin:9px 0}
.notification-list{display:grid}.notification-item{display:grid;gap:3px;padding:10px 0;border-bottom:1px solid var(--line)}.notification-item:last-child{border-bottom:0}
.notification-item b{font-size:12px}.notification-item span{font-size:11px;color:var(--muted)}.notification-item small{font-size:10px;color:#8c9b97}.notification-item.unread{border-left:3px solid var(--brand);padding-left:10px;background:#f7fbfa}
@media(max-width:1200px){.agenda-filter{grid-template-columns:repeat(3,minmax(0,1fr))}.agenda-week{grid-template-columns:repeat(7,170px)}}
@media(max-width:820px){.agenda-filter{grid-template-columns:1fr 1fr}.agenda-filter .actions{grid-column:1/-1}.agenda-week{grid-template-columns:repeat(7,220px)}.request-top{display:grid}.slot-chip{width:100%}}


.request-history{margin:9px 0;border-top:1px dashed var(--line);padding-top:8px}
.request-history summary{cursor:pointer;font-size:11px;font-weight:800;color:var(--brand)}
.request-history>div{display:grid;gap:2px;padding:7px 0;border-bottom:1px solid #edf2f0}
.request-history>div:last-child{border-bottom:0}.request-history b{font-size:10px}.request-history span{font-size:10px;color:var(--muted)}


.three-time{grid-template-columns:1.2fr .9fr .9fr}
.tech-select-grid .check span{display:grid;gap:2px}
.tech-select-grid .check small{font-size:10px;color:var(--muted)}
.request-targets{display:grid;gap:8px;margin:10px 0}
.request-target{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:flex-start;padding:10px;border:1px solid var(--line);border-radius:11px;background:#f9fbfa}
.request-target>div:first-child{display:grid;gap:3px}
.request-target b{font-size:12px}
.request-target span{font-size:10px;color:var(--muted)}
.request-target .pill{color:inherit}
.request-justification{padding-top:4px;color:#6b5320!important}
.agenda-event-open{width:100%;text-align:left;font-family:inherit;cursor:pointer}
.agenda-event-open:hover{border-color:var(--brand);box-shadow:0 4px 14px rgba(14,65,54,.08)}
.event-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.event-detail-grid>div{display:grid;gap:3px;padding:10px;border:1px solid var(--line);border-radius:11px;background:#f9fbfa}
.event-detail-grid small{font-size:10px;color:var(--muted)}
.event-detail-grid b{font-size:12px}
.tech-chip-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.event-history{display:grid;gap:6px}
.event-history>div{display:grid;gap:2px;padding:8px 0;border-bottom:1px solid var(--line)}
.event-history>div:last-child{border-bottom:0}
.event-history b{font-size:11px}.event-history span{font-size:10px;color:var(--muted)}
@media(max-width:820px){.three-time,.event-detail-grid{grid-template-columns:1fr}.request-target{grid-template-columns:1fr}.request-target .actions{margin-top:6px}}


.educator-action-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.educator-duty-grid{display:grid;grid-template-columns:1fr;gap:8px}
.educator-duty-grid .check{align-items:flex-start}
.educator-duty-grid .check span{display:grid;gap:3px}
.educator-duty-grid small{color:var(--muted);line-height:1.35}
.educator-filter .read-only{display:flex;align-items:center;min-height:42px;background:#f7f9f8}
@media(max-width:820px){.educator-action-grid{grid-template-columns:1fr}}


.goal-help{position:relative;display:inline-flex;align-items:center;justify-content:center;width:19px;height:19px;border-radius:50%;font-size:12px;font-weight:800;background:#e7f2ef;color:var(--brand);vertical-align:middle;margin-left:4px;cursor:help;flex:0 0 auto}
.goal-tooltip{display:none;position:absolute;z-index:90;left:50%;top:calc(100% + 8px);transform:translateX(-50%);width:min(360px,80vw);padding:12px;background:#102e29;color:#fff;border-radius:12px;box-shadow:0 14px 36px rgba(0,0,0,.24);text-align:left;font-weight:400}
.goal-tooltip>b{display:block;font-size:12px;margin-bottom:8px}
.goal-tooltip>span{display:grid;gap:2px;padding:7px 0;border-top:1px solid rgba(255,255,255,.13)}
.goal-tooltip>span:first-of-type{border-top:0}
.goal-tooltip strong{font-size:11px}.goal-tooltip small{font-size:10px;line-height:1.35;color:#dce9e6}
.goal-tooltip em{display:block;margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,.13);font-size:10px;color:#ffe5a8}
.goal-help:hover .goal-tooltip{display:block}.goal-help:not(:hover) .goal-tooltip{display:none!important}
.educator-tabs{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0 16px}
.educator-tabs a{padding:9px 12px;border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--text);background:#fff;font-size:12px;font-weight:700}
.educator-tabs a.active{background:var(--brand);border-color:var(--brand);color:#fff}
.educator-subhead{margin-top:16px}
.person-search{position:relative}
.person-search-results{position:absolute;z-index:70;left:0;right:0;top:calc(100% + 4px);max-height:320px;overflow:auto;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 35px rgba(0,0,0,.16)}
.person-search-results.hidden,.person-selected.hidden{display:none}
.person-result{width:100%;border:0;border-bottom:1px solid var(--line);background:#fff;padding:10px 12px;text-align:left;display:grid;gap:2px;cursor:pointer}
.person-result:hover{background:#f0f7f5}.person-result:last-child{border-bottom:0}
.person-result b{font-size:12px}.person-result span{font-size:10px;color:var(--muted)}
.person-result.provisional{background:#fffaf0}
.person-selected{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:7px;padding:9px 10px;border:1px solid #b7d8d0;background:#f2fbf8;border-radius:10px}
.person-selected span{font-size:10px;color:var(--muted)}
.linklike{border:0;background:transparent;color:var(--brand);text-decoration:underline;cursor:pointer;padding:0}
.person-empty{padding:12px;color:var(--muted);font-size:11px}
.referral-status-row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}
.referral-status-row:last-child{border-bottom:0}.referral-status-row>div{display:grid;gap:3px}.referral-status-row span{font-size:10px;color:var(--muted)}
.signature-pad{border:1px dashed #91aaa4;border-radius:12px;background:#fff;touch-action:none;width:100%;height:180px}
.workshop-alert{padding:10px;border:1px solid #efd28b;background:#fff9e8;border-radius:11px;display:grid;gap:5px}
.workshop-roster-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}
.workshop-roster-row:last-child{border-bottom:0}
@media(max-width:820px){.goal-tooltip{left:auto;right:-10px;transform:none}.referral-status-row{align-items:flex-start;flex-direction:column}}


.checkin-page{min-height:100vh;display:grid;place-items:center;padding:24px;background:#f1f6f4}
.checkin-card{width:min(560px,100%);background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:0 20px 55px rgba(10,55,48,.12)}
.checkin-card h1{margin:14px 0 5px}
.checkin-results{display:grid;gap:7px;margin-top:10px}
.checkin-person{width:100%;display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid var(--line);background:#fff;border-radius:11px;padding:11px 12px;text-align:left;cursor:pointer}
.checkin-person:hover{border-color:var(--brand);background:#f2f9f7}
.checkin-person b{font-size:13px}.checkin-person span{font-size:11px;color:var(--muted)}
.hidden{display:none!important}

.notification-message{white-space:pre-line}
.referral-notification{border-left:3px solid var(--brand);padding-left:12px}


.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}
.choice-card{display:grid;gap:6px;text-align:left;padding:18px;border:1px solid var(--line);border-radius:14px;background:var(--card);cursor:pointer}
.choice-card:hover,.choice-card:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(11,91,76,.08)}
.choice-card b{font-size:1rem}.choice-card span{color:var(--muted);font-size:.9rem;line-height:1.4}
.checkin-step-head{display:flex;gap:12px;align-items:flex-start;margin:12px 0 16px}
.checkin-step-head h2{margin:0 0 2px}.checkin-step-head p{margin:0;color:var(--muted)}
.step-badge{width:32px;height:32px;display:grid;place-items:center;border-radius:999px;background:var(--primary);color:white;font-weight:700;flex:0 0 auto}
.checkin-back{margin-bottom:6px}
.selected-person{display:grid;gap:4px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#f8faf9}
.selected-person span{color:var(--muted);font-size:.9rem}
.public-signature{width:100%;height:180px;border:1px solid var(--line);border-radius:10px;background:white;touch-action:none}
.pending-fields{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.pending-fields span{padding:4px 8px;border-radius:999px;background:rgba(184,112,0,.10);font-size:.78rem}
.checkin-success{text-align:center;display:grid;gap:14px}
.success-mark{width:58px;height:58px;border-radius:999px;background:#e5f5ec;color:#137a46;display:grid;place-items:center;font-size:2rem;font-weight:700;margin:0 auto}
.session-presence-list{display:grid;gap:8px}
.session-presence-row{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.session-presence-row:last-child{border-bottom:0}
.session-presence-row>div:first-child{display:grid;gap:3px}
.session-presence-row span,.session-presence-row small{color:var(--muted)}
.session-presence-row.visitor{background:rgba(184,112,0,.035);padding-left:8px;padding-right:8px;border-radius:10px}
@media(max-width:760px){
  .choice-grid{grid-template-columns:1fr}
  .session-presence-row{align-items:flex-start;flex-direction:column}
}

.attendance-sheet-meta{display:grid;grid-template-columns:2fr 1.5fr 1.5fr 1fr 1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:10px}
.attendance-sheet-meta>div{padding:9px 10px;border-right:1px solid var(--line);display:grid;gap:3px}
.attendance-sheet-meta>div:last-child{border-right:0}
.attendance-sheet-meta b{font-size:.72rem;text-transform:uppercase;color:var(--muted)}
.attendance-sheet-meta span{font-weight:600}
.attendance-official-table th{white-space:nowrap;font-size:.75rem}
.sheet-signature{max-width:120px;max-height:42px;display:block;object-fit:contain}
.attendance-sheet-card .table-wrap{margin-top:6px}
@media(max-width:900px){
  .attendance-sheet-meta{grid-template-columns:1fr 1fr}
  .attendance-sheet-meta>div{border-bottom:1px solid var(--line)}
  .attendance-sheet-meta>div:nth-child(even){border-right:0}
}


/* Pré-visualização dos anexos oficiais da Metodologia dos CRJs */
.methodology-form-workspace{display:block}
.methodology-form-workspace.preview-open{display:grid;grid-template-columns:minmax(0,1fr) minmax(430px,.92fr);gap:18px;align-items:start}
.methodology-form-editor{min-width:0}
.methodology-preview-pane{display:none;min-width:0}
.methodology-form-workspace.preview-open .methodology-preview-pane{display:block;position:sticky;top:88px;max-height:calc(100vh - 112px);overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#edf1f0;box-shadow:var(--shadow)}
.methodology-preview-toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px 14px;background:white;border-bottom:1px solid var(--line)}
.methodology-preview-toolbar>div{display:grid;gap:2px}
.methodology-preview-toolbar span:not(.pill){font-size:11px;color:var(--muted)}
.methodology-preview-scroll{overflow:auto;max-height:calc(100vh - 170px);padding:18px}
.methodology-paper{width:100%;max-width:760px;margin:0 auto;background:white;color:#111;border:1px solid #d5d5d5;padding:28px 34px 36px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1.28;box-shadow:0 8px 30px rgba(0,0,0,.08)}
.methodology-paper-landscape{max-width:980px;padding:24px 28px 30px}
.methodology-annex-title{text-align:center;font-weight:700;font-size:12px;margin-bottom:22px}
.methodology-institutional-header{text-align:center;margin:0 auto 13px}
.methodology-institutional-header img{display:block;width:min(330px,80%);height:auto;margin:auto}
.methodology-inner-title{text-align:center;font-size:10px;font-weight:800;border:1px solid #222;padding:5px 7px;margin-bottom:-1px}
.methodology-row{border:1px solid #222;margin-top:-1px;min-height:28px;padding:7px 9px;display:block}
.methodology-row b{font-size:10px}
.methodology-inline-answer{margin-left:6px;white-space:pre-wrap}
.methodology-row-tall{min-height:70px}
.methodology-answer{margin-top:7px;white-space:pre-wrap;font-weight:400}
.methodology-lines{min-height:42px;background:repeating-linear-gradient(to bottom,transparent 0,transparent 17px,#c9c9c9 18px)}
.methodology-options{min-height:52px}
.methodology-option-list{display:grid;gap:3px;margin-top:6px;padding-left:14px}
.methodology-option-list span{display:block}
.methodology-section-title{text-align:center;font-weight:800;font-style:italic;border:1px solid #222;margin-top:-1px;padding:6px 8px;background:#fafafa}
.methodology-presence-table,.methodology-rating-table,.methodology-planning-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:9px}
.methodology-presence-table th,.methodology-presence-table td,.methodology-rating-table th,.methodology-rating-table td,.methodology-planning-table th,.methodology-planning-table td{border:1px solid #222;padding:5px 4px;vertical-align:middle;text-align:left}
.methodology-presence-table th,.methodology-rating-table th,.methodology-planning-table th{font-weight:800;text-align:center}
.methodology-presence-table th:nth-child(1){width:5%}
.methodology-presence-table th:nth-child(2){width:27%}
.methodology-presence-table th:nth-child(3){width:15%}
.methodology-presence-table th:nth-child(4){width:15%}
.methodology-presence-table th:nth-child(5){width:23%}
.methodology-presence-table th:nth-child(6){width:15%}
.methodology-presence-table td{height:31px}
.methodology-signature{display:block;max-width:92px;max-height:25px;object-fit:contain;margin:3px auto 0}
.methodology-system-note{font-size:8px;margin-top:8px;color:#555;border-top:1px solid #aaa;padding-top:5px}
.methodology-rating-table{margin-top:-1px}
.methodology-rating-table th:first-child,.methodology-rating-table td:first-child{width:48%;text-align:left}
.methodology-rating-table th:not(:first-child),.methodology-rating-table td:not(:first-child){text-align:center}
.methodology-planning-table{margin-top:-1px}
.methodology-planning-table td{height:34px}
.methodology-cut-line{max-width:760px;margin:20px auto;border-top:1px dashed #777;text-align:center;color:#777;font-size:9px;padding-top:3px}
.methodology-preview-modal{background:#edf1f0;padding:18px;border-radius:12px;max-height:76vh;overflow:auto}
.modal.modal-wide{width:min(1180px,94vw);max-width:none}
.attendance-sheet-card [data-sheet-preview]{background:#edf1f0;border:1px solid var(--line);border-radius:12px;padding:16px;overflow:auto}
.attendance-sheet-card [data-sheet-preview] .methodology-paper{min-width:780px}
@media(max-width:1180px){
  .methodology-form-workspace.preview-open{grid-template-columns:1fr}
  .methodology-form-workspace.preview-open .methodology-preview-pane{position:static;max-height:none}
  .methodology-preview-scroll{max-height:none}
}
@media(max-width:720px){
  .methodology-paper{padding:18px 16px;min-width:620px}
  .methodology-preview-scroll{padding:10px}
  .methodology-preview-pane{overflow:auto}
}


/* Gestão ampliada de oficinas */
.workshop-tabs{margin-bottom:18px}
.workshop-card-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;margin-top:12px}
.workshop-card-meta span{display:grid;gap:2px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:#fafcfb;font-size:.86rem}
.workshop-card-meta b{font-size:.68rem;text-transform:uppercase;color:var(--muted);letter-spacing:.04em}
.workshop-weekdays{grid-template-columns:repeat(4,minmax(0,1fr))}
.month-filter{min-width:190px}
.month-filter>span{display:block;font-size:.72rem;font-weight:700;margin-bottom:5px;color:var(--muted);text-transform:uppercase}
.notice.info{background:#f2f7ff;border-color:#cdddf8;color:#244d7d}
.notice.compact{padding:9px 12px}
.workshop-calendar-card{overflow:auto}
.calendar-week-head,.calendar-month-grid{display:grid;grid-template-columns:repeat(7,minmax(145px,1fr));min-width:1015px}
.calendar-week-head>div{padding:9px 8px;text-align:center;font-size:.75rem;font-weight:800;color:var(--muted);text-transform:uppercase;border-bottom:1px solid var(--line)}
.calendar-month-grid{border-left:1px solid var(--line);border-top:1px solid var(--line)}
.calendar-day{min-height:145px;padding:7px;background:#fff;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.calendar-day.outside{background:#f7f9f8;min-height:40px}
.calendar-day-number{font-size:.75rem;font-weight:800;color:var(--muted);margin-bottom:6px}
.calendar-event{display:grid;gap:2px;padding:7px;border:1px solid var(--line);border-radius:9px;margin-bottom:6px;background:#f8fbfa;font-size:.72rem}
.calendar-event b{font-size:.73rem}
.calendar-event span,.calendar-event small{color:var(--muted)}
.calendar-event.done{border-color:#b9e1ca;background:#f0faf4}
.calendar-event.cancelled{opacity:.6;text-decoration:line-through;background:#faf6f6}
.calendar-event.planned{border-left:3px solid var(--brand)}
.calendar-event-actions{display:flex;gap:4px;margin-top:3px;flex-wrap:wrap}
.calendar-event-actions .btn{padding:4px 6px;font-size:.66rem;border-radius:7px}
.instructor-dashboard{gap:18px}
.instructor-head{margin-bottom:10px}
.instructor-head h3{font-size:1.15rem;margin:0}
.instructor-head p{margin:4px 0 0;color:var(--muted)}
.instructor-kpis{grid-template-columns:repeat(4,minmax(0,1fr))}
.instructor-kpis .kpi{padding:12px;border:1px solid var(--line);border-radius:12px;background:#fafcfb}
.instructor-kpis .value{font-size:1.55rem}
.instructor-record-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}
.instructor-record-row:last-child{border-bottom:0}
.instructor-record-row>div{display:grid;gap:3px}
.instructor-record-row span{font-size:.82rem;color:var(--muted)}
.instructor-evidence-paper{max-width:960px}
.instructor-kpi-table td{text-align:center;font-weight:700}
@media(max-width:980px){
  .workshop-card-meta{grid-template-columns:1fr}
  .instructor-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .workshop-weekdays{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:620px){
  .instructor-kpis{grid-template-columns:1fr}
}


/* Planejamento mensal e cadastro dos oficineiros */
.instructor-registry{margin-bottom:16px}
.instructor-profile-card{display:grid;gap:6px;border:1px solid var(--line);border-radius:12px;padding:12px;background:#fafcfb}
.instructor-profile-card>div{display:grid;gap:2px}
.instructor-profile-card span,.instructor-profile-card small{color:var(--muted)}
.workshop-planning-grid{align-items:stretch}
.workshop-plan-summary{display:flex;flex-direction:column;gap:10px}
.workshop-plan-summary .actions:last-child{margin-top:auto}
.workshop-plan-lesson{display:grid;gap:12px}
.workshop-plan-lesson .page-head.compact{margin-bottom:0}
.workshop-plan-lesson h4{margin:5px 0 2px}
.workshop-plan-lesson p{margin:0;color:var(--muted)}
.workshop-plan-paper{max-width:1180px}
.workshop-plan-table{font-size:8px}
.workshop-plan-table th:nth-child(1){width:14%}
.workshop-plan-table th:nth-child(2){width:13%}
.workshop-plan-table th:nth-child(3){width:16%}
.workshop-plan-table th:nth-child(4){width:20%}
.workshop-plan-table th:nth-child(5){width:14%}
.workshop-plan-table th:nth-child(6){width:8%}
.workshop-plan-table th:nth-child(7){width:15%}
.workshop-plan-table td{vertical-align:top;min-height:48px;white-space:pre-wrap}
[data-workshop-plan-workspace].preview-open{grid-template-columns:minmax(0,1fr) minmax(520px,1.05fr)}
[data-workshop-plan-workspace] .methodology-preview-pane{position:sticky;top:88px}
@media(max-width:1180px){
  [data-workshop-plan-workspace].preview-open{grid-template-columns:1fr}
  [data-workshop-plan-workspace] .methodology-preview-pane{position:static}
}


/* Área da Equipe Técnica e papel timbrado */
.technical-progress-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
.technical-progress-card{display:grid;gap:10px}
.technical-progress-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.technical-progress-head>div{display:grid;gap:4px}
.technical-progress-head span{font-size:.75rem;color:var(--muted)}
.technical-progress-head b{font-size:1.35rem}
.progress-track{height:9px;border-radius:999px;background:#e7ece9;overflow:hidden}
.progress-fill{height:100%;border-radius:inherit;background:var(--brand);transition:width .25s ease}
.technical-prof-metrics{display:grid;grid-template-columns:auto auto;gap:2px 8px;align-items:center;text-align:right}
.technical-prof-metrics b{font-size:1rem}.technical-prof-metrics small{color:var(--muted)}
.technical-summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.technical-summary-grid>div{display:grid;gap:2px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fafcfb}
.technical-summary-grid b{font-size:1.4rem}.technical-summary-grid span{font-size:.78rem;color:var(--muted)}
.technical-youth-picker{max-height:270px;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:10px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;background:#fafcfb}
.technical-evidence-paper{max-width:1050px}
.technical-evidence-table{font-size:8.5px}
.technical-evidence-table th:nth-child(1){width:5%}.technical-evidence-table th:nth-child(2){width:10%}.technical-evidence-table th:nth-child(3){width:23%}.technical-evidence-table th:nth-child(4){width:34%}.technical-evidence-table th:nth-child(5){width:28%}
.document-header-settings{margin-top:16px}
.document-header-grid{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.1fr);gap:18px;align-items:start}
.document-header-preview{display:grid;gap:8px}
.document-header-preview>span{font-size:.72rem;font-weight:800;color:var(--muted);text-transform:uppercase}
.header-paper-preview{background:#fff;border:1px solid #d7ddda;border-radius:10px;padding:24px;box-shadow:0 8px 24px rgba(0,0,0,.06);min-height:190px}
.header-paper-preview img{display:block;max-width:100%;max-height:92px;object-fit:contain;margin:0 auto 20px}
.header-paper-lines{height:62px;background:repeating-linear-gradient(to bottom,transparent 0,transparent 16px,#e6e9e8 17px)}
.technical-target-settings{border-top:1px solid var(--line);padding-top:12px}
.technical-target-settings h4{margin:0 0 10px}
@media(max-width:1050px){
  .technical-progress-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .document-header-grid{grid-template-columns:1fr}
}
@media(max-width:700px){
  .technical-progress-grid{grid-template-columns:1fr}
  .technical-youth-picker{grid-template-columns:1fr}
  .technical-summary-grid{grid-template-columns:1fr}
}


/* Planejamentos de oficina sincronizados com a Área do Educador */
.educator-workshop-plans{gap:18px}
.educator-workshop-plan-card{display:grid;gap:14px}
.educator-planned-lists{display:grid;gap:8px}
.educator-planned-list-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid var(--line)}
.educator-planned-list-row:last-child{border-bottom:0}
.educator-planned-list-row>div:first-child{display:grid;gap:3px;min-width:0}
.educator-planned-list-row span,.educator-planned-list-row small{color:var(--muted)}
.educator-planned-list-row .actions{justify-content:flex-end;flex-wrap:wrap}
@media(max-width:820px){
  .educator-planned-list-row{align-items:flex-start;flex-direction:column}
  .educator-planned-list-row .actions{justify-content:flex-start}
}
