const EDU_GOALS={
  cadastro:{title:'Cadastro / Formulario Inicial',items:[['Meta 2 - Etapa 2.2','Comprova e qualifica o acolhimento com identificacao nominal.'],['Meta 2 - Etapa 2.3','Sustenta o acompanhamento do acesso do jovem ao CRJ.'],['Meta 9 - Etapa 9.1','Alimenta a base de monitoramento.']],note:'O cadastro sozinho nao e contado como atendimento.'},
  acolhimento_educativo:{title:'Acolhimento educativo',items:[['Meta 2 - Etapa 2.1','CONTABILIZA atendimento nominal quando ha jovem cadastrado.'],['Meta 2 - Etapa 2.2','Comprova acolhimento e orientacao.'],['Meta 2 - Etapa 2.3','Ajuda a demonstrar acesso efetivo ao CRJ.']]},
  demanda_identificada:{title:'Demanda identificada',items:[['Meta 2 - Etapa 2.2','Qualifica o acolhimento e a leitura da demanda.'],['Meta 4 - Etapas 4.2/4.3','Ajuda a direcionar o jovem ao nucleo/eixo adequado.'],['Meta 9 - Etapa 9.1','Gera dado de monitoramento das demandas.']]},
  encaminhamento_interno:{title:'Encaminhamento',items:[['Meta 2 - Etapa 2.2','Demonstra continuidade apos o acolhimento.'],['Meta 4 - Etapas 4.1/4.2/4.3','Conecta o jovem aos eixos adequados.'],['Meta 6 - Etapas 6.2/6.3/6.4','Da rastreabilidade a PVida, #FicaAdica e PTrampo quando aplicavel.']]},
  acompanhamento_oficina:{title:'Acompanhamento de oficina',items:[['Meta 4 - Etapas 4.2/4.3','Comprova integracao das atividades do nucleo/eixo.'],['Meta 6 - Etapa 6.1','Sustenta oficinas, participacoes e transversalidade do CFDH.'],['Meta 9 - Etapa 9.1','Produz informacao de monitoramento.']],note:'A carga horaria e contabilizada pela sessao/aula, nao por este registro narrativo.'},
  mediacao_convivencia:{title:'Mediacao e convivencia',items:[['Meta 2 - Etapa 2.2','Qualifica acolhimento e permanencia.'],['Meta 3 - Etapa 3.1','Contribui para regras de convivencia e gestao participativa.'],['Meta 4 - Etapa 4.2','Fortalece o Nucleo Socioafirmativo.']]},
  cfdh_estrutural:{title:'CFDH estrutural',items:[['Meta 6 - Etapa 6.1','CONTABILIZA carga horaria quando a execucao e registrada.'],['Meta 4 - Etapa 4.2','Integra Direitos Humanos ao Nucleo Socioafirmativo.']]},
  cfdh_transversal:{title:'CFDH transversal',items:[['Meta 6 - Etapa 6.1','CONTABILIZA os minutos lancados dentro da aula da oficina.'],['Meta 4 - Etapa 4.2','Comprova transversalidade de Direitos Humanos.']]},
  ficaadica_orientacao:{title:'#FicaAdica / orientacao',items:[['Meta 6 - Etapa 6.3','CONTABILIZA consulta/subsidio/orientacao.'],['Meta 2 - Etapa 2.3','Apoia acesso a oportunidades e direitos.']]},
  trampo_labpoca:{title:'Trampo Coletivo / LABPoca',items:[['Meta 4 - Etapa 4.3','Comprova acao de Economia Criativa, Trabalho e Renda.'],['Meta 6 - Etapas 6.5/6.6','Sustenta monitoramento de uso e satisfacao.']]},
  mobilizacao:{title:'Mobilizacao',items:[['Meta 2 - Etapas 2.2/2.3','Amplia acolhimento e acesso.'],['Meta 9 - Etapa 9.1','Gera evidencia territorial e de alcance.']]},
  evento_programacao:{title:'Evento / programacao',items:[['Meta 6 - Etapa 6.1','CONTABILIZA evento/programacao quando executado.'],['Meta 4 - Etapa 4.2','Comprova realizacao de atividades previstas.']]},
  mostra:{title:'Mostra',items:[['Meta 6 - Etapa 6.1','Comprova mostra semestral do CRJ.'],['Meta 4 - Etapa 4.5','Se Mostra de Profissoes, contribui para o indicador especifico.']]},
  estudo_caso:{title:'Estudo de caso',items:[['Meta 2 - Etapa 2.2','Qualifica resposta as demandas acolhidas.'],['Meta 6 - Etapa 6.2','Pode sustentar demandas eventuais do Fortalece Familia.']],note:'Nao substitui o registro tecnico especializado.'},
  aula:{title:'Aula / sessao',items:[['Meta 6 - Etapa 6.1','CONTABILIZA carga horaria mensal de oficinas/cursos.'],['Meta 4 - Etapa 4.6','Se profissionalizante, tambem alimenta a carga especifica.'],['Meta 6 - Etapa 6.1 CFDH','Minutos de CFDH transversal entram na carga semestral.']]},
  presenca:{title:'Presenca',items:[['Meta 2 - Etapa 2.1','CONTABILIZA atendimento/participacao nominal.'],['Meta 6 - Etapa 6.1','Comprova publico das oficinas/cursos.'],['Meta 4 - Etapa 4.6','Em oficina profissionalizante, ajuda a contar jovens unicos.']]},
  inscricao_oficina:{title:'Inscricao formal na oficina',items:[['Meta 6 - Etapa 6.1','Qualifica acompanhamento de frequencia e publico.'],['Meta 4 - Etapa 4.6','Em curso profissionalizante, sustenta comprovacao do publico.'],['Meta 9 - Etapa 9.1','Melhora rastreabilidade da trajetoria.']],note:'Inscricao nao vale como presenca.'},
  planejamento_oficina:{title:'Planejamento de oficina',items:[['Meta 4 - Etapas 4.2/4.3','Organiza atividade prevista no nucleo correspondente.'],['Meta 6 - Etapa 6.1','Prepara oficina, carga, presenca e evidencias.']],note:'PLANEJAMENTO: ainda nao contabiliza execucao.'},
  planejamento_cfdh_estrutural:{title:'Planejamento CFDH estrutural',items:[['Meta 6 - Etapa 6.1','Prepara carga e evidencia de CFDH estrutural.']],note:'Horas so entram quando a execucao e registrada.'},
  planejamento_cfdh_transversal:{title:'Planejamento CFDH transversal',items:[['Meta 6 - Etapa 6.1','Planeja o CFDH dentro da oficina.']],note:'A execucao e contada pelos minutos da sessao.'},
  planejamento_evento:{title:'Planejamento de evento',items:[['Meta 6 - Etapa 6.1','Prepara evento/programacao mensal.']],note:'O evento so contabiliza apos execucao.'}
};
function eduGoalInfo(key){const g=EDU_GOALS[key];if(!g)return '';return `<span class="goal-help" tabindex="0">ⓘ<span class="goal-tooltip"><b>${esc(g.title)}</b>${g.items.map(([m,d])=>`<span><strong>${esc(m)}</strong><small>${esc(d)}</small></span>`).join('')}${g.note?`<em>${esc(g.note)}</em>`:''}</span></span>`}
function eduTypeLabel(t){return ({acolhimento_educativo:'Acolhimento educativo',demanda_identificada:'Demanda identificada',encaminhamento_interno:'Encaminhamento interno',acompanhamento_oficina:'Acompanhamento de oficina',mediacao_convivencia:'Mediacao e convivencia',cfdh_estrutural:'CFDH estrutural',ficaadica_orientacao:'#FicaAdica / orientacao',trampo_labpoca:'Trampo Coletivo / LABPoca',mobilizacao:'Mobilizacao',evento_programacao:'Evento / programacao',mostra:'Mostra',estudo_caso:'Participacao em estudo de caso',outra_acao_educativa:'Outra acao educativa'}[t]||t)}
function eduPlanLabel(t){return ({oficina:'Oficina',cfdh_estrutural:'CFDH estrutural',cfdh_transversal:'CFDH transversal',evento:'Evento / programacao'}[t]||t)}
function eduNorm(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()}
function eduPersonSearchHtml(){return `<div class="person-search"><input class="input" type="search" data-person-search autocomplete="off" placeholder="Digite o nome do jovem..."><input type="hidden" name="youth_id"><input type="hidden" name="provisional_person_id"><div class="person-search-results hidden" data-person-results></div><div class="person-selected hidden" data-person-selected></div></div>`}
function bindEduPersonSearch(root,youth,provisional){const input=root.querySelector('[data-person-search]'),box=root.querySelector('[data-person-results]'),sel=root.querySelector('[data-person-selected]'),yi=root.querySelector('[name="youth_id"]'),pi=root.querySelector('[name="provisional_person_id"]');if(!input||!box)return;const render=()=>{const q=eduNorm(input.value).trim();if(!q){box.classList.add('hidden');box.innerHTML='';return}const ys=youth.filter(y=>eduNorm(`${y.preferred_name||''} ${y.full_name||''}`).includes(q)).slice(0,10),ps=provisional.filter(p=>eduNorm(p.full_name).includes(q)).slice(0,8);box.innerHTML=[...ys.map(y=>`<button type="button" class="person-result" data-kind="youth" data-id="${y.id}"><b>${esc(y.preferred_name||y.full_name)}</b><span>${esc(y.full_name)} · CPF final ${esc(String(y.cpf||'').replace(/\D/g,'').slice(-4)||'----')} · ${esc(y.neighborhood||'Bairro nao informado')}</span></button>`),...ps.map(p=>`<button type="button" class="person-result provisional" data-kind="provisional" data-id="${p.id}"><b>${esc(p.full_name)}</b><span>Participante provisório · ${esc(p.neighborhood||'Bairro nao informado')}</span></button>`)].join('')||'<div class="person-empty">Nenhum nome compativel.</div>';box.classList.remove('hidden');box.querySelectorAll('[data-kind]').forEach(b=>b.addEventListener('click',()=>{const kind=b.dataset.kind,id=b.dataset.id,p=kind==='youth'?youth.find(x=>x.id===id):provisional.find(x=>x.id===id);yi.value=kind==='youth'?id:'';pi.value=kind==='provisional'?id:'';input.value='';box.classList.add('hidden');sel.innerHTML=`<b>${esc(kind==='youth'?(p?.preferred_name||p?.full_name):p?.full_name)}</b><span>${kind==='youth'?'Cadastro CRJ':'Participante provisório'} · <button type="button" class="linklike" data-clear-person>trocar</button></span>`;sel.classList.remove('hidden');sel.querySelector('[data-clear-person]')?.addEventListener('click',()=>{yi.value='';pi.value='';sel.classList.add('hidden');input.focus()})}))};input.addEventListener('input',render);input.addEventListener('focus',render)}
function eduTabs(view,month,userId){const base=new URLSearchParams();if(month)base.set('month',month);if(userId)base.set('user',userId);return `<div class="educator-tabs">${[['responsabilidades','Responsabilidades'],['planejamento','Planejamento'],['relatorios','Relatorios'],['oficinas','Oficinas e presencas'],['encaminhamentos','Encaminhamentos']].map(([k,l])=>{const p=new URLSearchParams(base);p.set('view',k);return `<a class="${view===k?'active':''}" href="#educador?${p.toString()}">${l}</a>`}).join('')}</div>`}
