function educatorGoalV2(key){
  const M={
    cadastro:{t:'Cadastro / Formulário Inicial',i:[
      ['Meta 2 · Etapa 2.2','Comprova e qualifica o acolhimento com identificação do jovem.'],
      ['Meta 2 · Etapa 2.3','Sustenta o acompanhamento do acesso do jovem ao CRJ.'],
      ['Meta 9 · Etapa 9.1','Alimenta a base nominal e sociodemográfica de monitoramento.']
    ],n:'O cadastro identifica e qualifica o percurso; não deve ser contado sozinho como presença.'},
    acolhimento_educativo:{t:'Acolhimento educativo',i:[
      ['Meta 2 · Etapa 2.1','Contabiliza 1 atendimento nominal quando há jovem cadastrado.'],
      ['Meta 2 · Etapa 2.2','Comprova acolhimento e resposta inicial à demanda.'],
      ['Meta 2 · Etapa 2.3','Ajuda a demonstrar acesso efetivo ao CRJ.']
    ]},
    demanda_identificada:{t:'Demanda identificada',i:[
      ['Meta 2 · Etapa 2.2','Comprova acolhimento e leitura da demanda.'],
      ['Meta 4 · Etapas 4.2/4.3','Ajuda a direcionar o jovem ao núcleo/eixo adequado.'],
      ['Meta 9 · Etapa 9.1','Qualifica o monitoramento das demandas.']
    ]},
    encaminhamento_interno:{t:'Encaminhamento',i:[
      ['Meta 2 · Etapa 2.2','Demonstra continuidade após o acolhimento.'],
      ['Meta 4 · Etapas 4.1/4.2/4.3','Conecta o jovem aos eixos e responsáveis adequados.'],
      ['Meta 6 · Etapas 6.2/6.3/6.4','Dá rastreabilidade a PVida, #FicaAdica e PTrampo quando pertinente.']
    ]},
    acompanhamento_oficina:{t:'Acompanhamento de oficina',i:[
      ['Meta 4 · Etapas 4.2/4.3','Comprova execução e integração das atividades do núcleo/eixo.'],
      ['Meta 6 · Etapa 6.1','Sustenta oficinas, participação e transversalidade do CFDH.'],
      ['Meta 9 · Etapa 9.1','Produz informação de monitoramento da oferta.']
    ],n:'A carga horária da oficina é contabilizada pela aula/sessão, evitando dupla contagem.'},
    mediacao_convivencia:{t:'Mediação e convivência',i:[
      ['Meta 2 · Etapa 2.2','Qualifica acolhimento, permanência e convivência.'],
      ['Meta 3 · Etapa 3.1','Contribui para regras de convivência e gestão participativa.']
    ]},
    ficaadica_orientacao:{t:'#FicaAdica / orientação',i:[
      ['Meta 6 · Etapa 6.3','Contabiliza consulta/subsídio/orientação.'],
      ['Meta 2 · Etapa 2.3','Ajuda o jovem a acessar oportunidades e direitos.']
    ]},
    trampo_labpoca:{t:'Trampo Coletivo / LABPoca',i:[
      ['Meta 4 · Etapa 4.3','Comprova ações de Economia Criativa, Trabalho e Renda.'],
      ['Meta 6 · Etapas 6.5/6.6','Sustenta monitoramento de uso e satisfação.']
    ]},
    mobilizacao:{t:'Mobilização',i:[
      ['Meta 2 · Etapas 2.2/2.3','Amplia acolhimento e acesso das juventudes.'],
      ['Meta 9 · Etapa 9.1','Gera evidência territorial e de alcance.']
    ]},
    evento_programacao:{t:'Evento / programação',i:[
      ['Meta 6 · Etapa 6.1','Contabiliza evento/programação mensal quando a execução é registrada.'],
      ['Meta 4 · Etapa 4.2','Comprova ações do núcleo socioafirmativo.']
    ]},
    mostra:{t:'Mostra',i:[
      ['Meta 6 · Etapa 6.1','Comprova a mostra semestral do CRJ.'],
      ['Meta 4 · Etapa 4.5','Se for Mostra de Profissões, colabora com o indicador específico.']
    ]},
    estudo_caso:{t:'Estudo de caso',i:[
      ['Meta 2 · Etapa 2.2','Qualifica a resposta às demandas acolhidas.'],
      ['Meta 6 · Etapa 6.2','Pode sustentar acompanhamento de demandas eventuais.']
    ],n:'A participação do educador não substitui o registro técnico especializado.'},
    planejamento_oficina:{t:'Planejamento de oficina',i:[
      ['Meta 4 · Etapas 4.2/4.3','Organiza atividade prevista no núcleo correspondente.'],
      ['Meta 6 · Etapa 6.1','Prepara oficina, carga horária, presença e evidências.']
    ],n:'Planejamento não contabiliza execução.'},
    planejamento_cfdh_estrutural:{t:'Planejamento CFDH estrutural',i:[
      ['Meta 6 · Etapa 6.1','Prepara a carga de CFDH estrutural e sua evidência.']
    ],n:'As horas entram somente no relatório de execução.'},
    planejamento_cfdh_transversal:{t:'Planejamento CFDH transversal',i:[
      ['Meta 6 · Etapa 6.1','Planeja a inserção de Direitos Humanos dentro da oficina.']
    ],n:'A execução entra pelos minutos de CFDH registrados na sessão.'},
    planejamento_evento:{t:'Planejamento de evento',i:[
      ['Meta 6 · Etapa 6.1','Prepara evento/programação e meios de verificação.']
    ],n:'Só contabiliza após a execução.'},
    aula:{t:'Aula / sessão de oficina',i:[
      ['Meta 6 · Etapa 6.1','Contabiliza carga horária mensal das oficinas/cursos.'],
      ['Meta 4 · Etapa 4.6','Se profissionalizante, alimenta a carga e o público específicos.'],
      ['Meta 6 · Etapa 6.1 · CFDH','Minutos de CFDH transversal alimentam a carga semestral.']
    ]},
    presenca:{t:'Presença em oficina',i:[
      ['Meta 2 · Etapa 2.1','Contabiliza atendimento/participação nominal do jovem no mês.'],
      ['Meta 6 · Etapa 6.1','Comprova público de oficinas e cursos.'],
      ['Meta 4 · Etapa 4.6','Em atividade profissionalizante, ajuda a comprovar jovens atendidos.']
    ]},
    inscricao_oficina:{t:'Inscrição formal na oficina',i:[
      ['Meta 6 · Etapa 6.1','Qualifica frequência e público das oficinas.'],
      ['Meta 9 · Etapa 9.1','Melhora rastreabilidade da trajetória.']
    ],n:'A inscrição não conta como presença; a presença é registrada em cada aula.'}
  };
  return M[key]||null;
}

function goalInfoV2(key){
  const g=educatorGoalV2(key); if(!g)return '';
  return '<span class="goal-help" tabindex="0">ⓘ<span class="goal-tooltip"><b>'+esc(g.t)+'</b>'+
    g.i.map(x=>'<span><strong>'+esc(x[0])+'</strong><small>'+esc(x[1])+'</small></span>').join('')+
    (g.n?'<em>'+esc(g.n)+'</em>':'')+'</span></span>';
}

function educatorTypeLabelV2(t){
  return ({acolhimento_educativo:'Acolhimento educativo',demanda_identificada:'Demanda identificada',
    encaminhamento_interno:'Encaminhamento interno',acompanhamento_oficina:'Acompanhamento de oficina',
    mediacao_convivencia:'Mediação e convivência',ficaadica_orientacao:'#FicaAdica / orientação',
    trampo_labpoca:'Trampo Coletivo / LABPoca',mobilizacao:'Mobilização',
    evento_programacao:'Evento / programação',mostra:'Mostra',estudo_caso:'Estudo de caso',
    outra_acao_educativa:'Outra ação educativa'})[t]||t;
}

function planLabelV2(t){return ({oficina:'Oficina',cfdh_estrutural:'CFDH estrutural',cfdh_transversal:'CFDH transversal',evento:'Evento / programação'})[t]||t}

function personSearchMarkupV2(){
  return '<div class="person-search"><input class="input" type="search" data-person-search autocomplete="off" placeholder="Digite o nome...">'+
    '<input type="hidden" name="youth_id"><input type="hidden" name="provisional_person_id">'+
    '<div class="person-search-results hidden" data-person-results></div><div class="person-selected hidden" data-person-selected></div></div>';
}

function bindPersonSearchV2(root,youth,provisional){
  const input=root.querySelector('[data-person-search]'),box=root.querySelector('[data-person-results]'),selected=root.querySelector('[data-person-selected]');
  const youthId=root.querySelector('[name="youth_id"]'),provId=root.querySelector('[name="provisional_person_id"]');
  if(!input||!box)return;
  const norm=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
  const update=()=>{
    const q=norm(input.value).trim();
    if(!q){box.classList.add('hidden');box.innerHTML='';return}
    const ys=youth.filter(y=>norm((y.preferred_name||'')+' '+(y.full_name||'')).includes(q)).slice(0,10);
    const ps=provisional.filter(p=>norm(p.full_name).includes(q)).slice(0,8);
    box.innerHTML=ys.map(y=>'<button type="button" class="person-result" data-kind="youth" data-id="'+y.id+'"><b>'+esc(y.preferred_name||y.full_name)+'</b><span>'+esc(y.full_name)+' · CPF final '+esc((String(y.cpf||'').replace(/\D/g,'').slice(-4)||'----'))+' · '+esc(y.neighborhood||'Bairro não informado')+'</span></button>').join('')+
      ps.map(p=>'<button type="button" class="person-result provisional" data-kind="provisional" data-id="'+p.id+'"><b>'+esc(p.full_name)+'</b><span>Participante provisório · '+esc(p.neighborhood||'Bairro não informado')+'</span></button>').join('')+
      ((!ys.length&&!ps.length)?'<div class="person-empty">Nenhum nome compatível.</div>':'');
    box.classList.remove('hidden');
    box.querySelectorAll('[data-kind]').forEach(b=>b.addEventListener('click',()=>{
      const isYouth=b.dataset.kind==='youth',id=b.dataset.id,p=isYouth?youth.find(x=>x.id===id):provisional.find(x=>x.id===id);
      youthId.value=isYouth?id:'';provId.value=isYouth?'':id;input.value='';box.classList.add('hidden');
      selected.innerHTML='<b>'+esc(isYouth?(p?.preferred_name||p?.full_name):p?.full_name)+'</b><span>'+(isYouth?'Cadastro CRJ':'Participante provisório')+' · <button type="button" class="linklike" data-person-clear>trocar</button></span>';
      selected.classList.remove('hidden');
      selected.querySelector('[data-person-clear]')?.addEventListener('click',()=>{youthId.value='';provId.value='';selected.classList.add('hidden');input.focus()});
    }));
  };
  input.addEventListener('input',update);input.addEventListener('focus',update);
}

async function pageEducatorV2(){
  if(!permitted('educador_area'))return '<div class="notice danger">Seu perfil não possui acesso à Área do Educador.</div>';
  const r=route(),month=r.params.get('month')||currentMonth(),view=r.params.get('view')||'responsabilidades';
  const team=await listTeam(),educators=team.filter(x=>x.role==='educador'&&x.active);
  const selectedId=state.user?.role==='educador'?state.user.id:(r.params.get('user')||educators[0]?.id||'');
  const selected=educators.find(x=>x.id===selectedId)||state.user;
  const [records,contrib,workshops,youth,plans,reports,receipts]=await Promise.all([
    listEducatorRecords(month,selectedId||null),educatorContributionSummary(month,selectedId||null),listWorkshops(),listYouth(''),
    listEducatorPlans(month,selectedId||null),listEducatorReports(selectedId||null),listEducatorReferralReceipts()
  ]);
  const sum=t=>contrib.filter(x=>x.event_type===t).reduce((a,x)=>a+Number(x.quantity||0),0);
  const reportByPlan=new Map(reports.map(x=>[x.plan_id,x]));
  const base=new URLSearchParams();base.set('month',month);if(state.user?.role!=='educador'&&selectedId)base.set('user',selectedId);
  const tabs=[['responsabilidades','Responsabilidades'],['planejamento','Planejamento'],['relatorios','Relatórios'],['oficinas','Oficinas e presenças'],['encaminhamentos','Encaminhamentos']]
    .map(x=>{const p=new URLSearchParams(base);p.set('view',x[0]);return '<a class="'+(view===x[0]?'active':'')+'" href="#educador?'+p.toString()+'">'+x[1]+'</a>'}).join('');
  const filter='<div class="card educator-filter"><div class="form-grid">'+
    (state.user?.role==='educador'?'<div class="field"><label>Educador</label><div class="input read-only">'+esc(selected?.display_name||'Meu perfil')+'</div></div>':
      '<div class="field"><label>Educador</label><select data-educator-filter-user>'+educators.map(e=>'<option value="'+e.id+'" '+(e.id===selectedId?'selected':'')+'>'+esc(e.display_name)+'</option>').join('')+'</select></div>')+
    '<div class="field"><label>Mês</label><input class="input" type="month" data-educator-filter-month value="'+esc(month)+'"></div></div></div>';
  const head='<div class="page-head"><div><h2>Área do Educador Social</h2><p>Planejar → executar → registrar → comprovar → avaliar. Os balões ⓘ mostram como cada ação colabora com Metas e Etapas.</p></div></div>'+filter+'<div class="educator-tabs">'+tabs+'</div>';

  if(view==='planejamento'){
    return head+'<div class="page-head educator-subhead"><div><h3>Planejamentos</h3><p>Estrutura baseada no relatório: atividade, descrição, núcleo/eixo, público, duração, equipe, parceiros, mobilização e ações previstas.</p></div><button class="btn primary" data-new-educator-plan>+ Novo planejamento '+goalInfoV2('planejamento_oficina')+'</button></div>'+
      '<div class="grid two">'+(plans.map(p=>'<div class="card"><div class="actions"><span class="pill">'+esc(planLabelV2(p.plan_type))+'</span><span class="pill info">'+esc(p.status)+'</span></div><h3>'+esc(p.activity_title)+'</h3><p>'+esc(p.description_objective||'Sem objetivo descrito')+'</p><p class="muted">'+fmtDate(p.planned_start)+' · '+(p.planned_duration_hours||0)+'h · '+(p.expected_participants??'—')+' jovens</p><div class="actions">'+(reportByPlan.has(p.id)?'<span class="pill success">Relatório registrado</span>':'<button class="btn secondary" data-report-plan="'+p.id+'">Relatar execução</button>')+goalInfoV2('planejamento_'+p.plan_type)+'</div></div>').join('')||'<div class="card empty">Nenhum planejamento registrado.</div>')+'</div>';
  }
  if(view==='relatorios'){
    return head+'<div class="page-head educator-subhead"><div><h3>Relatórios</h3><p>O relatório responde ao que foi planejado e registra o que realmente aconteceu.</p></div></div><div class="grid two">'+
      (plans.map(p=>{const rep=reportByPlan.get(p.id);return '<div class="card"><span class="pill">'+esc(planLabelV2(p.plan_type))+'</span><h3>'+esc(p.activity_title)+'</h3><p class="muted">Planejado: '+fmtDate(p.planned_start)+' · '+(p.expected_participants??'—')+' jovens · '+(p.planned_duration_hours||0)+'h</p>'+(rep?'<div class="notice '+(rep.execution_status==='nao_realizado'?'danger':rep.execution_status==='parcial'?'warn':'success')+'"><b>'+esc(rep.execution_status)+'</b> · '+(rep.actual_participants??0)+' jovens · '+(rep.actual_duration_hours??0)+'h<br>'+esc(rep.actual_description||'')+'</div>':'<button class="btn primary" data-report-plan="'+p.id+'">Responder relatório</button>')+'</div>'}).join('')||'<div class="card empty">Crie um planejamento antes do relatório.</div>')+'</div>';
  }
  if(view==='oficinas'){
    const ws=workshops.filter(w=>w.active&&(state.user?.role!=='educador'||!w.educator_user_id||w.educator_user_id===state.user.id));
    return head+'<div class="page-head educator-subhead"><div><h3>Oficinas e presenças</h3><p>Acompanhe turma, participações, alertas de cadastro, inscrição formal e lista virtual.</p></div></div><div class="grid three">'+
      (ws.map(w=>'<div class="card"><span class="pill success">Ativa</span><h3>'+esc(w.name)+'</h3><p class="muted">'+esc(w.category||'')+' · '+esc(w.days||'')+'</p><button class="btn primary" data-nav="oficina/'+w.id+'">Acompanhar turma '+goalInfoV2('presenca')+'</button></div>').join('')||'<div class="card empty">Nenhuma oficina disponível.</div>')+'</div>';
  }
  if(view==='encaminhamentos'){
    const recordMap=new Map(records.map(x=>[x.id,x])),people=new Map(team.map(x=>[x.id,x]));
    const out=receipts.filter(x=>recordMap.has(x.educator_record_id));
    return head+'<div class="page-head educator-subhead"><div><h3>Encaminhamentos e ciência</h3><p>O destinatário recebe a especificidade; ao visualizar, a ciência volta automaticamente.</p></div></div><div class="card">'+
      (out.map(x=>{const rec=recordMap.get(x.educator_record_id),p=people.get(x.recipient_user_id);return '<div class="referral-status-row"><div><b>'+esc(rec?.title||educatorTypeLabelV2(rec?.record_type))+'</b><span>'+esc(p?.display_name||'Colaborador')+' · '+esc(roleLabel(p?.role))+'</span></div><span class="pill '+(x.status==='ciente'?'success':'warn')+'">'+(x.status==='ciente'?'Ciente em '+fmtDateTime(x.viewed_at):'Aguardando ciência')+'</span></div>'}).join('')||'<div class="empty">Nenhum encaminhamento do período.</div>')+'</div>';
  }

  const quick=[['acolhimento_educativo','Acolhimento educativo'],['demanda_identificada','Demanda identificada'],['encaminhamento_interno','Encaminhamento interno'],['acompanhamento_oficina','Acompanhamento de oficina'],['mediacao_convivencia','Mediação / convivência'],['ficaadica_orientacao','#FicaAdica / orientação'],['trampo_labpoca','Trampo Coletivo / LABPoca'],['mobilizacao','Mobilização'],['evento_programacao','Evento / programação'],['mostra','Mostra'],['estudo_caso','Estudo de caso'],['outra_acao_educativa','Outra ação']];
  return head+'<div class="grid cards" style="margin-top:16px"><div class="card kpi"><div class="label">Horas de aula</div><div class="value">'+sum('aula').toFixed(1)+'</div><div class="meta">sessões '+goalInfoV2('aula')+'</div></div><div class="card kpi"><div class="label">Presenças</div><div class="value">'+sum('presenca')+'</div><div class="meta">nominais '+goalInfoV2('presenca')+'</div></div><div class="card kpi"><div class="label">Planejamentos</div><div class="value">'+plans.length+'</div><div class="meta">não contam como execução</div></div><div class="card kpi"><div class="label">Registros educativos</div><div class="value">'+records.length+'</div></div></div>'+
    '<div class="grid two" style="margin-top:16px"><div class="card"><h3>Responsabilidades</h3><div class="check-grid educator-duty-grid">'+
    '<div class="check"><span><b>Referência cotidiana</b><small>Acolher, criar vínculo e perceber demandas.</small></span>'+goalInfoV2('acolhimento_educativo')+'</div>'+
    '<div class="check"><span><b>Planejamento e relatório</b><small>Planejar, registrar execução, avaliar e comprovar.</small></span>'+goalInfoV2('planejamento_oficina')+'</div>'+
    '<div class="check"><span><b>Oficinas</b><small>Acompanhar turmas, presenças e oficineiros.</small></span>'+goalInfoV2('acompanhamento_oficina')+'</div>'+
    '<div class="check"><span><b>CFDH</b><small>Organizar ações estruturais e transversais.</small></span>'+goalInfoV2('planejamento_cfdh_estrutural')+'</div>'+
    '<div class="check"><span><b>Encaminhamentos</b><small>Encaminhar ao responsável sem substituir atendimento técnico.</small></span>'+goalInfoV2('encaminhamento_interno')+'</div></div></div>'+
    '<div class="card"><h3>Registrar contribuição</h3><p class="muted">Ação já realizada e não originada de um planejamento formal.</p><div class="educator-action-grid">'+quick.map(x=>'<button class="btn" data-educator-new="'+x[0]+'">'+x[1]+' '+goalInfoV2(x[0])+'</button>').join('')+'</div></div></div>'+
    '<div class="card" style="margin-top:16px"><h3>Instrumentais do Educador</h3><div class="actions"><button class="btn" data-nav="formulario/lista-presenca-contato">Anexo 2 · Lista de Presença</button><button class="btn" data-nav="formulario/avaliacao-atividades">Anexo 7 · Avaliação</button><button class="btn" data-nav="formulario/relatorio-mobilizacao">Anexo 8 · Mobilização</button><button class="btn" data-nav="formulario/cfdh-planejamento">Anexo 11 · CFDH</button></div></div>';
}

async function bindEducatorPageV2(){
  const monthEl=document.querySelector('[data-educator-filter-month]'),userEl=document.querySelector('[data-educator-filter-user]');
  const view=route().params.get('view')||'responsabilidades';
  const apply=()=>{const p=new URLSearchParams();if(monthEl?.value)p.set('month',monthEl.value);if(userEl?.value)p.set('user',userEl.value);p.set('view',view);nav('educador?'+p.toString())};
  monthEl?.addEventListener('change',apply);userEl?.addEventListener('change',apply);
  const [youth,workshops,provisional,plans]=await Promise.all([listYouth(''),listWorkshops(),listProvisionalPeople(),listEducatorPlans(route().params.get('month')||currentMonth(),state.user?.role==='educador'?state.user.id:(route().params.get('user')||null))]);

  document.querySelectorAll('[data-educator-new]').forEach(btn=>btn.addEventListener('click',()=>{
    const initial=btn.dataset.educatorNew||'acolhimento_educativo';
    const types=['acolhimento_educativo','demanda_identificada','encaminhamento_interno','acompanhamento_oficina','mediacao_convivencia','ficaadica_orientacao','trampo_labpoca','mobilizacao','evento_programacao','mostra','estudo_caso','outra_acao_educativa'];
    modal('Registrar contribuição do Educador','<form id="educator-record-v2" class="stack"><div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="'+new Date().toISOString().slice(0,10)+'" required></div><div class="field"><label>Tipo</label><select name="record_type">'+types.map(k=>'<option value="'+k+'" '+(k===initial?'selected':'')+'>'+esc(educatorTypeLabelV2(k))+'</option>').join('')+'</select></div></div>'+
      '<div class="field"><label>Jovem / participante '+goalInfoV2('cadastro')+'</label>'+personSearchMarkupV2()+'<small>Resultados incompatíveis desaparecem a cada letra digitada.</small></div>'+
      '<div class="field"><label>Oficina relacionada</label><select name="workshop_id"><option value="">Nenhuma</option>'+workshops.filter(w=>w.active).map(w=>'<option value="'+w.id+'">'+esc(w.name)+'</option>').join('')+'</select></div>'+
      '<div class="field"><label>Título / síntese</label><input class="input" name="title"></div><div class="field"><label>Descrição objetiva</label><textarea name="description" required></textarea></div>'+
      '<div class="form-grid"><div class="field"><label>Duração (h)</label><input class="input" type="number" min="0" max="24" step="0.25" name="duration_hours" value="0"></div><div class="field"><label>Nº participantes</label><input class="input" type="number" min="0" name="participants_count"></div></div>'+
      '<div class="field"><label>Encaminhar para '+goalInfoV2('encaminhamento_interno')+'</label><select name="referral_target"><option value="">Sem encaminhamento</option><option value="equipe_tecnica">Equipe Técnica</option><option value="coordenacao">Coordenação Geral</option><option value="articulacao">Articulação</option><option value="administrativo">Administrativo</option><option value="oficina">Oficineiro da oficina</option><option value="rede_externa">Orientação para rede externa</option></select><small>O destinatário recebe todos os detalhes e a ciência retorna ao Educador ao visualizar.</small></div>'+
      '<div class="field"><label>Evidência</label><input class="input" name="evidence_ref"></div><div class="field"><label>Observação interna</label><textarea name="notes"></textarea></div><button class="btn primary">Salvar contribuição</button></form>');
    const form=document.querySelector('#educator-record-v2');bindPersonSearchV2(form,youth,provisional);
    form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(['demanda_identificada','encaminhamento_interno'].includes(p.record_type)&&!p.youth_id&&!p.provisional_person_id){toast('Selecione o jovem ou participante.','danger');return}try{await createEducatorRecord(p);document.querySelector('#modal')?.remove();toast(p.referral_target?'Registro salvo e encaminhamento enviado':'Contribuição registrada');await render()}catch(err){toast(err.message,'danger')}});
  }));

  document.querySelector('[data-new-educator-plan]')?.addEventListener('click',()=>{
    modal('Novo planejamento','<form id="educator-plan-v2" class="stack"><div class="field"><label>Tipo</label><select name="plan_type"><option value="oficina">Oficina</option><option value="cfdh_estrutural">CFDH estrutural</option><option value="cfdh_transversal">CFDH transversal</option><option value="evento">Evento / programação</option></select></div>'+
      '<div class="field"><label>Oficina vinculada</label><select name="workshop_id"><option value="">Não se aplica</option>'+workshops.filter(w=>w.active).map(w=>'<option value="'+w.id+'">'+esc(w.name)+'</option>').join('')+'</select></div>'+
      '<div class="field"><label>ATIVIDADE</label><input class="input" name="activity_title" required></div><div class="field"><label>DESCRIÇÃO / objetivo</label><textarea name="description_objective" required></textarea></div>'+
      '<div class="form-grid"><div class="field"><label>Núcleo</label><input class="input" name="nucleus"></div><div class="field"><label>Eixo</label><input class="input" name="axis"></div></div>'+
      '<div class="form-grid"><div class="field"><label>Jovens previstos</label><input class="input" type="number" min="0" name="expected_participants"></div><div class="field"><label>Duração prevista (h)</label><input class="input" type="number" min="0" step="0.25" name="planned_duration_hours"></div></div>'+
      '<div class="form-grid"><div class="field"><label>Data inicial</label><input class="input" type="date" name="planned_start"></div><div class="field"><label>Data final</label><input class="input" type="date" name="planned_end"></div></div>'+
      '<div class="form-grid"><div class="field"><label>Hora inicial</label><input class="input" type="time" name="start_time"></div><div class="field"><label>Hora final</label><input class="input" type="time" name="end_time"></div></div>'+
      '<div class="field"><label>Equipe prevista</label><input class="input" name="team_text"></div><div class="field"><label>Parceiros</label><input class="input" name="partners"></div>'+
      '<div class="field"><label>Mobilização / divulgação planejada</label><textarea name="mobilization_plan"></textarea></div><div class="field"><label>Ações planejadas</label><textarea name="planned_actions"></textarea></div>'+
      '<div class="field"><label>Resultados esperados</label><textarea name="expected_results"></textarea></div><div class="field"><label>Recursos necessários</label><textarea name="resources"></textarea></div>'+
      '<div class="notice">Planejamento não contabiliza execução. O indicador só muda quando a execução é registrada.</div><button class="btn primary">Salvar planejamento</button></form>');
    document.querySelector('#educator-plan-v2')?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorPlan(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Planejamento salvo');await render()}catch(err){toast(err.message,'danger')}});
  });
  document.querySelectorAll('[data-report-plan]').forEach(btn=>btn.addEventListener('click',()=>{
    const p=plans.find(x=>x.id===btn.dataset.reportPlan);if(!p)return;
    modal('Relatório de execução','<form id="educator-report-v2" class="stack"><input type="hidden" name="plan_id" value="'+p.id+'"><div class="notice"><b>'+esc(p.activity_title)+'</b><br>'+esc(p.description_objective||'')+'<br>Previsto: '+fmtDate(p.planned_start)+' · '+(p.expected_participants??'—')+' jovens · '+(p.planned_duration_hours||0)+'h</div>'+
      '<div class="field"><label>Situação</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Não realizado</option></select></div>'+
      '<div class="field"><label>DESCRIÇÃO do que aconteceu</label><textarea name="actual_description" required></textarea></div><div class="form-grid"><div class="field"><label>Jovens participantes</label><input class="input" type="number" min="0" name="actual_participants"></div><div class="field"><label>Duração real (h)</label><input class="input" type="number" min="0" step="0.25" name="actual_duration_hours"></div></div>'+
      '<div class="form-grid"><div class="field"><label>Data inicial real</label><input class="input" type="date" name="actual_start" value="'+esc(p.planned_start||'')+'"></div><div class="field"><label>Data final real</label><input class="input" type="date" name="actual_end" value="'+esc(p.planned_end||p.planned_start||'')+'"></div></div>'+
      '<div class="field"><label>MOBILIZAÇÃO / divulgação realizada</label><textarea name="mobilization_actual"></textarea></div><div class="field"><label>PONTOS POSITIVOS</label><textarea name="positive_points"></textarea></div><div class="field"><label>PONTOS NEGATIVOS</label><textarea name="negative_points"></textarea></div>'+
      '<div class="field"><label>AÇÕES realizadas</label><textarea name="actions_performed"></textarea></div><div class="field"><label>Justificativa de parcial/não realizado</label><textarea name="justification"></textarea></div><div class="field"><label>Evidências</label><input class="input" name="evidence_ref"></div><button class="btn primary">Salvar relatório</button></form>');
    document.querySelector('#educator-report-v2')?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatório salvo e execução consolidada');await render()}catch(err){toast(err.message,'danger')}});
  }));
}

async function pageWorkshopDetailV2(workshopId){
  const [workshops,youth,provisional,stats,guests,roster,sessions,att]=await Promise.all([
    listWorkshops(),listYouth(''),listProvisionalPeople(),listProvisionalParticipationStats(),listGuestParticipations(workshopId),
    workshopRoster(workshopId),listWorkshopSessions(workshopId,30),listWorkshopAttendance(workshopId)
  ]);
  const w=workshops.find(x=>x.id===workshopId);if(!w)return '<div class="notice danger">Oficina não encontrada.</div>';
  const selectedId=route().params.get('session')||sessions[0]?.id||'',session=sessions.find(x=>x.id===selectedId)||null;
  const rosterIds=new Set(roster.map(x=>x.youth_id)),workCounts={};for(const a of att)if(a.present!==false)workCounts[a.youth_id]=(workCounts[a.youth_id]||0)+1;
  const eligible=youth.filter(y=>(workCounts[y.id]||0)>3&&!rosterIds.has(y.id));
  const provisionalById=new Map(provisional.map(x=>[x.id,x])),statMap=new Map(stats.map(x=>[x.provisional_person_id,x]));
  const alertGuests=[...new Set(guests.map(x=>x.provisional_person_id))].map(id=>({p:provisionalById.get(id),s:statMap.get(id)})).filter(x=>x.p&&Number(x.s?.total||0)>=3);
  const sessionNav=sessions.slice(0,8).map(s=>'<button class="btn '+(s.id===selectedId?'primary':'')+'" data-nav="oficina/'+workshopId+'?session='+s.id+'">'+fmtDate(s.session_date)+'</button>').join('');
  return '<div class="page-head"><div><h2>'+esc(w.name)+'</h2><p>Acompanhamento da oficina, presenças, inscrição e lista virtual.</p></div><div class="actions"><button class="btn" data-nav="educador?view=oficinas">← Área do Educador</button><button class="btn primary" data-action="session" data-workshop="'+w.id+'">+ Registrar aula '+goalInfoV2('aula')+'</button></div></div>'+
    '<div class="grid cards"><div class="card kpi"><div class="label">Inscritos ativos</div><div class="value">'+roster.length+'</div></div><div class="card kpi"><div class="label">Sessões</div><div class="value">'+sessions.length+'</div></div><div class="card kpi"><div class="label">Participações nominais</div><div class="value">'+att.filter(x=>x.present!==false).length+'</div></div></div>'+
    ((alertGuests.length||eligible.length)?'<div class="card alert-stack" style="margin-top:16px"><h3>Alertas de vínculo</h3>'+
      alertGuests.map(x=>'<div class="notice warn"><b>'+esc(x.p.full_name)+'</b> já possui '+Number(x.s?.total||0)+' participações/atendimentos registrados. Convide para preencher o Formulário Inicial. '+goalInfoV2('cadastro')+' <button class="btn" data-start-registration="'+x.p.id+'">Iniciar cadastro</button></div>').join('')+
      eligible.map(y=>'<div class="notice info"><b>'+esc(y.preferred_name||y.full_name)+'</b> já ultrapassou 3 participações nesta oficina. Recomendada inscrição formal. '+goalInfoV2('inscricao_oficina')+' <button class="btn" data-formal-enroll="'+y.id+'">Inscrever</button></div>').join('')+'</div>':'')+
    '<div class="card" style="margin-top:16px"><h3>Aulas recentes</h3><div class="actions">'+(sessionNav||'<span class="muted">Nenhuma aula registrada.</span>')+'</div></div>'+
    (session?'<div class="grid two" style="margin-top:16px"><div class="card"><h3>Presença da aula · '+fmtDate(session.session_date)+' '+goalInfoV2('presenca')+'</h3><p class="muted">Pesquise jovem cadastrado ou participante provisório.</p>'+personSearchMarkupV2()+'<div class="actions" style="margin-top:10px"><button class="btn primary" data-mark-session-person>Registrar presença</button><button class="btn secondary" data-new-provisional>Novo participante sem cadastro</button></div></div>'+
      '<div class="card"><h3>Lista virtual</h3><p>Para jovens formalmente inscritos: escolhem o nome, conferem o final do CPF e digitam a senha criada na inscrição.</p><div class="actions"><button class="btn primary" data-open-checkin="'+session.id+'">Abrir lista virtual</button><button class="btn" data-generate-list="'+session.id+'">Gerar Anexo 2 preenchido</button></div><div data-checkin-link></div></div></div>':'')+
    '<div class="grid two" style="margin-top:16px"><div class="card"><h3>Inscritos</h3>'+ (roster.map(e=>'<div class="agenda-row"><div><b>'+esc(e.youth?.preferred_name||e.youth?.full_name)+'</b><span>CPF final '+esc((String(e.cpf_snapshot||e.youth?.cpf||'').replace(/\D/g,'').slice(-4)||'----'))+'</span></div><span class="pill success">Inscrito</span></div>').join('')||'<div class="empty">Nenhum inscrito.</div>')+'</div>'+
    '<div class="card"><h3>Participantes provisórios</h3>'+([...new Set(guests.map(x=>x.provisional_person_id))].map(id=>{const p=provisionalById.get(id),st=statMap.get(id);return p?'<div class="agenda-row"><div><b>'+esc(p.full_name)+'</b><span>'+Number(st?.total||0)+' participação(ões) gerais</span></div>'+(Number(st?.total||0)>=3?'<span class="pill warn">Convidar para cadastro</span>':'')+'</div>':''}).join('')||'<div class="empty">Nenhum participante provisório.</div>')+'</div></div>';
}

async function bindWorkshopDetailV2(workshopId){
  const [youth,provisional,sessions]=await Promise.all([listYouth(''),listProvisionalPeople(),listWorkshopSessions(workshopId,30)]);
  const sessionId=route().params.get('session')||sessions[0]?.id||'',session=sessions.find(x=>x.id===sessionId);
  const searchRoot=document.querySelector('.person-search');if(searchRoot)bindPersonSearchV2(searchRoot,youth,provisional);
  document.querySelector('[data-mark-session-person]')?.addEventListener('click',async()=>{
    const root=document.querySelector('.person-search'),yid=root?.querySelector('[name="youth_id"]')?.value,pid=root?.querySelector('[name="provisional_person_id"]')?.value;
    if(!session){toast('Registre uma aula primeiro.','danger');return} if(!yid&&!pid){toast('Selecione o jovem/participante.','danger');return}
    try{
      if(yid)await addWorkshopAttendanceParticipant({session_id:session.id,workshop_id:workshopId,youth_id:yid,attendance_date:session.session_date});
      else await addWorkshopGuestParticipation({session_id:session.id,workshop_id:workshopId,provisional_person_id:pid,participation_date:session.session_date});
      toast('Presença registrada');await render();
    }catch(err){toast(err.message,'danger')}
  });
  document.querySelector('[data-new-provisional]')?.addEventListener('click',()=>{
    modal('Novo participante sem cadastro','<form id="new-provisional-v2" class="stack"><div class="notice">Use para participação avulsa. Ao atingir 3 participações/atendimentos o sistema alerta para convite ao Formulário Inicial.</div><div class="field"><label>Nome completo</label><input class="input" name="full_name" required></div><div class="form-grid"><div class="field"><label>Nascimento</label><input class="input" type="date" name="birth_date"></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood"></div></div><div class="field"><label>Contato</label><input class="input" name="phone"></div><button class="btn primary">Salvar participante</button></form>');
    document.querySelector('#new-provisional-v2')?.addEventListener('submit',async e=>{e.preventDefault();try{const p=await createProvisionalPerson(parseForm(e.target));if(session)await addWorkshopGuestParticipation({session_id:session.id,workshop_id:workshopId,provisional_person_id:p.id,participation_date:session.session_date});document.querySelector('#modal')?.remove();toast('Participante registrado');await render()}catch(err){toast(err.message,'danger')}});
  });
  document.querySelectorAll('[data-formal-enroll]').forEach(btn=>btn.addEventListener('click',async()=>{
    const y=youth.find(x=>x.id===btn.dataset.formalEnroll);if(!y)return;
    modal('Inscrição formal na oficina','<form id="formal-enroll-v2" class="stack"><div class="notice"><b>'+esc(y.preferred_name||y.full_name)+'</b><br>Os dados abaixo vieram do Formulário Inicial/cadastro e podem ser revisados antes da inscrição.</div><input type="hidden" name="youth_id" value="'+y.id+'"><div class="field"><label>CPF</label><input class="input" name="cpf" value="'+esc(y.cpf||'')+'" required></div><div class="field"><label>E-mail</label><input class="input" type="email" name="email" value="'+esc(y.email||'')+'" required></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood" value="'+esc(y.neighborhood||'')+'" required></div><div class="field"><label>Senha da presença</label><input class="input" type="password" name="secret" minlength="4" required><small>O sistema guarda somente o hash da senha.</small></div><div class="field"><label>Assinatura manuscrita</label><canvas id="signature-canvas" width="620" height="180" class="signature-canvas"></canvas><div class="actions"><button type="button" class="btn ghost" data-clear-signature>Limpar assinatura</button></div><input type="hidden" name="signature_data"></div><button class="btn primary">Confirmar inscrição '+goalInfoV2('inscricao_oficina')+'</button></form>');
    const canvas=document.querySelector('#signature-canvas'),ctx=canvas?.getContext('2d');let drawing=false;
    if(canvas&&ctx){ctx.lineWidth=2;ctx.lineCap='round';const pos=e=>{const r=canvas.getBoundingClientRect(),t=e.touches?.[0]||e;return {x:(t.clientX-r.left)*(canvas.width/r.width),y:(t.clientY-r.top)*(canvas.height/r.height)}};const start=e=>{drawing=true;const p=pos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault()};const move=e=>{if(!drawing)return;const p=pos(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault()};const stop=()=>drawing=false;canvas.addEventListener('pointerdown',start);canvas.addEventListener('pointermove',move);window.addEventListener('pointerup',stop);document.querySelector('[data-clear-signature]')?.addEventListener('click',()=>ctx.clearRect(0,0,canvas.width,canvas.height))}
    document.querySelector('#formal-enroll-v2')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);p.signature_data=canvas?.toDataURL('image/png')||'';try{await registerWorkshopEnrollment({workshop_id:workshopId,...p});document.querySelector('#modal')?.remove();toast('Inscrição formal registrada');await render()}catch(err){toast(err.message,'danger')}});
  }));
  document.querySelector('[data-open-checkin]')?.addEventListener('click',async btn=>{
    try{const x=await openWorkshopCheckin(btn.currentTarget.dataset.openCheckin),link=location.origin+location.pathname+'#presenca-oficina/'+x.public_token;const box=document.querySelector('[data-checkin-link]');if(box)box.innerHTML='<div class="notice success" style="margin-top:12px"><b>Lista virtual aberta</b><br><input class="input" readonly value="'+esc(link)+'"><div class="actions" style="margin-top:8px"><button class="btn" data-copy-checkin>Copiar link</button><a class="btn primary" href="'+esc(link)+'" target="_blank">Abrir lista</a></div></div>';box?.querySelector('[data-copy-checkin]')?.addEventListener('click',()=>navigator.clipboard.writeText(link).then(()=>toast('Link copiado')))}catch(err){toast(err.message,'danger')}
  });
  document.querySelector('[data-generate-list]')?.addEventListener('click',async btn=>{
    try{const saved=await generateWorkshopAttendanceSubmission(btn.currentTarget.dataset.generateList);toast('Lista oficial gerada');modal('Lista de Presença gerada','<div class="stack"><div class="notice success">O Anexo 2 foi preenchido com os dados nominais da aula.</div><div class="actions"><button class="btn primary" data-auto-list-download="'+saved.id+'" data-format="pdf">PDF</button><button class="btn" data-auto-list-download="'+saved.id+'" data-format="docx">DOCX</button></div></div>');document.querySelectorAll('[data-auto-list-download]').forEach(b=>b.addEventListener('click',()=>downloadFormSubmission(b.dataset.autoListDownload,b.dataset.format).catch(e=>toast(e.message,'danger'))))}catch(err){toast(err.message,'danger')}
  });
  document.querySelectorAll('[data-start-registration]').forEach(btn=>btn.addEventListener('click',async()=>{
    const p=await getProvisionalPerson(btn.dataset.startRegistration);if(!p)return;
    sessionStorage.setItem('crj_provisional_prefill',JSON.stringify(p));nav('novo-jovem?provisional='+p.id);
  }));
}

async function pagePublicWorkshopCheckinV2(token){
  try{
    const rows=await publicWorkshopCheckinRoster(token);
    if(!rows.length)return '<div class="public-checkin"><div class="card"><h2>Lista de presença</h2><div class="notice warn">A lista não está disponível, ainda não abriu ou já foi encerrada.</div></div></div>';
    const first=rows[0];
    return '<div class="public-checkin"><div class="card"><h2>'+esc(first.workshop_name)+'</h2><p>'+fmtDate(first.session_date)+' · '+esc(String(first.start_time||'').slice(0,5))+'–'+esc(String(first.end_time||'').slice(0,5))+'</p><div class="field"><label>Seu nome</label><input class="input" type="search" data-public-name placeholder="Digite seu nome"></div><div data-public-roster>'+rows.map(r=>'<button class="person-result public-person" data-enrollment="'+r.enrollment_id+'" data-name="'+esc(r.display_name)+'"><b>'+esc(r.display_name)+'</b><span>CPF final '+esc(r.cpf_last4)+'</span></button>').join('')+'</div><form id="public-checkin-form" class="stack hidden"><input type="hidden" name="enrollment_id"><div class="notice" data-public-selected></div><div class="field"><label>Senha da presença</label><input class="input" type="password" name="secret" required></div><button class="btn primary">Confirmar presença</button></form></div></div>';
  }catch(err){return '<div class="public-checkin"><div class="card"><h2>Lista de presença</h2><div class="notice danger">'+esc(err.message)+'</div></div></div>'}
}

async function bindPublicWorkshopCheckinV2(token){
  const input=document.querySelector('[data-public-name]'),items=[...document.querySelectorAll('.public-person')],form=document.querySelector('#public-checkin-form');
  input?.addEventListener('input',()=>{const q=String(input.value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();items.forEach(x=>x.classList.toggle('hidden',!String(x.dataset.name||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().includes(q)))});
  items.forEach(x=>x.addEventListener('click',()=>{form.querySelector('[name="enrollment_id"]').value=x.dataset.enrollment;form.querySelector('[data-public-selected]').innerHTML='<b>'+esc(x.dataset.name)+'</b><br>Confira o final do CPF acima e digite sua senha.';form.classList.remove('hidden');form.querySelector('[name="secret"]').focus()}));
  form?.addEventListener('submit',async e=>{e.preventDefault();const fd=new FormData(form);try{await publicWorkshopCheckinMark(token,fd.get('enrollment_id'),fd.get('secret'));form.innerHTML='<div class="notice success"><b>Presença confirmada.</b><br>Obrigado!</div>'}catch(err){const old=form.querySelector('.notice.danger');old?.remove();form.insertAdjacentHTML('afterbegin','<div class="notice danger">'+esc(err.message)+'</div>')}});
}


function eduGoalInfo(key){
  if(key==='cfdh_estrutural'){
    const g={t:'CFDH estrutural',i:[
      ['Meta 6 · Etapa 6.1','CONTABILIZA a carga horária de CFDH estrutural quando a execução é registrada.'],
      ['Meta 4 · Etapa 4.2','Comprova atividade do Núcleo Socioafirmativo e de Acesso.']
    ],n:'Planejamento sozinho não contabiliza horas; a execução precisa ser registrada.'};
    return '<span class="goal-help" tabindex="0">ⓘ<span class="goal-tooltip"><b>'+esc(g.t)+'</b>'+g.i.map(x=>'<span><strong>'+esc(x[0])+'</strong><small>'+esc(x[1])+'</small></span>').join('')+'<em>'+esc(g.n)+'</em></span></span>';
  }
  if(key==='cfdh_transversal'){
    const g={t:'CFDH transversal',i:[
      ['Meta 6 · Etapa 6.1','Os minutos de CFDH lançados dentro da aula alimentam a carga semestral.'],
      ['Meta 4 · Etapa 4.2','Comprova transversalidade de Direitos Humanos nas oficinas.']
    ]};
    return '<span class="goal-help" tabindex="0">ⓘ<span class="goal-tooltip"><b>'+esc(g.t)+'</b>'+g.i.map(x=>'<span><strong>'+esc(x[0])+'</strong><small>'+esc(x[1])+'</small></span>').join('')+'</span></span>';
  }
  return goalInfoV2(key);
}
function eduTabs(view,month,userId){
  const base=new URLSearchParams();if(month)base.set('month',month);if(userId)base.set('user',userId);
  const tabs=[['responsabilidades','Responsabilidades'],['planejamento','Planejamento'],['relatorios','Relatórios'],['oficinas','Oficinas e presenças'],['encaminhamentos','Encaminhamentos']];
  return '<div class="educator-tabs">'+tabs.map(x=>{const p=new URLSearchParams(base);p.set('view',x[0]);return '<a class="'+(view===x[0]?'active':'')+'" href="#educador?'+p.toString()+'">'+x[1]+'</a>'}).join('')+'</div>';
}
function eduPlanLabel(t){return planLabelV2(t)}
function eduTypeLabel(t){return educatorTypeLabelV2(t)}
function eduPersonSearchHtml(){return personSearchMarkupV2()}
function bindEduPersonSearch(root,youth,provisional){return bindPersonSearchV2(root,youth,provisional)}
function decorateEduGoalForm(form,key){
  if(!form)return;
  form.querySelectorAll('[data-edu-goal-context]').forEach(x=>x.remove());
  const info=eduGoalInfo(key);
  if(info){
    const box=document.createElement('div');
    box.dataset.eduGoalContext='1';
    box.className='goal-context-line notice';
    box.innerHTML='<b>Como este preenchimento colabora:</b> '+info+' <span class="muted">Passe o mouse ou toque no ⓘ.</span>';
    form.prepend(box);
  }
  form.querySelectorAll('label').forEach(label=>{
    if(label.querySelector('.goal-help'))return;
    label.insertAdjacentHTML('beforeend',' '+eduGoalInfo(key));
  });
}
function decorateMethodologyFormGoals(form){
  if(!form)return;
  const slug=form.dataset.slug||'';
  const map={
    'formulario-inicial':'cadastro',
    'lista-presenca-contato':'presenca',
    'avaliacao-atividades':'acompanhamento_oficina',
    'relatorio-mobilizacao':'mobilizacao',
    'cfdh-planejamento':'planejamento_cfdh_estrutural',
    'cfdh-avaliacao-jovens':'cfdh_estrutural',
    'cfdh-avaliacao-equipe':'cfdh_estrutural'
  };
  const key=map[slug];
  if(key)decorateEduGoalForm(form,key);
}
