/* LABPOCA_WORKSPACE_CORE_20261022 */
(()=>{
const R=['coordenacao_geral','coordenacao_articulacao','educador','assistente_social','psicologo','terapeuta_ocupacional'],S=new Set(R);let A=null,U=null,t=null;
const api=()=>A||(A=import('./api.js?v=20261016-hours1')),db=async()=>{const m=await api();if(m.apiMode()!=='live')throw Error('Banco ainda não conectado.');return m.supabaseClient()},esc=(v='')=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),now=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).format(new Date()),hp=()=>new URLSearchParams((location.hash.split('?')[1]||'')),mon=()=>hp().get('month')||now(),ms=m=>m+'-01',nx=m=>{const [y,x]=m.split('-').map(Number);return new Date(Date.UTC(y,x,1)).toISOString().slice(0,10)},area=a=>a==='audiovisual'?'Audiovisual (LABSTUDIO)':'Estética (LABPOCA)',hrs=(a,b)=>{if(!a||!b)return 0;const A=String(a).slice(0,5).split(':').map(Number),B=String(b).slice(0,5).split(':').map(Number);return Math.max(0,(B[0]*60+B[1]-A[0]*60-A[1])/60)};
function css(){if(document.querySelector('#lp-css'))return;const s=document.createElement('style');s.id='lp-css';s.textContent='.lp{display:grid;gap:14px}.lp-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}.lp-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.lp-card{background:#fff;border:1px solid #dbe7e2;border-radius:16px;padding:14px}.lp-kpis{display:grid;grid-template-columns:repeat(6,minmax(95px,1fr));gap:7px}.lp-kpi{border:1px solid #e0e9e6;border-radius:12px;padding:9px}.lp-kpi span{display:block;font-size:10px;color:#64766f}.lp-kpi b{font-size:19px}.lp-table{width:100%;border-collapse:collapse;font-size:11px}.lp-table th,.lp-table td{padding:7px;border-bottom:1px solid #e7efec;text-align:left;vertical-align:top}.lp-scroll{overflow:auto}.lp-muted{font-size:12px;color:#677973}.lp-badge{display:inline-flex;padding:3px 7px;border-radius:999px;background:#e8f4f0;color:#145747;font-size:10px;font-weight:700}.lp-actions{display:flex;gap:7px;flex-wrap:wrap}.lp-progress{height:8px;background:#e6eeeb;border-radius:999px;overflow:hidden}.lp-progress i{display:block;height:100%;background:#0b6b58}@media(max-width:900px){.lp-kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.lp-two{grid-template-columns:1fr}.lp-kpis{grid-template-columns:repeat(2,1fr)}}';document.head.appendChild(s)}
async function user(){if(U)return U;try{const m=await api(),s=await m.getSession();U=s?.user||null}catch{}return U}
async function nav(){const u=await user(),n=document.querySelector('.sidebar .nav');if(!n)return;let a=n.querySelector('[data-lp-nav]');if(!u||!S.has(u.role)){a?.remove();return}if(!a){a=document.createElement('a');a.dataset.lpNav='1';a.href='#labpoca?month='+now();a.innerHTML='<span>◈</span><span>LABPOCA</span>';n.insertBefore(a,n.querySelector('.sep')||null)}a.classList.toggle('active',location.hash.startsWith('#labpoca'))}
async function load(m){const c=await db(),s=ms(m),e=nx(m),wq=await c.rpc('list_workshops_for_month',{p_month:s});if(wq.error)throw wq.error;const w=(wq.data||[]).filter(x=>x.active!==false&&(x.is_labpoca===true||String(x.is_labpoca)==='true')&&['estetica','audiovisual'].includes(x.labpoca_area)),wi=w.map(x=>x.id);let p=[],l=[],se=[],at=[],rp=[],cr=[],lk=[],ac=[],ca=[],er=[],cy=[],re=[],mr=null;if(wi.length){let q=await c.from('workshop_monthly_plans').select('*').in('workshop_id',wi).eq('plan_month',s);if(q.error)throw q.error;p=q.data||[];const pi=p.map(x=>x.id);if(pi.length){q=await c.from('workshop_plan_lessons').select('*').in('plan_id',pi).eq('included',true);if(q.error)throw q.error;l=q.data||[];q=await c.from('workshop_monthly_reports').select('*').in('plan_id',pi);if(!q.error)rp=q.data||[]}q=await c.from('workshop_sessions').select('*').in('workshop_id',wi).gte('session_date',s).lt('session_date',e);if(q.error)throw q.error;se=q.data||[];q=await c.from('attendance').select('workshop_id,youth_id,attendance_date').in('workshop_id',wi).gte('attendance_date',s).lt('attendance_date',e).eq('present',true);if(q.error)throw q.error;at=q.data||[];q=await c.from('labpoca_survey_credentials').select('workshop_id,login,active').in('workshop_id',wi);if(!q.error)cr=q.data||[];q=await c.from('labpoca_cfdh_links').select('*').in('workshop_id',wi).eq('contributes',true);if(!q.error)lk=q.data||[];const ai=lk.map(x=>x.action_id);if(ai.length){q=await c.from('cfdh_actions').select('id,title,action_theme,scheduled_date,actual_date,planned_duration_hours,actual_duration_hours,execution_description').in('id',ai);if(!q.error)ac=(q.data||[]).filter(x=>{const d=x.actual_date||x.scheduled_date;return d>=s&&d<e});const aa=ac.map(x=>x.id);if(aa.length){q=await c.from('cfdh_attendance').select('action_id,youth_id,attendance_date').in('action_id',aa).eq('present',true);if(!q.error)ca=(q.data||[]).filter(x=>x.attendance_date>=s&&x.attendance_date<e)}}q=await c.from('educator_records').select('*').in('workshop_id',wi).eq('record_type','trampo_labpoca').gte('record_date',s).lt('record_date',e);if(!q.error)er=q.data||[]}
let q=await c.from('labpoca_survey_cycles').select('*').eq('reference_month',s);if(!q.error)cy=q.data||[];const ci=cy.map(x=>x.id);if(ci.length){q=await c.from('labpoca_survey_responses').select('*').in('cycle_id',ci);if(!q.error)re=q.data||[]}q=await c.from('labpoca_monthly_reports').select('*').eq('reference_month',s).maybeSingle();if(!q.error)mr=q.data||null;const yi=[...new Set([...at.map(x=>x.youth_id),...ca.map(x=>x.youth_id),...er.map(x=>x.youth_id)].filter(Boolean))],ym=new Map();if(yi.length){q=await c.from('young_people').select('id,full_name,preferred_name').in('id',yi);if(!q.error)(q.data||[]).forEach(y=>ym.set(y.id,y))}return {m,s,e,w,p,l,se,at,rp,cr,lk,ac,ca,er,cy,re,mr,ym}}
function sub(d,a){const w=d.w.filter(x=>x.labpoca_area===a),wi=new Set(w.map(x=>x.id)),p=d.p.filter(x=>wi.has(x.workshop_id)),pi=new Set(p.map(x=>x.id)),l=d.l.filter(x=>pi.has(x.plan_id)),se=d.se.filter(x=>wi.has(x.workshop_id)),at=d.at.filter(x=>wi.has(x.workshop_id)),lk=d.lk.filter(x=>x.area===a),ai=new Set(lk.map(x=>x.action_id)),ac=d.ac.filter(x=>ai.has(x.id)),ca=d.ca.filter(x=>ai.has(x.action_id)),er=d.er.filter(x=>wi.has(x.workshop_id)),cy=d.cy.find(x=>x.area===a),re=cy?d.re.filter(x=>x.cycle_id===cy.id):[],yu=new Set([...at.map(x=>x.youth_id),...ca.map(x=>x.youth_id),...er.map(x=>x.youth_id)].filter(Boolean));return {a,w,wi,p,pi,l,se,at,lk,ac,ca,er,cy,re,yu,ph:l.reduce((n,x)=>n+hrs(x.start_time,x.end_time),0),eh:se.reduce((n,x)=>n+Number(x.duration_hours||0),0),ew:new Set(se.map(x=>x.workshop_id)).size}}
const sat=r=>{const n=r.length,p=r.filter(x=>Number(x.overall_score)>=4).length;return {n,p,v:n?Math.round(p*10000/n)/100:0}};
function wrows(d,a){return a.w.map(w=>{const p=a.p.find(x=>x.workshop_id===w.id),l=a.l.filter(x=>x.plan_id===p?.id),s=a.se.filter(x=>x.workshop_id===w.id),y=new Set(a.at.filter(x=>x.workshop_id===w.id).map(x=>x.youth_id)).size,r=d.rp.find(x=>x.plan_id===p?.id),c=d.cr.find(x=>x.workshop_id===w.id);return `<tr><td><b>${esc(w.name)}</b><br><span class="lp-badge">${esc(area(w.labpoca_area))}</span></td><td>${l.length}</td><td>${s.length}</td><td>${l.reduce((n,x)=>n+hrs(x.start_time,x.end_time),0).toLocaleString('pt-BR')}h / ${s.reduce((n,x)=>n+Number(x.duration_hours||0),0).toLocaleString('pt-BR')}h</td><td>${y}</td><td>${esc(r?.actual_description||'Sem síntese mensal registrada.')}</td><td><button class="btn secondary" data-lp-access="${w.id}">${c?.active?'Acesso pesquisa':'Configurar pesquisa'}</button></td></tr>`}).join('')}
function arows(a){return [...a.ac.map(x=>`<tr><td>${esc(x.actual_date||x.scheduled_date||'')}</td><td>CFDH</td><td><b>${esc(x.title||x.action_theme||'Ação CFDH')}</b><br>${esc(x.execution_description||'Contribuição ao desenvolvimento do LABPOCA.')}</td><td>${Number(x.actual_duration_hours||x.planned_duration_hours||0).toLocaleString('pt-BR')}h</td><td>${a.ca.filter(y=>y.action_id===x.id).length}</td></tr>`),...a.er.map(x=>`<tr><td>${esc(x.record_date||'')}</td><td>Outra ação</td><td><b>${esc(x.title||'Ação LABPOCA')}</b><br>${esc(x.description||'')}</td><td>${Number(x.duration_hours||0).toLocaleString('pt-BR')}h</td><td>${x.youth_id?1:(x.participants_count??'—')}</td></tr>`)].join('')}
function yrows(d,a){const src=new Map();a.at.forEach(x=>{const w=d.w.find(z=>z.id===x.workshop_id),s=src.get(x.youth_id)||new Set();s.add('Oficina: '+(w?.name||'LABPOCA'));src.set(x.youth_id,s)});a.ca.forEach(x=>{const s=src.get(x.youth_id)||new Set();s.add('CFDH');src.set(x.youth_id,s)});a.er.filter(x=>x.youth_id).forEach(x=>{const s=src.get(x.youth_id)||new Set();s.add('Outra ação');src.set(x.youth_id,s)});return [...a.yu].map(id=>{const y=d.ym.get(id),r=a.re.find(x=>x.youth_id===id);return `<tr><td><b>${esc(y?.preferred_name||y?.full_name||'Jovem')}</b></td><td>${esc([...(src.get(id)||[])].join(' · '))}</td><td>${r?`<span class="lp-badge">Respondida · ${r.overall_score}/5</span>`:'Pendente'}</td><td><button class="btn secondary" data-lp-survey="${id}" data-lp-area="${a.a}">${r?'Editar':'Aplicar pesquisa'}</button></td></tr>`}).join('')}
function areaHtml(d,k){const a=sub(d,k),s=sat(a.re);return `<section class="lp-card"><div class="lp-head"><div><h3 style="margin:0">${area(k)}</h3><div class="lp-muted">Competência ${d.m.split('-').reverse().join('/')}</div></div><span class="lp-badge">Pesquisa: ${s.n} · ${s.v.toLocaleString('pt-BR')}%</span></div><div class="lp-kpis" style="margin-top:10px"><div class="lp-kpi"><span>Oficinas planejadas</span><b>${a.p.length}</b></div><div class="lp-kpi"><span>Oficinas executadas</span><b>${a.ew}</b></div><div class="lp-kpi"><span>Aulas planejadas</span><b>${a.l.length}</b></div><div class="lp-kpi"><span>Aulas executadas</span><b>${a.se.length}</b></div><div class="lp-kpi"><span>CH prev. / exec.</span><b style="font-size:14px">${a.ph.toLocaleString('pt-BR')}h / ${a.eh.toLocaleString('pt-BR')}h</b></div><div class="lp-kpi"><span>Jovens</span><b>${a.yu.size}</b></div></div><details open><summary><b>Oficinas e sínteses</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Oficina</th><th>Plan.</th><th>Exec.</th><th>CH</th><th>Jovens</th><th>Síntese</th><th>Pesquisa</th></tr></thead><tbody>${wrows(d,a)||'<tr><td colspan="7">Nenhuma oficina classificada.</td></tr>'}</tbody></table></div></details><details><summary><b>Ações integradas</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Data</th><th>Origem</th><th>Ação</th><th>CH</th><th>Participações</th></tr></thead><tbody>${arows(a)||'<tr><td colspan="5">Nenhuma ação integrada registrada.</td></tr>'}</tbody></table></div></details><details><summary><b>Jovens participantes</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Jovem</th><th>Vínculo</th><th>Pesquisa</th><th>Ação</th></tr></thead><tbody>${yrows(d,a)||'<tr><td colspan="4">Nenhum jovem participante.</td></tr>'}</tbody></table></div></details></section>`}
async function render(){if(!location.hash.startsWith('#labpoca'))return;const u=await user();if(!u||!S.has(u.role))return;css();const h=document.querySelector('.content');if(!h)return;const m=mon(),key='lp:'+location.hash;if(h.dataset.lpKey===key&&h.querySelector('[data-lp-page]'))return;h.dataset.lpKey=key;h.innerHTML='<div class="card"><div class="empty">Carregando LABPOCA…</div></div>';try{const d=await load(m),o=sat(d.re),a=sub(d,'estetica'),b=sub(d,'audiovisual'),yu=new Set([...a.yu,...b.yu]),ans=new Set(d.re.map(x=>x.youth_id)),cv=yu.size?Math.round(ans.size*10000/yu.size)/100:0;h.innerHTML=`<div class="lp" data-lp-page><div class="lp-head"><div><h2 style="margin:0">LABPOCA</h2><p class="lp-muted">Estética (LABPOCA) e Audiovisual (LABSTUDIO). Oficinas, ações e participantes demonstram o desenvolvimento; <b>somente a pesquisa mensal alimenta o indicador 6.6.</b></p></div><div class="lp-actions"><input class="input" type="month" min="2025-10" max="2027-03" value="${esc(m)}" data-lp-month><button class="btn secondary" data-lp-refresh>Atualizar</button></div></div><section class="lp-card"><div class="lp-head"><div><h3 style="margin:0">Indicador 6.6 · Satisfação com recursos</h3><div class="lp-muted">Satisfeito = nota geral 4 ou 5 · meta mínima 85%.</div></div><div class="lp-actions"><button class="btn primary" data-lp-report>${d.mr?.submission_id?'Atualizar evidência':'Gerar evidência mensal'}</button>${d.mr?.submission_id?'<button class="btn secondary" data-lp-pdf>PDF</button><button class="btn secondary" data-lp-docx>DOCX</button>':''}</div></div><div class="lp-kpis" style="margin-top:10px"><div class="lp-kpi"><span>Resultado 6.6</span><b>${o.v.toLocaleString('pt-BR')}%</b></div><div class="lp-kpi"><span>Meta</span><b>85%</b></div><div class="lp-kpi"><span>Respostas</span><b>${o.n}</b></div><div class="lp-kpi"><span>Satisfeitos</span><b>${o.p}</b></div><div class="lp-kpi"><span>Participantes</span><b>${yu.size}</b></div><div class="lp-kpi"><span>Cobertura pesquisa</span><b>${cv.toLocaleString('pt-BR')}%</b></div></div><div class="lp-progress" style="margin-top:9px"><i style="width:${Math.min(100,o.v)}%"></i></div></section><div class="lp-two">${areaHtml(d,'estetica')}${areaHtml(d,'audiovisual')}</div></div>`;window.CRJLabpocaData=d;window.dispatchEvent(new CustomEvent('crj:labpoca-rendered',{detail:d}))}catch(e){h.innerHTML=`<div class="notice danger"><b>Não foi possível abrir o LABPOCA.</b><br>${esc(e.message||String(e))}</div>`}}
window.CRJLabpoca={db,api,esc,area,mon,ms,nx,load,sub,sat,render,user,roles:S};
function pulse(){nav().catch(()=>{});if(location.hash.startsWith('#labpoca'))render().catch(()=>{})}const schedule=()=>{clearTimeout(t);t=setTimeout(pulse,55)};window.addEventListener('hashchange',schedule);window.addEventListener('crj:route-rendered',schedule);window.addEventListener('crj:features-ready',schedule);new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});css();schedule();
})();