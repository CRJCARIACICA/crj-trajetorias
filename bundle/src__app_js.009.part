function bindSignaturePadV2(canvas){
  const ctx=canvas.getContext('2d');let drawing=false,last=null,dirty=false;
  const resize=()=>{const r=canvas.getBoundingClientRect(),dpr=window.devicePixelRatio||1;canvas.width=Math.max(1,Math.floor(r.width*dpr));canvas.height=Math.max(1,Math.floor(r.height*dpr));ctx.setTransform(dpr,0,0,dpr,0,0);ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#173f38'};resize();
  const pos=e=>{const r=canvas.getBoundingClientRect(),p=e.touches?.[0]||e;return {x:p.clientX-r.left,y:p.clientY-r.top}};
  const start=e=>{e.preventDefault();drawing=true;last=pos(e)};
  const move=e=>{if(!drawing)return;e.preventDefault();const p=pos(e);ctx.beginPath();ctx.moveTo(last.x,last.y);ctx.lineTo(p.x,p.y);ctx.stroke();last=p;dirty=true};
  const end=()=>{drawing=false;last=null};
  canvas.addEventListener('pointerdown',start);canvas.addEventListener('pointermove',move);window.addEventListener('pointerup',end);
  return {isDirty:()=>dirty,clear:()=>{ctx.clearRect(0,0,canvas.width,canvas.height);dirty=false},data:()=>canvas.toDataURL('image/png')};
}
async function pageWorkshopDetailV2(id){
  const workshops=await listWorkshops(),w=workshops.find(x=>x.id===id);if(!w)return '<div class="notice danger">Oficina nao encontrada.</div>';
  const month=route().params.get('month')||currentMonth();
  const [sessions,roster,attendance,guests,provisional,stats,youth,planHeaders,team]=await Promise.all([listWorkshopSessions(id,40),workshopRoster(id),listWorkshopAttendance(id),listGuestParticipations(id),listProvisionalPeople(),listProvisionalParticipationStats(),listYouth(''),listWorkshopMonthlyPlans(month),listTeam()]);
  const planHeader=(planHeaders||[]).find(p=>p.workshop_id===id)||null;
  const planBundle=planHeader?await getWorkshopMonthlyPlan(planHeader.id):null;
  const plannedLessons=(planBundle?.lessons||[]).filter(x=>x.included!==false).sort((a,b)=>String(a.scheduled_date).localeCompare(String(b.scheduled_date))||Number(a.lesson_number)-Number(b.lesson_number));
  const sessionByLesson=new Map(sessions.filter(s=>s.plan_lesson_id).map(s=>[s.plan_lesson_id,s]));
  const today=new Date().toISOString().slice(0,10);
  const nextPlanned=plannedLessons.find(l=>!sessionByLesson.has(l.id)&&String(l.scheduled_date)>=today)||plannedLessons.find(l=>!sessionByLesson.has(l.id))||null;
  const teamMap=new Map(team.map(x=>[x.id,x.display_name]));
  const canFollow=['coordenacao_geral','educador','oficineiro'].includes(state.user?.role),canChangeEducator=['coordenacao_geral','educador'].includes(state.user?.role);
  const sessionId=route().params.get('session')||sessions[0]?.id||'',session=sessions.find(x=>x.id===sessionId)||sessions[0]||null;
  const sheet=session?await getWorkshopAttendanceSheet(session.id):null;
  const enrolled=new Set(roster.map(x=>x.youth_id)),counts={};for(const a of attendance)if(a.present)counts[a.youth_id]=(counts[a.youth_id]||0)+1;
  const youthAlerts=youth.filter(y=>(counts[y.id]||0)>=4&&!enrolled.has(y.id)).sort((a,b)=>(counts[b.id]||0)-(counts[a.id]||0));
  const sm=new Map(stats.map(x=>[x.provisional_person_id,x]));
  const provisionalInWorkshop=[...new Set(guests.map(x=>x.provisional_person_id))].map(pid=>provisional.find(p=>p.id===pid)).filter(Boolean);
  const provAlerts=provisionalInWorkshop.filter(p=>(sm.get(p.id)?.total||0)>=3);
  const sessionAttendance=session?attendance.filter(a=>a.session_id===session.id):[];
  const sessionGuests=session?guests.filter(g=>g.session_id===session.id):[];
  return `<div class="page-head"><div><h2>${esc(w.name)}</h2><p>${esc(w.category||'')} · ${esc(w.days||'')} · ${esc(String(w.start_time||'').slice(0,5))}${w.end_time?'–'+esc(String(w.end_time).slice(0,5)):''}</p></div><div class="actions"><button class="btn" data-nav="educador?view=oficinas">Voltar</button>${canFollow?`<button class="btn primary" data-action="session" data-workshop="${w.id}">+ Registrar aula ${eduGoalInfo('aula')}</button>`:''}</div></div>
  <div class="grid cards"><div class="card kpi"><div class="label">Inscritos ativos</div><div class="value">${roster.length}</div><div class="meta">${eduGoalInfo('inscricao_oficina')}</div></div><div class="card kpi"><div class="label">Presencas nominais</div><div class="value">${attendance.filter(x=>x.present).length}</div><div class="meta">${eduGoalInfo('presenca')}</div></div><div class="card kpi"><div class="label">Participantes provisórios</div><div class="value">${provisionalInWorkshop.length}</div><div class="meta">ainda sem Formulario Inicial</div></div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Aula / lista atual</h3><p>${session?fmtDate(session.session_date)+' · '+String(session.start_time||'').slice(0,5)+'–'+String(session.end_time||'').slice(0,5)+' · Educador: '+(teamMap.get(session.educator_user_id)||'não definido'):(nextPlanned?'Próxima prevista: Aula '+nextPlanned.lesson_number+' · '+fmtDate(nextPlanned.scheduled_date)+' · '+String(nextPlanned.start_time||'').slice(0,5)+'–'+String(nextPlanned.end_time||'').slice(0,5):'Nenhuma aula planejada ou registrada.')}</p></div>${session?`<select data-session-select>${sessions.map(s=>`<option value="${s.id}" ${s.id===session.id?'selected':''}>${fmtDate(s.session_date)} · ${String(s.start_time||'').slice(0,5)}</option>`).join('')}</select>`:''}</div>${session?`<div class="actions"><button class="btn primary" data-add-workshop-participant="${session.id}">+ Registrar participante ${eduGoalInfo('presenca')}</button><button class="btn secondary" data-open-checkin="${session.id}">Abrir lista virtual ${eduGoalInfo('checkin_virtual')}</button><button class="btn" data-generate-attendance="${session.id}">Gerar lista oficial ${eduGoalInfo('lista_oficial')}</button>${canChangeEducator?`<button class="btn ghost" data-change-session-educator="${session.id}">Alterar educador</button>`:''}</div>`:(nextPlanned?`<div class="notice info"><b>${esc(nextPlanned.theme||('Aula '+nextPlanned.lesson_number))}</b><br>${esc(workshopLocationLabel({location_type:nextPlanned.location_type,location_other:nextPlanned.location_other}))}</div><div class="actions">${canFollow?`<button class="btn primary" data-follow-planned-lesson="${nextPlanned.id}">Acompanhar esta aula</button>`:''}<button class="btn" data-planned-list-pdf="${nextPlanned.id}">Lista PDF</button><button class="btn" data-planned-list-docx="${nextPlanned.id}">Lista DOCX</button></div>`:'<div class="notice warn">Crie ou sincronize o planejamento mensal para gerar as aulas e listas previstas.</div>')}</div>
  <div class="card"><h3>Alertas de acompanhamento</h3>${provAlerts.map(p=>{const st=sm.get(p.id);return `<div class="workshop-alert"><b>${esc(p.full_name)} · ${st?.total||0} participacoes gerais</b><span>A partir da 3ª participacao, convide para preencher o Formulario Inicial.</span><button class="btn" data-convert-provisional="${p.id}">Iniciar cadastro ${eduGoalInfo('cadastro')}</button></div>`}).join('')}${youthAlerts.map(y=>`<div class="workshop-alert"><b>${esc(y.preferred_name||y.full_name)} · ${counts[y.id]} participacoes nesta oficina</b><span>Ultrapassou 3 participacoes e ainda nao possui inscricao formal nesta oficina.</span><button class="btn primary" data-formal-enroll="${y.id}">Fazer inscricao ${eduGoalInfo('inscricao_oficina')}</button></div>`).join('')||(!provAlerts.length&&!youthAlerts.length?'<div class="empty">Nenhum alerta pendente.</div>':'')}</div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><h3>Jovens inscritos</h3>${roster.map(r=>`<div class="workshop-roster-row"><div><b>${esc(r.youth?.preferred_name||r.youth?.full_name)}</b><span class="muted">CPF final ${esc(String(r.youth?.cpf||'').replace(/\D/g,'').slice(-4)||'----')} · ${counts[r.youth_id]||0} presencas</span></div><span class="pill success">Inscrito</span></div>`).join('')||'<div class="empty">Nenhum jovem inscrito.</div>'}</div><div class="card"><h3>Participantes ainda sem cadastro</h3>${provisionalInWorkshop.map(p=>{const st=sm.get(p.id);return `<div class="workshop-roster-row"><div><b>${esc(p.full_name)}</b><span class="muted">${st?.by_workshop?.[id]||0} nesta oficina · ${st?.total||0} participacoes gerais</span></div>${(st?.total||0)>=3?`<button class="btn" data-convert-provisional="${p.id}">Convidar cadastro</button>`:'<span class="pill warn">Provisorio</span>'}</div>`}).join('')||'<div class="empty">Nenhum participante provisório.</div>'}</div></div>
  <div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Aulas previstas pelo planejamento</h3><p>As listas são preparadas a partir das datas, horários e locais planejados. A execução só é contabilizada quando a aula é acompanhada/registrada.</p></div><span class="pill info">${plannedLessons.length} prevista(s)</span></div><div class="educator-planned-lists">${plannedLessons.map(l=>{const done=sessionByLesson.get(l.id);return `<div class="educator-planned-list-row"><div><b>Aula ${l.lesson_number} · ${fmtDate(l.scheduled_date)}</b><span>${String(l.start_time||'').slice(0,5)}–${String(l.end_time||'').slice(0,5)} · ${esc(workshopLocationLabel({location_type:l.location_type,location_other:l.location_other}))}</span><small>${esc(l.theme||('Aula '+l.lesson_number))}</small></div><div class="actions">${done?`<span class="pill success">Acompanhada</span><button class="btn primary" data-nav="oficina/${id}?session=${done.id}">Abrir aula</button>`:`<span class="pill warn">Planejada</span>${canFollow?`<button class="btn primary" data-follow-planned-lesson="${l.id}">Acompanhar aula</button>`:''}`}<button class="btn ghost" data-planned-list-pdf="${l.id}">PDF</button><button class="btn ghost" data-planned-list-docx="${l.id}">DOCX</button></div></div>`}).join('')||'<div class="empty">Nenhuma aula prevista neste mês.</div>'}</div></div>
  ${session?`<div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Registros desta aula</h3><p>Disponível durante a aula e depois para correção da equipe.</p></div><span class="pill">${sessionAttendance.length+sessionGuests.length} registro(s)</span></div>
    <div class="session-presence-list">
      ${sessionAttendance.map(a=>{const y=youth.find(x=>x.id===a.youth_id);return `<div class="session-presence-row"><div><b>${esc(y?.preferred_name||y?.full_name||'Jovem')}</b><span>Nascimento: ${fmtDate(y?.birth_date)} · CPF final ${esc(String(y?.cpf||'').replace(/\D/g,'').slice(-4)||'----')}</span><small>${esc(a.notes||'Sem observação')}</small></div><div class="actions"><span class="pill ${a.present?'success':'warn'}">${a.present?'Presente':'Ausente'}</span><button class="btn ghost" data-edit-attendance="${a.id}">Editar</button><button class="btn danger" data-remove-attendance="${a.id}">Remover</button></div></div>`}).join('')}
      ${sessionGuests.map(g=>{const p=provisional.find(x=>x.id===g.provisional_person_id);return `<div class="session-presence-row visitor"><div><b>${esc(p?.full_name||'Visitante')}</b><span>Nascimento: ${fmtDate(p?.birth_date)} · CPF final ${esc(String(p?.cpf||'').replace(/\D/g,'').slice(-4)||'----')}</span><small>Visitante · ${esc(p?.neighborhood||'Bairro não informado')}</small></div><div class="actions"><span class="pill warn">Visitante</span><button class="btn ghost" data-edit-guest="${g.id}" data-person="${g.provisional_person_id}">Editar</button><button class="btn danger" data-remove-guest="${g.id}">Remover</button></div></div>`}).join('')}
      ${(!sessionAttendance.length&&!sessionGuests.length)?'<div class="empty">Nenhum registro nesta aula.</div>':''}
    </div></div>`:''}
  ${session&&sheet?`<div class="card attendance-sheet-card" style="margin-top:16px">
    <div class="page-head" style="margin-bottom:10px">
      <div><h3 style="margin:0">Lista de Presença e Contato · Anexo 2</h3><p>Pré-visualização oficial atualizada automaticamente a partir dos registros desta aula.</p></div>
      <div class="actions"><span class="pill success" data-sheet-count>${Number(sheet.participant_count||0)} participante(s)</span><button class="btn" data-refresh-sheet>Atualizar</button><button class="btn secondary" data-open-sheet-preview>Ampliar prévia</button><button class="btn primary" data-sheet-pdf>PDF</button><button class="btn secondary" data-sheet-docx>DOCX</button><button class="btn" data-sheet-print>Imprimir</button></div>
    </div>
    <div data-sheet-preview>${workshopAttendancePreviewHtmlV2(sheet)}</div>
  </div>`:''}
  <div class="card" style="margin-top:16px"><h3>Historico de aulas</h3>${sessions.map(s=>`<div class="agenda-row"><div><b>${fmtDate(s.session_date)} · ${String(s.start_time||'').slice(0,5)}–${String(s.end_time||'').slice(0,5)}</b><span>${esc(s.content||'Sem conteudo registrado')} · ${esc(workshopLocationLabel({location_type:s.location_type||w.location_type,location_other:s.location_other||w.location_other}))} · ${Number(s.duration_hours||0)}h · Educador: ${esc(teamMap.get(s.educator_user_id)||'não definido')} · CFDH ${Number(s.cfdh_minutes||0)}min ${eduGoalInfo('aula')}</span></div><button class="btn" data-nav="oficina/${id}?session=${s.id}">Abrir</button></div>`).join('')||'<div class="empty">Nenhuma aula registrada.</div>'}</div>`;
}
async function openFormalEnrollmentV2(workshopId,youthObj){
  try{
    const [workshops,context]=await Promise.all([listWorkshops(),getYouthWorkshopEnrollmentContext(youthObj.id)]);
    const enrolled=new Set(context?.enrolled_workshop_ids||[]);
    const active=workshops.filter(w=>w.active);
    const available=active.filter(w=>!enrolled.has(w.id));
    const enrolledNames=active.filter(w=>enrolled.has(w.id)).map(w=>w.name);
    if(!available.length){
      modal('Inscrição em oficinas','<div class="stack"><div class="notice success"><b>'+esc(youthObj.preferred_name||youthObj.full_name)+'</b><br>Este jovem já possui inscrição ativa em todas as oficinas disponíveis.</div>'+(enrolledNames.length?'<div class="check-grid">'+enrolledNames.map(n=>'<div class="check"><span>'+esc(n)+'</span><span class="pill success">Inscrito</span></div>').join('')+'</div>':'')+'</div>');
      return;
    }
    const reuse=Boolean(context?.has_reusable_signature);
    const options=available.map(w=>'<label class="check workshop-enrollment-option"><input type="checkbox" name="workshop_ids" value="'+w.id+'" '+(w.id===workshopId?'checked':'')+'><span><b>'+esc(w.name)+'</b><small>'+esc(workshopScheduleLabel(w))+' · '+esc(workshopLocationLabel(w))+'</small></span></label>').join('');
    const already=enrolledNames.length?'<div class="field"><label>Já possui inscrição ativa</label><div class="check-grid">'+enrolledNames.map(n=>'<div class="check"><span>'+esc(n)+'</span><span class="pill success">Inscrito</span></div>').join('')+'</div></div>':'';
    const signatureHtml=reuse
      ?'<div class="notice success"><b>Assinatura já registrada</b><br>A mesma assinatura será reutilizada automaticamente nas novas oficinas selecionadas.</div><label class="check"><input type="checkbox" data-new-enrollment-signature><span>Coletar uma nova assinatura agora</span></label><div data-new-signature-wrap hidden><div class="field"><label>Nova assinatura manuscrita</label><canvas class="signature-pad" data-signature-pad></canvas><div class="actions"><button type="button" class="btn" data-clear-signature>Limpar assinatura</button></div></div></div>'
      :'<div class="notice warn"><b>Primeira inscrição formal</b><br>É necessário coletar a assinatura uma única vez. Ela poderá ser reutilizada nas próximas inscrições.</div><div class="field"><label>Assinatura manuscrita</label><canvas class="signature-pad" data-signature-pad></canvas><div class="actions"><button type="button" class="btn" data-clear-signature>Limpar assinatura</button></div></div>';
    modal('Inscrição em uma ou mais oficinas','<form id="formal-enrollment-form" class="stack"><input type="hidden" name="youth_id" value="'+youthObj.id+'"><div class="notice"><b>'+esc(youthObj.preferred_name||youthObj.full_name)+'</b><br>Selecione uma ou mais oficinas disponíveis. Os dados do cadastro e a assinatura válida do jovem serão reaproveitados.</div>'+already+'<div class="field"><label>Oficinas disponíveis</label><div class="check-grid workshop-enrollment-grid">'+options+'</div><small>É possível realizar várias inscrições na mesma operação.</small></div><div class="form-grid"><div class="field"><label>CPF</label><input class="input" name="cpf" value="'+esc(youthObj.cpf||'')+'" required></div><div class="field"><label>E-mail</label><input class="input" type="email" name="email" value="'+esc(youthObj.email||'')+'" required></div></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood" value="'+esc(youthObj.neighborhood||'')+'" required></div><div class="field"><label>Senha para confirmar presença</label><input class="input" type="password" name="secret" minlength="4" maxlength="32" required><small>A mesma senha será configurada nas oficinas selecionadas nesta inscrição.</small></div>'+signatureHtml+'<button class="btn primary">Concluir inscrição nas oficinas '+eduGoalInfo('inscricao_oficina')+'</button></form>');
    const form=document.querySelector('#formal-enrollment-form');
    const canvas=form?.querySelector('[data-signature-pad]');
    const pad=canvas?bindSignaturePadV2(canvas):null;
    decorateEduGoalForm(form,'inscricao_oficina');
    form?.querySelector('[data-clear-signature]')?.addEventListener('click',()=>pad?.clear());
    const newSigToggle=form?.querySelector('[data-new-enrollment-signature]');
    const sigWrap=form?.querySelector('[data-new-signature-wrap]');
    newSigToggle?.addEventListener('change',()=>{if(sigWrap)sigWrap.hidden=!newSigToggle.checked});
    form?.addEventListener('submit',async e=>{
      e.preventDefault();
      const workshopIds=[...form.querySelectorAll('[name="workshop_ids"]:checked')].map(x=>x.value);
      if(!workshopIds.length){toast('Selecione ao menos uma oficina.','danger');return}
      const p=parseForm(form);
      let signatureData=null;
      const collectingNew=!reuse||Boolean(newSigToggle?.checked);
      if(collectingNew){
        if(!pad?.isDirty()){toast('Solicite a assinatura do jovem no campo de desenho.','danger');return}
        signatureData=pad.data();
      }
      const btn=form.querySelector('button[type="submit"],button.btn.primary'),original=btn?.textContent||'';
      if(btn){btn.disabled=true;btn.textContent='Inscrevendo...'}
      try{
        const result=await registerWorkshopEnrollments({...p,youth_id:youthObj.id,workshop_ids:workshopIds,signature_data:signatureData});
        document.querySelector('#modal')?.remove();
        toast((result?.registered_count||workshopIds.length)+' oficina(s) vinculada(s) ao jovem');
        await render();
      }catch(err){
        toast(err.message,'danger');
        if(btn){btn.disabled=false;btn.textContent=original}
      }
    });
  }catch(err){toast(err.message,'danger')}
}

async function openPlannedLessonFollowV2(workshop,lesson,plan,existingSessions=[]){
  const existing=existingSessions.find(s=>s.plan_lesson_id===lesson.id);
  if(existing){nav('oficina/'+workshop.id+'?session='+existing.id);return}
  const team=await listTeam(),educators=team.filter(x=>x.active&&x.role==='educador');
  const defaultEducator=plan?.educator_user_id||workshop.educator_user_id||state.user?.id||'';
  const html='<form id="planned-session-form" class="stack">'+
    '<div class="notice info"><b>'+esc(workshop.name)+' · Aula '+esc(lesson.lesson_number)+'</b><br>'+esc(lesson.theme||'Aula planejada')+'</div>'+
    '<div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="session_date" value="'+esc(lesson.scheduled_date||'')+'" required></div><div class="field"><label>Educador(a) acompanhando</label><select name="educator_user_id" required><option value="">Selecione</option>'+educators.map(e=>'<option value="'+e.id+'" '+(e.id===defaultEducator?'selected':'')+'>'+esc(e.display_name)+'</option>').join('')+'</select></div></div>'+
    '<div class="form-grid"><div class="field"><label>Início</label><input class="input" type="time" name="start_time" value="'+esc(String(lesson.start_time||'').slice(0,5))+'" required></div><div class="field"><label>Fim</label><input class="input" type="time" name="end_time" value="'+esc(String(lesson.end_time||'').slice(0,5))+'" required></div></div>'+
    '<div class="form-grid"><div class="field"><label>Local</label><select name="location_type"><option value="">Usar local da oficina</option>'+['LABPoca','Sala de computadores','Sala de dança','Trampo Coletivo','Externa','Outro'].map(x=>'<option value="'+x+'">'+x+'</option>').join('')+'</select></div><div class="field"><label>Outro / externo</label><input class="input" name="location_other" value="'+esc(lesson.location_other||'')+'"></div></div>'+
    '<div class="field"><label>Conteúdo / atividade executada</label><textarea name="content">'+esc(lesson.proposed_activities||lesson.theme||'')+'</textarea></div>'+
    '<div class="field"><label>CFDH dentro da aula (minutos)</label><input class="input" type="number" min="0" step="5" name="cfdh_minutes" value="0"></div>'+
    '<div class="field"><label>Observação</label><textarea name="notes">'+esc(lesson.observations||'')+'</textarea></div>'+
    '<button class="btn primary">Abrir acompanhamento e lista de presença</button></form>';
  modal('Acompanhar aula planejada',html);
  const form=document.querySelector('#planned-session-form'),loc=form?.querySelector('[name="location_type"]');
  if(loc)loc.value=lesson.location_type||workshop.location_type||'';
  decorateEduGoalForm(form,'aula');
  form?.addEventListener('submit',async e=>{
    e.preventDefault();const p=parseForm(e.target);
    if(!p.educator_user_id){toast('Selecione o educador que está acompanhando a aula.','danger');return}
    if(!p.start_time||!p.end_time||p.end_time<=p.start_time){toast('Confira o horário planejado.','danger');return}
    if(['Externa','Outro'].includes(p.location_type)&&!String(p.location_other||'').trim()){toast('Descreva o local.','danger');return}
    try{
      const saved=await createWorkshopSession({...p,workshop_id:workshop.id,calendar_entry_id:lesson.calendar_entry_id||null,plan_lesson_id:lesson.id});
      document.querySelector('#modal')?.remove();
      toast('Acompanhamento da aula aberto');
      nav('oficina/'+workshop.id+'?session='+saved.id);
      await render();
    }catch(err){toast(err.message,'danger')}
  });
}
async function changeSessionEducatorV2(session){
  const team=await listTeam(),educators=team.filter(x=>x.active&&x.role==='educador');
  modal('Alterar educador da aula','<form id="change-session-educator-form" class="stack"><div class="notice"><b>'+esc(fmtDate(session.session_date))+' · '+esc(String(session.start_time||'').slice(0,5))+'</b><br>Esta alteração vale somente para esta aula e fica registrada no histórico.</div><div class="field"><label>Educador(a) acompanhando</label><select name="educator_user_id" required><option value="">Selecione</option>'+educators.map(e=>'<option value="'+e.id+'" '+(e.id===session.educator_user_id?'selected':'')+'>'+esc(e.display_name)+'</option>').join('')+'</select></div><button class="btn primary">Salvar educador da aula</button></form>');
  document.querySelector('#change-session-educator-form')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);try{await updateWorkshopSession(session.id,{educator_user_id:p.educator_user_id});document.querySelector('#modal')?.remove();toast('Educador da aula atualizado');await render()}catch(err){toast(err.message,'danger')}});
}

async function bindWorkshopDetailV2(id){
  const workshops=await listWorkshops(),w=workshops.find(x=>x.id===id);if(!w)return;
  const month=route().params.get('month')||currentMonth();
  const [sessions,youth,provisional,planHeaders]=await Promise.all([listWorkshopSessions(id,40),listYouth(''),listProvisionalPeople(),listWorkshopMonthlyPlans(month)]);
  const planHeader=(planHeaders||[]).find(p=>p.workshop_id===id)||null;
  const planBundle=planHeader?await getWorkshopMonthlyPlan(planHeader.id):null;
  const plannedLessons=(planBundle?.lessons||[]).filter(x=>x.included!==false);
  const sessionId=route().params.get('session')||sessions[0]?.id||'';
  const session=sessions.find(x=>x.id===sessionId)||sessions[0]||null;
  const sheet=session?await getWorkshopAttendanceSheet(session.id):null;
  document.querySelector('[data-session-select]')?.addEventListener('change',e=>nav(`oficina/${id}?session=${e.target.value}`));
  document.querySelectorAll('[data-follow-planned-lesson]').forEach(b=>b.addEventListener('click',async()=>{const lesson=plannedLessons.find(x=>x.id===b.dataset.followPlannedLesson);if(lesson)await openPlannedLessonFollowV2(w,lesson,planBundle?.plan,sessions)}));
  document.querySelectorAll('[data-planned-list-pdf]').forEach(b=>b.addEventListener('click',async()=>{try{await downloadWorkshopPlannedAttendance(b.dataset.plannedListPdf,'pdf');toast('PDF da lista planejada gerado')}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-planned-list-docx]').forEach(b=>b.addEventListener('click',async()=>{try{await downloadWorkshopPlannedAttendance(b.dataset.plannedListDocx,'docx');toast('DOCX da lista planejada gerado')}catch(err){toast(err.message,'danger')}}));
  document.querySelector('[data-change-session-educator]')?.addEventListener('click',async()=>{if(session)await changeSessionEducatorV2(session)});
  document.querySelectorAll('[data-formal-enroll]').forEach(b=>b.addEventListener('click',async()=>{const y=youth.find(x=>x.id===b.dataset.formalEnroll);if(y)await openFormalEnrollmentV2(id,y)}));
  document.querySelectorAll('[data-convert-provisional]').forEach(b=>b.addEventListener('click',()=>nav(`novo-jovem?provisional=${b.dataset.convertProvisional}`)));
  document.querySelector('[data-add-workshop-participant]')?.addEventListener('click',async b=>{
    try{
      const sid=b.currentTarget.dataset.addWorkshopParticipant;
      const x=await openWorkshopCheckin(sid);
      const url=new URL('checkin.html',location.href);
      url.searchParams.set('token',x.public_token);
      modal('Registrar participante',`<div class="stack"><div class="notice info"><b>Fluxo individual obrigatório</b><br>Para adicionar uma pessoa, use a mesma lista guiada da aula. Ela verifica CPF, situação do Formulário Inicial, inscrição na oficina, visitante e senha antes de registrar a presença.</div><input class="input" value="${esc(url.href)}" readonly data-checkin-url><div class="actions"><a class="btn primary" href="${esc(url.href)}" target="_blank">Abrir fluxo individual</a><button class="btn secondary" data-copy-guided-link>Copiar link</button></div></div>`);
      document.querySelector('[data-copy-guided-link]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link copiado')});
    }catch(err){toast(err.message,'danger')}
  });
  document.querySelectorAll('[data-edit-attendance]').forEach(b=>b.addEventListener('click',async()=>{
    const all=await listWorkshopAttendance(id),rec=all.find(x=>x.id===b.dataset.editAttendance);if(!rec)return;
    modal('Editar presença',`<form id="edit-attendance-form" class="stack"><div class="field"><label>Situação</label><select name="present"><option value="true" ${rec.present?'selected':''}>Presente</option><option value="false" ${!rec.present?'selected':''}>Ausente</option></select></div><div class="field"><label>Observação</label><textarea name="notes">${esc(rec.notes||'')}</textarea></div><button class="btn primary">Salvar alteração</button></form>`);
    document.querySelector('#edit-attendance-form')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);try{await updateWorkshopAttendanceEntry(rec.id,{present:p.present==='true',notes:p.notes||''});document.querySelector('#modal')?.remove();toast('Presença atualizada');await render()}catch(err){toast(err.message,'danger')}})
  }));
  document.querySelectorAll('[data-remove-attendance]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Remover apenas este lançamento de presença?'))return;try{await removeWorkshopAttendanceEntry(b.dataset.removeAttendance);toast('Lançamento removido');await render()}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-edit-guest]').forEach(b=>b.addEventListener('click',async()=>{
    const people=await listProvisionalPeople(),p=people.find(x=>x.id===b.dataset.person);if(!p)return;
    modal('Editar visitante',`<form id="edit-guest-form" class="stack"><div class="field"><label>Nome completo</label><input class="input" name="full_name" value="${esc(p.full_name||'')}" required></div><div class="form-grid"><div class="field"><label>Data de nascimento</label><input class="input" type="date" name="birth_date" value="${esc(p.birth_date||'')}"></div><div class="field"><label>CPF</label><input class="input" name="cpf" value="${esc(p.cpf||'')}"></div></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood" value="${esc(p.neighborhood||'')}"></div><button class="btn primary">Salvar visitante</button></form>`);
    document.querySelector('#edit-guest-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await updateProvisionalPerson(p.id,parseForm(e.target));document.querySelector('#modal')?.remove();toast('Visitante atualizado');await render()}catch(err){toast(err.message,'danger')}})
  }));
  document.querySelectorAll('[data-remove-guest]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Remover apenas esta visita da aula?'))return;try{await removeWorkshopGuestParticipation(b.dataset.removeGuest);toast('Visita removida');await render()}catch(err){toast(err.message,'danger')}}));
  document.querySelector('[data-open-checkin]')?.addEventListener('click',async b=>{try{const x=await openWorkshopCheckin(b.currentTarget.dataset.openCheckin),url=new URL('checkin.html',location.href);url.searchParams.set('token',x.public_token);modal('Lista virtual aberta',`<div class="stack"><div class="notice success">A lista individual foi aberta. Ela verifica a situação da trajetória de cada jovem e mostra somente a próxima etapa necessária antes de registrar a presença.</div><input class="input" value="${esc(url.href)}" readonly data-checkin-url><div class="actions"><button class="btn primary" data-copy-checkin>Copiar link</button><a class="btn secondary" href="${esc(url.href)}" target="_blank">Abrir lista</a></div></div>`);document.querySelector('[data-copy-checkin]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link copiado')})}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-refresh-sheet]')?.addEventListener('click',async()=>{try{const latest=await getWorkshopAttendanceSheet(session.id);updateAttendanceSheetDomV2(latest)}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-open-sheet-preview]')?.addEventListener('click',async()=>{
    try{
      const latest=await getWorkshopAttendanceSheet(session.id);
      modal('Pré-visualização · Anexo 2',`<div class="methodology-preview-modal">${workshopAttendancePreviewHtmlV2(latest)}</div>`);
      document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }catch(err){toast(err.message,'danger')}
  });
  if(window.__crjAttendanceSheetPoll){
    clearInterval(window.__crjAttendanceSheetPoll);
    window.__crjAttendanceSheetPoll=null;
  }
  if(session){
    const activeSessionId=session.id;
    window.__crjAttendanceSheetPoll=setInterval(async()=>{
      if(!location.hash.includes('oficina/'+id)){
        clearInterval(window.__crjAttendanceSheetPoll);
        window.__crjAttendanceSheetPoll=null;
        return;
      }
      if(document.querySelector('#modal'))return;
      const selector=document.querySelector('[data-session-select]');
      if(selector&&selector.value!==activeSessionId)return;
      try{
        const latest=await getWorkshopAttendanceSheet(activeSessionId);
        if(selector&&selector.value!==activeSessionId)return;
        updateAttendanceSheetDomV2(latest);
      }catch{}
    },8000);
  }
  async function exportCurrentSheet(format,button){
    const original=button?.textContent||'';
    try{
      if(button){button.disabled=true;button.textContent='Gerando...'}
      const latest=await getWorkshopAttendanceSheet(session.id);
      updateAttendanceSheetDomV2(latest);
      const sub=await createWorkshopAttendanceSubmission(session.id);
      const file=await downloadFormSubmission(sub.id,format);
      toast((format==='docx'?'DOC':'PDF')+' baixado'+(file?.filename?' · '+file.filename:''));
    }catch(err){
      toast(err?.message||'Não foi possível gerar o documento.','danger');
    }finally{
      if(button){button.disabled=false;button.textContent=original}
    }
  }
  document.querySelector('[data-sheet-pdf]')?.addEventListener('click',e=>exportCurrentSheet('pdf',e.currentTarget));
  document.querySelector('[data-sheet-docx]')?.addEventListener('click',e=>exportCurrentSheet('docx',e.currentTarget));
  document.querySelector('[data-sheet-print]')?.addEventListener('click',async()=>{try{printAttendanceSheetV2(await getWorkshopAttendanceSheet(session.id))}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-generate-attendance]')?.addEventListener('click',async()=>{try{const sub=await createWorkshopAttendanceSubmission(session.id);modal('Lista oficial atualizada',`<div class="stack"><div class="notice success">A Lista de Presença e Contato foi consolidada com ${Number(sheet?.participant_count||0)} participante(s).</div><div class="actions"><button class="btn primary" data-auto-list-pdf>PDF</button><button class="btn secondary" data-auto-list-docx>DOCX</button><button class="btn" data-auto-list-print>Imprimir</button></div></div>`);document.querySelector('[data-auto-list-pdf]')?.addEventListener('click',async e=>{const b=e.currentTarget,o=b.textContent;try{b.disabled=true;b.textContent='Gerando...';await downloadFormSubmission(sub.id,'pdf');toast('PDF baixado')}catch(err){toast(err?.message||'Falha ao gerar PDF','danger')}finally{b.disabled=false;b.textContent=o}});document.querySelector('[data-auto-list-docx]')?.addEventListener('click',async e=>{const b=e.currentTarget,o=b.textContent;try{b.disabled=true;b.textContent='Gerando...';await downloadFormSubmission(sub.id,'docx');toast('DOC baixado')}catch(err){toast(err?.message||'Falha ao gerar DOC','danger')}finally{b.disabled=false;b.textContent=o}});document.querySelector('[data-auto-list-print]')?.addEventListener('click',async()=>{try{printAttendanceSheetV2(await getWorkshopAttendanceSheet(session.id))}catch(err){toast(err.message,'danger')}})}catch(err){toast(err.message,'danger')}});

}
