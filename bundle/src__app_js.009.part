function bindSignaturePadV2(canvas){
  const ctx=canvas.getContext('2d');let drawing=false,last=null,dirty=false;
  const resize=()=>{const r=canvas.getBoundingClientRect(),dpr=window.devicePixelRatio||1;canvas.width=Math.max(1,Math.floor(r.width*dpr));canvas.height=Math.max(1,Math.floor(r.height*dpr));ctx.setTransform(dpr,0,0,dpr,0,0);ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#173f38'};resize();
  const pos=e=>{const r=canvas.getBoundingClientRect(),p=e.touches?.[0]||e;return {x:p.clientX-r.left,y:p.clientY-r.top}};
  const start=e=>{e.preventDefault();drawing=true;last=pos(e)};
  const move=e=>{if(!drawing)return;e.preventDefault();const p=pos(e);ctx.beginPath();ctx.moveTo(last.x,last.y);ctx.lineTo(p.x,p.y);ctx.stroke();last=p;dirty=true};
  const end=()=>{drawing=false;last=null};
  canvas.addEventListener('pointerdown',start);canvas.addEventListener('pointermove',move);window.addEventListener('pointerup',end);
  return {isDirty:()=>dirty,clear:()=>{ctx.clearRect(0,0,canvas.width,canvas.height);dirty=false},data:()=>canvas.toDataURL('image/png')};
}
async function pageWorkshopDetailV2(id){
  const workshops=await listWorkshops(),w=workshops.find(x=>x.id===id);if(!w)return '<div class="notice danger">Oficina nao encontrada.</div>';
  const [sessions,roster,attendance,guests,provisional,stats,youth]=await Promise.all([listWorkshopSessions(id,40),workshopRoster(id),listWorkshopAttendance(id),listGuestParticipations(id),listProvisionalPeople(),listProvisionalParticipationStats(),listYouth('')]);
  const sessionId=route().params.get('session')||sessions[0]?.id||'',session=sessions.find(x=>x.id===sessionId)||sessions[0]||null;
  const sheet=session?await getWorkshopAttendanceSheet(session.id):null;
  const enrolled=new Set(roster.map(x=>x.youth_id)),counts={};for(const a of attendance)if(a.present)counts[a.youth_id]=(counts[a.youth_id]||0)+1;
  const youthAlerts=youth.filter(y=>(counts[y.id]||0)>=4&&!enrolled.has(y.id)).sort((a,b)=>(counts[b.id]||0)-(counts[a.id]||0));
  const sm=new Map(stats.map(x=>[x.provisional_person_id,x]));
  const provisionalInWorkshop=[...new Set(guests.map(x=>x.provisional_person_id))].map(pid=>provisional.find(p=>p.id===pid)).filter(Boolean);
  const provAlerts=provisionalInWorkshop.filter(p=>(sm.get(p.id)?.total||0)>=3);
  const sessionAttendance=session?attendance.filter(a=>a.session_id===session.id):[];
  const sessionGuests=session?guests.filter(g=>g.session_id===session.id):[];
  return `<div class="page-head"><div><h2>${esc(w.name)}</h2><p>${esc(w.category||'')} · ${esc(w.days||'')} · ${esc(String(w.start_time||'').slice(0,5))}${w.end_time?'–'+esc(String(w.end_time).slice(0,5)):''}</p></div><div class="actions"><button class="btn" data-nav="educador?view=oficinas">Voltar</button><button class="btn primary" data-action="session" data-workshop="${w.id}">+ Registrar aula ${eduGoalInfo('aula')}</button></div></div>
  <div class="grid cards"><div class="card kpi"><div class="label">Inscritos ativos</div><div class="value">${roster.length}</div><div class="meta">${eduGoalInfo('inscricao_oficina')}</div></div><div class="card kpi"><div class="label">Presencas nominais</div><div class="value">${attendance.filter(x=>x.present).length}</div><div class="meta">${eduGoalInfo('presenca')}</div></div><div class="card kpi"><div class="label">Participantes provisórios</div><div class="value">${provisionalInWorkshop.length}</div><div class="meta">ainda sem Formulario Inicial</div></div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Aula / lista atual</h3><p>${session?fmtDate(session.session_date)+' · '+String(session.start_time||'').slice(0,5)+'–'+String(session.end_time||'').slice(0,5):'Nenhuma aula registrada.'}</p></div>${session?`<select data-session-select>${sessions.map(s=>`<option value="${s.id}" ${s.id===session.id?'selected':''}>${fmtDate(s.session_date)} · ${String(s.start_time||'').slice(0,5)}</option>`).join('')}</select>`:''}</div>${session?`<div class="actions"><button class="btn primary" data-add-workshop-participant="${session.id}">+ Registrar participante ${eduGoalInfo('presenca')}</button><button class="btn secondary" data-open-checkin="${session.id}">Abrir lista virtual ${eduGoalInfo('checkin_virtual')}</button><button class="btn" data-generate-attendance="${session.id}">Gerar lista oficial ${eduGoalInfo('lista_oficial')}</button></div>`:'<div class="notice warn">Registre uma aula para abrir a lista de presenca.</div>'}</div>
  <div class="card"><h3>Alertas de acompanhamento</h3>${provAlerts.map(p=>{const st=sm.get(p.id);return `<div class="workshop-alert"><b>${esc(p.full_name)} · ${st?.total||0} participacoes gerais</b><span>A partir da 3ª participacao, convide para preencher o Formulario Inicial.</span><button class="btn" data-convert-provisional="${p.id}">Iniciar cadastro ${eduGoalInfo('cadastro')}</button></div>`}).join('')}${youthAlerts.map(y=>`<div class="workshop-alert"><b>${esc(y.preferred_name||y.full_name)} · ${counts[y.id]} participacoes nesta oficina</b><span>Ultrapassou 3 participacoes e ainda nao possui inscricao formal nesta oficina.</span><button class="btn primary" data-formal-enroll="${y.id}">Fazer inscricao ${eduGoalInfo('inscricao_oficina')}</button></div>`).join('')||(!provAlerts.length&&!youthAlerts.length?'<div class="empty">Nenhum alerta pendente.</div>':'')}</div></div>
  <div class="grid two" style="margin-top:16px"><div class="card"><h3>Jovens inscritos</h3>${roster.map(r=>`<div class="workshop-roster-row"><div><b>${esc(r.youth?.preferred_name||r.youth?.full_name)}</b><span class="muted">CPF final ${esc(String(r.youth?.cpf||'').replace(/\D/g,'').slice(-4)||'----')} · ${counts[r.youth_id]||0} presencas</span></div><span class="pill success">Inscrito</span></div>`).join('')||'<div class="empty">Nenhum jovem inscrito.</div>'}</div><div class="card"><h3>Participantes ainda sem cadastro</h3>${provisionalInWorkshop.map(p=>{const st=sm.get(p.id);return `<div class="workshop-roster-row"><div><b>${esc(p.full_name)}</b><span class="muted">${st?.by_workshop?.[id]||0} nesta oficina · ${st?.total||0} participacoes gerais</span></div>${(st?.total||0)>=3?`<button class="btn" data-convert-provisional="${p.id}">Convidar cadastro</button>`:'<span class="pill warn">Provisorio</span>'}</div>`}).join('')||'<div class="empty">Nenhum participante provisório.</div>'}</div></div>
  ${session?`<div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Registros desta aula</h3><p>Disponível durante a aula e depois para correção da equipe.</p></div><span class="pill">${sessionAttendance.length+sessionGuests.length} registro(s)</span></div>
    <div class="session-presence-list">
      ${sessionAttendance.map(a=>{const y=youth.find(x=>x.id===a.youth_id);return `<div class="session-presence-row"><div><b>${esc(y?.preferred_name||y?.full_name||'Jovem')}</b><span>Nascimento: ${fmtDate(y?.birth_date)} · CPF final ${esc(String(y?.cpf||'').replace(/\D/g,'').slice(-4)||'----')}</span><small>${esc(a.notes||'Sem observação')}</small></div><div class="actions"><span class="pill ${a.present?'success':'warn'}">${a.present?'Presente':'Ausente'}</span><button class="btn ghost" data-edit-attendance="${a.id}">Editar</button><button class="btn danger" data-remove-attendance="${a.id}">Remover</button></div></div>`}).join('')}
      ${sessionGuests.map(g=>{const p=provisional.find(x=>x.id===g.provisional_person_id);return `<div class="session-presence-row visitor"><div><b>${esc(p?.full_name||'Visitante')}</b><span>Nascimento: ${fmtDate(p?.birth_date)} · CPF final ${esc(String(p?.cpf||'').replace(/\D/g,'').slice(-4)||'----')}</span><small>Visitante · ${esc(p?.neighborhood||'Bairro não informado')}</small></div><div class="actions"><span class="pill warn">Visitante</span><button class="btn ghost" data-edit-guest="${g.id}" data-person="${g.provisional_person_id}">Editar</button><button class="btn danger" data-remove-guest="${g.id}">Remover</button></div></div>`}).join('')}
      ${(!sessionAttendance.length&&!sessionGuests.length)?'<div class="empty">Nenhum registro nesta aula.</div>':''}
    </div></div>`:''}
  ${session&&sheet?`<div class="card attendance-sheet-card" style="margin-top:16px">
    <div class="page-head" style="margin-bottom:10px">
      <div><h3 style="margin:0">Lista de Presença e Contato · Anexo 2</h3><p>Pré-visualização oficial atualizada automaticamente a partir dos registros desta aula.</p></div>
      <div class="actions"><span class="pill success" data-sheet-count>${Number(sheet.participant_count||0)} participante(s)</span><button class="btn" data-refresh-sheet>Atualizar</button><button class="btn secondary" data-open-sheet-preview>Ampliar prévia</button><button class="btn primary" data-sheet-pdf>PDF</button><button class="btn secondary" data-sheet-docx>DOC</button><button class="btn" data-sheet-print>Imprimir</button></div>
    </div>
    <div data-sheet-preview>${workshopAttendancePreviewHtmlV2(sheet)}</div>
  </div>`:''}
  <div class="card" style="margin-top:16px"><h3>Historico de aulas</h3>${sessions.map(s=>`<div class="agenda-row"><div><b>${fmtDate(s.session_date)} · ${String(s.start_time||'').slice(0,5)}–${String(s.end_time||'').slice(0,5)}</b><span>${esc(s.content||'Sem conteudo registrado')} · ${esc(workshopLocationLabel({location_type:s.location_type||w.location_type,location_other:s.location_other||w.location_other}))} · ${Number(s.duration_hours||0)}h · CFDH ${Number(s.cfdh_minutes||0)}min ${eduGoalInfo('aula')}</span></div><button class="btn" data-nav="oficina/${id}?session=${s.id}">Abrir</button></div>`).join('')||'<div class="empty">Nenhuma aula registrada.</div>'}</div>`;
}
function openFormalEnrollmentV2(workshopId,youthObj){
  modal('Inscricao formal na oficina',`<form id="formal-enrollment-form" class="stack"><input type="hidden" name="workshop_id" value="${workshopId}"><input type="hidden" name="youth_id" value="${youthObj.id}"><div class="notice"><b>${esc(youthObj.preferred_name||youthObj.full_name)}</b><br>Os dados abaixo sao pre-preenchidos do Formulario Inicial quando ja existirem. A inscricao guarda uma fotografia desses dados sem alterar o cadastro-base.</div><div class="form-grid"><div class="field"><label>CPF</label><input class="input" name="cpf" value="${esc(youthObj.cpf||'')}" required></div><div class="field"><label>E-mail</label><input class="input" type="email" name="email" value="${esc(youthObj.email||'')}"></div></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood" value="${esc(youthObj.neighborhood||'')}"></div><div class="field"><label>Senha para confirmar presenca</label><input class="input" type="password" name="secret" minlength="4" required><small>O banco guarda apenas o hash da senha.</small></div><div class="field"><label>Assinatura manuscrita</label><canvas class="signature-pad" data-signature-pad></canvas><div class="actions"><button type="button" class="btn" data-clear-signature>Limpar assinatura</button></div></div><button class="btn primary">Concluir inscricao ${eduGoalInfo('inscricao_oficina')}</button></form>`);
  const form=document.querySelector('#formal-enrollment-form'),canvas=form?.querySelector('[data-signature-pad]'),pad=canvas?bindSignaturePadV2(canvas):null;decorateEduGoalForm(form,'inscricao_oficina');form?.querySelector('[data-clear-signature]')?.addEventListener('click',()=>pad?.clear());form?.addEventListener('submit',async e=>{e.preventDefault();if(!pad?.isDirty()){toast('Solicite a assinatura do jovem no campo de desenho.','danger');return}const p=parseForm(e.target);p.signature_data=pad.data();try{await registerWorkshopEnrollment(p);document.querySelector('#modal')?.remove();toast('Inscricao formal registrada');await render()}catch(err){toast(err.message,'danger')}});
}
async function bindWorkshopDetailV2(id){
  const workshops=await listWorkshops(),w=workshops.find(x=>x.id===id);if(!w)return;
  const [sessions,youth,provisional]=await Promise.all([listWorkshopSessions(id,40),listYouth(''),listProvisionalPeople()]);
  const sessionId=route().params.get('session')||sessions[0]?.id||'';
  const session=sessions.find(x=>x.id===sessionId)||sessions[0]||null;
  const sheet=session?await getWorkshopAttendanceSheet(session.id):null;
  document.querySelector('[data-session-select]')?.addEventListener('change',e=>nav(`oficina/${id}?session=${e.target.value}`));
  document.querySelectorAll('[data-formal-enroll]').forEach(b=>b.addEventListener('click',()=>{const y=youth.find(x=>x.id===b.dataset.formalEnroll);if(y)openFormalEnrollmentV2(id,y)}));
  document.querySelectorAll('[data-convert-provisional]').forEach(b=>b.addEventListener('click',()=>nav(`novo-jovem?provisional=${b.dataset.convertProvisional}`)));
  document.querySelector('[data-add-workshop-participant]')?.addEventListener('click',async b=>{
    try{
      const sid=b.currentTarget.dataset.addWorkshopParticipant;
      const x=await openWorkshopCheckin(sid);
      const url=new URL('checkin.html',location.href);
      url.searchParams.set('token',x.public_token);
      modal('Registrar participante',`<div class="stack"><div class="notice info"><b>Fluxo individual obrigatório</b><br>Para adicionar uma pessoa, use a mesma lista guiada da aula. Ela verifica CPF, situação do Formulário Inicial, inscrição na oficina, visitante e senha antes de registrar a presença.</div><input class="input" value="${esc(url.href)}" readonly data-checkin-url><div class="actions"><a class="btn primary" href="${esc(url.href)}" target="_blank">Abrir fluxo individual</a><button class="btn secondary" data-copy-guided-link>Copiar link</button></div></div>`);
      document.querySelector('[data-copy-guided-link]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link copiado')});
    }catch(err){toast(err.message,'danger')}
  });
  document.querySelectorAll('[data-edit-attendance]').forEach(b=>b.addEventListener('click',async()=>{
    const all=await listWorkshopAttendance(id),rec=all.find(x=>x.id===b.dataset.editAttendance);if(!rec)return;
    modal('Editar presença',`<form id="edit-attendance-form" class="stack"><div class="field"><label>Situação</label><select name="present"><option value="true" ${rec.present?'selected':''}>Presente</option><option value="false" ${!rec.present?'selected':''}>Ausente</option></select></div><div class="field"><label>Observação</label><textarea name="notes">${esc(rec.notes||'')}</textarea></div><button class="btn primary">Salvar alteração</button></form>`);
    document.querySelector('#edit-attendance-form')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);try{await updateWorkshopAttendanceEntry(rec.id,{present:p.present==='true',notes:p.notes||''});document.querySelector('#modal')?.remove();toast('Presença atualizada');await render()}catch(err){toast(err.message,'danger')}})
  }));
  document.querySelectorAll('[data-remove-attendance]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Remover apenas este lançamento de presença?'))return;try{await removeWorkshopAttendanceEntry(b.dataset.removeAttendance);toast('Lançamento removido');await render()}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-edit-guest]').forEach(b=>b.addEventListener('click',async()=>{
    const people=await listProvisionalPeople(),p=people.find(x=>x.id===b.dataset.person);if(!p)return;
    modal('Editar visitante',`<form id="edit-guest-form" class="stack"><div class="field"><label>Nome completo</label><input class="input" name="full_name" value="${esc(p.full_name||'')}" required></div><div class="form-grid"><div class="field"><label>Data de nascimento</label><input class="input" type="date" name="birth_date" value="${esc(p.birth_date||'')}"></div><div class="field"><label>CPF</label><input class="input" name="cpf" value="${esc(p.cpf||'')}"></div></div><div class="field"><label>Bairro</label><input class="input" name="neighborhood" value="${esc(p.neighborhood||'')}"></div><button class="btn primary">Salvar visitante</button></form>`);
    document.querySelector('#edit-guest-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await updateProvisionalPerson(p.id,parseForm(e.target));document.querySelector('#modal')?.remove();toast('Visitante atualizado');await render()}catch(err){toast(err.message,'danger')}})
  }));
  document.querySelectorAll('[data-remove-guest]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Remover apenas esta visita da aula?'))return;try{await removeWorkshopGuestParticipation(b.dataset.removeGuest);toast('Visita removida');await render()}catch(err){toast(err.message,'danger')}}));
  document.querySelector('[data-open-checkin]')?.addEventListener('click',async b=>{try{const x=await openWorkshopCheckin(b.currentTarget.dataset.openCheckin),url=new URL('checkin.html',location.href);url.searchParams.set('token',x.public_token);modal('Lista virtual aberta',`<div class="stack"><div class="notice success">A lista individual foi aberta. Ela verifica a situação da trajetória de cada jovem e mostra somente a próxima etapa necessária antes de registrar a presença.</div><input class="input" value="${esc(url.href)}" readonly data-checkin-url><div class="actions"><button class="btn primary" data-copy-checkin>Copiar link</button><a class="btn secondary" href="${esc(url.href)}" target="_blank">Abrir lista</a></div></div>`);document.querySelector('[data-copy-checkin]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link copiado')})}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-refresh-sheet]')?.addEventListener('click',async()=>{try{const latest=await getWorkshopAttendanceSheet(session.id);updateAttendanceSheetDomV2(latest)}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-open-sheet-preview]')?.addEventListener('click',async()=>{
    try{
      const latest=await getWorkshopAttendanceSheet(session.id);
      modal('Pré-visualização · Anexo 2',`<div class="methodology-preview-modal">${workshopAttendancePreviewHtmlV2(latest)}</div>`);
      document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }catch(err){toast(err.message,'danger')}
  });
  if(window.__crjAttendanceSheetPoll){
    clearInterval(window.__crjAttendanceSheetPoll);
    window.__crjAttendanceSheetPoll=null;
  }
  if(session){
    const activeSessionId=session.id;
    window.__crjAttendanceSheetPoll=setInterval(async()=>{
      if(!location.hash.includes('oficina/'+id)){
        clearInterval(window.__crjAttendanceSheetPoll);
        window.__crjAttendanceSheetPoll=null;
        return;
      }
      if(document.querySelector('#modal'))return;
      const selector=document.querySelector('[data-session-select]');
      if(selector&&selector.value!==activeSessionId)return;
      try{
        const latest=await getWorkshopAttendanceSheet(activeSessionId);
        if(selector&&selector.value!==activeSessionId)return;
        updateAttendanceSheetDomV2(latest);
      }catch{}
    },8000);
  }
  async function exportCurrentSheet(format,button){
    const original=button?.textContent||'';
    try{
      if(button){button.disabled=true;button.textContent='Gerando...'}
      const latest=await getWorkshopAttendanceSheet(session.id);
      updateAttendanceSheetDomV2(latest);
      const sub=await createWorkshopAttendanceSubmission(session.id);
      const file=await downloadFormSubmission(sub.id,format);
      toast((format==='docx'?'DOC':'PDF')+' baixado'+(file?.filename?' · '+file.filename:''));
    }catch(err){
      toast(err?.message||'Não foi possível gerar o documento.','danger');
    }finally{
      if(button){button.disabled=false;button.textContent=original}
    }
  }
  document.querySelector('[data-sheet-pdf]')?.addEventListener('click',e=>exportCurrentSheet('pdf',e.currentTarget));
  document.querySelector('[data-sheet-docx]')?.addEventListener('click',e=>exportCurrentSheet('docx',e.currentTarget));
  document.querySelector('[data-sheet-print]')?.addEventListener('click',async()=>{try{printAttendanceSheetV2(await getWorkshopAttendanceSheet(session.id))}catch(err){toast(err.message,'danger')}});
  document.querySelector('[data-generate-attendance]')?.addEventListener('click',async()=>{try{const sub=await createWorkshopAttendanceSubmission(session.id);modal('Lista oficial atualizada',`<div class="stack"><div class="notice success">A Lista de Presença e Contato foi consolidada com ${Number(sheet?.participant_count||0)} participante(s).</div><div class="actions"><button class="btn primary" data-auto-list-pdf>PDF</button><button class="btn secondary" data-auto-list-docx>DOC</button><button class="btn" data-auto-list-print>Imprimir</button></div></div>`);document.querySelector('[data-auto-list-pdf]')?.addEventListener('click',async e=>{const b=e.currentTarget,o=b.textContent;try{b.disabled=true;b.textContent='Gerando...';await downloadFormSubmission(sub.id,'pdf');toast('PDF baixado')}catch(err){toast(err?.message||'Falha ao gerar PDF','danger')}finally{b.disabled=false;b.textContent=o}});document.querySelector('[data-auto-list-docx]')?.addEventListener('click',async e=>{const b=e.currentTarget,o=b.textContent;try{b.disabled=true;b.textContent='Gerando...';await downloadFormSubmission(sub.id,'docx');toast('DOC baixado')}catch(err){toast(err?.message||'Falha ao gerar DOC','danger')}finally{b.disabled=false;b.textContent=o}});document.querySelector('[data-auto-list-print]')?.addEventListener('click',async()=>{try{printAttendanceSheetV2(await getWorkshopAttendanceSheet(session.id))}catch(err){toast(err.message,'danger')}})}catch(err){toast(err.message,'danger')}});

}
