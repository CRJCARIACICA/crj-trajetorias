  const r=route(), youthId=r.parts[0]==='jovem'?r.parts[1]:null;
  document.querySelector('[data-action="new-service"]')?.addEventListener('click',()=>{
    if(technicalWriter()){
      modal('Classificar atendimento técnico',`<form id="technical-service-router" class="stack">
        <div class="notice">Todo atendimento da Equipe Técnica deve ser vinculado a uma abertura metodológica.</div>
        <div class="field"><label>Tipo de atendimento</label><select name="technical_type" required>
          <option value="">Selecione</option>
          <option value="pvida">PVida</option>
          <option value="ptrampo">PTrampo</option>
          <option value="outras-demandas">Outro atendimento / demanda — gera Anexo 5</option>
        </select></div>
        <button class="btn primary">Abrir formulário</button>
      </form>`);
      document.querySelector('#technical-service-router').addEventListener('submit',e=>{
        e.preventDefault();
        const type=new FormData(e.target).get('technical_type');
        if(!type)return;
        document.querySelector('#modal').remove();
        nav(`formulario/${type}/${youthId}`);
      });
      return;
    }
    modal('Novo atendimento',`<form id="service-form" class="stack"><input type="hidden" name="youth_id" value="${youthId}"><div class="field"><label>Data</label><input class="input" type="date" name="date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Categoria</label><select name="category"><option>Acolhimento</option><option>Trabalho e renda</option><option>Educação</option><option>Saúde</option><option>Direitos</option><option>Benefício</option><option>Outro</option></select></div><div class="field"><label>Descrição</label><textarea name="description" required></textarea></div><div class="field"><label>Situação</label><select name="status"><option>realizado</option><option>encaminhado</option><option>pendente</option></select></div><button class="btn primary">Salvar atendimento</button></form>`);
    document.querySelector('#service-form').addEventListener('submit',async e=>{e.preventDefault();await createService(parseForm(e.target));document.querySelector('#modal').remove();toast('Atendimento registrado');render();});
  });
  document.querySelector('[data-action="new-followup"]')?.addEventListener('click',()=>{modal('Novo acompanhamento',`<form id="followup-form" class="stack"><input type="hidden" name="youth_id" value="${youthId}"><div class="field"><label>Data</label><input class="input" type="date" name="date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Tipo</label><select name="followup_type"><option>PVida</option><option>PTrampo</option><option>Outras Demandas</option><option>Escuta técnica</option></select></div><div class="field"><label>Duração (horas)</label><input class="input" type="number" step="0.25" name="duration_hours" value="1"></div><div class="field"><label>Resumo técnico</label><textarea name="summary" required></textarea></div><button class="btn primary">Salvar acompanhamento</button></form>`);document.querySelector('#followup-form').addEventListener('submit',async e=>{e.preventDefault();await createFollowup(parseForm(e.target));document.querySelector('#modal').remove();toast('Acompanhamento registrado');render();});});
  document.querySelector('[data-action="new-youth-form"]')?.addEventListener('click',()=>{modal('Adicionar formulário',`<div class="grid two">${FORMS.filter(f=>f.slug!=='formulario-inicial').map(f=>`<button class="btn" data-modal-nav="formulario/${f.slug}/${youthId}">${esc(f.annex)} — ${esc(f.title)}</button>`).join('')}</div>`);document.querySelectorAll('[data-modal-nav]').forEach(b=>b.addEventListener('click',()=>{document.querySelector('#modal').remove();nav(b.dataset.modalNav)}));});
  document.querySelectorAll('[data-enroll]').forEach(b=>b.addEventListener('click',async()=>{try{const {core}=await getYouth(youthId);openFormalEnrollmentV2(b.dataset.enroll,core)}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-download-form]').forEach(b=>b.addEventListener('click',async()=>{
    const original=b.textContent;
    b.disabled=true;b.textContent='Gerando...';
    try{await downloadFormSubmission(b.dataset.downloadForm,b.dataset.format);toast(`${String(b.dataset.format).toUpperCase()} gerado`);}
    catch(err){toast(err.message,'danger');}
    finally{b.disabled=false;b.textContent=original;}
  }));


  const openWorkshopFormV2=async(workshop=null)=>{
    const team=await listTeam();
    const instructors=team.filter(x=>x.active&&(x.role==='oficineiro'||x.id===workshop?.oficineiro_user_id));
    const educators=team.filter(x=>x.active&&(['educador','coordenacao_geral','coordenacao_articulacao'].includes(x.role)||x.id===workshop?.educator_user_id));
    const wd=[['1','Segunda'],['2','Terça'],['3','Quarta'],['4','Quinta'],['5','Sexta'],['6','Sábado'],['0','Domingo']];
    const selected=(workshop?.fixed_weekdays||[]).map(Number);
    let html='<form id="workshop-form" class="stack">';
    html+='<div class="form-grid"><div class="field"><label>Nome da oficina</label><input class="input" name="name" required value="'+esc(workshop?.name||'')+'"></div>';
    html+='<div class="field"><label>Categoria</label><select name="category"><option>Esporte</option><option>Cultura</option><option>Profissionalizante</option><option>Arte</option><option>Idioma</option><option>Outra</option></select></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Tipo de oficina</label><select name="workshop_type" required><option value="permanente">Permanente</option><option value="temporaria">Temporária</option><option value="pontual">Pontual</option></select></div>';
    html+='<div class="field"><label>Forma de calendário</label><select name="schedule_mode" required><option value="semanal_fixa">Semanal fixa em dias da semana</option><option value="calendario_flexivel">Calendário flexível / datas escolhidas</option></select></div></div>';
    html+='<div class="field" data-fixed-weekdays><label>Dias fixos da semana</label><div class="check-grid workshop-weekdays">'+wd.map(x=>'<label class="check"><input type="checkbox" name="fixed_weekdays" value="'+x[0]+'" '+(selected.includes(Number(x[0]))?'checked':'')+'><span>'+x[1]+'</span></label>').join('')+'</div></div>';
    html+='<div class="form-grid"><div class="field"><label>Início do calendário</label><input class="input" type="date" name="planned_start_date" value="'+esc(workshop?.planned_start_date||'')+'"></div><div class="field"><label>Término previsto</label><input class="input" type="date" name="planned_end_date" value="'+esc(workshop?.planned_end_date||'')+'"><small>Na permanente pode ficar vazio; serão gerados os próximos 90 dias.</small></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Horário padrão · início</label><input class="input" type="time" name="start_time" value="'+esc(String(workshop?.start_time||'').slice(0,5))+'"></div><div class="field"><label>Horário padrão · fim</label><input class="input" type="time" name="end_time" value="'+esc(String(workshop?.end_time||'').slice(0,5))+'"></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Local de realização</label><select name="location_type"><option value="">Selecione</option>'+['LABPoca','Sala de computadores','Sala de dança','Trampo Coletivo','Externa','Outro'].map(x=>'<option value="'+x+'">'+x+'</option>').join('')+'</select></div><div class="field"><label>Local externo / outro</label><input class="input" name="location_other" value="'+esc(workshop?.location_other||'')+'"></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Oficineiro(a)</label><select name="oficineiro_user_id"><option value="">Ainda não definido</option>'+instructors.map(x=>'<option value="'+x.id+'">'+esc(x.display_name)+'</option>').join('')+'</select></div><div class="field"><label>Educador(a) de referência</label><select name="educator_user_id"><option value="">Ainda não definido</option>'+educators.map(x=>'<option value="'+x.id+'">'+esc(x.display_name)+'</option>').join('')+'</select></div></div>';
    html+='<div class="field"><label>Observações de planejamento</label><textarea name="planning_notes">'+esc(workshop?.planning_notes||'')+'</textarea></div>';
    html+='<div class="field"><label>Situação</label><select name="active"><option value="true">Ativa</option><option value="false">Inativa</option></select></div>';
    html+='<div class="notice info"><b>Calendário:</b> agenda semanal fixa gera as datas planejadas automaticamente. Agenda flexível recebe datas pela aba Calendário.</div>';
    html+='<button class="btn primary">'+(workshop?'Salvar alterações':'Criar oficina')+'</button></form>';
    modal(workshop?'Editar oficina':'Nova oficina',html);
    const form=document.querySelector('#workshop-form');
    decorateEduGoalForm(form,'planejamento_oficina');
    const set=(n,v)=>{const el=form?.querySelector('[name="'+n+'"]');if(el&&v!==undefined&&v!==null)el.value=String(v)};
    set('category',workshop?.category||'Esporte');set('workshop_type',workshop?.workshop_type||'permanente');set('schedule_mode',workshop?.schedule_mode||'calendario_flexivel');set('location_type',workshop?.location_type||'');set('oficineiro_user_id',workshop?.oficineiro_user_id||'');set('educator_user_id',workshop?.educator_user_id||'');set('active',workshop?.active===false?'false':'true');
    const sync=()=>{const mode=form?.querySelector('[name="schedule_mode"]')?.value;const type=form?.querySelector('[name="workshop_type"]')?.value;form?.querySelector('[data-fixed-weekdays]')?.classList.toggle('hidden',mode!=='semanal_fixa');const end=form?.querySelector('[name="planned_end_date"]');if(end)end.required=type==='temporaria'};
    form?.querySelector('[name="schedule_mode"]')?.addEventListener('change',sync);form?.querySelector('[name="workshop_type"]')?.addEventListener('change',sync);sync();
    form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target),days=Array.isArray(p.fixed_weekdays)?p.fixed_weekdays:p.fixed_weekdays?[p.fixed_weekdays]:[];if(!p.planned_start_date){toast('Informe a data de início do calendário.','danger');return}if(!p.start_time||!p.end_time){toast('Informe o horário padrão de início e fim.','danger');return}if(p.end_time<=p.start_time){toast('O horário final deve ser posterior ao horário inicial.','danger');return}if(!p.location_type){toast('Defina o local de realização da oficina.','danger');return}if(['Externa','Outro'].includes(p.location_type)&&!String(p.location_other||'').trim()){toast('Descreva o local externo ou outro local.','danger');return}if(p.workshop_type==='temporaria'&&!p.planned_end_date){toast('Informe a data prevista de término da oficina temporária.','danger');return}if(p.schedule_mode==='semanal_fixa'&&!days.length){toast('Selecione ao menos um dia fixo da semana.','danger');return}if(p.workshop_type==='pontual'){p.planned_end_date=p.planned_start_date;p.schedule_mode='calendario_flexivel';p.fixed_weekdays=[]}try{const saved=workshop?await updateWorkshop(workshop.id,p):await createWorkshop(p);if(saved.schedule_mode==='semanal_fixa')await generateWorkshopFixedCalendar(saved);if(saved.workshop_type==='pontual'){const oldEntries=await listWorkshopCalendar(null,null,saved.id);for(const ce of oldEntries.filter(x=>x.status==='planejada'))await updateWorkshopCalendarEntry(ce.id,{status:'cancelada'});await createWorkshopCalendarEntry({workshop_id:saved.id,scheduled_date:saved.planned_start_date,start_time:String(saved.start_time||'').slice(0,5),end_time:String(saved.end_time||'').slice(0,5),location_type:saved.location_type,location_other:saved.location_other,source:'manual',status:'planejada',notes:'Gerado a partir do cadastro da oficina pontual'});}document.querySelector('#modal')?.remove();toast(workshop?'Oficina atualizada':'Oficina criada');await render()}catch(err){toast(err.message,'danger')}});
  };
  const openWorkshopSessionV2=async(workshop,entry=null)=>{
    const team=await listTeam();
    const educators=team.filter(x=>x.active&&x.role==='educador');
    const defaultEducator=entry?.educator_user_id||workshop.educator_user_id||state.user?.id||'';
    let html='<form id="session-form" class="stack"><input type="hidden" name="workshop_id" value="'+workshop.id+'"><input type="hidden" name="calendar_entry_id" value="'+esc(entry?.calendar_entry_id||entry?.id||'')+'"><input type="hidden" name="plan_lesson_id" value="'+esc(entry?.plan_lesson_id||'')+'">';
    html+='<div class="notice"><b>'+esc(workshop.name)+'</b><br>'+esc(workshopTypeLabel(workshop.workshop_type))+' · '+esc(workshopScheduleLabel(workshop))+'</div>';
    if(entry?.plan_lesson_id)html+='<div class="notice info"><b>Aula '+esc(entry.lesson_number||'')+' do planejamento</b><br>'+esc(entry.theme||'Aula planejada')+'</div>';
    html+='<div class="field"><label>Data da aula</label><input class="input" type="date" name="session_date" value="'+esc(entry?.scheduled_date||new Date().toISOString().slice(0,10))+'" required></div>';
    html+='<div class="form-grid"><div class="field"><label>Início</label><input class="input" type="time" name="start_time" value="'+esc(String(entry?.start_time||workshop.start_time||'').slice(0,5))+'" required></div><div class="field"><label>Fim</label><input class="input" type="time" name="end_time" value="'+esc(String(entry?.end_time||workshop.end_time||'').slice(0,5))+'" required></div></div>';
    html+='<div class="field"><label>Educador(a) acompanhando esta aula</label><select name="educator_user_id" required><option value="">Selecione</option>'+educators.map(x=>'<option value="'+x.id+'" '+(x.id===defaultEducator?'selected':'')+'>'+esc(x.display_name)+'</option>').join('')+'</select><small>Pode ser diferente do educador de referência geral da oficina. O histórico guardará quem acompanhou esta aula.</small></div>';
    html+='<div class="form-grid"><div class="field"><label>Local desta aula</label><select name="location_type"><option value="">Usar local padrão</option>'+['LABPoca','Sala de computadores','Sala de dança','Trampo Coletivo','Externa','Outro'].map(x=>'<option value="'+x+'">'+x+'</option>').join('')+'</select></div><div class="field"><label>Local externo / outro</label><input class="input" name="location_other" value="'+esc(entry?.location_other||workshop.location_other||'')+'"></div></div>';
    html+='<div class="field"><label>Conteúdo / atividade executada</label><textarea name="content">'+esc(entry?.proposed_activities||entry?.theme||'')+'</textarea></div><div class="field"><label>CFDH dentro da aula (minutos)</label><input class="input" type="number" min="0" step="5" name="cfdh_minutes" value="0"></div><div class="field"><label>Observação</label><textarea name="notes">'+esc(entry?.observations||'')+'</textarea></div><button class="btn primary">Salvar aula executada</button></form>';
    modal(entry?.plan_lesson_id?'Acompanhar aula planejada':'Registrar aula',html);
    const form=document.querySelector('#session-form'),loc=form?.querySelector('[name="location_type"]');if(loc)loc.value=entry?.location_type||workshop.location_type||'';
    decorateEduGoalForm(form,'aula');
    form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(!p.educator_user_id){toast('Selecione o educador que está acompanhando esta aula.','danger');return}if(!p.start_time||!p.end_time||p.end_time<=p.start_time){toast('Confira o horário da aula. O término deve ser posterior ao início.','danger');return}if(['Externa','Outro'].includes(p.location_type)&&!String(p.location_other||'').trim()){toast('Descreva o local desta aula.','danger');return}try{const saved=await createWorkshopSession(p);document.querySelector('#modal')?.remove();toast('Aula registrada. A lista de presença já pode ser acompanhada.');nav('oficina/'+workshop.id+'?session='+saved.id);await render()}catch(err){toast(err.message,'danger')}});
  };
  document.querySelector('[data-action="new-workshop"]')?.addEventListener('click',()=>openWorkshopFormV2());
  document.querySelectorAll('[data-edit-workshop]').forEach(btn=>btn.addEventListener('click',async()=>{try{const ws=await listWorkshops(),w=ws.find(x=>x.id===btn.dataset.editWorkshop);if(w)await openWorkshopFormV2(w)}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-action="session"]').forEach(btn=>btn.addEventListener('click',async()=>{try{const ws=await listWorkshops(),w=ws.find(x=>x.id===btn.dataset.workshop);if(w)await openWorkshopSessionV2(w)}catch(err){toast(err.message,'danger')}}));

  document.querySelectorAll('[data-generate-workshop-calendar]').forEach(btn=>btn.addEventListener('click',async()=>{try{const ws=await listWorkshops(),w=ws.find(x=>x.id===btn.dataset.generateWorkshopCalendar);if(!w)return;const rows=await generateWorkshopFixedCalendar(w);toast(rows.length+' data(s) planejada(s) gerada(s)');await render()}catch(err){toast(err.message,'danger')}}));

  document.querySelector('[data-new-calendar-entry]')?.addEventListener('click',async()=>{
    try{
      const ws=(await listWorkshops()).filter(x=>x.active);
      let html='<form id="calendar-entry-form" class="stack"><div class="field"><label>Oficina</label><select name="workshop_id" required><option value="">Selecione</option>'+ws.map(w=>'<option value="'+w.id+'">'+esc(w.name)+'</option>').join('')+'</select></div>';
      html+='<div class="field"><label>Data</label><input class="input" type="date" name="scheduled_date" required></div><div class="form-grid"><div class="field"><label>Início</label><input class="input" type="time" name="start_time" required></div><div class="field"><label>Fim</label><input class="input" type="time" name="end_time"></div></div>';
      html+='<div class="form-grid"><div class="field"><label>Local</label><select name="location_type"><option value="">Usar local da oficina</option>'+['LABPoca','Sala de computadores','Sala de dança','Trampo Coletivo','Externa','Outro'].map(x=>'<option value="'+x+'">'+x+'</option>').join('')+'</select></div><div class="field"><label>Outro / local externo</label><input class="input" name="location_other"></div></div>';
      html+='<div class="field"><label>Observação</label><textarea name="notes"></textarea></div><button class="btn primary">Adicionar ao calendário</button></form>';
      modal('Adicionar data ao calendário',html);
      const form=document.querySelector('#calendar-entry-form');
      form?.querySelector('[name="workshop_id"]')?.addEventListener('change',e=>{const w=ws.find(x=>x.id===e.target.value);if(!w)return;const st=form.querySelector('[name="start_time"]'),et=form.querySelector('[name="end_time"]'),lt=form.querySelector('[name="location_type"]'),lo=form.querySelector('[name="location_other"]');if(st&&!st.value)st.value=String(w.start_time||'').slice(0,5);if(et&&!et.value)et.value=String(w.end_time||'').slice(0,5);if(lt&&!lt.value)lt.value=w.location_type||'';if(lo&&!lo.value)lo.value=w.location_other||''});
      form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(!p.start_time){toast('Informe o horário inicial.','danger');return}if(p.end_time&&p.end_time<=p.start_time){toast('O horário final deve ser posterior ao inicial.','danger');return}if(['Externa','Outro'].includes(p.location_type)&&!String(p.location_other||'').trim()){toast('Descreva o local externo ou outro local.','danger');return}try{await createWorkshopCalendarEntry(p);document.querySelector('#modal')?.remove();toast('Data adicionada ao calendário');await render()}catch(err){toast(err.message,'danger')}});
    }catch(err){toast(err.message,'danger')}
  });

  document.querySelectorAll('[data-calendar-session]').forEach(btn=>btn.addEventListener('click',async()=>{try{const ws=await listWorkshops(),w=ws.find(x=>x.id===btn.dataset.workshop),entries=await listWorkshopCalendar(null,null,btn.dataset.workshop),entry=entries.find(x=>x.id===btn.dataset.calendarSession);if(w&&entry)await openWorkshopSessionV2(w,entry)}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-calendar-cancel]').forEach(btn=>btn.addEventListener('click',async()=>{if(!confirm('Cancelar esta data planejada?'))return;try{await updateWorkshopCalendarEntry(btn.dataset.calendarCancel,{status:'cancelada'});toast('Data cancelada');await render()}catch(err){toast(err.message,'danger')}}));
  document.querySelector('[data-workshop-month]')?.addEventListener('change',e=>{const view=route().params.get('view')||'calendario';nav('oficinas?view='+view+'&month='+e.target.value)});

  const openInstructorRecordV2=async(instructorId,record=null)=>{
    const [team,ws]=await Promise.all([listTeam(),listWorkshops()]);
    const instructor=team.find(x=>x.id===instructorId),own=state.user?.role==='oficineiro'&&state.user?.id===instructorId,management=!own,linked=ws.filter(w=>w.oficineiro_user_id===instructorId);
    let html='<form id="instructor-record-form" class="stack"><input type="hidden" name="instructor_user_id" value="'+instructorId+'"><div class="notice"><b>'+esc(instructor?.display_name||'Oficineiro')+'</b></div>';
    html+='<div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="'+esc(record?.record_date||new Date().toISOString().slice(0,10))+'" required></div><div class="field"><label>Tipo</label><select name="record_type"><option value="solicitacao">Solicitação</option><option value="informacao_relevante">Informação relevante</option>'+(management?'<option value="observacao_desempenho">Observação de desempenho</option>':'')+'</select></div></div>';
    html+='<div class="field"><label>Oficina relacionada</label><select name="workshop_id"><option value="">Geral / sem oficina específica</option>'+linked.map(w=>'<option value="'+w.id+'">'+esc(w.name)+'</option>').join('')+'</select></div>';
    html+='<div class="form-grid"><div class="field"><label>Categoria</label><select name="category"><option>Material</option><option>Agenda / horário</option><option>Espaço</option><option>Suporte pedagógico</option><option>Administrativo</option><option>Infraestrutura</option><option>Outro</option></select></div><div class="field"><label>Prioridade</label><select name="priority"><option value="baixa">Baixa</option><option value="normal">Normal</option><option value="alta">Alta</option><option value="urgente">Urgente</option></select></div></div>';
    html+='<div class="field"><label>Descrição</label><textarea name="description" required>'+esc(record?.description||'')+'</textarea></div>';
    if(management)html+='<div class="field"><label>Situação</label><select name="status"><option value="aberta">Aberta</option><option value="em_analise">Em análise</option><option value="atendida">Atendida</option><option value="arquivada">Arquivada</option></select></div><div class="field"><label>Retorno / encaminhamento</label><textarea name="response">'+esc(record?.response||'')+'</textarea></div>';
    html+='<button class="btn primary">'+(record?'Salvar atualização':'Registrar')+'</button></form>';
    modal(record?'Atualizar registro do oficineiro':'Solicitação / informação do oficineiro',html);
    const form=document.querySelector('#instructor-record-form'),set=(n,v)=>{const el=form?.querySelector('[name="'+n+'"]');if(el&&v!==undefined&&v!==null)el.value=String(v)};
    set('record_type',record?.record_type||'solicitacao');set('workshop_id',record?.workshop_id||'');set('category',record?.category||'Material');set('priority',record?.priority||'normal');set('status',record?.status||'aberta');
    form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);try{if(record)await updateWorkshopInstructorRecord(record.id,p);else await createWorkshopInstructorRecord(p);document.querySelector('#modal')?.remove();toast(record?'Registro atualizado':'Registro criado');await render()}catch(err){toast(err.message,'danger')}});
  };

  document.querySelectorAll('[data-instructor-record]').forEach(btn=>btn.addEventListener('click',()=>openInstructorRecordV2(btn.dataset.instructorRecord)));
  document.querySelectorAll('[data-instructor-record-edit]').forEach(btn=>btn.addEventListener('click',async()=>{try{const rows=await listWorkshopInstructorRecords(btn.dataset.instructor),rec=rows.find(x=>x.id===btn.dataset.instructorRecordEdit);if(rec)await openInstructorRecordV2(btn.dataset.instructor,rec)}catch(err){toast(err.message,'danger')}}));
  document.querySelectorAll('[data-instructor-evidence]').forEach(btn=>btn.addEventListener('click',async()=>{try{const month=route().params.get('month')||currentMonth(),rows=await listWorkshopInstructorDashboard(month),i=rows.find(x=>x.id===btn.dataset.instructorEvidence);if(!i)return;modal('Prévia de evidência · Oficineiro(a)','<div class="methodology-preview-modal">'+workshopInstructorEvidencePreviewHtml(i,month)+'</div>');document.querySelector('#modal .modal')?.classList.add('modal-wide')}catch(err){toast(err.message,'danger')}}));


  document.querySelector('[data-new-instructor-account]')?.addEventListener('click',()=>{
    let html='<form id="instructor-account-form" class="stack">';
    html+='<div class="form-grid"><div class="field"><label>Nome completo</label><input class="input" name="name" required></div><div class="field"><label>E-mail de acesso</label><input class="input" type="email" name="email" required></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Senha inicial</label><input class="input" type="password" name="password" minlength="6" required><small>Mínimo de 6 caracteres.</small></div><div class="field"><label>CPF</label><input class="input" name="cpf"></div></div>';
    html+='<div class="form-grid"><div class="field"><label>Telefone</label><input class="input" name="phone"></div><div class="field"><label>Área / especialidade</label><input class="input" name="specialty" placeholder="Ex.: Capoeira, Jiu-jitsu, Tranças..."></div></div>';
    html+='<div class="field"><label>Carga horária semanal de referência</label><input class="input" type="number" min="0" step="0.5" name="contracted_weekly_hours"><small>Usada como referência de acompanhamento; as horas executadas vêm das aulas registradas e listas.</small></div>';
    html+='<div class="field"><label>Informações relevantes</label><textarea name="notes"></textarea></div>';
    html+='<div class="notice info">O cadastro cria o acesso do oficineiro no sistema com perfil <b>Oficineiro(a)</b> e uma ficha profissional vinculada.</div><button class="btn primary">Criar cadastro do oficineiro</button></form>';
    modal('Cadastrar oficineiro',html);
    document.querySelector('#instructor-account-form')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);const btn=e.target.querySelector('button[type="submit"],button.btn.primary');if(btn){btn.disabled=true;btn.textContent='Criando...'}try{await createWorkshopInstructorAccount(p);document.querySelector('#modal')?.remove();toast('Oficineiro cadastrado e acesso criado');await render()}catch(err){toast(err.message,'danger');if(btn){btn.disabled=false;btn.textContent='Criar cadastro do oficineiro'}}});
  });

  document.querySelectorAll('[data-edit-instructor-profile]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const profiles=await listWorkshopInstructorProfiles(),p=profiles.find(x=>x.id===btn.dataset.editInstructorProfile);if(!p)return;
      let html='<form id="instructor-profile-form" class="stack"><div class="field"><label>Nome</label><input class="input" name="display_name" value="'+esc(p.display_name||'')+'" required></div>';
      html+='<div class="form-grid"><div class="field"><label>E-mail de referência</label><input class="input" type="email" name="email" value="'+esc(p.email||'')+'"><small>Alterar aqui não troca o e-mail usado para login.</small></div><div class="field"><label>CPF</label><input class="input" name="cpf" value="'+esc(p.cpf||'')+'"></div></div>';
      html+='<div class="form-grid"><div class="field"><label>Telefone</label><input class="input" name="phone" value="'+esc(p.phone||'')+'"></div><div class="field"><label>Área / especialidade</label><input class="input" name="specialty" value="'+esc(p.specialty||'')+'"></div></div>';
      html+='<div class="field"><label>Carga horária semanal de referência</label><input class="input" type="number" min="0" step="0.5" name="contracted_weekly_hours" value="'+esc(p.contracted_weekly_hours??'')+'"></div><div class="field"><label>Informações relevantes</label><textarea name="notes">'+esc(p.notes||'')+'</textarea></div><button class="btn primary">Salvar cadastro</button></form>';
      modal('Editar cadastro do oficineiro',html);
      document.querySelector('#instructor-profile-form')?.addEventListener('submit',async e=>{e.preventDefault();const x=parseForm(e.target);try{await updateTeamMember(p.id,{display_name:x.display_name});await updateWorkshopInstructorProfile(p.id,x);document.querySelector('#modal')?.remove();toast('Cadastro do oficineiro atualizado');await render()}catch(err){toast(err.message,'danger')}});
    }catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-workshop-plan-generate]').forEach(btn=>btn.addEventListener('click',async()=>{
    const month=route().params.get('month')||currentMonth(),original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{const out=await syncWorkshopMonthlyPlan(btn.dataset.workshopPlanGenerate,month);toast(out.lessons.length+' aula(s) prevista(s) vinculada(s)');nav('oficinas?view=planejamento&month='+month+'&plan='+out.plan.id)}catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-workshop-plan-open]').forEach(btn=>btn.addEventListener('click',()=>{
    const month=route().params.get('month')||currentMonth();nav('oficinas?view=planejamento&month='+month+'&plan='+btn.dataset.workshopPlanOpen);
  }));

  const workshopPlanForm=document.querySelector('#workshop-plan-form');
  if(workshopPlanForm){
    const planId=workshopPlanForm.dataset.planId,workshopId=workshopPlanForm.dataset.workshopId;
    Promise.all([getWorkshopMonthlyPlan(planId),listWorkshops(),listTeam()]).then(([bundle,ws,team])=>{
      const workshop=ws.find(x=>x.id===workshopId),teamMap=new Map(team.map(x=>[x.id,x.display_name])),preview=document.querySelector('[data-workshop-plan-preview]'),workspace=document.querySelector('[data-workshop-plan-workspace]'),toggle=document.querySelector('[data-toggle-workshop-plan-preview]');
      const statusEl=workshopPlanForm.querySelector('[name="status"]');if(statusEl)statusEl.value=bundle.plan.status||'rascunho';
      const collect=()=>{
        const header={};
        for(const k of ['general_objective','general_methodology','expected_results','general_resources','observations','status'])header[k]=workshopPlanForm.querySelector('[name="'+k+'"]')?.value||'';
        const lessons=[...workshopPlanForm.querySelectorAll('[data-plan-lesson]')].map(card=>({id:card.dataset.planLesson,theme:card.querySelector('[name="theme"]')?.value||'',objective:card.querySelector('[name="objective"]')?.value||'',proposed_activities:card.querySelector('[name="proposed_activities"]')?.value||'',resources:card.querySelector('[name="resources"]')?.value||'',cfdh_transversal:card.querySelector('[name="cfdh_transversal"]')?.value||'',observations:card.querySelector('[name="observations"]')?.value||''}));
        return {header,lessons};
      };
      const refresh=()=>{
        if(!preview||!workshop)return;
        const edit=collect(),lessonMap=new Map(edit.lessons.map(x=>[x.id,x]));
        const draft={plan:{...bundle.plan,...edit.header},lessons:(bundle.lessons||[]).map(l=>({...l,...(lessonMap.get(l.id)||{})}))};
        preview.innerHTML=workshopPlanPreviewHtml(draft,workshop,teamMap);
      };
      workshopPlanForm.addEventListener('input',refresh);workshopPlanForm.addEventListener('change',refresh);
      toggle?.addEventListener('click',()=>{workspace?.classList.toggle('preview-open');toggle.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
      refresh();
    }).catch(err=>toast(err.message,'danger'));
    workshopPlanForm.addEventListener('submit',async e=>{e.preventDefault();const header={};for(const k of ['general_objective','general_methodology','expected_results','general_resources','observations','status'])header[k]=workshopPlanForm.querySelector('[name="'+k+'"]')?.value||'';const lessons=[...workshopPlanForm.querySelectorAll('[data-plan-lesson]')].map(card=>({id:card.dataset.planLesson,theme:card.querySelector('[name="theme"]')?.value||'',objective:card.querySelector('[name="objective"]')?.value||'',proposed_activities:card.querySelector('[name="proposed_activities"]')?.value||'',resources:card.querySelector('[name="resources"]')?.value||'',cfdh_transversal:card.querySelector('[name="cfdh_transversal"]')?.value||'',observations:card.querySelector('[name="observations"]')?.value||''}));try{await saveWorkshopMonthlyPlan(planId,header,lessons);toast('Planejamento salvo');await render()}catch(err){toast(err.message,'danger')}});
    document.querySelector('[data-sync-workshop-plan]')?.addEventListener('click',async btnEv=>{const btn=btnEv.currentTarget,original=btn.textContent;btn.disabled=true;btn.textContent='Sincronizando...';try{const detail=await getWorkshopMonthlyPlan(planId),month=String(detail.plan.plan_month||'').slice(0,7);await syncWorkshopMonthlyPlan(workshopId,month);toast('Planejamento sincronizado com o calendário');await render()}catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=original}});
  }

  document.querySelectorAll('[data-action="attendance"]').forEach(b=>b.addEventListener('click',async()=>{const roster=await workshopRoster(b.dataset.workshop); if(!roster.length){toast('Inscreva jovens na oficina antes de lançar presença','warn');return;} const sessionId=`manual_${Date.now()}`,date=new Date().toISOString().slice(0,10);modal('Lista de presença',`<form id="attendance-form"><input type="hidden" name="session_id" value="${sessionId}"><input type="hidden" name="date" value="${date}"><div class="check-grid">${roster.map(r=>`<label class="check"><input type="checkbox" name="youth_id" value="${r.youth_id}"><span>${esc(r.youth?.preferred_name||r.youth?.full_name)}</span></label>`).join('')}</div><div class="actions" style="margin-top:16px"><button class="btn primary">Salvar presença</button></div></form>`);const attendanceForm=document.querySelector('#attendance-form');decorateEduGoalForm(attendanceForm,'presenca');attendanceForm.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target),ids=Array.isArray(p.youth_id)?p.youth_id:p.youth_id?[p.youth_id]:[];aw