ait saveAttendance(p.session_id,b.dataset.workshop,p.date,ids);document.querySelector('#modal').remove();toast('Presenças registradas');render();});}));
}


async function pageEducator(){
  if(!permitted('educador_area')) return '<div class="notice danger">Seu perfil não possui acesso à Área do Educador.</div>';
  const month=route().params.get('month')||currentMonth();
  const team=await listTeam();
  const educators=team.filter(x=>x.role==='educador'&&x.active);
  const selectedId=state.user?.role==='educador'?state.user.id:(route().params.get('user')||educators[0]?.id||'');
  const selected=educators.find(x=>x.id===selectedId)||state.user;
  const [records,contrib,workshops,youth]=await Promise.all([
    listEducatorRecords(month,selectedId||null),
    educatorContributionSummary(month,selectedId||null),
    listWorkshops(),
    listYouth('')
  ]);
  const sum=type=>contrib.filter(x=>x.event_type===type).reduce((a,x)=>a+Number(x.quantity||0),0);
  const countTypes=types=>contrib.filter(x=>types.includes(x.event_type)).reduce((a,x)=>a+Number(x.quantity||0),0);
  const myWorkshops=workshops.filter(w=>w.educator_user_id===selectedId);
  const unassigned=workshops.filter(w=>!w.educator_user_id&&w.active);
  const typeLabel=t=>({
    acolhimento_educativo:'Acolhimento educativo',
    demanda_identificada:'Demanda identificada',
    encaminhamento_interno:'Encaminhamento interno',
    acompanhamento_oficina:'Acompanhamento de oficina',
    mediacao_convivencia:'Mediação e convivência',
    cfdh_estrutural:'CFDH estrutural',
    ficaadica_orientacao:'#FicaAdica / orientação',
    trampo_labpoca:'Trampo Coletivo / LABPoca',
    mobilizacao_evento:'Mobilização / evento',
    mostra:'Mostra',
    estudo_caso:'Participação em estudo de caso',
    outra_acao_educativa:'Outra ação educativa'
  }[t]||t);
  const recordList=records.map(r=>{
    const y=youth.find(x=>x.id===r.youth_id),w=workshops.find(x=>x.id===r.workshop_id);
    return `<div class="agenda-row"><div><b>${esc(typeLabel(r.record_type))}</b><span>${fmtDate(r.record_date)}${y?' · '+esc(y.preferred_name||y.full_name):''}${w?' · '+esc(w.name):''}</span><span>${esc(r.title||r.description||'Sem descrição')}${r.duration_hours>0?' · '+r.duration_hours+'h':''}</span></div>${state.user?.id===r.educator_user_id||state.user?.role==='coordenacao_geral'?'<button class="btn ghost" data-educator-delete="'+r.id+'">Excluir</button>':''}</div>`;
  }).join('');
  const roleIntro=`
    <div class="card">
      <h3>Atribuições metodológicas do Educador Social</h3>
      <div class="check-grid educator-duty-grid">
        <div class="check"><span><b>Referência cotidiana das juventudes</b><small>Acolher, construir vínculo, perceber interesses e demandas.</small></span></div>
        <div class="check"><span><b>Oficinas</b><small>Acompanhar as turmas e fazer a ponte entre oficineiro, jovens e CRJ.</small></span></div>
        <div class="check"><span><b>CFDH</b><small>Planejar e executar rodas e ações de Direitos Humanos, estruturais e transversais.</small></span></div>
        <div class="check"><span><b>Registros</b><small>Registrar participações, atendimentos educativos, atividades e encaminhamentos.</small></span></div>
        <div class="check"><span><b>Convivência</b><small>Construir combinados e contribuir na mediação de relações e conflitos.</small></span></div>
        <div class="check"><span><b>Avaliação e relatórios</b><small>Produzir planejamento, registros, avaliações e evidências da execução.</small></span></div>
        <div class="check"><span><b>Trampo Coletivo / LABPoca</b><small>Acompanhar o uso educativo e as demandas das juventudes.</small></span></div>
        <div class="check"><span><b>Estudos de caso</b><small>Participar com a Equipe Técnica sem substituir o atendimento especializado.</small></span></div>
      </div>
    </div>`;
  return `<div class="page-head"><div><h2>Área do Educador Social</h2><p>O educador registra o trabalho realizado; o sistema transforma a execução em trajetória, contribuição da equipe e indicadores.</p></div><div class="actions"><button class="btn primary" data-educator-new="acolhimento_educativo">+ Registrar contribuição</button></div></div>
    <div class="card educator-filter"><div class="form-grid">${state.user?.role==='educador'?'<div class="field"><label>Educador</label><div class="input read-only">'+esc(selected?.display_name||'Meu perfil')+'</div></div>':`<div class="field"><label>Educador</label><select data-educator-filter-user>${educators.map(e=>`<option value="${e.id}" ${e.id===selectedId?'selected':''}>${esc(e.display_name)}</option>`).join('')}</select></div>`}<div class="field"><label>Mês</label><input class="input" type="month" data-educator-filter-month value="${esc(month)}"></div></div></div>
    <div class="grid cards" style="margin-top:16px">
      <div class="card kpi"><div class="label">Horas de aula registradas</div><div class="value">${sum('aula').toFixed(1)}</div><div class="meta">oficinas/cursos</div></div>
      <div class="card kpi"><div class="label">Presenças lançadas</div><div class="value">${sum('presenca')}</div><div class="meta">registros nominais</div></div>
      <div class="card kpi"><div class="label">CFDH estrutural</div><div class="value">${sum('cfdh_estrutural').toFixed(1)}h</div><div class="meta">entra em M6.1 CFDH</div></div>
      <div class="card kpi"><div class="label">Registros educativos</div><div class="value">${records.length}</div><div class="meta">ações próprias do educador</div></div>
    </div>
    <div class="grid two" style="margin-top:16px">
      ${roleIntro}
      <div class="card"><h3>Registrar trabalho realizado</h3><p class="muted">Escolha a natureza do trabalho. A autoria fica vinculada ao usuário logado.</p><div class="educator-action-grid">
        <button class="btn" data-educator-new="acolhimento_educativo">Acolhimento educativo</button>
        <button class="btn" data-educator-new="demanda_identificada">Demanda identificada</button>
        <button class="btn" data-educator-new="encaminhamento_interno">Encaminhamento interno</button>
        <button class="btn" data-educator-new="acompanhamento_oficina">Acompanhamento de oficina</button>
        <button class="btn" data-educator-new="mediacao_convivencia">Mediação / convivência</button>
        <button class="btn" data-educator-new="cfdh_estrutural">CFDH estrutural</button>
        <button class="btn" data-educator-new="ficaadica_orientacao">#FicaAdica / orientação</button>
        <button class="btn" data-educator-new="trampo_labpoca">Trampo Coletivo / LABPoca</button>
        <button class="btn" data-educator-new="mobilizacao_evento">Mobilização / evento</button>
        <button class="btn" data-educator-new="mostra">Mostra</button>
        <button class="btn" data-educator-new="estudo_caso">Estudo de caso</button>
        <button class="btn" data-educator-new="outra_acao_educativa">Outra ação</button>
      </div><div class="notice" style="margin-top:14px"><b>Limite:</b> PVida, PTrampo, Outras Demandas e Formulário de Acompanhamento continuam exclusivos da Equipe Técnica. O educador identifica e encaminha a demanda.</div></div>
    </div>
    <div class="grid two" style="margin-top:16px">
      <div class="card"><h3>Instrumentais diretamente relacionados ao trabalho educativo</h3><p class="muted">Os documentos abaixo geram evidência oficial em PDF/DOCX.</p><div class="stack">
        <button class="btn" data-nav="formulario/lista-presenca-contato">Anexo 2 · Lista de Presença e Contato</button>
        <button class="btn" data-nav="formulario/avaliacao-atividades">Anexo 7 · Avaliação das Atividades</button>
        <button class="btn" data-nav="formulario/relatorio-mobilizacao">Anexo 8 · Relatório de Mobilização</button>
        <button class="btn" data-nav="formulario/cfdh-planejamento">Anexo 11 · CFDH Planejamento</button>
        <button class="btn" data-nav="formulario/cfdh-avaliacao-jovens">Anexo 12 · CFDH Avaliação Jovens</button>
        <button class="btn" data-nav="formulario/cfdh-avaliacao-equipe">Anexo 13 · CFDH Avaliação Educadores/Oficineiros</button>
      </div></div>
      <div class="card"><h3>Oficinas sob referência</h3>${myWorkshops.map(w=>`<div class="agenda-row"><div><b>${esc(w.name)}</b><span>${esc(w.days||'')} · ${esc(String(w.start_time||'').slice(0,5))}${w.end_time?'–'+esc(String(w.end_time).slice(0,5)):''}</span></div><button class="btn" data-nav="oficinas">Abrir</button></div>`).join('')||'<div class="empty">Nenhuma oficina está vinculada formalmente a este educador.</div>'}${unassigned.length&&state.user?.role!=='educador'?'<div class="notice warn" style="margin-top:12px">'+unassigned.length+' oficina(s) ativa(s) ainda sem educador referência.</div>':''}</div>
    </div>
    <div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:8px"><div><h3 style="margin:0">Contribuições do mês</h3><p>Registros autorais do educador. Aula, presença e formulários também entram no resumo acima pelas tabelas próprias.</p></div><span class="pill">${records.length} registro(s)</span></div>${recordList||'<div class="empty">Nenhuma contribuição educativa registrada neste mês.</div>'}</div>`;
}

async function bindEducatorPage(){
  if(!document.querySelector('[data-educator-new]')&&!document.querySelector('[data-educator-filter-month]')) return;
  const monthEl=document.querySelector('[data-educator-filter-month]');
  const userEl=document.querySelector('[data-educator-filter-user]');
  const applyFilter=()=>{
    const p=new URLSearchParams();
    if(monthEl?.value)p.set('month',monthEl.value);
    if(userEl?.value)p.set('user',userEl.value);
    nav('educador?'+p.toString());
  };
  monthEl?.addEventListener('change',applyFilter);
  userEl?.addEventListener('change',applyFilter);
  const [youth,workshops]=await Promise.all([listYouth(''),listWorkshops()]);
  const labels={
    acolhimento_educativo:'Acolhimento educativo',
    demanda_identificada:'Demanda identificada',
    encaminhamento_interno:'Encaminhamento interno',
    acompanhamento_oficina:'Acompanhamento de oficina',
    mediacao_convivencia:'Mediação e convivência',
    cfdh_estrutural:'CFDH estrutural',
    ficaadica_orientacao:'#FicaAdica / orientação',
    trampo_labpoca:'Trampo Coletivo / LABPoca',
    mobilizacao_evento:'Mobilização / evento',
    mostra:'Mostra',
    estudo_caso:'Participação em estudo de caso',
    outra_acao_educativa:'Outra ação educativa'
  };
  document.querySelectorAll('[data-educator-new]').forEach(btn=>btn.addEventListener('click',()=>{
    const initial=btn.dataset.educatorNew||'acolhimento_educativo';
    modal('Registrar contribuição do Educador',`<form id="educator-record-form" class="stack">
      <div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Tipo de contribuição</label><select name="record_type" required>${Object.entries(labels).map(([k,v])=>`<option value="${k}" ${k===initial?'selected':''}>${esc(v)}</option>`).join('')}</select></div></div>
      <div class="field"><label>Jovem relacionado <span class="muted">(quando houver)</span></label><select name="youth_id"><option value="">Sem jovem específico / atividade coletiva</option>${youth.map(y=>`<option value="${y.id}">${esc(y.preferred_name||y.full_name)} — ${esc(y.neighborhood||'')}</option>`).join('')}</select></div>
      <div class="field"><label>Oficina relacionada <span class="muted">(quando houver)</span></label><select name="workshop_id"><option value="">Nenhuma</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div>
      <div class="field"><label>Título / síntese</label><input class="input" name="title" placeholder="Ex.: Roda sobre respeito às mulheres"></div>
      <div class="field"><label>Descrição objetiva do que foi realizado</label><textarea name="description" required placeholder="Registre ação, contexto e resultado. Não inclua conteúdo clínico ou sigiloso de atendimento técnico."></textarea></div>
      <div class="form-grid"><div class="field"><label>Duração em horas</label><input class="input" type="number" name="duration_hours" min="0" max="24" step="0.25" value="0"><small>Obrigatório para CFDH estrutural.</small></div><div class="field"><label>Nº de participantes</label><input class="input" type="number" name="participants_count" min="0"></div></div>
      <div class="field"><label>Encaminhar demanda para</label><select name="referral_target"><option value="">Sem encaminhamento</option><option value="equipe_tecnica">Equipe Técnica</option><option value="coordenacao">Coordenação</option><option value="articulacao">Articulação</option><option value="administrativo">Administrativo</option><option value="oficina">Oficina / oficineiro</option><option value="rede_externa">Rede externa</option></select><small>Ao selecionar Equipe Técnica, os profissionais técnicos recebem notificação.</small></div>
      <div class="field"><label>Evidência / referência</label><input class="input" name="evidence_ref" placeholder="Ex.: foto registrada, lista de presença, formulário, pasta/arquivo"></div>
      <div class="field"><label>Observação interna</label><textarea name="notes"></textarea></div>
      <button class="btn primary">Salvar contribuição</button>
    </form>`);
    document.querySelector('#educator-record-form')?.addEventListener('submit',async e=>{
      e.preventDefault();const p=parseForm(e.target);
      if(p.record_type==='cfdh_estrutural'&&Number(p.duration_hours||0)<=0){toast('Informe a carga horária do CFDH estrutural.','danger');return;}
      if(['demanda_identificada','encaminhamento_interno'].includes(p.record_type)&&!p.youth_id){toast('Vincule o jovem para registrar uma demanda ou encaminhamento.','danger');return;}
      try{
        await createEducatorRecord(p);
        document.querySelector('#modal')?.remove();
        toast(p.referral_target==='equipe_tecnica'?'Registro salvo e Equipe Técnica notificada':'Contribuição do educador registrada');
        await render();
      }catch(err){toast(err.message,'danger')}
    });
  }));
  document.querySelectorAll('[data-educator-delete]').forEach(btn=>btn.addEventListener('click',async()=>{
    if(!confirm('Excluir este registro do educador? A contribuição e o indicador associado serão retirados.'))return;
    try{await deleteEducatorRecord(btn.dataset.educatorDelete);toast('Registro excluído');await render();}catch(err){toast(err.message,'danger')}
  }));
}


function technicalTargetSettingsCard(settings,editable=false){
  const fields='<div class="form-grid"><div class="field"><label>Atendimentos / mês <small>referência geral CRJ</small></label><input class="input" type="number" min="0" name="technical_target_total_services" value="'+esc(settings?.technical_target_total_services??380)+'"></div><div class="field"><label>Jovens únicos / mês</label><input class="input" type="number" min="0" name="technical_target_unique_youth" value="'+esc(settings?.technical_target_unique_youth??'')+'"></div><div class="field"><label>Atendimentos coletivos / mês</label><input class="input" type="number" min="0" name="technical_target_collective_services" value="'+esc(settings?.technical_target_collective_services??'')+'"></div><div class="field"><label>PVida / referência</label><input class="input" type="number" min="0" name="technical_target_pvida" value="'+esc(settings?.technical_target_pvida??1)+'"></div><div class="field"><label>PTrampo · jovens / mês</label><input class="input" type="number" min="0" name="technical_target_ptrampo_youth" value="'+esc(settings?.technical_target_ptrampo_youth??15)+'"></div><div class="field"><label>PTrampo · atividades / mês</label><input class="input" type="number" min="0" name="technical_target_ptrampo_activities" value="'+esc(settings?.technical_target_ptrampo_activities??8)+'"></div><div class="field"><label>Outras demandas / referência</label><input class="input" type="number" min="0" name="technical_target_other_demands" value="'+esc(settings?.technical_target_other_demands??1)+'"></div></div>';
  return '<div class="card technical-target-settings"><div class="page-head compact"><div><h3>Metas de referência da Equipe Técnica</h3><p>Esses valores alimentam apenas as barras de acompanhamento. O cabeçalho institucional dos documentos é fixo e não pode ser alterado.</p></div></div>'+(editable?'<form id="technical-target-settings-form" class="stack">'+fields+'<button class="btn primary">Salvar referências</button></form>':fields)+'</div>';
}
function technicalProgressCard(label,value,target,meta=''){
  const n=Number(value||0),t=Number(target||0),pct=t>0?Math.min(100,Math.round((n/t)*100)):0;
  return '<div class="card technical-progress-card"><div class="technical-progress-head"><div><span>'+esc(label)+'</span><b>'+n.toLocaleString('pt-BR')+(t>0?' / '+t.toLocaleString('pt-BR'):'')+'</b></div><span class="pill '+(t>0&&n>=t?'success':'info')+'">'+(t>0?pct+'%':'sem referência')+'</span></div><div class="progress-track"><div class="progress-fill" style="width:'+pct+'%"></div></div><small>'+esc(meta||'')+'</small></div>';
}
function technicalProgramLabel(v){return ({atendimento:'Atendimento técnico',acompanhamento:'Acompanhamento',pvida:'PVida',ptrampo:'PTrampo','outras-demandas':'Outras Demandas'})[v]||v}
function technicalEvidenceHtml(dashboard,month){
  const rows=(dashboard?.evidence||[]).map((r,i)=>'<tr><td>'+(i+1)+'</td><td>'+esc(fmtDate(r.date))+'</td><td>'+esc(r.youth_name||'')+'</td><td>'+esc(r.reason||'')+'<br><small>'+esc(technicalProgramLabel(r.program_type))+' · '+esc(r.service_type==='coletivo'?'Coletivo':'Individual')+'</small></td><td>'+esc(r.professional_names||'')+'</td></tr>').join('');
  return '<div class="methodology-paper methodology-paper-landscape technical-evidence-paper"><div class="methodology-annex-title">CRJ CARIACICA · EVIDÊNCIA DE ATENDIMENTOS DA EQUIPE TÉCNICA</div><div class="methodology-institutional-header"><img src="'+esc(METHODOLOGY_HEADER_DATA)+'" alt="Cabeçalho institucional"></div><div class="methodology-inner-title">RELAÇÃO DE ATENDIMENTOS · '+esc(month.split('-').reverse().join('/'))+'</div><table class="methodology-planning-table technical-evidence-table"><thead><tr><th>Nº</th><th>Data</th><th>Jovem</th><th>Motivo do atendimento</th><th>Técnico(s) responsável(is)</th></tr></thead><tbody>'+(rows||'<tr><td colspan="5">Nenhum atendimento técnico registrado no período.</td></tr>')+'</tbody></table><div class="methodology-system-note">Documento operacional de evidência. O detalhamento técnico sensível permanece protegido nos registros internos.</div></div>';
}
function printTechnicalEvidence(dashboard,month){
  const win=window.open('','_blank','noopener,noreferrer,width=1200,height=800');if(!win){toast('O navegador bloqueou a janela de impressão.','danger');return}
  const html=technicalEvidenceHtml(dashboard,month);
  win.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Evidência Equipe Técnica</title><style>@page{size:A4 landscape;margin:10mm}body{font-family:Arial;margin:0;color:#111}.methodology-paper{font-size:9px}.methodology-annex-title,.methodology-inner-title{text-align:center;font-weight:700;margin:8px}.methodology-institutional-header{text-align:center}.methodology-institutional-header img{max-width:340px;max-height:90px}.methodology-planning-table{width:100%;border-collapse:collapse;table-layout:fixed}.methodology-planning-table th,.methodology-planning-table td{border:1px solid #222;padding:5px;vertical-align:top}.technical-evidence-table th:nth-child(1){width:5%}.technical-evidence-table th:nth-child(2){width:10%}.technical-evidence-table th:nth-child(3){width:23%}.technical-evidence-table th:nth-child(4){width:34%}.technical-evidence-table th:nth-child(5){width:28%}.methodology-system-note{font-size:8px;margin-top:7px;color:#555}</style></head><body>'+html+'<script>window.addEventListener("load",()=>setTimeout(()=>window.print(),150));<\/script></body></html>');win.document.close();
}
function downloadTechnicalEvidenceDoc(dashboard,month){
  const html='<!doctype html><html><head><meta charset="UTF-8"><style>@page{size:landscape;margin:1cm}body{font-family:Arial;font-size:9pt}.methodology-institutional-header{text-align:center}.methodology-institutional-header img{width:330px}.methodology-annex-title,.methodology-inner-title{text-align:center;font-weight:bold;margin:10px}.methodology-planning-table{width:100%;border-collapse:collapse}.methodology-planning-table th,.methodology-planning-table td{border:1px solid #000;padding:5px}.methodology-system-note{font-size:7pt;color:#555;margin-top:6px}</style></head><body>'+technicalEvidenceHtml(dashboard,month)+'</body></html>';
  const blob=new Blob([html],{type:'application/msword;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='evidencia-equipe-tecnica-'+month+'.doc';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);
}

async function pageTechnicalTeam(){
  if(!permitted('technical_area'))return '<div class="notice danger">Seu perfil não possui acesso à Área da Equipe Técnica.</div>';
  const month=route().params.get('month')||currentMonth(),view=route().params.get('view')||'painel';
  const dashboard=await listTechnicalTeamDashboard(month);applyDocumentSettings(dashboard.settings);
  const m=dashboard.metrics||{},s=dashboard.settings||{};
  const tabs='<div class="tabs workshop-tabs"><button class="tab '+(view==='painel'?'active':'')+'" data-nav="equipe-tecnica?view=painel&month='+month+'">Painel</button><button class="tab '+(view==='evidencias'?'active':'')+'" data-nav="equipe-tecnica?view=evidencias&month='+month+'">Evidências</button><button class="tab '+(view==='configuracoes'?'active':'')+'" data-nav="equipe-tecnica?view=configuracoes&month='+month+'">Configurações</button></div>';
  const head='<div class="page-head"><div><h2>Área da Equipe Técnica</h2><p>Psicologia · Serviço Social · Terapia Ocupacional — atendimentos, jovens únicos e acompanhamento de PVida, PTrampo e outras demandas.</p></div><div class="actions"><button class="btn primary" data-new-technical-service>+ Novo atendimento</button></div></div>'+tabs+'<div class="toolbar"><label class="field month-filter"><span>Período</span><input class="input" type="month" data-technical-month value="'+esc(month)+'"></label></div>';
  if(view==='configuracoes')return head+technicalTargetSettingsCard(s,permitted('document_settings'));
  if(view==='evidencias'){
    return head+'<div class="card"><div class="page-head compact"><div><h3>Evidência nominal do período</h3><p>Data, jovem, motivo resumido e técnico(s) responsável(is).</p></div><div class="actions"><button class="btn primary" data-technical-print>Imprimir / Salvar PDF</button><button class="btn secondary" data-technical-doc>Baixar DOC</button></div></div><div class="methodology-preview-modal">'+technicalEvidenceHtml(dashboard,month)+'</div></div>';
  }
  const totalTarget=s.technical_target_total_services,uniqueTarget=s.technical_target_unique_youth,collectiveTarget=s.technical_target_collective_services;
  return head+
    '<div class="notice info">A referência de <b>380 atendimentos/mês</b> é a meta geral do CRJ, não uma cota exclusiva da Equipe Técnica. Os demais valores podem ser ajustados em Configurações.</div>'+
    '<div class="grid three technical-progress-grid">'+
      technicalProgressCard('Atendimentos técnicos',m.total_services,totalTarget,'Meta 2.1 · referência geral CRJ')+
      technicalProgressCard('Jovens únicos atendidos',m.unique_youth,uniqueTarget,'Deduplicado por jovem no mês')+
      technicalProgressCard('Atendimentos coletivos',m.collective_services,collectiveTarget,'Aberturas classificadas como coletivas')+
      technicalProgressCard('PVida · acompanhamentos',m.pvida_services,s.technical_target_pvida,'Registros técnicos vinculados ao PVida')+
      technicalProgressCard('PTrampo · jovens únicos',m.ptrampo_unique_youth,s.technical_target_ptrampo_youth,'Referência do plano: 15 jovens/mês')+
      technicalProgressCard('PTrampo · acompanhamentos',m.ptrampo_services,s.technical_target_ptrampo_activities,'Referência operacional: 8 atividades relacionadas')+
      technicalProgressCard('Outras Demandas',m.other_demands,s.technical_target_other_demands,'Acompanhamentos e demandas diversas')+
    '</div>'+
    '<div class="grid two" style="margin-top:16px"><div class="card"><h3>Produção por técnico</h3>'+((dashboard.professionals||[]).map(p=>'<div class="agenda-row"><div><b>'+esc(p.display_name)+'</b><span>'+esc(roleLabel(p.role))+'</span></div><div class="technical-prof-metrics"><b>'+p.services+'</b><small>atendimentos</small><b>'+p.unique_youth+'</b><small>jovens únicos</small></div></div>').join('')||'<div class="empty">Nenhum atendimento no mês.</div>')+'</div><div class="card"><h3>Resumo do período</h3><div class="technical-summary-grid"><div><b>'+m.individual_services+'</b><span>individuais</span></div><div><b>'+m.collective_services+'</b><span>coletivos</span></div><div><b>'+m.pvida_unique_youth+'</b><span>jovens no PVida</span></div><div><b>'+m.ptrampo_unique_youth+'</b><span>jovens no PTrampo</span></div><div><b>'+m.other_unique_youth+'</b><span>jovens em outras demandas</span></div></div></div></div>'+
    '<div class="card" style="margin-top:16px"><div class="page-head compact"><div><h3>Últimos atendimentos</h3><p>Resumo operacional sem exposição de conteúdo técnico sensível.</p></div><button class="btn" data-nav="equipe-tecnica?view=evidencias&month='+month+'">Abrir evidência</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Data</th><th>Jovem(ns)</th><th>Tipo</th><th>Motivo</th><th>Técnico(s)</th></tr></thead><tbody>'+((dashboard.records||[]).slice(0,20).map(r=>'<tr><td>'+fmtDate(r.service_date)+'</td><td>'+esc((r.youth||[]).map(y=>y.preferred_name||y.full_name).join(', '))+'</td><td>'+esc(r.service_type==='coletivo'?'Coletivo':'Individual')+'<br><small>'+esc(technicalProgramLabel(r.program_type))+'</small></td><td>'+esc(r.reason||'')+'</td><td>'+esc((r.professionals||[]).map(p=>p.display_name).join(', '))+'</td></tr>').join('')||'<tr><td colspan="5" class="empty">Nenhum atendimento técnico registrado neste mês.</td></tr>')+'</tbody></table></div></div>';
}
async function bindTechnicalPage(){
  const month=route().params.get('month')||currentMonth();
  document.querySelector('[data-technical-month]')?.addEventListener('change',e=>{const view=route().params.get('view')||'painel';nav('equipe-tecnica?view='+view+'&month='+e.target.value)});
  document.querySelector('[data-new-technical-service]')?.addEventListener('click',async()=>{
    const [youth,team]=await Promise.all([listYouth(''),listTeam()]);
    const tech=team.filter(x=>x.active&&['assistente_social','psicologo','terapeuta_ocupacional'].includes(x.role));
    let html='<form id="technical-service-form" class="stack"><div class="form-grid"><div class="field"><label>Data do atendimento</label><input class="input" type="date" name="service_date" value="'+new Date().toISOString().slice(0,10)+'" required></div><div class="field"><label>Tipo de atendimento</label><select name="service_type"><option value="individual">Individual</option><option value="coletivo">Coletivo</option></select></div></div><div class="field"><label>Vínculo metodológico</label><select name="program_type"><option value="atendimento">Atendimento técnico</option><option value="acompanhamento">Acompanhamento</option><option value="pvida">PVida</option><option value="ptrampo">PTrampo</option><option value="outras-demandas">Outras Demandas</option></select></div><div class="field"><label>Jovem(ns) atendido(s)</label><div class="technical-youth-picker">'+youth.map(y=>'<label class="check"><input type="checkbox" name="youth_ids" value="'+y.id+'"><span>'+esc(y.preferred_name||y.full_name)+' <small>· '+esc(y.neighborhood||'')+'</small></span></label>').join('')+'</div></div><div class="field"><label>Técnico(s) responsável(is)</label><div class="check-grid">'+tech.map(p=>'<label class="check"><input type="checkbox" name="professional_ids" value="'+p.id+'" '+(p.id===state.user?.id?'checked':'')+'><span>'+esc(p.display_name)+' · '+esc(roleLabel(p.role))+'</span></label>').join('')+'</div><small>A estrutura já aceita um ou mais técnicos por atendimento.</small></div><div class="field"><label>Motivo do atendimento / síntese para evidência</label><input class="input" name="reason" required placeholder="Ex.: orientação familiar, demanda escolar, PTrampo..."></div><div class="field"><label>Resumo técnico interno</label><textarea name="summary"></textarea><small>Este conteúdo não aparece na evidência nominal.</small></div><div class="field"><label>Situação</label><select name="status"><option value="realizado">Realizado</option><option value="em_acompanhamento">Em acompanhamento</option><option value="encaminhado">Encaminhado</option><option value="cancelado">Cancelado</option></select></div><button class="btn primary">Salvar atendimento</button></form>';
    modal('Novo atendimento da Equipe Técnica',html);
    document.querySelector('#technical-service-form')?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target),ys=Array.isArray(p.youth_ids)?p.youth_ids:p.youth_ids?[p.youth_ids]:[],ps=Array.isArray(p.professional_ids)?p.professional_ids:p.professional_ids?[p.professional_ids]:[];if(!ys.length){toast('Selecione ao menos um jovem.','danger');return}if(p.service_type==='individual'&&ys.length>1){toast('Atendimento individual deve ter apenas um jovem. Para vários jovens, use Coletivo.','danger');return}if(!ps.length){toast('Selecione ao menos um técnico responsável.','danger');return}try{await createTechnicalService({...p,youth_ids:ys,professional_ids:ps});document.querySelector('#modal')?.remove();toast('Atendimento técnico registrado');await render()}catch(err){toast(err.message,'danger')}});
  });
  const dashboard=await listTechnicalTeamDashboard(month);applyDocumentSettings(dashboard.settings);
  document.querySelector('[data-technical-print]')?.addEventListener('click',()=>printTechnicalEvidence(dashboard,month));
  document.querySelector('[data-technical-doc]')?.addEventListener('click',()=>downloadTechnicalEvidenceDoc(dashboard,month));
  const settingsForm=document.querySelector('#technical-target-settings-form');
  if(settingsForm){
    settingsForm.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target),patch={};for(const k of ['technical_target_total_services','technical_target_unique_youth','technical_target_collective_services','technical_target_pvida','technical_target_ptrampo_youth','technical_target_ptrampo_activities','technical_target_other_demands'])patch[k]=p[k]===''?null:Number(p[k]);try{const saved=await saveDocumentSettings(patch);state.documentSettings=saved;toast('Referências de acompanhamento atualizadas');await render()}catch(err){toast(err.message,'danger')}});
  }
}

async function render(){
  const publicRoute=route();
  if(publicRoute.parts[0]==='presenca-oficina'&&publicRoute.parts[1]){
    app.innerHTML=await pagePublicWorkshopCheckinV2(publicRoute.parts[1]);
    await bindPublicWorkshopCheckinV2(publicRoute.parts[1]);
    return;
  }
  if(!state.user){
    try{
      const s=await getSession();
      state.user=s?.user||null;
    }catch(err){
      console.error('Falha ao restaurar sessão:',err);
      state.user=null;
    }
    if(!state.user){renderLogin();return;}
  }
  if(state.user?.role==='pendente'){renderPending();return;}
  if(!state.documentSettings){try{state.documentSettings=await getDocumentSettings();applyDocumentSettings(state.documentSettings)}catch(err){console.warn('Configuração de documentos indisponível:',err)}}
  try{state.agendaUnread=await agendaUnreadCount();}catch{state.agendaUnread=0;}
  const r=route(); let content=''; try{
    const [p1,p2,p3]=r.parts;
    if(!p1||p1==='dashboard') content=await pageDashboard();
    else if(p1==='jovens') content=await pageYouth();
    else if(p1==='novo-jovem') content=await pageNewYouth();
    else if(p1==='editar-jovem') content=await pageEditYouth(p2);
    else if(p1==='jovem') content=await pageYouthProfile(p2);
    else if(p1==='formularios') content=await pageForms();
    else if(p1==='formulario') content=await pageForm(p2,p3||null);
    else if(p1==='oficinas') content=await pageWorkshops();
    else if(p1==='oficina') content=await pageWorkshopDetailV2(p2);
    else if(p1==='educador') content=await pageEducatorV2();
    else if(p1==='cfdh') content=await pageCfdhShared();
    else if(p1==='equipe-tecnica') content=await pageTechnicalTeam();
    else if(p1==='agenda') content=await renderAgendaPage(state.user);
    else if(p1==='metas') content=await pageGoals();
    else if(p1==='lancamento-geral') content=await pageAggregate();
    else if(p1==='equipe') content=await pageTeam();
    else content='<div class="notice danger">Página não encontrada.</div>';
    app.innerHTML=layout(content); await bindRoute();
    if(p1==='educador') await bindEducatorPageV2();
    if(p1==='cfdh') await bindCfdhShared();
    if(p1==='equipe-tecnica') await bindTechnicalPage();
    if(p1==='oficina') await bindWorkshopDetailV2(p2);
    if(p1==='agenda') await bindAgendaPage(state.user,{toast,rerender:render,nav});
  }catch(err){console.error(err);app.innerHTML=layout(`<div class="notice danger"><strong>Erro ao carregar.</strong><br>${esc(err.message)}</div>`);await bindRoute();}
}

window.addEventListener('hashchange',render);
let __bootError=null;
try{
  await initApi();
}catch(err){
  __bootError=err;
  console.error('Falha na inicialização do CRJ Trajetórias:',err);
  app.innerHTML=`<div class="login-page"><div class="login-card"><div class="brand-mark" style="margin-bottom:16px">CRJ</div><h1>CRJ Trajetórias</h1><div class="notice danger"><strong>Não foi possível iniciar o sistema.</strong><br>${esc(err?.message||String(err))}</div><div class="actions" style="margin-top:16px"><button class="btn primary" onclick="location.reload()">Recarregar</button></div></div></div>`;
}
window.__CRJ_BOOT_ERROR__=__bootError;
window.__CRJ_RESET_DEMO__=()=>{resetDemo();location.reload()};

