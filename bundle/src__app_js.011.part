
/* LABPOCA_WORKSPACE_20261022
 * Área transversal para Coordenações, Educadores e Equipe Técnica.
 * Estética = LABPOCA | Audiovisual = LABSTUDIO.
 * M6.6 é alimentado exclusivamente pela pesquisa mensal de satisfação.
 */
(()=>{
  const ALLOWED=new Set(['coordenacao_geral','coordenacao_articulacao','educador','assistente_social','psicologo','terapeuta_ocupacional']);
  let apiP=null,cfgP=null,profile=null,timer=null,lastWorkshopId=null,cfdhCache={planId:null,plan:null,workshops:[],links:new Map()};
  const esc=(v='')=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const api=()=>apiP||(apiP=import('./api.js?v=20261016-hours1'));
  const cfg=()=>cfgP||(cfgP=import('./config.js'));
  const client=async()=>{const m=await api();if(m.apiMode()!=='live')throw new Error('Banco ainda não conectado.');return m.supabaseClient()};
  const monthNow=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).format(new Date());
  const params=()=>new URLSearchParams((location.hash.split('?')[1]||''));
  const selectedMonth=()=>params().get('month')||monthNow();
  const monthStart=m=>`${m}-01`;
  const nextMonth=m=>{const [y,mo]=m.split('-').map(Number);return new Date(Date.UTC(y,mo,1)).toISOString().slice(0,10)};
  const areaLabel=a=>a==='audiovisual'?'Audiovisual (LABSTUDIO)':'Estética (LABPOCA)';
  const timeHours=(a,b)=>{if(!a||!b)return 0;const A=String(a).slice(0,5).split(':').map(Number),B=String(b).slice(0,5).split(':').map(Number);return Math.max(0,(B[0]*60+B[1]-A[0]*60-A[1])/60)};
  const slug=s=>String(s||'labpoca').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,35);
  function toast(msg,type='success'){const d=document.createElement('div');d.textContent=msg;d.className=`pill ${type}`;Object.assign(d.style,{position:'fixed',right:'20px',bottom:'20px',zIndex:'2147483647',padding:'12px 16px',boxShadow:'0 12px 35px rgba(0,0,0,.22)'});document.body.appendChild(d);setTimeout(()=>d.remove(),3800)}
  function ensureCss(){if(document.querySelector('#labpoca-workspace-css'))return;const s=document.createElement('style');s.id='labpoca-workspace-css';s.textContent=`
    .lp-shell{display:grid;gap:14px}.lp-top{display:flex;gap:12px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}.lp-kpis{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:9px}.lp-kpi{border:1px solid #dce8e3;border-radius:14px;padding:12px;background:#fff}.lp-kpi span{display:block;font-size:11px;color:#65766f}.lp-kpi b{display:block;font-size:22px;margin-top:4px}.lp-two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.lp-card{border:1px solid #dbe7e2;border-radius:16px;background:#fff;padding:14px}.lp-table{width:100%;border-collapse:collapse;font-size:12px}.lp-table th,.lp-table td{padding:8px;border-bottom:1px solid #e8efec;text-align:left;vertical-align:top}.lp-table th{font-size:11px;color:#52665f}.lp-badge{display:inline-flex;border-radius:999px;padding:3px 7px;background:#eaf5f1;color:#145747;font-size:10px;font-weight:700}.lp-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.lp-modal-bg{position:fixed;inset:0;z-index:2147483000;background:rgba(6,22,18,.68);display:grid;place-items:center;padding:14px}.lp-modal{width:min(760px,96vw);max-height:94vh;overflow:auto;background:#fff;border-radius:18px;padding:18px;box-shadow:0 28px 80px rgba(0,0,0,.3)}.lp-modal h3{margin-top:0}.lp-question{border:1px solid #dce7e2;border-radius:12px;padding:11px;margin:9px 0}.lp-question label{display:block;font-weight:700;font-size:12px;margin-bottom:6px}.lp-question select{width:100%}.lp-cfdh{margin-top:10px;padding:12px;border:1px solid #b9d8cd;border-radius:12px;background:#f5faf8}.lp-cfdh label{font-weight:700}.lp-workshop-class{border:2px solid #9bcabc;border-radius:14px;padding:13px;background:#f4faf8}.lp-muted{color:#697a74;font-size:12px}.lp-empty{padding:16px;text-align:center;color:#71807b}.lp-progress{height:9px;background:#e7eeeb;border-radius:999px;overflow:hidden}.lp-progress>i{display:block;height:100%;background:#0b6b58}.lp-actions{display:flex;gap:8px;flex-wrap:wrap}.lp-area-title{display:flex;justify-content:space-between;gap:10px;align-items:center}.lp-scroll{overflow:auto}@media(max-width:1000px){.lp-kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.lp-two,.lp-form-grid{grid-template-columns:1fr}.lp-kpis{grid-template-columns:repeat(2,1fr)}}`;
    document.head.appendChild(s);
  }
  async function currentProfile(){if(profile)return profile;try{const m=await api(),s=await m.getSession();profile=s?.user||null}catch{}return profile}
  async function ensureNav(){const p=await currentProfile();const nav=document.querySelector('.sidebar .nav');if(!nav)return;let a=nav.querySelector('[data-labpoca-nav]');if(!p||!ALLOWED.has(p.role)){a?.remove();return}if(!a){a=document.createElement('a');a.dataset.labpocaNav='1';a.href='#labpoca?month='+monthNow();a.innerHTML='<span>◈</span><span>LABPOCA</span>';const sep=nav.querySelector('.sep');nav.insertBefore(a,sep||null)}a.classList.toggle('active',location.hash.startsWith('#labpoca'))}
  async function qin(q,column,ids){if(!ids.length)return {data:[],error:null};return q.in(column,ids)}
  async function loadLabData(m){
    const db=await client(),start=monthStart(m),end=nextMonth(m);
    const wq=await db.rpc('list_workshops_for_month',{p_month:start});if(wq.error)throw wq.error;
    const workshops=(wq.data||[]).filter(w=>w.active!==false&&(w.is_labpoca===true||String(w.is_labpoca)==='true')&&['estetica','audiovisual'].includes(w.labpoca_area));
    const wids=workshops.map(w=>w.id);
    let plans=[],lessons=[],sessions=[],attendance=[],reports=[],credentials=[],cfdhLinks=[],cfdhActions=[],cfdhAttendance=[],educatorRecords=[],cycles=[],responses=[],reportRow=null;
    if(wids.length){
      let r=await db.from('workshop_monthly_plans').select('*').in('workshop_id',wids).eq('plan_month',start);if(r.error)throw r.error;plans=r.data||[];
      const pids=plans.map(x=>x.id);if(pids.length){r=await db.from('workshop_plan_lessons').select('*').in('plan_id',pids).eq('included',true);if(r.error)throw r.error;lessons=r.data||[];r=await db.from('workshop_monthly_reports').select('*').in('plan_id',pids);if(r.error)throw r.error;reports=r.data||[]}
      r=await db.from('workshop_sessions').select('*').in('workshop_id',wids).gte('session_date',start).lt('session_date',end);if(r.error)throw r.error;sessions=r.data||[];
      r=await db.from('attendance').select('id,workshop_id,youth_id,attendance_date,present').in('workshop_id',wids).gte('attendance_date',start).lt('attendance_date',end).eq('present',true);if(r.error)throw r.error;attendance=r.data||[];
      r=await db.from('labpoca_survey_credentials').select('workshop_id,login,active,updated_at').in('workshop_id',wids);if(!r.error)credentials=r.data||[];
      r=await db.from('labpoca_cfdh_links').select('*').in('workshop_id',wids).eq('contributes',true);if(!r.error)cfdhLinks=r.data||[];
      const aids=cfdhLinks.map(x=>x.action_id);if(aids.length){r=await db.from('cfdh_actions').select('id,plan_id,workshop_id,title,action_theme,scheduled_date,actual_date,planned_duration_hours,actual_duration_hours,execution_status,execution_description').in('id',aids);if(!r.error)cfdhActions=(r.data||[]).filter(x=>{const d=x.actual_date||x.scheduled_date;return d>=start&&d<end});const currentIds=cfdhActions.map(x=>x.id);if(currentIds.length){r=await db.from('cfdh_attendance').select('action_id,youth_id,attendance_date,present').in('action_id',currentIds).eq('present',true);if(!r.error)cfdhAttendance=(r.data||[]).filter(x=>x.attendance_date>=start&&x.attendance_date<end)}}
      r=await db.from('educator_records').select('*').in('workshop_id',wids).eq('record_type','trampo_labpoca').gte('record_date',start).lt('record_date',end);if(!r.error)educatorRecords=r.data||[];
    }
    let r=await db.from('labpoca_survey_cycles').select('*').eq('reference_month',start);if(!r.error)cycles=r.data||[];
    const cids=cycles.map(x=>x.id);if(cids.length){r=await db.from('labpoca_survey_responses').select('*').in('cycle_id',cids);if(!r.error)responses=r.data||[]}
    r=await db.from('labpoca_monthly_reports').select('*').eq('reference_month',start).maybeSingle();if(!r.error)reportRow=r.data||null;
    const youthIds=[...new Set([...attendance.map(x=>x.youth_id),...cfdhAttendance.map(x=>x.youth_id),...educatorRecords.map(x=>x.youth_id)].filter(Boolean))],youth=new Map();
    if(youthIds.length){r=await db.from('young_people').select('id,full_name,preferred_name,cpf,phone,email').in('id',youthIds);if(!r.error)for(const y of r.data||[])youth.set(y.id,y)}
    return {m,start,end,workshops,plans,lessons,sessions,attendance,reports,credentials,cfdhLinks,cfdhActions,cfdhAttendance,educatorRecords,cycles,responses,reportRow,youth};
  }
  function areaData(d,area){
    const ws=d.workshops.filter(x=>x.labpoca_area===area),ids=new Set(ws.map(x=>x.id)),plans=d.plans.filter(x=>ids.has(x.workshop_id)),pids=new Set(plans.map(x=>x.id)),less=d.lessons.filter(x=>pids.has(x.plan_id)),sess=d.sessions.filter(x=>ids.has(x.workshop_id)),att=d.attendance.filter(x=>ids.has(x.workshop_id)),links=d.cfdhLinks.filter(x=>x.area===area),aid=new Set(links.map(x=>x.action_id)),cacts=d.cfdhActions.filter(x=>aid.has(x.id)),catt=d.cfdhAttendance.filter(x=>aid.has(x.action_id)),erec=d.educatorRecords.filter(x=>ids.has(x.workshop_id)),cyc=d.cycles.find(x=>x.area===area),resp=cyc?d.responses.filter(x=>x.cycle_id===cyc.id):[];
    const unique=new Set([...att.map(x=>x.youth_id),...catt.map(x=>x.youth_id),...erec.map(x=>x.youth_id)].filter(Boolean));
    return {ws,plans,less,sess,att,links,cacts,catt,erec,cyc,resp,unique,plannedHours:less.reduce((n,x)=>n+timeHours(x.start_time,x.end_time),0),executedHours:sess.reduce((n,x)=>n+Number(x.duration_hours||0),0),executedWorkshops:new Set(sess.map(x=>x.workshop_id)).size};
  }
  function satisfaction(resp){const n=resp.length,pos=resp.filter(x=>Number(x.overall_score)>=4).length;return {n,pos,pct:n?Math.round(pos*10000/n)/100:0}}
  function workshopRows(d,a){return a.ws.map(w=>{const p=a.plans.find(x=>x.workshop_id===w.id),less=a.less.filter(x=>x.plan_id===p?.id),sess=a.sess.filter(x=>x.workshop_id===w.id),att=a.att.filter(x=>x.workshop_id===w.id),uniq=new Set(att.map(x=>x.youth_id).filter(Boolean)).size,rep=d.reports.find(x=>x.plan_id===p?.id),cred=d.credentials.find(x=>x.workshop_id===w.id);return `<tr><td><b>${esc(w.name)}</b><br><span class="lp-badge">${esc(areaLabel(w.labpoca_area))}</span></td><td>${less.length}</td><td>${sess.length}</td><td>${less.reduce((n,x)=>n+timeHours(x.start_time,x.end_time),0).toLocaleString('pt-BR')}h / ${sess.reduce((n,x)=>n+Number(x.duration_hours||0),0).toLocaleString('pt-BR')}h</td><td>${uniq}</td><td>${esc(rep?.actual_description||'Sem síntese mensal registrada.')}</td><td><button class="btn secondary" data-lp-access="${w.id}">${cred?.active?'Acesso pesquisa':'Configurar pesquisa'}</button></td></tr>`}).join('')}
  function actionRows(d,a){const c=a.cacts.map(x=>{const l=a.links.find(y=>y.action_id===x.id);return `<tr><td>${esc(x.actual_date||x.scheduled_date||'')}</td><td>CFDH</td><td><b>${esc(x.title||x.action_theme||'Ação CFDH')}</b><br>${esc(x.execution_description||'Vínculo com desenvolvimento do LABPOCA.')}</td><td>${Number(x.actual_duration_hours||x.planned_duration_hours||0).toLocaleString('pt-BR')}h</td><td>${a.catt.filter(y=>y.action_id===x.id).length}</td></tr>`});const e=a.erec.map(x=>`<tr><td>${esc(x.record_date||'')}</td><td>Outra ação</td><td><b>${esc(x.title||'Ação LABPOCA')}</b><br>${esc(x.description||'')}</td><td>${Number(x.duration_hours||0).toLocaleString('pt-BR')}h</td><td>${x.youth_id?1:(x.participants_count??'—')}</td></tr>`);return [...c,...e].join('')}
  function participantRows(d,a){const src=new Map();for(const x of a.att){const w=d.workshops.find(y=>y.id===x.workshop_id);const s=src.get(x.youth_id)||new Set();s.add('Oficina: '+(w?.name||'LABPOCA'));src.set(x.youth_id,s)}for(const x of a.catt){const s=src.get(x.youth_id)||new Set();s.add('CFDH vinculado');src.set(x.youth_id,s)}for(const x of a.erec.filter(x=>x.youth_id)){const s=src.get(x.youth_id)||new Set();s.add('Ação LABPOCA');src.set(x.youth_id,s)}return [...a.unique].map(id=>{const y=d.youth.get(id),r=a.resp.find(x=>x.youth_id===id);return `<tr><td><b>${esc(y?.preferred_name||y?.full_name||'Jovem')}</b><br><small>${esc(y?.full_name||'')}</small></td><td>${esc([...(src.get(id)||[])].join(' · '))}</td><td>${r?`<span class="lp-badge">Respondida · ${r.overall_score}/5</span>`:'Pendente'}</td><td><button class="btn secondary" data-lp-survey-youth="${id}" data-lp-area="${a.ws[0]?.labpoca_area||''}">${r?'Editar pesquisa':'Aplicar pesquisa'}</button></td></tr>`}).join('')}
  function areaHtml(d,area){const a=areaData(d,area),sat=satisfaction(a.resp);return `<section class="lp-card"><div class="lp-area-title"><div><h3 style="margin:0">${areaLabel(area)}</h3><div class="lp-muted">Resultados da competência ${d.m.split('-').reverse().join('/')}</div></div><span class="lp-badge">${sat.n} resposta(s) · ${sat.pct.toLocaleString('pt-BR')}%</span></div><div class="lp-kpis" style="margin-top:12px"><div class="lp-kpi"><span>Oficinas planejadas</span><b>${a.plans.length}</b></div><div class="lp-kpi"><span>Oficinas executadas</span><b>${a.executedWorkshops}</b></div><div class="lp-kpi"><span>Aulas planejadas</span><b>${a.less.length}</b></div><div class="lp-kpi"><span>Aulas executadas</span><b>${a.sess.length}</b></div><div class="lp-kpi"><span>Carga horária</span><b style="font-size:16px">${a.plannedHours.toLocaleString('pt-BR')}h / ${a.executedHours.toLocaleString('pt-BR')}h</b></div><div class="lp-kpi"><span>Jovens participantes</span><b>${a.unique.size}</b></div></div><details open style="margin-top:12px"><summary><b>Oficinas e sínteses de execução</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Oficina</th><th>Planejadas</th><th>Executadas</th><th>CH prev./exec.</th><th>Jovens</th><th>Síntese</th><th>Pesquisa</th></tr></thead><tbody>${workshopRows(d,a)||'<tr><td colspan="7" class="lp-empty">Nenhuma oficina classificada nesta categoria.</td></tr>'}</tbody></table></div></details><details style="margin-top:12px"><summary><b>Ações integradas ao LABPOCA</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Data</th><th>Origem</th><th>Ação</th><th>CH</th><th>Participações</th></tr></thead><tbody>${actionRows(d,a)||'<tr><td colspan="5" class="lp-empty">Nenhuma ação integrada registrada.</td></tr>'}</tbody></table></div></details><details style="margin-top:12px"><summary><b>Jovens participantes</b></summary><div class="lp-scroll"><table class="lp-table"><thead><tr><th>Jovem</th><th>Como participa</th><th>Pesquisa mensal</th><th>Ação</th></tr></thead><tbody>${participantRows(d,a)||'<tr><td colspan="4" class="lp-empty">Nenhum jovem com participação registrada.</td></tr>'}</tbody></table></div></details></section>`}
  async function renderLab(){
    if(!location.hash.startsWith('#labpoca'))return;ensureCss();const p=await currentProfile();if(!p||!ALLOWED.has(p.role))return;const host=document.querySelector('.content');if(!host)return;const m=selectedMonth(),key=`${m}:${location.hash}`;if(host.dataset.labpocaKey===key&&host.querySelector('[data-labpoca-page]'))return;host.dataset.labpocaKey=key;host.innerHTML='<div class="card"><div class="empty">Carregando LABPOCA…</div></div>';
    try{const d=await loadLabData(m),allResp=d.responses,sat=satisfaction(allResp),answered=new Set(allResp.map(x=>x.youth_id)).size,allUnique=new Set([...areaData(d,'estetica').unique,...areaData(d,'audiovisual').unique]),coverage=allUnique.size?Math.round(answered*10000/allUnique.size)/100:0;host.innerHTML=`<div class="lp-shell" data-labpoca-page><div class="lp-top"><div><h2 style="margin:0">LABPOCA</h2><p class="lp-muted">Estética (LABPOCA) + Audiovisual (LABSTUDIO). Execuções e participações são demonstrativas; <b>somente a pesquisa mensal de satisfação alimenta a Meta 6.6.</b></p></div><div class="lp-actions"><input class="input" type="month" min="2025-10" max="2027-03" value="${esc(m)}" data-lp-month><button class="btn secondary" data-lp-refresh>Atualizar</button></div></div><div class="lp-card"><div class="lp-area-title"><div><h3 style="margin:0">Indicador 6.6 · Satisfação com recursos</h3><div class="lp-muted">Satisfeitos = nota geral 4 ou 5. Meta mínima: 85%.</div></div><div class="lp-actions"><button class="btn primary" data-lp-report>${d.reportRow?.submission_id?'Atualizar evidência mensal':'Gerar evidência mensal'}</button>${d.reportRow?.submission_id?`<button class="btn secondary" data-lp-report-pdf>PDF</button><button class="btn secondary" data-lp-report-docx>DOCX</button>`:''}</div></div><div class="lp-kpis" style="margin-top:12px"><div class="lp-kpi"><span>Resultado M6.6</span><b>${sat.pct.toLocaleString('pt-BR')}%</b></div><div class="lp-kpi"><span>Meta</span><b>85%</b></div><div class="lp-kpi"><span>Respostas válidas</span><b>${sat.n}</b></div><div class="lp-kpi"><span>Satisfeitos</span><b>${sat.pos}</b></div><div class="lp-kpi"><span>Participantes únicos</span><b>${allUnique.size}</b></div><div class="lp-kpi"><span>Cobertura da pesquisa</span><b>${coverage.toLocaleString('pt-BR')}%</b></div></div><div class="lp-progress" style="margin-top:10px"><i style="width:${Math.min(100,sat.pct)}%"></i></div></div><div class="lp-two">${areaHtml(d,'estetica')}${areaHtml(d,'audiovisual')}</div></div>`;
      bindLab(host,d);
    }catch(err){host.innerHTML=`<div class="notice danger"><b>Não foi possível carregar o LABPOCA.</b><br>${esc(err?.message||String(err))}</div>`}
  }
  async function downloadSubmission(id,format){const [db,{CONFIG}]=await Promise.all([client(),cfg()]),{data:{session}}=await db.auth.getSession();if(!session)throw new Error('Sessão expirada.');const r=await fetch(`${CONFIG.supabaseUrl}/functions/v1/crj-export-document`,{method:'POST',headers:{Authorization:`Bearer ${session.access_token}`,apikey:CONFIG.supabasePublishableKey,'Content-Type':'application/json'},body:JSON.stringify({submission_id:id,format})});if(!r.ok){let m='Falha ao gerar arquivo.';try{m=(await r.json()).error||m}catch{}throw new Error(m)}const b=await r.blob(),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=`LABPOCA_${selectedMonth()}.${format}`;a.click();setTimeout(()=>URL.revokeObjectURL(u),10000)}
  function closeModal(){document.querySelector('.lp-modal-bg')?.remove()}
  function ratingOptions(v=''){return `<option value="">Selecione</option>${[[1,'1 · Péssimo'],[2,'2 · Ruim'],[3,'3 · Regular'],[4,'4 · Bom'],[5,'5 · Ótimo']].map(([n,l])=>`<option value="${n}" ${Number(v)===n?'selected':''}>${l}</option>`).join('')}`}
  function surveyModal(d,youthId,area){const a=areaData(d,area),y=d.youth.get(youthId),cyc=a.cyc,old=cyc?d.responses.find(x=>x.cycle_id===cyc.id&&x.youth_id===youthId):null,bg=document.createElement('div');bg.className='lp-modal-bg';bg.innerHTML=`<div class="lp-modal"><h3>Pesquisa mensal · ${esc(areaLabel(area))}</h3><p class="lp-muted">Jovem: <b>${esc(y?.preferred_name||y?.full_name||'')}</b> · competência ${esc(d.m)}</p><form data-lp-survey-form><div class="field"><label>Oficina de referência</label><select class="input" name="workshop_id" required>${a.ws.map(w=>`<option value="${w.id}" ${old?.workshop_id===w.id?'selected':''}>${esc(w.name)}</option>`).join('')}</select></div>${[['tech_score','Os equipamentos e recursos tecnológicos disponíveis atenderam às necessidades da atividade?'],['materials_score','Os materiais e insumos disponíveis foram adequados para a atividade?'],['availability_score','A quantidade e disponibilidade dos recursos foram suficientes?'],['condition_score','O estado de conservação e funcionamento dos recursos foi satisfatório?'],['overall_score','De forma geral, qual seu nível de satisfação com os recursos tecnológicos e materiais do LABPOCA/LABSTUDIO?']].map(([n,q])=>`<div class="lp-question"><label>${esc(q)}</label><select class="input" name="${n}" required>${ratingOptions(old?.[n])}</select></div>`).join('')}<div class="field"><label>O que funcionou bem?</label><textarea class="input" name="positive_notes">${esc(old?.positive_notes||'')}</textarea></div><div class="field"><label>O que precisa melhorar?</label><textarea class="input" name="improvement_notes">${esc(old?.improvement_notes||'')}</textarea></div><div class="field"><label>Observações / sugestões</label><textarea class="input" name="comments">${esc(old?.comments||'')}</textarea></div><div class="lp-actions"><button class="btn secondary" type="button" data-lp-close>Cancelar</button><button class="btn primary" type="submit">Salvar pesquisa</button></div></form></div>`;document.body.appendChild(bg);bg.querySelector('[data-lp-close]').onclick=closeModal;bg.addEventListener('click',e=>{if(e.target===bg)closeModal()});bg.querySelector('form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,fd=new FormData(f),b=f.querySelector('button[type=submit]');b.disabled=true;try{const db=await client(),r=await db.rpc('labpoca_staff_submit_satisfaction',{p_month:d.start,p_area:area,p_workshop_id:fd.get('workshop_id'),p_youth_id:youthId,p_tech_score:Number(fd.get('tech_score')),p_materials_score:Number(fd.get('materials_score')),p_availability_score:Number(fd.get('availability_score')),p_condition_score:Number(fd.get('condition_score')),p_overall_score:Number(fd.get('overall_score')),p_positive_notes:String(fd.get('positive_notes')||''),p_improvement_notes:String(fd.get('improvement_notes')||''),p_comments:String(fd.get('comments')||'')});if(r.error)throw r.error;closeModal();toast('Pesquisa salva e indicador 6.6 recalculado.');document.querySelector('.content').dataset.labpocaKey='';renderLab()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false}}}
  function accessModal(d,wid){const w=d.workshops.find(x=>x.id===wid),old=d.credentials.find(x=>x.workshop_id===wid),login=old?.login||slug(w?.name),urlBase=new URL('./demanda.html',location.href.split('#')[0]);urlBase.searchParams.set('mode','labpoca');urlBase.searchParams.set('month',d.m);urlBase.searchParams.set('login',login);const bg=document.createElement('div');bg.className='lp-modal-bg';bg.innerHTML=`<div class="lp-modal"><h3>Acesso remoto · ${esc(w?.name||'Oficina')}</h3><p class="lp-muted">O jovem usa o login e a senha da oficina. O CPF identifica o participante sem expor a lista de jovens.</p><form data-lp-access-form><div class="field"><label>Login da oficina</label><input class="input" name="login" required minlength="4" value="${esc(login)}"></div><div class="field"><label>${old?'Nova senha (deixe em branco para manter)':'Senha da oficina'}</label><input class="input" name="password" type="password" minlength="4" ${old?'':'required'}></div><div class="field"><label>Link da pesquisa</label><input class="input" readonly data-lp-link value="${esc(urlBase.toString())}"></div><div class="lp-actions"><button class="btn secondary" type="button" data-lp-copy>Copiar link</button><button class="btn secondary" type="button" data-lp-close>Fechar</button><button class="btn primary" type="submit">Salvar acesso</button></div></form></div>`;document.body.appendChild(bg);const f=bg.querySelector('form'),link=f.querySelector('[data-lp-link]');f.querySelector('[name=login]').oninput=e=>{const u=new URL(link.value);u.searchParams.set('login',e.target.value);link.value=u.toString()};f.querySelector('[data-lp-copy]').onclick=()=>navigator.clipboard.writeText(link.value).then(()=>toast('Link copiado.')).catch(()=>{});bg.querySelector('[data-lp-close]').onclick=closeModal;f.onsubmit=async e=>{e.preventDefault();const fd=new FormData(f),b=f.querySelector('button[type=submit]');b.disabled=true;try{const db=await client(),r=await db.rpc('labpoca_set_workshop_access',{p_workshop_id:wid,p_login:String(fd.get('login')||''),p_password:String(fd.get('password')||''),p_active:true});if(r.error)throw r.error;closeModal();toast('Acesso da pesquisa atualizado.');document.querySelector('.content').dataset.labpocaKey='';renderLab()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false}}}
  function bindLab(host,d){host.querySelector('[data-lp-month]').onchange=e=>location.hash=`labpoca?month=${e.target.value}`;host.querySelector('[data-lp-refresh]').onclick=()=>{host.dataset.labpocaKey='';renderLab()};host.querySelectorAll('[data-lp-survey-youth]').forEach(b=>b.onclick=()=>surveyModal(d,b.dataset.lpSurveyYouth,b.dataset.lpArea));host.querySelectorAll('[data-lp-access]').forEach(b=>b.onclick=()=>accessModal(d,b.dataset.lpAccess));host.querySelector('[data-lp-report]').onclick=async e=>{const b=e.currentTarget,old=b.textContent;b.disabled=true;b.textContent='Gerando…';try{const db=await client(),r=await db.rpc('labpoca_generate_monthly_report',{p_month:d.start});if(r.error)throw r.error;toast('Evidência mensal atualizada.');await downloadSubmission(r.data,'pdf');host.dataset.labpocaKey='';renderLab()}catch(err){toast(err.message||String(err),'danger')}finally{b.disabled=false;b.textContent=old}};host.querySelector('[data-lp-report-pdf]')?.addEventListener('click',()=>downloadSubmission(d.reportRow.submission_id,'pdf').catch(e=>toast(e.message,'danger')));host.querySelector('[data-lp-report-docx]')?.addEventListener('click',()=>downloadSubmission(d.reportRow.submission_id,'docx').catch(e=>toast(e.message,'danger')))}

  /* Classificação explícita na criação/edição da oficina. */
  document.addEventListener('click',e=>{const edit=e.target.closest?.('[data-edit-workshop]'),nw=e.target.closest?.('[data-action="new-workshop"]');if(edit)lastWorkshopId=edit.dataset.editWorkshop;if(nw)lastWorkshopId=null},true);
  async function enhanceWorkshopForm(){const f=document.querySelector('#workshop-device-form');if(!f||f.dataset.labpocaBound==='1')return;f.dataset.labpocaBound='1';ensureCss();const loc=f.querySelector('[name=location_type]');if(loc&&!loc.querySelector('option[value="LABStudio"]')){const o=document.createElement('option');o.value='LABStudio';o.textContent='LABStudio';loc.insertBefore(o,loc.querySelector('option[value="Sala de computadores"]'))}
    let current=null;try{if(lastWorkshopId){const db=await client(),r=await db.rpc('list_workshops_for_month',{p_month:monthStart(selectedMonth())});current=(r.data||[]).find(x=>x.id===lastWorkshopId)||null}}catch{}
    const box=document.createElement('div');box.className='lp-workshop-class';box.dataset.labpocaWorkshopClass='1';box.innerHTML=`<div><b>Essa oficina é um LABPOCA?</b><br><small class="lp-muted">Se sim, ela passa a integrar o painel mensal LABPOCA e deve ser classificada em uma das duas frentes.</small></div><div class="lp-form-grid" style="margin-top:10px"><div class="field"><label>Integra o LABPOCA?</label><select class="input" name="is_labpoca"><option value="false">Não</option><option value="true">Sim</option></select></div><div class="field" data-lp-area-field><label>Qual frente?</label><select class="input" name="labpoca_area"><option value="">Selecione</option><option value="estetica">Estética (LABPOCA)</option><option value="audiovisual">Audiovisual (LABSTUDIO)</option></select></div></div>`;const dev=f.querySelector('[data-wd-device-box]');dev?.insertAdjacentElement('beforebegin',box);const yes=box.querySelector('[name=is_labpoca]'),area=box.querySelector('[name=labpoca_area]'),generic=f.querySelector('[name="methodology_devices"][value="labpoca"]');if(generic)generic.closest('label')?.setAttribute('style','display:none');yes.value=(current?.is_labpoca===true||String(current?.is_labpoca)==='true')?'true':'false';area.value=current?.labpoca_area||'';
    const sync=()=>{const on=yes.value==='true';area.required=on;box.querySelector('[data-lp-area-field]').style.display=on?'block':'none';if(generic&&!generic.disabled){generic.checked=on;generic.dispatchEvent(new Event('change',{bubbles:true}))}if(!on)area.value='';if(on&&area.value==='audiovisual'&&loc&&!loc.value)loc.value='LABStudio';if(on&&area.value==='estetica'&&loc&&!loc.value)loc.value='LABPoca'};yes.addEventListener('change',sync);area.addEventListener('change',sync);sync();
  }

  /* CFDH: vínculo LABPOCA é metodológico; não altera agenda estrutural. */
  async function cfdhContext(){const id=params().get('plan');if(!id)return null;if(cfdhCache.planId===id)return cfdhCache;const db=await client(),pq=await db.from('educator_plans').select('id,plan_type,planned_start').eq('id',id).single();if(pq.error)return null;const m=String(pq.data.planned_start||'').slice(0,7)||monthNow(),wr=await db.rpc('list_workshops_for_month',{p_month:monthStart(m)}),workshops=(wr.data||[]).filter(w=>w.active!==false&&(w.is_labpoca===true||String(w.is_labpoca)==='true'),cards=[...document.querySelectorAll('[data-cfdh-action-card]')],aids=cards.map(x=>x.dataset.actionId).filter(Boolean);let links=[];if(aids.length){const lq=await db.from('labpoca_cfdh_links').select('*').in('action_id',aids);if(!lq.error)links=lq.data||[]}cfdhCache={planId:id,plan:pq.data,workshops,links:new Map(links.map(x=>[x.action_id,x]))};return cfdhCache}
  async function enhanceCfdh(){if(!location.hash.startsWith('#cfdh'))return;const ctx=await cfdhContext();if(!ctx)return;for(const card of document.querySelectorAll('[data-cfdh-action-card]')){card.querySelector('[data-cfdh-program-option="labpoca"]')?.setAttribute('style','display:none');if(card.querySelector('[data-lp-cfdh]'))continue;const aid=card.dataset.actionId;if(!aid)continue;const old=ctx.links.get(aid),trans=ctx.plan.plan_type==='cfdh_transversal',normalSel=card.querySelector('[data-cfdh-action-workshop]');const box=document.createElement('div');box.className='lp-cfdh';box.dataset.lpCfdh='1';card.appendChild(box);
      const draw=()=>{let refId=trans?(normalSel?.value||''):(old?.workshop_id||''),w=ctx.workshops.find(x=>x.id===refId);if(trans&&!w){box.innerHTML='<b>LABPOCA</b><div class="lp-muted">A pergunta de contribuição será exibida automaticamente quando a oficina vinculada estiver classificada como LABPOCA/LABSTUDIO.</div>';return}box.innerHTML=`<b>Desenvolvimento do LABPOCA</b>${trans?'':`<div class="field" style="margin-top:8px"><label>Oficina LABPOCA de referência</label><select class="input" data-lp-cfdh-workshop><option value="">Não vinculada</option>${ctx.workshops.map(x=>`<option value="${x.id}" ${refId===x.id?'selected':''}>${esc(x.name)} · ${esc(areaLabel(x.labpoca_area))}</option>`).join('')}</select></div>`}${w||(!trans&&refId)?`<div class="field" style="margin-top:8px"><label>Este CFDH contribui para o desenvolvimento do ${esc(w?areaLabel(w.labpoca_area):'LABPOCA')}?</label><select class="input" data-lp-cfdh-contributes><option value="false" ${!old?.contributes?'selected':''}>Não</option><option value="true" ${old?.contributes?'selected':''}>Sim</option></select><small class="lp-muted">Este vínculo aparece no painel LABPOCA, mas não alimenta o indicador 6.6. A Meta 6.6 recebe apenas a pesquisa mensal de satisfação.</small></div>`:''}`;
        const ref=box.querySelector('[data-lp-cfdh-workshop]');if(ref)ref.onchange=async e=>{const wid=e.target.value;if(!wid){box.innerHTML='<b>Desenvolvimento do LABPOCA</b><div class="lp-muted">Selecione uma oficina LABPOCA de referência.</div>';return}const db=await client(),r=await db.rpc('labpoca_set_cfdh_link',{p_action_id:aid,p_workshop_id:wid,p_contributes:false});if(r.error){toast(r.error.message,'danger');return}ctx.links.set(aid,Array.isArray(r.data)?r.data[0]:r.data);cfdhCache.links=ctx.links;enhanceCfdh()};const contrib=box.querySelector('[data-lp-cfdh-contributes]');if(contrib)contrib.onchange=async e=>{const wid=trans?(normalSel?.value||''):(box.querySelector('[data-lp-cfdh-workshop]')?.value||old?.workshop_id);if(!wid)return;const db=await client(),r=await db.rpc('labpoca_set_cfdh_link',{p_action_id:aid,p_workshop_id:wid,p_contributes:e.target.value==='true'});if(r.error){toast(r.error.message,'danger');return}const row=Array.isArray(r.data)?r.data[0]:r.data;ctx.links.set(aid,row);old.workshop_id=row.workshop_id;old.contributes=row.contributes;toast('Vínculo LABPOCA do CFDH salvo.')};
      };draw();normalSel?.addEventListener('change',()=>{const wid=normalSel.value,w=ctx.workshops.find(x=>x.id===wid);if(w){const existing=ctx.links.get(aid)||{};Object.assign(existing,{workshop_id:wid,area:w.labpoca_area,contributes:false});ctx.links.set(aid,existing)}draw()});
    }}

  async function pulse(){ensureNav().catch(()=>{});enhanceWorkshopForm().catch(()=>{});if(location.hash.startsWith('#labpoca'))renderLab().catch(()=>{});if(location.hash.startsWith('#cfdh'))enhanceCfdh().catch(()=>{})}
  const schedule=()=>{clearTimeout(timer);timer=setTimeout(pulse,50)};
  window.addEventListener('hashchange',()=>{cfdhCache={planId:null,plan:null,workshops:[],links:new Map()};schedule()});window.addEventListener('crj:route-rendered',schedule);window.addEventListener('crj:features-ready',schedule);document.addEventListener('click',schedule,true);new MutationObserver(schedule).observe(document.documentElement,{childList:true,subtree:true});ensureCss();schedule();
})();
