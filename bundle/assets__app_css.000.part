:root {
  --bg:#f4f7f6; --panel:#ffffff; --ink:#17322c; --muted:#6b7d78; --line:#dfe8e5;
  --brand:#0b5b4c; --brand-2:#167764; --accent:#f2c94c; --danger:#b42318; --warn:#9a6700;
  --success:#087443; --info:#175cd3; --radius:18px; --shadow:0 10px 30px rgba(19,50,44,.08);
}
*{box-sizing:border-box} html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif}
button,input,select,textarea{font:inherit} button{cursor:pointer}.hidden{display:none!important}
a{color:inherit}.app-shell{min-height:100vh;display:grid;grid-template-columns:270px 1fr}.sidebar{background:#0c3f36;color:#fff;padding:22px 16px;position:sticky;top:0;height:100vh;overflow:auto}.brand{display:flex;align-items:center;gap:12px;padding:8px 8px 20px}.brand-mark{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#20a486,#f2c94c);display:grid;place-items:center;font-weight:800;color:#07372f}.brand h1{font-size:18px;margin:0}.brand small{opacity:.72}.nav{display:grid;gap:6px}.nav a{display:flex;gap:10px;align-items:center;padding:11px 12px;border-radius:12px;text-decoration:none;color:#d8ebe6}.nav a:hover,.nav a.active{background:rgba(255,255,255,.12);color:#fff}.nav .sep{height:1px;background:rgba(255,255,255,.13);margin:10px 6px}.sidebar-footer{margin-top:28px;border-top:1px solid rgba(255,255,255,.13);padding-top:16px}.user-chip{display:flex;gap:10px;align-items:center}.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#f2c94c;color:#123d34;font-weight:800}.main{min-width:0}.topbar{height:72px;background:rgba(255,255,255,.93);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:10;backdrop-filter:blur(10px)}.content{padding:28px;max-width:1500px;margin:auto}.page-head{display:flex;gap:18px;align-items:flex-start;justify-content:space-between;margin-bottom:22px}.page-head h2{margin:0;font-size:28px}.page-head p{margin:7px 0 0;color:var(--muted)}.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:#fff;color:var(--ink);padding:10px 14px;border-radius:12px;font-weight:650}.btn:hover{transform:translateY(-1px)}.btn.primary{background:var(--brand);color:white;border-color:var(--brand)}.btn.secondary{background:#e8f3f0;border-color:#cde4de;color:#0c5d4d}.btn.danger{color:#b42318;border-color:#f5c7c2;background:#fff8f7}.btn.ghost{border-color:transparent;background:transparent}.grid{display:grid;gap:16px}.grid.cards{grid-template-columns:repeat(4,minmax(0,1fr))}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow)}.card h3{margin:0 0 12px;font-size:16px}.kpi .label{font-size:13px;color:var(--muted);font-weight:600}.kpi .value{font-size:34px;font-weight:800;margin-top:5px}.kpi .meta{font-size:12px;color:var(--muted);margin-top:5px}.pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:700;background:#eef5f3;color:#34665c}.pill.success{background:#e8f7ef;color:#087443}.pill.warn{background:#fff4d6;color:#8a5d00}.pill.danger{background:#fff0ef;color:#b42318}.pill.info{background:#eef4ff;color:#175cd3}.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}.search{flex:1;min-width:240px}.input,select,textarea{width:100%;border:1px solid #cfdcd8;background:#fff;border-radius:11px;padding:10px 11px;color:var(--ink)}textarea{min-height:100px;resize:vertical}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}.field small{display:block;color:var(--muted);margin-top:5px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field.full{grid-column:1/-1}.section{border-top:1px solid var(--line);padding-top:18px;margin-top:18px}.section-title{font-size:15px;font-weight:800;margin-bottom:12px}.check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.check{display:flex;gap:8px;align-items:flex-start;border:1px solid var(--line);border-radius:10px;padding:9px;background:#fbfdfc}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px;background:#fff}.table{width:100%;border-collapse:collapse;min-width:760px}.table th,.table td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);font-size:13px}.table th{background:#f7faf9;color:#536a64;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.table tr:last-child td{border-bottom:0}.name{font-weight:750}.muted{color:var(--muted)}.timeline{display:grid;gap:12px}.timeline-item{display:grid;grid-template-columns:120px 1fr;gap:14px}.timeline-date{font-size:12px;color:var(--muted);padding-top:4px}.timeline-body{border-left:3px solid #cfe3dd;padding:0 0 14px 16px}.timeline-body strong{display:block;margin-bottom:4px}.tabs{display:flex;gap:8px;overflow:auto;border-bottom:1px solid var(--line);margin-bottom:16px}.tab{padding:10px 12px;border:0;background:transparent;color:var(--muted);font-weight:700;border-bottom:3px solid transparent;white-space:nowrap}.tab.active{color:var(--brand);border-color:var(--brand)}.progress{height:9px;border-radius:99px;background:#e9efed;overflow:hidden}.progress>span{display:block;height:100%;background:var(--brand);border-radius:inherit}.indicator{display:grid;grid-template-columns:1.4fr .8fr .8fr auto;gap:12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.indicator:last-child{border-bottom:0}.indicator .code{font-weight:800}.indicator .source{font-size:12px;color:var(--muted)}.notice{border:1px solid #d9e5e1;background:#f8fbfa;padding:14px;border-radius:12px;color:#46635c}.notice.warn{background:#fff9eb;border-color:#f4d58d;color:#6d4c00}.notice.danger{background:#fff5f4;border-color:#f1bbb5;color:#7f1d16}.login-page{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 20% 10%,#dff1eb,transparent 35%),linear-gradient(135deg,#f5f8f7,#eaf3f0)}.login-card{width:min(100%,480px);background:white;border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:0 20px 70px rgba(14,65,54,.16)}.login-card h1{margin:0 0 6px}.login-card p{color:var(--muted);margin-top:0}.stack{display:grid;gap:12px}.divider{display:flex;align-items:center;gap:10px;color:var(--mute