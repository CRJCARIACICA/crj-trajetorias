export async function listWorkshopSessions(workshopId,limit=30){
  if(mode==='mock'){const st=mock();return (st.sessions||[]).filter(x=>x.workshop_id===workshopId).sort((a,b)=>String(b.session_date).localeCompare(String(a.session_date))).slice(0,limit);}
  const {data,error}=await supabase.from('workshop_sessions').select('*').eq('workshop_id',workshopId).order('session_date',{ascending:false}).limit(limit);
  if(error)throw error;return data||[];
}
