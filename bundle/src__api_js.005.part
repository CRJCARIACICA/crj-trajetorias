
export async function listEducatorPlans(month=monthKey(),userId=null){
  const [y,m]=String(month).split('-').map(Number);
  const start=`${y}-${String(m).padStart(2,'0')}-01`;
  const end=new Date(Date.UTC(y,m,1)).toISOString().slice(0,10);
  if(mode==='mock'){
    const st=mock();return (st.educatorPlans||[]).filter(x=>(!userId||x.educator_user_id===userId)&&(!x.planned_start||(x.planned_start>=start&&x.planned_start<end)));
  }
  let q=supabase.from('educator_plans').select('*').order('planned_start',{ascending:false}).order('created_at',{ascending:false});
  if(userId)q=q.eq('educator_user_id',userId);
  const {data,error}=await q;if(error)throw error;return data||[];
}
function normalizeEducatorPlanPayload(row){
  const cfdh=['cfdh_estrutural','cfdh_transversal'].includes(row.plan_type);
  return {
    ...row,
    expected_participants:row.expected_participants===''?null:Number(row.expected_participants||0)||null,
    planned_duration_hours:row.planned_duration_hours===''?null:Number(row.planned_duration_hours||0)||null,
    workshop_id:cfdh?null:(row.workshop_id||null),
    planned_start:row.planned_start||null,
    planned_end:row.planned_end||null,
    start_time:row.start_time||null,
    end_time:row.end_time||null,
    cfdh_theme_code:row.cfdh_theme_code===''||row.cfdh_theme_code==null?null:Number(row.cfdh_theme_code),
    cfdh_theme_custom:row.cfdh_theme_custom||null,
    cfdh_action_count:row.cfdh_action_count===''||row.cfdh_action_count==null?null:Number(row.cfdh_action_count),
    cfdh_monthly_notes:row.cfdh_monthly_notes||null
  };
}
export async function createEducatorPlan(row){
  const payload=normalizeEducatorPlanPayload(row);
  if(mode==='mock'){const st=mock();st.educatorPlans||=[];const rec={id:uid('plan'),...payload,educator_user_id:st.currentUser.id,status:'planejado',created_at:now(),updated_at:now()};st.educatorPlans.push(rec);save(st);return rec;}
  const {data,error}=await supabase.from('educator_plans').insert(payload).select('*').single();if(error)throw error;return data;
}
export async function updateEducatorPlan(id,row){
  const payload={...normalizeEducatorPlanPayload(row),updated_at:now()};
  if(mode==='mock'){const st=mock(),rec=(st.educatorPlans||[]).find(x=>x.id===id);if(!rec)throw new Error('Planejamento não encontrado');Object.assign(rec,payload);save(st);return rec;}
  const {data,error}=await supabase.from('educator_plans').update(payload).eq('id',id).select('*').single();if(error)throw error;return data;
}

