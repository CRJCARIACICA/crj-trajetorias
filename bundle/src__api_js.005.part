export async function createEducatorReport(row){
  const payload={
    ...row,
    actual_participants:row.actual_participants===''?null:Number(row.actual_participants||0)||0,
    actual_duration_hours:row.actual_duration_hours===''?null:Number(row.actual_duration_hours||0)||0,
    actual_start:row.actual_start||null,
    actual_end:row.actual_end||null,
    methodology_applied:row.methodology_applied||null,
    results_achieved:row.results_achieved||null,
    youth_feedback:row.youth_feedback||null,
    next_steps:row.next_steps||null,
    observations:row.observations||null,
    execution_snapshot:row.execution_snapshot||{},
    updated_at:now()
  };
  if(mode==='mock'){const st=mock();st.educatorReports||=[];let rec=(st.educatorReports||[]).find(x=>x.plan_id===row.plan_id);if(rec)Object.assign(rec,payload);else{rec={id:uid('rpt'),...payload,educator_user_id:st.currentUser.id,created_at:now()};st.educatorReports.push(rec)}save(st);return rec;}
  const {data,error}=await supabase.from('educator_reports').upsert(payload,{onConflict:'plan_id'}).select('*').single();if(error)throw error;return data;
}

