async function bindEducatorPageV2(){
  const monthEl=document.querySelector('[data-educator-filter-month]'),userEl=document.querySelector('[data-educator-filter-user]'),view=route().params.get('view')||'responsabilidades';if(!monthEl&&!document.querySelector('[data-educator-new]')&&!document.querySelector('[data-new-educator-plan]'))return;
  const apply=()=>{const p=new URLSearchParams();if(monthEl?.value)p.set('month',monthEl.value);if(userEl?.value)p.set('user',userEl.value);p.set('view',view);nav('educador?'+p.toString())};monthEl?.addEventListener('change',apply);userEl?.addEventListener('change',apply);
  const [youth,workshops,provisional,plans]=await Promise.all([listYouth(''),listWorkshops(),listProvisionalPeople(),listEducatorPlans(route().params.get('month')||currentMonth(),state.user?.role==='educador'?state.user.id:(route().params.get('user')||null))]);
  document.querySelectorAll('[data-educator-new]').forEach(btn=>btn.addEventListener('click',()=>{const initial=btn.dataset.educatorNew||'acolhimento_educativo',types=['acolhimento_educativo','demanda_identificada','encaminhamento_interno','acompanhamento_oficina','mediacao_convivencia','ficaadica_orientacao','trampo_labpoca','mobilizacao','evento_programacao','mostra','estudo_caso','outra_acao_educativa'];modal('Registrar contribuicao do Educador',`<form id="educator-record-form" class="stack"><div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Tipo ${eduGoalInfo(initial)}</label><select name="record_type" required>${types.map(k=>`<option value="${k}" ${k===initial?'selected':''}>${esc(eduTypeLabel(k))}</option>`).join('')}</select></div></div><div class="field"><label>Jovem / participante ${eduGoalInfo('cadastro')}</label>${eduPersonSearchHtml()}<small>A busca filtra em tempo real e elimina nomes nao compativeis.</small></div><div class="field"><label>Oficina relacionada</label><select name="workshop_id"><option value="">Nenhuma</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>Titulo / sintese</label><input class="input" name="title"></div><div class="field"><label>Descricao objetiva</label><textarea name="description" required></textarea></div><div class="form-grid"><div class="field"><label>Duracao em horas</label><input class="input" type="number" name="duration_hours" min="0" max="24" step="0.25" value="0"></div><div class="field"><label>Nº de participantes</label><input class="input" type="number" name="participants_count" min="0"></div></div><div class="field"><label>Encaminhar para ${eduGoalInfo('encaminhamento_interno')}</label><select name="referral_target"><option value="">Sem encaminhamento</option><option value="equipe_tecnica">Equipe Tecnica</option><option value="coordenacao">Coordenacao Geral</option><option value="articulacao">Articulacao</option><option value="administrativo">Administrativo</option><option value="oficina">Oficineiro da oficina</option><option value="rede_externa">Orientacao para rede externa</option></select><small>O destinatario recebe as especificidades e a ciencia volta ao Educador ao visualizar.</small></div><div class="field"><label>Evidencia / referencia</label><input class="input" name="evidence_ref"></div><div class="field"><label>Observacao interna</label><textarea name="notes"></textarea></div><button class="btn primary">Salvar contribuicao</button></form>`);const form=document.querySelector('#educator-record-form');bindEduPersonSearch(form,youth,provisional);decorateEduGoalForm(form,initial);form?.querySelector('[name="record_type"]')?.addEventListener('change',e=>decorateEduGoalForm(form,e.target.value));form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(['demanda_identificada','encaminhamento_interno'].includes(p.record_type)&&!p.youth_id&&!p.provisional_person_id){toast('Selecione o jovem/participante.','danger');return}try{await createEducatorRecord(p);document.querySelector('#modal')?.remove();toast(p.referral_target?'Registro salvo e encaminhamento enviado':'Contribuicao registrada');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelector('[data-new-educator-plan]')?.addEventListener('click',()=>{modal('Novo planejamento',`<form id="educator-plan-form" class="stack"><div class="field"><label>Tipo</label><select name="plan_type" required><option value="cfdh_estrutural">CFDH estrutural</option><option value="cfdh_transversal">CFDH transversal</option><option value="evento">Evento / programacao</option></select></div><div class="field"><label>Oficina vinculada</label><select name="workshop_id"><option value="">Nao se aplica</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>ATIVIDADE / titulo</label><input class="input" name="activity_title" required></div><div class="field"><label>DESCRICAO / objetivo</label><textarea name="description_objective" required></textarea></div><div class="form-grid"><div class="field"><label>Nucleo</label><input class="input" name="nucleus"></div><div class="field"><label>Eixo</label><input class="input" name="axis"></div></div><div class="form-grid"><div class="field"><label>Nº de jovens previsto</label><input class="input" type="number" name="expected_participants" min="0"></div><div class="field"><label>Duracao prevista (h)</label><input class="input" type="number" step="0.25" name="planned_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial</label><input class="input" type="date" name="planned_start"></div><div class="field"><label>Data final</label><input class="input" type="date" name="planned_end"></div></div><div class="field"><label>Equipe prevista</label><input class="input" name="team_text"></div><div class="field"><label>Parceiros</label><input class="input" name="partners"></div><div class="field"><label>Mobilizacao / divulgacao planejada</label><textarea name="mobilization_plan"></textarea></div><div class="field"><label>Acoes planejadas</label><textarea name="planned_actions"></textarea></div><div class="field"><label>Resultados esperados</label><textarea name="expected_results"></textarea></div><div class="field"><label>Recursos necessarios</label><textarea name="resources"></textarea></div><div class="notice">Planejamento nao contabiliza execucao ate que o relatorio ou a sessao seja registrado.</div><button class="btn primary">Salvar planejamento</button></form>`);const planForm=document.querySelector('#educator-plan-form');decorateEduGoalForm(planForm,'planejamento_oficina');planForm?.querySelector('[name="plan_type"]')?.addEventListener('change',e=>decorateEduGoalForm(planForm,'planejamento_'+e.target.value));planForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorPlan(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Planejamento salvo');await render()}catch(err){toast(err.message,'danger')}})});

  document.querySelectorAll('[data-edu-workshop-plan-open]').forEach(btn=>btn.addEventListener('click',()=>{
    const month=route().params.get('month')||currentMonth();
    nav('oficinas?view=planejamento&month='+month+'&plan='+btn.dataset.eduWorkshopPlanOpen);
  }));
  document.querySelectorAll('[data-edu-workshop-plan-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanPdf,'pdf');toast('PDF do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanDocx,'docx');toast('DOCX do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorWorkshopPlan(btn.dataset.eduWorkshopPlanPrint)}catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-edu-list-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListPdf,'pdf');toast('PDF da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListDocx,'docx');toast('DOCX da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorPlannedAttendance(btn.dataset.plan,btn.dataset.eduListPrint)}catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-report-plan]').forEach(btn=>btn.addEventListener('click',()=>{const p=plans.find(x=>x.id===btn.dataset.reportPlan);if(!p)return;modal('Relatorio de execucao',`<form id="educator-report-form" class="stack"><input type="hidden" name="plan_id" value="${p.id}"><div class="notice"><b>${esc(p.activity_title)}</b><br>Planejado: ${esc(p.description_objective||'')}<br>${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</div><div class="field"><label>Situacao</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Nao realizado</option></select></div><div class="field"><label>DESCRICAO do que efetivamente aconteceu</label><textarea name="actual_description" required></textarea></div><div class="form-grid"><div class="field"><label>Nº real de jovens</label><input class="input" type="number" name="actual_participants" min="0"></div><div class="field"><label>Duracao real (h)</label><input class="input" type="number" step="0.25" name="actual_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial real</label><input class="input" type="date" name="actual_start" value="${esc(p.planned_start||'')}"></div><div class="field"><label>Data final real</label><input class="input" type="date" name="actual_end" value="${esc(p.planned_end||p.planned_start||'')}"></div></div><div class="field"><label>MOBILIZACAO / divulgacao realizada</label><textarea name="mobilization_actual"></textarea></div><div class="field"><label>PONTOS POSITIVOS</label><textarea name="positive_points"></textarea></div><div class="field"><label>PONTOS NEGATIVOS</label><textarea name="negative_points"></textarea></div><div class="field"><label>ACOES realizadas</label><textarea name="actions_performed"></textarea></div><div class="field"><label>Justificativa (parcial/nao realizado)</label><textarea name="justification"></textarea></div><div class="field"><label>Evidencias</label><input class="input" name="evidence_ref"></div><button class="btn primary">Salvar relatorio</button></form>`);const reportForm=document.querySelector('#educator-report-form');decorateEduGoalForm(reportForm,p.plan_type==='cfdh_transversal'?'cfdh_transversal':p.plan_type==='cfdh_estrutural'?'cfdh_estrutural':p.plan_type==='evento'?'evento_programacao':'acompanhamento_oficina');reportForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatorio salvo');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelectorAll('[data-educator-delete]').forEach(btn=>btn.addEventListener('click',async()=>{if(!confirm('Excluir este registro?'))return;try{await deleteEducatorRecord(btn.dataset.educatorDelete);toast('Registro excluido');await render()}catch(err){toast(err.message,'danger')}}));

}
