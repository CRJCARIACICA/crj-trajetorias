

async function bindCfdhShared(){
  const rr=route(),month=rr.params.get('month')||currentMonth(),planId=rr.params.get('plan')||'',view=rr.params.get('view')||'planejamento';
  document.querySelector('[data-cfdh-month]')?.addEventListener('change',e=>nav('cfdh?month='+e.target.value));

  document.querySelector('[data-new-cfdh-plan]')?.addEventListener('click',async()=>{
    try{
      const dash=await listCfdhMonthDashboard(month),themes=await listCfdhThemes(),cfg=dash.month_theme||null;
      const inheritedTheme=cfg?(cfg.theme_custom||themes.find(t=>Number(t.code)===Number(cfg.theme_code))?.theme||'Tema mensal definido'):'';
      const themeOptions=themes.map(t=>'<option value="'+t.code+'">'+esc(t.code+'. '+t.theme)+'</option>').join('');
      const themeFields=cfg
        ?'<div class="notice success"><b>Tema oficial do mês: '+esc(inheritedTheme)+'</b><br>Este circuito herdará o tema já definido para '+esc(month.split('-').reverse().join('/'))+'.</div><input type="hidden" name="cfdh_theme_code" value="'+esc(cfg.theme_code??'')+'"><input type="hidden" name="cfdh_theme_custom" value="'+esc(cfg.theme_custom||'')+'">'
        :'<div class="notice info"><b>Defina o tema do mês ao criar o circuito.</b><br>Este será o tema oficial do CFDH para '+esc(month.split('-').reverse().join('/'))+'. As ações receberão esse tema automaticamente e poderão adaptar sua descrição sem alterar o tema mensal.</div>'+
          '<div class="form-grid"><div class="field"><label>Tema da Metodologia</label><select name="cfdh_theme_code"><option value="">Selecione um tema</option>'+themeOptions+'</select></div><div class="field"><label>Outro tema / adaptação territorial</label><input class="input" name="cfdh_theme_custom" placeholder="Descreva o tema, se necessário"></div></div>';
      modal('Novo circuito CFDH','<form id="new-cfdh-plan-form" class="stack">'+
        themeFields+
        '<div class="form-grid"><div class="field"><label>Modalidade</label><select name="plan_type"><option value="cfdh_estrutural">CFDH estrutural</option><option value="cfdh_transversal">CFDH transversal</option></select></div><div class="field"><label>Quantidade inicial de ações</label><input class="input" type="number" min="1" max="60" name="cfdh_action_count" value="1"></div></div>'+
        '<div class="field"><label>Título do circuito</label><input class="input" name="activity_title" placeholder="Pode completar depois"></div>'+
        '<div class="field"><label>Objetivo geral</label><textarea name="description_objective" placeholder="Pode completar depois"></textarea></div>'+
        '<div data-cfdh-create-status></div><button class="btn primary" type="submit" data-cfdh-create-submit>Criar e estruturar ações</button></form>');
      document.querySelector('#new-cfdh-plan-form')?.addEventListener('submit',async e=>{
        e.preventDefault();
        const form=e.currentTarget,btn=form.querySelector('[data-cfdh-create-submit]')||form.querySelector('button[type="submit"]'),status=form.querySelector('[data-cfdh-create-status]');
        const p=parseForm(form);
        if(!cfg&&!p.cfdh_theme_code&&!String(p.cfdh_theme_custom||'').trim()){toast('Defina o tema mensal antes de criar o circuito.','danger');return}
        if(btn){btn.disabled=true;btn.textContent='Criando e estruturando...'}
        if(status)status.innerHTML='<div class="notice info compact">Criando o circuito e abrindo a estrutura das ações...</div>';
        try{
          const created=await createEducatorPlan({...p,activity_title:String(p.activity_title||'').trim()||'Circuito Formativo em Direitos Humanos',description_objective:p.description_objective||'',planned_start:month+'-01',planned_end:month+'-01',status:'planejado',workshop_id:null,cfdh_planning_status:'draft'});
          if(!created?.id)throw new Error('O circuito foi enviado, mas o sistema não recebeu o identificador do planejamento.');
          document.querySelector('#modal')?.remove();
          nav('cfdh?month='+month+'&plan='+created.id);
          await render();
        }catch(err){
          console.error('Falha ao criar CFDH:',err);
          const message=err?.message||String(err)||'Não foi possível criar o CFDH.';
          toast(message,'danger');
          if(status)status.innerHTML='<div class="notice danger"><b>Não foi possível criar o CFDH.</b><br>'+esc(message)+'</div>';
          if(btn){btn.disabled=false;btn.textContent='Criar e estruturar ações'}
        }
      });
    }catch(err){toast(err.message,'danger')}
  });

  document.querySelectorAll('[data-cfdh-edit-theme]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const [dash,themes]=await Promise.all([listCfdhMonthDashboard(month),listCfdhThemes()]);
      const cfg=dash.month_theme;
      if(!cfg){toast('Crie o primeiro planejamento CFDH do mês antes de definir o tema.','danger');return}
      const options=themes.map(t=>'<option value="'+t.code+'" '+(Number(t.code)===Number(cfg.theme_code)?'selected':'')+'>'+esc(t.code+'. '+t.theme)+'</option>').join('');
      modal('Editar tema mensal do CFDH','<form id="edit-cfdh-month-theme" class="stack"><div class="notice info"><b>Tema de referência do mês</b><br>Ele foi definido pelo primeiro planejamento criado, mas pode ser atualizado quando a realidade do território exigir. A alteração será aplicada aos demais circuitos deste mês.</div><div class="form-grid"><div class="field"><label>Tema da Metodologia</label><select name="theme_code"><option value="">Selecione</option>'+options+'</select></div><div class="field"><label>Outro tema / adaptação territorial</label><input class="input" name="theme_custom" value="'+esc(cfg.theme_custom||'')+'"></div></div><div class="actions"><button type="submit" class="btn primary">Salvar tema do mês</button></div></form>');
      document.querySelector('#edit-cfdh-month-theme')?.addEventListener('submit',async e=>{
        e.preventDefault();
        const form=e.currentTarget,p=parseForm(form),submit=form.querySelector('[type="submit"]'),label=submit.textContent;
        if(!p.theme_code&&!String(p.theme_custom||'').trim()){toast('Defina um tema antes de salvar.','danger');return}
        submit.disabled=true;submit.textContent='Salvando...';
        try{
          await updateCfdhMonthTheme(month,{theme_code:p.theme_code,theme_custom:p.theme_custom});
          document.querySelector('#modal')?.remove();
          toast('Tema mensal do CFDH atualizado');
          await render();
        }catch(err){toast(err.message,'danger');submit.disabled=false;submit.textContent=label}
      });
    }catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-cfdh-delete-plan]').forEach(btn=>btn.addEventListener('click',async()=>{
    const title=btn.dataset.cfdhDeleteTitle||'este CFDH';
    let dash=null;
    try{dash=await listCfdhMonthDashboard(month)}catch{}
    const isSource=dash?.month_theme?.source_plan_id===btn.dataset.cfdhDeletePlan;
    const remaining=(dash?.plans||[]).filter(p=>p.id!==btn.dataset.cfdhDeletePlan).length;
    const themeMessage=isSource
      ?(remaining?'\n\nEste é o planejamento que atualmente referencia o tema do mês. O tema será preservado e a referência passará automaticamente para o próximo CFDH do mês.':'\n\nEste é o único CFDH do mês. Ao excluí-lo, a configuração do tema mensal também será removida.')
      :'';
    if(!confirm('Excluir "'+title+'"?\n\nAs ações, listas e relatório vinculados a este circuito também serão excluídos.'+themeMessage))return;
    const original=btn.textContent;btn.disabled=true;btn.textContent='Excluindo...';
    try{
      await deleteCfdhPlan(btn.dataset.cfdhDeletePlan);
      toast('CFDH excluído');
      await render();
    }catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=original}
  }));

  document.querySelectorAll('[data-crj-special-close],[data-crj-special-open]').forEach(btn=>btn.addEventListener('click',()=>{
    const status=btn.hasAttribute('data-crj-special-close')?'closed':'open',id=btn.dataset.crjSpecialClose||btn.dataset.crjSpecialOpen;
    modal(status==='closed'?'Aprovar fechamento do CRJ':'Registrar funcionamento do CRJ',
      '<form id="crj-special-day-decision" class="stack">'+
        '<div class="notice '+(status==='closed'?'warn':'info')+'"><b>'+(status==='closed'?'Fechamento sujeito à aprovação':'Funcionamento mantido')+'</b><br>Registre a decisão para que o calendário e a distribuição inteligente passem a considerar essa data corretamente.</div>'+
        '<div class="field"><label>Observação / justificativa</label><textarea name="note" placeholder="Ex.: fechamento aprovado pela gestão; funcionamento mantido normalmente."></textarea></div>'+
        '<div class="field"><label>Referência da decisão</label><input class="input" name="reference" placeholder="Ex.: e-mail, ofício, reunião, comunicado interno"></div>'+
        '<button class="btn '+(status==='closed'?'danger':'primary')+'" type="submit">'+(status==='closed'?'Confirmar fechamento':'Confirmar funcionamento')+'</button>'+
      '</form>');
    document.querySelector('#crj-special-day-decision')?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(e.currentTarget),submit=e.currentTarget.querySelector('[type="submit"]'),label=submit.textContent;
      submit.disabled=true;submit.textContent='Salvando...';
      try{
        await decideCrjSpecialDay(id,status,{note:fd.get('note')||'',reference:fd.get('reference')||''});
        document.querySelector('#modal')?.remove();toast(status==='closed'?'Fechamento registrado':'Funcionamento mantido registrado');await render();
      }catch(err){toast(err.message,'danger');submit.disabled=false;submit.textContent=label}
    });
  }));

    if(!planId)return;

  let bundle;
  try{
    const [b,themes,classification,indicators,monthDashboard,crjCalendar,smartSignals,specialDays]=await Promise.all([getCfdhPlanBundle(planId),listCfdhThemes(),listMethodologyClassificationCatalog(),listIndicatorCatalog(),listCfdhMonthDashboard(month),listCrjPlanningCalendar(month),getCfdhStructuralDistributionSignals(month),listCrjSpecialDays(Number(month.slice(0,4)))]);
    bundle=b;bundle.themes=themes;bundle.classification=classification;bundle.indicators=indicators;bundle.month_dashboard=monthDashboard;bundle.crj_calendar=crjCalendar;bundle.smart_signals=smartSignals;bundle.special_days=specialDays;
  }catch(err){toast(err.message,'danger');return}

  const planForm=document.querySelector('#cfdh-plan-editor');
  if(planForm){
    const actionsBox=document.querySelector('[data-cfdh-actions]'),preview=document.querySelector('[data-cfdh-plan-preview]'),alertsBox=document.querySelector('[data-cfdh-alerts]'),workspace=document.querySelector('[data-cfdh-plan-workspace]');

    const selectedWorkshopIds=()=>[...planForm.querySelectorAll('[name="cfdh_workshop_id"]:checked')].map(x=>x.value);
    const collectActions=()=>[...planForm.querySelectorAll('[data-cfdh-action-card]')].map((card,i)=>{
      const v=n=>card.querySelector('[name="'+n+'"]')?.value||'';
      const cat=bundle.classification||[];
      const additional=[...card.querySelectorAll('[name="additional_classification_key"]:checked')].map(el=>{
        const [axisCode,itemCodeRaw='']=String(el.value||'').split('|'),itemCode=itemCodeRaw||null;
        const row=cat.find(x=>x.axis_code===axisCode&&(x.item_code||null)===itemCode);
        return row?{nucleus_code:row.nucleus_code,nucleus_name:row.nucleus_name,axis_code:row.axis_code,axis_name:row.axis_name,item_code:row.item_code||null,item_label:row.item_label||null}:null;
      }).filter(Boolean);
      return {
        id:card.dataset.actionId||null,action_number:i+1,
        workshop_id:v('workshop_id')||null,schedule_mode:v('schedule_mode')||'structural',
        workshop_calendar_id:v('workshop_calendar_id')||null,
        scheduled_date:v('scheduled_date'),start_time:v('start_time')||null,end_time:v('end_time')||null,
        planned_duration_hours:v('planned_duration_hours')===''?null:Number(v('planned_duration_hours')),
        location_type:v('location_type')||null,location_other:v('location_other')||null,
        title:v('title')||('Ação '+(i+1)),action_theme:v('action_theme')||cfdhMonthlyThemeText(bundle),objective:v('objective')||'',activities:v('activities')||'',resources:v('resources')||'',
        nucleus_code:'N1',axis_code:'N1.E1',item_code:'C',
        item_label:'Circuito Formativo em Direitos Humanos',
        additional_classifications:additional,
        has_additional_methodology:v('has_additional_methodology')==='yes',
        classification_group_id:null,
        responsible_user_ids:[...card.querySelectorAll('[name="responsible_user_id"]:checked')].map(x=>x.value),
        responsible_names:[...card.querySelectorAll('[name="responsible_user_id"]:checked')].map(x=>bundle.team.find(t=>t.id===x.value)?.display_name).filter(Boolean),
        responsible_roles:[...card.querySelectorAll('[name="responsible_user_id"]:checked')].map(x=>bundle.team.find(t=>t.id===x.value)?.role).filter(Boolean),
        execution_status:(bundle.actions.find(x=>x.id===card.dataset.actionId)?.execution_status)||'planejada'
      };
    });
    const collectPlan=()=>({
      ...bundle.plan,
      plan_type:planForm.querySelector('[name="plan_type"]')?.value||bundle.plan.plan_type,
      cfdh_theme_code:planForm.querySelector('[name="cfdh_theme_code"]')?.value??bundle.month_theme?.theme_code??bundle.plan.cfdh_theme_code??null,
      cfdh_theme_custom:planForm.querySelector('[name="cfdh_theme_custom"]')?.value??bundle.month_theme?.theme_custom??bundle.plan.cfdh_theme_custom??'',
      activity_title:planForm.querySelector('[name="activity_title"]')?.value||'',
      description_objective:planForm.querySelector('[name="description_objective"]')?.value||'',
      cfdh_action_count:Number(planForm.querySelector('[name="cfdh_action_count"]')?.value||0),
      expected_participants:planForm.querySelector('[name="expected_participants"]')?.value||null,
      team_text:planForm.querySelector('[name="team_text"]')?.value||'',
      partners:planForm.querySelector('[name="partners"]')?.value||'',
      mobilization_plan:planForm.querySelector('[name="mobilization_plan"]')?.value||'',
      expected_results:planForm.querySelector('[name="expected_results"]')?.value||'',
      cfdh_monthly_notes:planForm.querySelector('[name="cfdh_monthly_notes"]')?.value||''
    });
    const draftBundle=()=>({...bundle,plan:collectPlan(),workshop_ids:collectPlan().plan_type==='cfdh_transversal'?selectedWorkshopIds():[],actions:collectActions()});
    const refresh=()=>{
      const d=draftBundle();
      if(preview)preview.innerHTML=cfdhPlanPreviewHtml(d,d);
      planForm.querySelectorAll('[data-cfdh-action-card]').forEach((card,i)=>{
        const zone=card.querySelector('[data-cfdh-action-goals]'),action=d.actions[i];
        if(!zone||!action)return;
        const links=cfdhActionGoalLinks(d,action);
        const badge=zone.querySelector('.cfdh-action-goal-badge'),fly=zone.querySelector('.cfdh-action-goal-flyout');
        if(badge)badge.textContent='Metas e etapas · '+links.length;
        if(fly)fly.innerHTML=cfdhActionGoalFlyoutContent(d,action,i);
      });
      const statusBox=document.querySelector('[data-cfdh-planning-status]'),completion=cfdhPlanCompleteness(d);
      if(statusBox)statusBox.innerHTML=completion.complete?'<div class="notice success"><b>Planejamento concluído.</b> Todos os campos essenciais das ações estão preenchidos.</div>':'<div class="notice warn"><b>Planejamento não concluído.</b> Rascunho salvo/permitido. Pendências: '+esc(completion.missing.join(', ')||'campos obrigatórios')+'.</div>';
      if(alertsBox){
        const alerts=cfdhPlanAlerts(d);
        alertsBox.innerHTML=alerts.length?alerts.map(x=>'<div class="notice warn compact">⚠ '+esc(x)+'</div>').join(''):'<div class="notice success compact">Planejamento sem pendências estruturais.</div>';
      }
    };
    const setClassificationOnCard=(targetCard,{nucleus_code='',axis_code='',item_code=''}={})=>{
      if(!targetCard)return;
      const nucleus=targetCard.querySelector('[data-cfdh-nucleus]'),axis=targetCard.querySelector('[data-cfdh-axis]'),item=targetCard.querySelector('[data-cfdh-item]');
      if(nucleus)nucleus.value=nucleus_code||'';
      const axisRows=bundle.classification.filter(x=>x.nucleus_code===(nucleus_code||'')),axes=[...new Map(axisRows.map(x=>[x.axis_code,{code:x.axis_code,name:x.axis_name}])).values()];
      if(axis){
        axis.innerHTML='<option value="">Selecione</option>'+axes.map(x=>'<option value="'+x.code+'">'+esc(x.name)+'</option>').join('');
        axis.value=axis_code||'';
      }
      const itemRows=bundle.classification.filter(x=>x.axis_code===(axis_code||'')&&x.item_code);
      if(item){
        item.innerHTML='<option value="">'+(itemRows.length?'Selecione o Item':'Sem subdivisão por Item')+'</option>'+itemRows.map(x=>'<option value="'+x.item_code+'">'+esc(x.item_code)+') '+esc(x.item_label)+'</option>').join('');
        item.required=itemRows.length>0;
        item.value=item_code||'';
      }
      const itemLabel=targetCard.querySelector('[name="item_label"]'),row=bundle.classification.find(x=>x.axis_code===(axis_code||'')&&x.item_code===(item_code||''));
      if(itemLabel)itemLabel.value=row?.item_label||'';
    };
    const linkedCardsFor=(sourceCard)=>{
      const group=sourceCard?.querySelector('[name="classification_group_id"]')?.value||'';
      if(!group)return [];
      return [...planForm.querySelectorAll('[data-cfdh-action-card]')].filter(x=>x.querySelector('[name="classification_group_id"]')?.value===group);
    };
    const updateLinkedHint=(card)=>{
      const group=card?.querySelector('[name="classification_group_id"]')?.value||'',hint=card?.querySelector('[data-cfdh-linked-hint]'),btn=card?.querySelector('[data-cfdh-link-classification]');
      const count=group?linkedCardsFor(card).length:0;
      if(hint){
        hint.classList.toggle('hidden',!group);
        hint.textContent=group?'Classificação vinculada com '+Math.max(0,count-1)+' outra(s) ação(ões). Alterações em Núcleo, Eixo ou Item são sincronizadas automaticamente.':'';
      }
      if(btn)btn.textContent=group?'🔗 Gerenciar vínculo':'🔗 Vincular ações';
    };
    const syncLinkedClassification=(sourceCard)=>{
      const group=sourceCard?.querySelector('[name="classification_group_id"]')?.value||'';
      if(!group)return;
      const payload={
        nucleus_code:sourceCard.querySelector('[name="nucleus_code"]')?.value||'',
        axis_code:sourceCard.querySelector('[name="axis_code"]')?.value||'',
        item_code:sourceCard.querySelector('[name="item_code"]')?.value||''
      };
      for(const target of linkedCardsFor(sourceCard)){
        if(target===sourceCard)continue;
        setClassificationOnCard(target,payload);
      }
      for(const target of linkedCardsFor(sourceCard))updateLinkedHint(target);
      refresh();
    };
    const bindActionCards=()=>{
      planForm.querySelectorAll('[data-cfdh-action-card]').forEach(card=>{
        const nucleus=card.querySelector('[data-cfdh-nucleus]'),axis=card.querySelector('[data-cfdh-axis]'),item=card.querySelector('[data-cfdh-item]');
        const rebuildAxis=()=>{
          const rows=bundle.classification.filter(x=>x.nucleus_code===nucleus.value),axes=[...new Map(rows.map(x=>[x.axis_code,{code:x.axis_code,name:x.axis_name}])).values()];
          axis.innerHTML='<option value="">Selecione</option>'+axes.map(x=>'<option value="'+x.code+'">'+esc(x.name)+'</option>').join('');
          axis.value='';
          item.innerHTML='<option value="">Selecione o Eixo</option>';item.required=false;item.value='';
          const itemLabel=card.querySelector('[name="item_label"]');if(itemLabel)itemLabel.value='';
          syncLinkedClassification(card);refresh();
        };
        const rebuildItem=()=>{
          const rows=bundle.classification.filter(x=>x.axis_code===axis.value&&x.item_code);
          item.innerHTML='<option value="">'+(rows.length?'Selecione o Item':'Sem subdivisão por Item')+'</option>'+rows.map(x=>'<option value="'+x.item_code+'">'+esc(x.item_code)+') '+esc(x.item_label)+'</option>').join('');
          item.required=rows.length>0;item.value='';
          const itemLabel=card.querySelector('[name="item_label"]');if(itemLabel)itemLabel.value='';
          syncLinkedClassification(card);refresh();
        };
        nucleus?.addEventListener('change',rebuildAxis);
        axis?.addEventListener('change',rebuildItem);
        item?.addEventListener('change',()=>{
          const itemLabel=card.querySelector('[name="item_label"]'),row=bundle.classification.find(x=>x.axis_code===axis.value&&x.item_code===item.value);
          if(itemLabel)itemLabel.value=row?.item_label||'';
          syncLinkedClassification(card);refresh();
        });
        updateLinkedHint(card);
        const additionalToggle=card.querySelector('[data-cfdh-has-additional]'),additionalBox=card.querySelector('[data-cfdh-additional-methodologies]');
        additionalToggle?.addEventListener('change',()=>{
          const yes=additionalToggle.value==='yes';additionalBox?.classList.toggle('hidden',!yes);
          if(!yes)card.querySelectorAll('[name="additional_classification_key"]').forEach(x=>x.checked=false);
          refresh();
        });
        card.querySelectorAll('[name="additional_classification_key"]').forEach(x=>x.addEventListener('change',refresh));

        card.querySelectorAll('[data-cfdh-repeat-field]').forEach(btn=>btn.addEventListener('click',()=>{
          const field=btn.dataset.cfdhRepeatField,source=card.querySelector('[name="'+field+'"]'),sourceText=source?.value||'';
          if(!String(sourceText).trim()){toast('Preencha primeiro este campo antes de repetir a descrição.','warn');return}
          const sourceNumber=Number(card.dataset.actionNumber||0),cards=[...planForm.querySelectorAll('[data-cfdh-action-card]')].filter(x=>Number(x.dataset.actionNumber)!==sourceNumber);
          if(!cards.length){toast('Crie pelo menos duas ações para repetir a descrição.','warn');return}
          const labels={action_theme:'Tema desta ação',title:'Título da ação',objective:'Objetivo específico',activities:'Atividades propostas',resources:'Recursos necessários',location_other:'Descrição do local'};
          modal('Repetir descrição · '+(labels[field]||field),
            '<form id="cfdh-repeat-field-form" class="stack"><div class="notice info"><b>Origem: Ação '+sourceNumber+'</b><br>Somente <b>'+esc(labels[field]||field)+'</b> será copiado. Os demais campos continuam independentes.</div>'+
            '<div class="cfdh-copy-preview">'+esc(sourceText)+'</div>'+
            '<div class="actions"><button type="button" class="btn secondary" data-repeat-all>Selecionar todas</button><button type="button" class="btn ghost" data-repeat-none>Desmarcar todas</button></div>'+
            '<div class="check-grid">'+cards.map(t=>{const n=Number(t.dataset.actionNumber||0),cur=t.querySelector('[name="'+field+'"]')?.value||'';return '<label class="check"><input type="checkbox" name="target_action" value="'+n+'"><span><b>Ação '+n+'</b><small>'+(String(cur).trim()?'Já possui conteúdo — será substituído.':'Campo vazio.')+'</small></span></label>'}).join('')+'</div>'+
            '<button type="submit" class="btn primary">Repetir nas ações selecionadas</button></form>');
          const form=document.querySelector('#cfdh-repeat-field-form');
          document.querySelector('[data-repeat-all]')?.addEventListener('click',()=>form?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=true));
          document.querySelector('[data-repeat-none]')?.addEventListener('click',()=>form?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=false));
          form?.addEventListener('submit',e=>{
            e.preventDefault();const selected=[...form.querySelectorAll('[name="target_action"]:checked')].map(x=>Number(x.value));
            if(!selected.length){toast('Selecione pelo menos uma ação.','warn');return}
            for(const n of selected){const target=planForm.querySelector('[data-cfdh-action-card][data-action-number="'+n+'"] [name="'+field+'"]');if(target){target.value=sourceText;target.dispatchEvent(new Event('input',{bubbles:true}))}}
            document.querySelector('#modal')?.remove();refresh();toast('Descrição repetida em '+selected.length+' ação(ões).');
          });
        }));

        const workshop=card.querySelector('[data-cfdh-action-workshop]');
        const dateInput=card.querySelector('[name="scheduled_date"]'),startInput=card.querySelector('[name="start_time"]'),endInput=card.querySelector('[name="end_time"]'),durationInput=card.querySelector('[name="planned_duration_hours"]');
        const modeInput=card.querySelector('[name="schedule_mode"]'),calendarIdInput=card.querySelector('[name="workshop_calendar_id"]'),scheduleStatus=card.querySelector('[data-cfdh-schedule-link-status]');
        const calendarPanel=card.querySelector('[data-cfdh-calendar-panel]'),dayDetail=card.querySelector('[data-cfdh-calendar-day-detail]'),selectedBox=card.querySelector('[data-cfdh-calendar-selected]');

        const syncStructuralBounds=()=>{
          if(!startInput)return;
          if(collectPlan().plan_type!=='cfdh_estrutural'){
            startInput.removeAttribute('min');startInput.removeAttribute('max');return;
          }
          const win=cfdhStructuralWindow(dateInput?.value||'');
          if(!win){startInput.removeAttribute('min');startInput.removeAttribute('max');return}
          const mins=Math.round(Number(durationInput?.value||0)*60),latest=cfdhTimeMinutes(win.end)-mins;
          startInput.min=win.start;
          startInput.max=latest>=cfdhTimeMinutes(win.start)?cfdhMinutesTime(latest):win.start;
          const cur=cfdhTimeMinutes(startInput.value),min=cfdhTimeMinutes(startInput.min),max=cfdhTimeMinutes(startInput.max);
          if(cur!=null&&(cur<min||cur>max)){startInput.value='';if(endInput)endInput.value=''}
        };
        const syncCalculatedEnd=()=>{
          if(!endInput)return;
          endInput.value=cfdhAutoEndTime(startInput?.value,durationInput?.value);
        };
        const syncTransversalCalendarLink=()=>{
          if(!modeInput||!calendarIdInput)return;
          const wid=workshop?.value||'',date=dateInput?.value||'',start=cfdhTimeMinutes(startInput?.value),end=cfdhTimeMinutes(endInput?.value);
          const match=(bundle.calendar||[]).find(x=>{
            if(x.workshop_id!==wid||x.scheduled_date!==date)return false;
            const xs=cfdhTimeMinutes(String(x.start_time||'').slice(0,5)),xe=cfdhTimeMinutes(String(x.end_time||'').slice(0,5));
            return start!=null&&end!=null&&xs!=null&&xe!=null&&start>=xs&&end<=xe;
          });
          modeInput.value=match?'workshop_planned':'atypical';
          calendarIdInput.value=match?.id||'';
          if(scheduleStatus)scheduleStatus.textContent=match?'Dentro de aula planejada · '+fmtDate(match.scheduled_date)+' · '+String(match.start_time||'').slice(0,5)+'–'+String(match.end_time||'').slice(0,5):'Dia/horário atípico em relação à oficina vinculada';
        };
        const updateConflictBox=()=>{
          const d=draftBundle(),idx=Number(card.dataset.actionNumber||1)-1,action=d.actions[idx],box=card.querySelector('[data-cfdh-calendar-conflict]');
          if(!box||!action)return;
          const conflicts=cfdhActionCalendarConflicts(d,action,d.actions);
          box.classList.toggle('hidden',!conflicts.length);
          box.innerHTML=conflicts.length?'<div class="notice danger compact"><b>Conflito de horário:</b><br>'+conflicts.map(x=>esc((x.start||'--:--')+'–'+(x.end||'--:--')+' · '+(x.title||'Atividade CRJ'))).join('<br>')+'</div>':'';
        };
        const updateDayDetail=()=>{
          if(!dayDetail)return;
          const idx=Number(card.dataset.actionNumber||1)-1,d=draftBundle(),action=d.actions[idx]||{};
          dayDetail.innerHTML=cfdhCalendarDayDetailHtml(d,dateInput?.value||'',action);
        };
        card.querySelector('[data-cfdh-toggle-calendar]')?.addEventListener('click',()=>calendarPanel?.classList.toggle('hidden'));
        card.querySelectorAll('[data-cfdh-calendar-day]').forEach(btn=>btn.addEventListener('click',()=>{
          const date=btn.dataset.cfdhCalendarDay||'';
          if(dateInput)dateInput.value=date;
          card.querySelectorAll('[data-cfdh-calendar-day]').forEach(x=>x.classList.toggle('selected',x===btn));
          if(selectedBox){selectedBox.classList.remove('hidden');selectedBox.innerHTML='<b>Dia selecionado:</b> <span>'+esc(fmtDate(date))+'</span>'}
          const special=cfdhSpecialDayState(draftBundle(),date);
          if(special.pending)toast(special.day.name+': fechamento depende de aprovação. A data continua disponível manualmente até que o fechamento seja aprovado.','warn');
          updateDayDetail();
          syncStructuralBounds();syncCalculatedEnd();syncTransversalCalendarLink();updateConflictBox();refresh();
        }));
        workshop?.addEventListener('change',()=>{syncTransversalCalendarLink();updateConflictBox();refresh()});
        startInput?.addEventListener('input',()=>{syncStructuralBounds();syncCalculatedEnd();syncTransversalCalendarLink();updateConflictBox();refresh()});
        durationInput?.addEventListener('input',e=>{
          const pill=card.querySelector('[data-cfdh-count-status]'),ok=Number(e.target.value||0)>=2;
          if(pill){pill.textContent=ok?'Contabilizável':'Menos de 2h';pill.className='pill '+(ok?'success':'warn')}
          syncStructuralBounds();syncCalculatedEnd();syncTransversalCalendarLink();updateConflictBox();refresh();
        });
        syncStructuralBounds();syncCalculatedEnd();syncTransversalCalendarLink();updateDayDetail();updateConflictBox();

        card.querySelector('[data-cfdh-link-classification]')?.addEventListener('click',()=>{
          const sourceNumber=Number(card.dataset.actionNumber||0),current=collectActions(),source=current[sourceNumber-1]||{};
          const existingGroup=card.querySelector('[name="classification_group_id"]')?.value||'';
          const group=existingGroup||(crypto?.randomUUID?crypto.randomUUID():('cfdh-'+Date.now()+'-'+Math.random().toString(16).slice(2)));
          const targets=current.map((a,i)=>({...a,number:i+1})).filter(a=>a.number!==sourceNumber);
          if(!targets.length){toast('Crie pelo menos duas ações para vincular a classificação.','warn');return}
          modal(existingGroup?'Gerenciar vínculo da classificação':'Vincular classificação a outras ações',
            '<div class="stack">'+
              '<div class="notice info"><b>Ação de referência: '+sourceNumber+' · '+esc(source.title||('Ação '+sourceNumber))+'</b><br>'+
              'As ações selecionadas compartilharão <b>Núcleo → Eixo → Item</b>. Depois disso, alterar qualquer uma das três opções em uma ação vinculada atualizará as demais automaticamente.</div>'+
              '<form id="cfdh-link-classification-form" class="stack"><div class="check-grid cfdh-copy-actions-grid">'+
                targets.map(a=>{
                  const targetCard=planForm.querySelector('[data-cfdh-action-card][data-action-number="'+a.number+'"]');
                  const targetGroup=targetCard?.querySelector('[name="classification_group_id"]')?.value||'';
                  const checked=existingGroup&&targetGroup===existingGroup;
                  const classification=[a.nucleus_code,a.axis_code,a.item_code].filter(Boolean).join(' → ')||'Sem classificação completa';
                  return '<label class="check cfdh-copy-action-option"><input type="checkbox" name="target_action" value="'+a.number+'" '+(checked?'checked':'')+'><span><b>Ação '+a.number+' · '+esc(a.title||('Ação '+a.number))+'</b><small>'+esc(classification)+'</small>'+(targetGroup&&targetGroup!==existingGroup?'<em>Está vinculada a outro grupo; ao selecionar, passará para este vínculo.</em>':'')+'</span></label>';
                }).join('')+
              '</div><div class="actions"><button type="button" class="btn ghost" data-cfdh-unlink-source>Desvincular esta ação</button><button type="submit" class="btn primary">Aplicar vínculo</button></div></form>'+
            '</div>');
          const form=document.querySelector('#cfdh-link-classification-form');
          document.querySelector('[data-cfdh-unlink-source]')?.addEventListener('click',()=>{
            const hidden=card.querySelector('[name="classification_group_id"]');if(hidden)hidden.value='';
            document.querySelector('#modal')?.remove();updateLinkedHint(card);refresh();toast('Ação desvinculada da classificação compartilhada.');
          });
          form?.addEventListener('submit',e=>{
            e.preventDefault();
            const selected=[...form.querySelectorAll('[name="target_action"]:checked')].map(x=>Number(x.value));
            if(!selected.length){toast('Selecione pelo menos uma outra ação para criar o vínculo.','warn');return}
            const sourceHidden=card.querySelector('[name="classification_group_id"]');if(sourceHidden)sourceHidden.value=group;
            const classification={
              nucleus_code:card.querySelector('[name="nucleus_code"]')?.value||'',
              axis_code:card.querySelector('[name="axis_code"]')?.value||'',
              item_code:card.querySelector('[name="item_code"]')?.value||''
            };
            const selectedSet=new Set(selected);
            for(const target of planForm.querySelectorAll('[data-cfdh-action-card]')){
              const number=Number(target.dataset.actionNumber||0),hidden=target.querySelector('[name="classification_group_id"]');
              if(number===sourceNumber)continue;
              if(selectedSet.has(number)){
                if(hidden)hidden.value=group;
                setClassificationOnCard(target,classification);
              }else if(existingGroup&&hidden?.value===existingGroup){
                hidden.value='';
              }
            }
            document.querySelector('#modal')?.remove();
            for(const target of planForm.querySelectorAll('[data-cfdh-action-card]'))updateLinkedHint(target);
            refresh();
            toast('Classificação vinculada e sincronizada em '+(selected.length+1)+' ações.');
          });
        });

        card.querySelector('[data-cfdh-copy-objective]')?.addEventListener('click',()=>{
          const sourceText=card.querySelector('[name="objective"]')?.value?.trim()||'';
          if(!sourceText){toast('Preencha primeiro o campo Objetivo específico desta ação.','warn');return}
          const sourceNumber=Number(card.dataset.actionNumber||0),current=collectActions();
          const targets=current.map((a,i)=>({...a,number:i+1})).filter(a=>a.number!==sourceNumber);
          if(!targets.length){toast('Crie pelo menos duas ações para replicar o objetivo.','warn');return}
          const sourceAction=current[sourceNumber-1]||{},sourceWorkshop=bundle.workshops.find(w=>w.id===sourceAction.workshop_id);
          modal('Preencher outras ações a partir deste objetivo',
            '<div class="stack">'+
              '<div class="notice info"><b>Origem: Ação '+sourceNumber+' · '+esc(sourceAction.title||('Ação '+sourceNumber))+'</b><br>'+
                esc(sourceWorkshop?.name||'Sem oficina definida')+(sourceAction.scheduled_date?' · '+fmtDate(sourceAction.scheduled_date):'')+
                '<br><small>Apenas o campo <b>Objetivo específico</b> será copiado. Tema, dinâmica, oficina, classificação, data, horário e recursos permanecem independentes.</small></div>'+
              '<div class="cfdh-copy-preview">'+esc(sourceText)+'</div>'+
              '<div class="actions"><button type="button" class="btn secondary" data-cfdh-copy-objective-select-all>Selecionar todas</button><button type="button" class="btn ghost" data-cfdh-copy-objective-clear>Desmarcar todas</button></div>'+
              '<form id="cfdh-copy-objective-form" class="stack"><div class="check-grid cfdh-copy-actions-grid">'+
                targets.map(a=>{
                  const w=bundle.workshops.find(x=>x.id===a.workshop_id),hasText=Boolean(String(a.objective||'').trim());
                  return '<label class="check cfdh-copy-action-option"><input type="checkbox" name="target_action" value="'+a.number+'"><span><b>Ação '+a.number+' · '+esc(a.title||('Ação '+a.number))+'</b><small>'+esc(w?.name||'Sem oficina definida')+(a.scheduled_date?' · '+fmtDate(a.scheduled_date):'')+'</small>'+(hasText?'<em>Já possui objetivo — o conteúdo será substituído.</em>':'<em>Campo de objetivo vazio.</em>')+'</span></label>';
                }).join('')+
              '</div><button type="submit" class="btn primary">Preencher objetivos selecionados</button></form>'+
            '</div>');
          const copyForm=document.querySelector('#cfdh-copy-objective-form');
          document.querySelector('[data-cfdh-copy-objective-select-all]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=true));
          document.querySelector('[data-cfdh-copy-objective-clear]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=false));
          copyForm?.addEventListener('submit',e=>{
            e.preventDefault();
            const selected=[...copyForm.querySelectorAll('[name="target_action"]:checked')].map(x=>Number(x.value));
            if(!selected.length){toast('Selecione pelo menos uma ação para receber o objetivo.','warn');return}
            let changed=0;
            for(const number of selected){
              const targetCard=planForm.querySelector('[data-cfdh-action-card][data-action-number="'+number+'"]');
              const textarea=targetCard?.querySelector('[name="objective"]');
              if(!textarea)continue;
              textarea.value=sourceText;
              textarea.dispatchEvent(new Event('input',{bubbles:true}));
              changed++;
            }
            document.querySelector('#modal')?.remove();
            refresh();
            toast('Objetivo replicado em '+changed+' ação(ões).');
          });
        });

        card.querySelector('[data-cfdh-copy-resources]')?.addEventListener('click',()=>{
          const sourceText=card.querySelector('[name="resources"]')?.value?.trim()||'';
          if(!sourceText){toast('Preencha primeiro o campo Recursos necessários desta ação.','warn');return}
          const sourceNumber=Number(card.dataset.actionNumber||0),current=collectActions();
          const targets=current.map((a,i)=>({...a,number:i+1})).filter(a=>a.number!==sourceNumber);
          if(!targets.length){toast('Crie pelo menos duas ações para replicar os recursos.','warn');return}
          const sourceAction=current[sourceNumber-1]||{},sourceWorkshop=bundle.workshops.find(w=>w.id===sourceAction.workshop_id);
          modal('Repetir recursos em outras ações',
            '<div class="stack">'+
              '<div class="notice info"><b>Origem: Ação '+sourceNumber+' · '+esc(sourceAction.title||('Ação '+sourceNumber))+'</b><br>'+
                esc(sourceWorkshop?.name||'Sem oficina definida')+(sourceAction.scheduled_date?' · '+fmtDate(sourceAction.scheduled_date):'')+
                '<br><small>Somente <b>Recursos necessários</b> será copiado. Os demais campos permanecem independentes.</small></div>'+
              '<div class="cfdh-copy-preview">'+esc(sourceText)+'</div>'+
              '<div class="actions"><button type="button" class="btn secondary" data-cfdh-copy-resources-select-all>Selecionar todas</button><button type="button" class="btn ghost" data-cfdh-copy-resources-clear>Desmarcar todas</button></div>'+
              '<form id="cfdh-copy-resources-form" class="stack"><div class="check-grid cfdh-copy-actions-grid">'+
                targets.map(a=>{
                  const w=bundle.workshops.find(x=>x.id===a.workshop_id),hasText=Boolean(String(a.resources||'').trim());
                  return '<label class="check cfdh-copy-action-option"><input type="checkbox" name="target_action" value="'+a.number+'"><span><b>Ação '+a.number+' · '+esc(a.title||('Ação '+a.number))+'</b><small>'+esc(w?.name||'Sem oficina definida')+(a.scheduled_date?' · '+fmtDate(a.scheduled_date):'')+'</small>'+(hasText?'<em>Já possui recursos — o conteúdo será substituído.</em>':'<em>Campo de recursos vazio.</em>')+'</span></label>';
                }).join('')+
              '</div><button type="submit" class="btn primary">Preencher recursos selecionados</button></form>'+
            '</div>');
          const copyForm=document.querySelector('#cfdh-copy-resources-form');
          document.querySelector('[data-cfdh-copy-resources-select-all]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=true));
          document.querySelector('[data-cfdh-copy-resources-clear]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=false));
          copyForm?.addEventListener('submit',e=>{
            e.preventDefault();
            const selected=[...copyForm.querySelectorAll('[name="target_action"]:checked')].map(x=>Number(x.value));
            if(!selected.length){toast('Selecione pelo menos uma ação para receber os recursos.','warn');return}
            let changed=0;
            for(const number of selected){
              const targetCard=planForm.querySelector('[data-cfdh-action-card][data-action-number="'+number+'"]');
              const textarea=targetCard?.querySelector('[name="resources"]');
              if(!textarea)continue;
              textarea.value=sourceText;
              textarea.dispatchEvent(new Event('input',{bubbles:true}));
              changed++;
            }
            document.querySelector('#modal')?.remove();
            refresh();
            toast('Recursos replicados em '+changed+' ação(ões).');
          });
        });

        card.querySelector('[data-cfdh-copy-activities]')?.addEventListener('click',()=>{
          const sourceText=card.querySelector('[name="activities"]')?.value?.trim()||'';
          if(!sourceText){toast('Preencha primeiro o campo Atividades propostas desta ação.','warn');return}
          const sourceNumber=Number(card.dataset.actionNumber||0),current=collectActions();
          const targets=current.map((a,i)=>({...a,number:i+1})).filter(a=>a.number!==sourceNumber);
          if(!targets.length){toast('Crie pelo menos duas ações para replicar a dinâmica.','warn');return}
          const sourceAction=current[sourceNumber-1]||{},sourceWorkshop=bundle.workshops.find(w=>w.id===sourceAction.workshop_id);
          modal('Preencher outras ações a partir desta descrição',
            '<div class="stack">'+
              '<div class="notice info"><b>Origem: Ação '+sourceNumber+' · '+esc(sourceAction.title||('Ação '+sourceNumber))+'</b><br>'+
                esc(sourceWorkshop?.name||'Sem oficina definida')+(sourceAction.scheduled_date?' · '+fmtDate(sourceAction.scheduled_date):'')+
                '<br><small>Apenas o campo <b>Atividades propostas</b> será copiado. Tema, objetivo, oficina, classificação, data, horário e recursos permanecem independentes.</small></div>'+
              '<div class="cfdh-copy-preview">'+esc(sourceText)+'</div>'+
              '<div class="actions"><button type="button" class="btn secondary" data-cfdh-copy-select-all>Selecionar todas</button><button type="button" class="btn ghost" data-cfdh-copy-clear>Desmarcar todas</button></div>'+
              '<form id="cfdh-copy-activities-form" class="stack"><div class="check-grid cfdh-copy-actions-grid">'+
                targets.map(a=>{
                  const w=bundle.workshops.find(x=>x.id===a.workshop_id),hasText=Boolean(String(a.activities||'').trim());
                  return '<label class="check cfdh-copy-action-option"><input type="checkbox" name="target_action" value="'+a.number+'"><span><b>Ação '+a.number+' · '+esc(a.title||('Ação '+a.number))+'</b><small>'+esc(w?.name||'Sem oficina definida')+(a.scheduled_date?' · '+fmtDate(a.scheduled_date):'')+'</small>'+(hasText?'<em>Já possui atividades — o conteúdo será substituído.</em>':'<em>Campo de atividades vazio.</em>')+'</span></label>';
                }).join('')+
              '</div><button type="submit" class="btn primary">Preencher ações selecionadas</button></form>'+
            '</div>');
          const copyForm=document.querySelector('#cfdh-copy-activities-form');
          document.querySelector('[data-cfdh-copy-select-all]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=true));
          document.querySelector('[data-cfdh-copy-clear]')?.addEventListener('click',()=>copyForm?.querySelectorAll('[name="target_action"]').forEach(x=>x.checked=false));
          copyForm?.addEventListener('submit',e=>{
            e.preventDefault();
            const selected=[...copyForm.querySelectorAll('[name="target_action"]:checked')].map(x=>Number(x.value));
            if(!selected.length){toast('Selecione pelo menos uma ação para receber a dinâmica.','warn');return}
            let changed=0;
            for(const number of selected){
              const targetCard=planForm.querySelector('[data-cfdh-action-card][data-action-number="'+number+'"]');
              const textarea=targetCard?.querySelector('[name="activities"]');
              if(!textarea)continue;
              textarea.value=sourceText;
              textarea.dispatchEvent(new Event('input',{bubbles:true}));
              changed++;
            }
            document.querySelector('#modal')?.remove();
            refresh();
            toast('Dinâmica replicada em '+changed+' ação(ões).');
          });
        });

        card.addEventListener('input',refresh);card.addEventListener('change',refresh);
      });
    };
    const renderActions=(actions)=>{
      const d={...bundle,plan:collectPlan(),workshop_ids:collectPlan().plan_type==='cfdh_transversal'?selectedWorkshopIds():[],actions};
      bundle.workshop_ids=d.workshop_ids;
      actionsBox.innerHTML=actions.map((a,i)=>cfdhActionEditorCard(d,{...a,action_number:i+1},i)).join('');
      bindActionCards();refresh();
    };
    const resizeActions=()=>{
      const wanted=Math.max(1,Math.min(60,Number(planForm.querySelector('[data-cfdh-action-count]')?.value||1))),current=collectActions();
      if(current.length<wanted){
        for(let i=current.length;i<wanted;i++){const me=bundle.team.find(t=>t.id===state.user?.id&&['educador','assistente_social','psicologo','terapeuta_ocupacional'].includes(t.role));current.push({action_number:i+1,title:'Ação '+(i+1),planned_duration_hours:2,schedule_mode:collectPlan().plan_type==='cfdh_estrutural'?'structural':'workshop_planned',scheduled_date:'',start_time:'',end_time:'',nucleus_code:'N1',axis_code:'N1.E1',item_code:'C',item_label:'Circuito Formativo em Direitos Humanos',additional_classifications:[],responsible_user_ids:me?[me.id]:[],responsible_names:me?[me.display_name]:[],responsible_roles:me?[me.role]:[],action_theme:cfdhMonthlyThemeText(bundle)})}
      }else if(current.length>wanted){
        const removed=current.slice(wanted);
        if(removed.some(x=>x.id&&['realizada','parcial'].includes(bundle.actions.find(a=>a.id===x.id)?.execution_status))){toast('Ação já executada não pode ser removida.','danger');planForm.querySelector('[data-cfdh-action-count]').value=current.length;return}
        current.splice(wanted);
      }
      renderActions(current);
    };
    if(!bundle.actions.length)resizeActions(); else bindActionCards();

    planForm.querySelector('[data-cfdh-action-count]')?.addEventListener('change',resizeActions);
    planForm.querySelector('[data-cfdh-type]')?.addEventListener('change',e=>{
      const structural=e.target.value==='cfdh_estrutural';
      document.querySelector('[data-cfdh-workshops-block]')?.classList.toggle('hidden',structural);
      document.querySelector('[data-cfdh-structural-smart-block]')?.classList.toggle('hidden',!structural);
      if(structural)planForm.querySelectorAll('[name="cfdh_workshop_id"]').forEach(x=>x.checked=false);
      const actions=collectActions().map(a=>({...a,workshop_id:structural?null:a.workshop_id,schedule_mode:structural?'structural':(a.schedule_mode==='structural'?'workshop_planned':a.schedule_mode),workshop_calendar_id:structural?null:a.workshop_calendar_id}));
      renderActions(actions);
    });
    planForm.querySelector('[data-cfdh-smart-distribute]')?.addEventListener('click',()=>{
      if(collectPlan().plan_type!=='cfdh_estrutural'){toast('A distribuição inteligente é específica do CFDH estrutural.','warn');return}
      const all=collectActions(),locked=all.filter(a=>a.id&&['realizada','parcial'].includes(bundle.actions.find(x=>x.id===a.id)?.execution_status)),pending=all.filter(a=>!locked.some(x=>x.action_number===a.action_number));
      if(!pending.length){toast('Não há ações estruturais pendentes para distribuir.','warn');return}
      const draft=draftBundle(),lockedCalendar=locked.filter(a=>a.scheduled_date&&a.start_time&&a.end_time).map(a=>({source:'fixed_current_plan',id:a.id||('locked-'+a.action_number),date:a.scheduled_date,start:a.start_time,end:a.end_time,title:'CFDH já executado · Ação '+a.action_number,location:a.location_other||a.location_type||'CRJ Cariacica'}));
      const smartBundle={...draft,crj_calendar:[...(bundle.crj_calendar||[]),...lockedCalendar],smart_signals:bundle.smart_signals};
      const suggestions=cfdhSmartDistribution(smartBundle,pending);
      if(!suggestions.length){toast('Não encontrei janelas livres suficientes para distribuir as ações neste mês.','danger');return}
      const missing=pending.length-suggestions.length;
      modal('Distribuição inteligente · CFDH estrutural',
        cfdhSmartDistributionModalHtml(smartBundle,suggestions)+
        (locked.length?'<div class="notice info compact" style="margin-top:10px">'+locked.length+' ação(ões) já executada(s)/parcial(is) foram preservadas e consideradas como horário ocupado.</div>':'')+
        (missing>0?'<div class="notice danger compact" style="margin-top:10px">Não foi possível encontrar janela sem conflito para '+missing+' ação(ões). Essas ações permanecerão sem alteração.</div>':'')
      );
      document.querySelector('[data-cfdh-cancel-smart-distribution]')?.addEventListener('click',()=>document.querySelector('#modal')?.remove());
      document.querySelector('[data-cfdh-apply-smart-distribution]')?.addEventListener('click',()=>{
        const byNumber=new Map(suggestions.map(x=>[x.action_number,x]));
        const updated=collectActions().map(a=>{
          const s=byNumber.get(a.action_number);if(!s)return a;
          return {...a,scheduled_date:s.date,start_time:s.start,end_time:s.end,schedule_mode:'structural',workshop_id:null,workshop_calendar_id:null};
        });
        document.querySelector('#modal')?.remove();
        renderActions(updated);
        toast('Distribuição inteligente aplicada. Datas e horários continuam editáveis manualmente.');
      });
    });

    planForm.querySelectorAll('[name="cfdh_workshop_id"]').forEach(x=>x.addEventListener('change',()=>{
      const selected=selectedWorkshopIds(),actions=collectActions().map(a=>selected.includes(a.workshop_id)?a:{...a,workshop_id:null,workshop_calendar_id:null,scheduled_date:a.schedule_mode==='atypical'?a.scheduled_date:'',start_time:a.schedule_mode==='atypical'?a.start_time:'',end_time:a.schedule_mode==='atypical'?a.end_time:''});
      renderActions(actions);
    }));
    planForm.querySelector('[data-cfdh-auto-distribute]')?.addEventListener('click',()=>{
      const selected=selectedWorkshopIds();
      if(!selected.length){toast('Selecione ao menos uma oficina antes de distribuir.','warn');return}
      const usedDates=new Set(),actions=collectActions().map((a,i)=>{
        const workshop_id=selected[i%selected.length],available=bundle.calendar.filter(x=>x.workshop_id===workshop_id);
        const d=available.find(x=>!usedDates.has(x.scheduled_date))||null;
        if(d){usedDates.add(d.scheduled_date);return {...a,workshop_id,schedule_mode:'workshop_planned',workshop_calendar_id:d.id,scheduled_date:d.scheduled_date,start_time:String(d.start_time||'').slice(0,5),end_time:String(d.end_time||'').slice(0,5),location_type:d.location_type||a.location_type,location_other:d.location_other||a.location_other}}
        return {...a,workshop_id,schedule_mode:'atypical',workshop_calendar_id:null,scheduled_date:'',start_time:'',end_time:''};
      });
      renderActions(actions);
      toast('Ações distribuídas entre oficinas e datas disponíveis. Complete os dias atípicos sinalizados.');
    });
    document.querySelector('[data-toggle-cfdh-plan-preview]')?.addEventListener('click',e=>{workspace?.classList.toggle('preview-open');e.currentTarget.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
    planForm.addEventListener('input',refresh);planForm.addEventListener('change',refresh);
    const saveCurrentCfdh=async({navigateBack=false}={})=>{
      const draft=draftBundle(),completion=cfdhPlanCompleteness(draft),btn=planForm.querySelector('[type="submit"]'),original=btn?.textContent||'Salvar planejamento CFDH';
      if(btn){btn.disabled=true;btn.textContent=completion.complete?'Salvando...':'Salvando rascunho...'}
      try{
        await saveCfdhPlanBundle(planId,{plan:draft.plan,workshop_ids:draft.workshop_ids,actions:draft.actions});
        toast(completion.complete?'Planejamento CFDH concluído e salvo.':'Rascunho salvo · planejamento não concluído.','success');
        if(navigateBack){nav('cfdh?month='+month);await render();return true}
        nav('cfdh?month='+month+'&plan='+planId);await render();return true;
      }catch(err){toast(err.message,'danger');if(btn){btn.disabled=false;btn.textContent=original}return false}
    };
    document.querySelector('[data-cfdh-save-back]')?.addEventListener('click',()=>saveCurrentCfdh({navigateBack:true}));
    planForm.addEventListener('submit',async e=>{e.preventDefault();await saveCurrentCfdh()});
    refresh();
  }

  document.querySelectorAll('[data-cfdh-plan-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';try{await downloadCfdhPlan(btn.dataset.cfdhPlanPdf,'pdf');toast('PDF do planejamento CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-plan-docx]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';try{await downloadCfdhPlan(btn.dataset.cfdhPlanDocx,'docx');toast('DOCX do planejamento CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-plan-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{const b=await getCfdhPlanBundle(btn.dataset.cfdhPlanPrint),themes=await listCfdhThemes(),classification=await listMethodologyClassificationCatalog();b.themes=themes;b.classification=classification;openPrintableDocument('Planejamento CFDH · '+(b.plan.activity_title||''),cfdhPlanPreviewHtml(b))}catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-cfdh-execute]').forEach(btn=>btn.addEventListener('click',()=>{
    const a=bundle.actions.find(x=>x.id===btn.dataset.cfdhExecute);if(!a)return;
    modal('Execução · Ação '+a.action_number,'<form id="cfdh-execution-form" class="stack"><div class="notice info"><b>'+esc(a.title||'Ação CFDH')+'</b><br>'+fmtDate(a.scheduled_date)+' · planejado '+Number(a.planned_duration_hours||0).toLocaleString('pt-BR')+'h.</div><div class="field"><label>Situação da execução</label><select name="execution_status"><option value="realizada" '+(a.execution_status==='realizada'?'selected':'')+'>Realizada</option><option value="parcial" '+(a.execution_status==='parcial'?'selected':'')+'>Parcial</option><option value="cancelada" '+(a.execution_status==='cancelada'?'selected':'')+'>Cancelada</option></select></div><div class="form-grid three"><div class="field"><label>Data real</label><input class="input" type="date" name="actual_date" value="'+esc(a.actual_date||a.scheduled_date||'')+'"></div><div class="field"><label>Início real</label><input class="input" type="time" name="actual_start" value="'+esc(String(a.actual_start||a.start_time||'').slice(0,5))+'"></div><div class="field"><label>Término real</label><input class="input" type="time" name="actual_end" value="'+esc(String(a.actual_end||a.end_time||'').slice(0,5))+'"></div></div><div class="field"><label>Duração real (h)</label><input class="input" type="number" min="0" step="0.25" name="actual_duration_hours" value="'+esc(a.actual_duration_hours??a.planned_duration_hours??'')+'"><small>Menos de 2h fica registrado, mas não entra na contagem operacional mínima configurada.</small></div><div class="field"><label>Descrição do que foi executado</label><textarea name="execution_description" required>'+esc(a.execution_description||'')+'</textarea></div><div class="field"><label>Observações / diferenças do planejado</label><textarea name="execution_notes">'+esc(a.execution_notes||'')+'</textarea></div><button class="btn primary">Salvar execução</button></form>');
    document.querySelector('#cfdh-execution-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await updateCfdhActionExecution(a.id,parseForm(e.target));document.querySelector('#modal')?.remove();toast('Execução CFDH registrada');await render()}catch(err){toast(err.message,'danger')}});
  }));

  document.querySelectorAll('[data-cfdh-open-checkin]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const x=await openCfdhCheckin(btn.dataset.cfdhOpenCheckin),url=new URL('checkin.html',location.href);url.searchParams.set('cfdh',x.public_token);
      modal('Lista de presença · CFDH','<div class="stack"><div class="notice success"><b>Lista CFDH aberta.</b><br>Somente jovens com pelo menos Formulário Inicial parcial podem participar. Quem ainda não possuir trajetória poderá iniciar o Formulário Inicial parcial e se inscrever no circuito pela própria lista.</div><input class="input" value="'+esc(url.href)+'" readonly data-cfdh-checkin-url><div class="actions"><a class="btn primary" href="'+esc(url.href)+'" target="_blank">Abrir lista</a><button class="btn secondary" data-copy-cfdh-checkin>Copiar link</button></div></div>');
      document.querySelector('[data-copy-cfdh-checkin]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link CFDH copiado')});
    }catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-cfdh-list-preview]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const s=await getCfdhAttendanceSheet(btn.dataset.cfdhListPreview);
      modal('Pré-visualização · Lista CFDH','<div class="methodology-preview-modal">'+methodologyAttendancePreviewHtml({activity:(s.activity||'CFDH')+' · '+(s.action_title||''),location:s.location,date:s.date,start_time:String(s.start_time||'').slice(0,5),end_time:String(s.end_time||'').slice(0,5),participants:s.participants||[]})+'</div>');document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }catch(err){toast(err.message,'danger')}
  }));
  const exportCfdhList=async(actionId,format,btn)=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{const sub=await createCfdhAttendanceSubmission(actionId);await downloadFormSubmission(sub.id,format);toast(String(format).toUpperCase()+' da lista CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  };
  document.querySelectorAll('[data-cfdh-list-pdf]').forEach(btn=>btn.addEventListener('click',()=>exportCfdhList(btn.dataset.cfdhListPdf,'pdf',btn)));
  document.querySelectorAll('[data-cfdh-list-docx]').forEach(btn=>btn.addEventListener('click',()=>exportCfdhList(btn.dataset.cfdhListDocx,'docx',btn)));
  document.querySelectorAll('[data-cfdh-list-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{const s=await getCfdhAttendanceSheet(btn.dataset.cfdhListPrint);openPrintableDocument('Lista CFDH · '+(s.action_title||''),methodologyAttendancePreviewHtml({activity:(s.activity||'CFDH')+' · '+(s.action_title||''),location:s.location,date:s.date,start_time:String(s.start_time||'').slice(0,5),end_time:String(s.end_time||'').slice(0,5),participants:s.participants||[]}))}catch(err){toast(err.message,'danger')}
  }));

  const reportForm=document.querySelector('#cfdh-report-editor');
  if(reportForm){
    const preview=document.querySelector('[data-cfdh-report-preview]'),workspace=document.querySelector('[data-cfdh-report-workspace]');
    const refresh=()=>{if(preview)preview.innerHTML=cfdhReportPreviewHtml(bundle,cfdhReportDraft(bundle,reportForm))};
    reportForm.addEventListener('input',refresh);reportForm.addEventListener('change',refresh);
    document.querySelector('[data-toggle-cfdh-report-preview]')?.addEventListener('click',e=>{workspace?.classList.toggle('preview-open');e.currentTarget.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
    reportForm.addEventListener('submit',async e=>{e.preventDefault();const btn=reportForm.querySelector('[type="submit"]'),o=btn.textContent;btn.disabled=true;btn.textContent='Salvando...';try{await createEducatorReport(cfdhReportDraft(bundle,reportForm));toast('Relatório CFDH salvo');nav('cfdh?month='+month+'&plan='+planId+'&view=relatorio');await render()}catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=o}});
    refresh();
  }
  document.querySelectorAll('[data-cfdh-report-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadCfdhReport(btn.dataset.cfdhReportPdf,'pdf');toast('PDF do relatório CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-report-docx]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadCfdhReport(btn.dataset.cfdhReportDocx,'docx');toast('DOCX do relatório CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-report-print]').forEach(btn=>btn.addEventListener('click',()=>openPrintableDocument('Relatório CFDH · '+(bundle.plan.activity_title||''),cfdhReportPreviewHtml(bundle,reportForm?cfdhReportDraft(bundle,reportForm):bundle.report))));
}

async function bindEducatorPageV2(){
  const monthEl=document.querySelector('[data-educator-filter-month]'),userEl=document.querySelector('[data-educator-filter-user]'),view=route().params.get('view')||'responsabilidades';if(!monthEl&&!document.querySelector('[data-educator-new]')&&!document.querySelector('[data-new-educator-plan]'))return;
  const apply=()=>{const p=new URLSearchParams();if(monthEl?.value)p.set('month',monthEl.value);if(userEl?.value)p.set('user',userEl.value);p.set('view',view);nav('educador?'+p.toString())};monthEl?.addEventListener('change',apply);userEl?.addEventListener('change',apply);
  const filterUser=route().params.get('user'),planUser=filterUser==='all'?null:(filterUser||state.user?.id||null);
  const [youth,workshops,provisional,plans]=await Promise.all([listYouth(''),listWorkshops(),listProvisionalPeople(),listEducatorPlans(route().params.get('month')||currentMonth(),planUser)]);
  const reportForm=document.querySelector('#workshop-monthly-report-form');
  if(reportForm){
    const planId=reportForm.dataset.planId;
    try{
      const bundle=await getWorkshopMonthlyReportBundle(planId),preview=document.querySelector('[data-workshop-report-preview]'),workspace=document.querySelector('[data-workshop-report-workspace]'),toggle=document.querySelector('[data-toggle-workshop-report-preview]');
      const refresh=()=>{if(preview)preview.innerHTML=workshopReportPreviewHtml(bundle,workshopReportDraft(bundle,reportForm))};
      reportForm.addEventListener('input',refresh);reportForm.addEventListener('change',refresh);
      toggle?.addEventListener('click',()=>{workspace?.classList.toggle('preview-open');toggle.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
      reportForm.addEventListener('submit',async e=>{
        e.preventDefault();
        const btn=reportForm.querySelector('[type="submit"]'),original=btn?.textContent;
        if(btn){btn.disabled=true;btn.textContent='Salvando...'}
        try{
          const payload=workshopReportDraft(bundle,reportForm);
          const saved=await saveWorkshopMonthlyReport(payload);
          toast('Relatório salvo e vinculado à execução registrada');
          const q=new URLSearchParams(route().params);q.set('report',planId);nav('educador?'+q.toString());await render();
        }catch(err){toast(err.message,'danger');if(btn){btn.disabled=false;btn.textContent=original||'Salvar relatório'}}
      });
      refresh();
    }catch(err){toast(err.message,'danger')}
  }

  document.querySelectorAll('[data-workshop-report-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyReport(btn.dataset.workshopReportPdf,'pdf');toast('PDF do relatório gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-workshop-report-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyReport(btn.dataset.workshopReportDocx,'docx');toast('DOCX do relatório gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-workshop-report-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const bundle=await getWorkshopMonthlyReportBundle(btn.dataset.workshopReportPrint);
      let draft=bundle.report||workshopReportDraft(bundle);
      const active=document.querySelector('#workshop-monthly-report-form');
      if(active?.dataset.planId===btn.dataset.workshopReportPrint)draft=workshopReportDraft(bundle,active);
      openPrintableDocument('Relatório · '+(bundle.workshop?.name||'Oficina'),workshopReportPreviewHtml(bundle,draft));
    }catch(err){toast(err.message,'danger')}
  }));

  const referralButtons=document.querySelectorAll('[data-referral-preview],[data-referral-pdf],[data-referral-docx],[data-referral-print]');
  if(referralButtons.length){
    const [team,receipts,monthRecords]=await Promise.all([listTeam(),listEducatorReferralReceipts(),listEducatorRecords(route().params.get('month')||currentMonth(),planUser)]);
    const teamMap=new Map(team.map(x=>[x.id,x])),youthMap=new Map(youth.map(x=>[x.id,x])),workshopMap=new Map(workshops.map(x=>[x.id,x]));
    const findRecord=id=>monthRecords.find(x=>x.id===id);
    document.querySelectorAll('[data-referral-preview]').forEach(btn=>btn.addEventListener('click',()=>{
      const rec=findRecord(btn.dataset.referralPreview);if(!rec)return;
      modal('Pré-visualização do encaminhamento','<div class="methodology-preview-modal">'+educatorReferralPreviewHtml(rec,receipts,teamMap,youthMap,workshopMap)+'</div>');
      document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }));
    document.querySelectorAll('[data-referral-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
      const original=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadEducatorReferral(btn.dataset.referralPdf,'pdf');toast('PDF do encaminhamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
    }));
    document.querySelectorAll('[data-referral-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
      const original=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadEducatorReferral(btn.dataset.referralDocx,'docx');toast('DOCX do encaminhamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
    }));
    document.querySelectorAll('[data-referral-print]').forEach(btn=>btn.addEventListener('click',()=>{
      const rec=findRecord(btn.dataset.referralPrint);if(!rec)return;
      openPrintableDocument('Encaminhamento · '+(rec.title||'Educador'),educatorReferralPreviewHtml(rec,receipts,teamMap,youthMap,workshopMap));
    }));
  }

  document.querySelectorAll('[data-educator-new]').forEach(btn=>btn.addEventListener('click',()=>{const initial=btn.dataset.educatorNew||'acolhimento_educativo',types=['acolhimento_educativo','demanda_identificada','encaminhamento_interno','acompanhamento_oficina','mediacao_convivencia','ficaadica_orientacao','trampo_labpoca','mobilizacao','evento_programacao','passeio_visita','atividade_externa','mostra','estudo_caso','outra_acao_educativa'];modal('Registrar contribuicao do Educador',`<form id="educator-record-form" class="stack"><div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Tipo ${eduGoalInfo(initial)}</label><select name="record_type" required>${types.map(k=>`<option value="${k}" ${k===initial?'selected':''}>${esc(eduTypeLabel(k))}</option>`).join('')}</select></div></div><div class="field"><label>Jovem / participante ${eduGoalInfo('cadastro')}</label>${eduPersonSearchHtml()}<small>A busca filtra em tempo real e elimina nomes nao compativeis.</small></div><div class="field"><label>Oficina relacionada</label><select name="workshop_id"><option value="">Nenhuma</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>Titulo / sintese</label><input class="input" name="title"></div><div class="field"><label>Descricao objetiva</label><textarea name="description" required></textarea></div><div class="form-grid"><div class="field"><label>Duracao em horas</label><input class="input" type="number" name="duration_hours" min="0" max="24" step="0.25" value="0"></div><div class="field"><label>Nº de participantes</label><input class="input" type="number" name="participants_count" min="0"></div></div><div class="field"><label>Encaminhar para ${eduGoalInfo('encaminhamento_interno')}</label><select name="referral_target"><option value="">Sem encaminhamento</option><option value="equipe_tecnica">Equipe Tecnica</option><option value="coordenacao">Coordenacao Geral</option><option value="articulacao">Articulacao</option><option value="administrativo">Administrativo</option><option value="oficina">Oficineiro da oficina</option><option value="rede_externa">Orientacao para rede externa</option></select><small>O destinatario recebe as especificidades e a ciencia volta ao Educador ao visualizar.</small></div><div class="field"><label>Evidencia / referencia</label><input class="input" name="evidence_ref"></div><div class="field"><label>Observacao interna</label><textarea name="notes"></textarea></div><button class="btn primary">Salvar contribuicao</button></form>`);const form=document.querySelector('#educator-record-form');bindEduPersonSearch(form,youth,provisional);decorateEduGoalForm(form,initial);form?.querySelector('[name="record_type"]')?.addEventListener('change',e=>decorateEduGoalForm(form,e.target.value));form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(['demanda_identificada','encaminhamento_interno'].includes(p.record_type)&&!p.youth_id&&!p.provisional_person_id){toast('Selecione o jovem/participante.','danger');return}try{await createEducatorRecord(p);document.querySelector('#modal')?.remove();toast(p.referral_target?'Registro salvo e encaminhamento enviado':'Contribuicao registrada');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelector('[data-new-educator-plan]')?.addEventListener('click',()=>{modal('Novo planejamento',`<form id="educator-plan-form" class="stack"><div class="field"><label>Tipo</label><select name="plan_type" required><option value="evento">Evento / programação</option></select></div><div class="field"><label>Oficina vinculada</label><select name="workshop_id"><option value="">Nao se aplica</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>ATIVIDADE / titulo</label><input class="input" name="activity_title" required></div><div class="field"><label>DESCRICAO / objetivo</label><textarea name="description_objective" required></textarea></div><div class="form-grid"><div class="field"><label>Nucleo</label><input class="input" name="nucleus"></div><div class="field"><label>Eixo</label><input class="input" name="axis"></div></div><div class="form-grid"><div class="field"><label>Nº de jovens previsto</label><input class="input" type="number" name="expected_participants" min="0"></div><div class="field"><label>Duracao prevista (h)</label><input class="input" type="number" step="0.25" name="planned_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial</label><input class="input" type="date" name="planned_start"></div><div class="field"><label>Data final</label><input class="input" type="date" name="planned_end"></div></div><div class="field"><label>Equipe prevista</label><input class="input" name="team_text"></div><div class="field"><label>Parceiros</label><input class="input" name="partners"></div><div class="field"><label>Mobilizacao / divulgacao planejada</label><textarea name="mobilization_plan"></textarea></div><div class="field"><label>Acoes planejadas</label><textarea name="planned_actions"></textarea></div><div class="field"><label>Resultados esperados</label><textarea name="expected_results"></textarea></div><div class="field"><label>Recursos necessarios</label><textarea name="resources"></textarea></div><div class="notice">Planejamento nao contabiliza execucao ate que o relatorio ou a sessao seja registrado.</div><button class="btn primary">Salvar planejamento</button></form>`);const planForm=document.querySelector('#educator-plan-form');decorateEduGoalForm(planForm,'evento_programacao');planForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorPlan(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Planejamento salvo');await render()}catch(err){toast(err.message,'danger')}})});

  document.querySelectorAll('[data-edu-workshop-plan-open]').forEach(btn=>btn.addEventListener('click',()=>{
    const month=route().params.get('month')||currentMonth();
    nav('oficinas?view=planejamento&month='+month+'&plan='+btn.dataset.eduWorkshopPlanOpen);
  }));
  document.querySelectorAll('[data-edu-workshop-plan-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanPdf,'pdf');toast('PDF do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanDocx,'docx');toast('DOCX do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorWorkshopPlan(btn.dataset.eduWorkshopPlanPrint)}catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-edu-list-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListPdf,'pdf');toast('PDF da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListDocx,'docx');toast('DOCX da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorPlannedAttendance(btn.dataset.plan,btn.dataset.eduListPrint)}catch(err){toast(err.message,'danger')}
  }));


  document.querySelectorAll('[data-workshop-monthly-report]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const planId=btn.dataset.workshopMonthlyReport;
      const [planBundle,reports,ws]=await Promise.all([getWorkshopMonthlyPlan(planId),listWorkshopMonthlyReports(),listWorkshops()]);
      const plan=planBundle.plan,workshop=ws.find(x=>x.id===plan.workshop_id)||{},existing=reports.find(x=>x.plan_id===planId)||{};
      let html='<form id="workshop-monthly-report-form" class="stack"><input type="hidden" name="plan_id" value="'+planId+'">';
      html+='<div class="notice info"><b>'+esc(workshop.name||'Oficina')+'</b><br>Relatório vinculado ao planejamento de '+esc(String(plan.plan_month||'').slice(0,7).split('-').reverse().join('/'))+'.</div>';
      html+='<div class="form-grid"><div class="field"><label>Data do relatório</label><input class="input" type="date" name="report_date" value="'+esc(existing.report_date||new Date().toISOString().slice(0,10))+'" required></div><div class="field"><label>Situação da execução</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Não realizado</option></select></div></div>';
      html+='<div class="field"><label>Descrição do que foi executado</label><textarea name="actual_description" required>'+esc(existing.actual_description||'')+'</textarea></div>';
      html+='<div class="form-grid"><div class="field"><label>Participantes alcançados</label><input class="input" type="number" min="0" name="actual_participants" value="'+esc(existing.actual_participants??'')+'"></div><div class="field"><label>Carga horária executada</label><input class="input" type="number" min="0" step="0.25" name="actual_duration_hours" value="'+esc(existing.actual_duration_hours??'')+'"></div></div>';
      html+='<div class="field"><label>Pontos positivos</label><textarea name="positive_points">'+esc(existing.positive_points||'')+'</textarea></div><div class="field"><label>Dificuldades</label><textarea name="difficulties">'+esc(existing.difficulties||'')+'</textarea></div><div class="field"><label>Ações realizadas / ajustes</label><textarea name="actions_performed">'+esc(existing.actions_performed||'')+'</textarea></div><div class="field"><label>Justificativa, quando parcial ou não realizado</label><textarea name="justification">'+esc(existing.justification||'')+'</textarea></div><div class="field"><label>Evidência / referência</label><input class="input" name="evidence_ref" value="'+esc(existing.evidence_ref||'')+'"></div><button class="btn primary">Salvar relatório da oficina</button></form>';
      modal('Relatório mensal da oficina',html);
      const form=document.querySelector('#workshop-monthly-report-form');
      if(form?.querySelector('[name="execution_status"]'))form.querySelector('[name="execution_status"]').value=existing.execution_status||'realizado';
      form?.addEventListener('submit',async e=>{e.preventDefault();try{await saveWorkshopMonthlyReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatório da oficina salvo');await render()}catch(err){toast(err.message,'danger')}});
    }catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-report-plan]').forEach(btn=>btn.addEventListener('click',()=>{const p=plans.find(x=>x.id===btn.dataset.reportPlan);if(!p)return;modal('Relatorio de execucao',`<form id="educator-report-form" class="stack"><input type="hidden" name="plan_id" value="${p.id}"><div class="notice"><b>${esc(p.activity_title)}</b><br>Planejado: ${esc(p.description_objective||'')}<br>${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</div><div class="field"><label>Situacao</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Nao realizado</option></select></div><div class="field"><label>DESCRICAO do que efetivamente aconteceu</label><textarea name="actual_description" required></textarea></div><div class="form-grid"><div class="field"><label>Nº real de jovens</label><input class="input" type="number" name="actual_participants" min="0"></div><div class="field"><label>Duracao real (h)</label><input class="input" type="number" step="0.25" name="actual_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial real</label><input class="input" type="date" name="actual_start" value="${esc(p.planned_start||'')}"></div><div class="field"><label>Data final real</label><input class="input" type="date" name="actual_end" value="${esc(p.planned_end||p.planned_start||'')}"></div></div><div class="field"><label>MOBILIZACAO / divulgacao realizada</label><textarea name="mobilization_actual"></textarea></div><div class="field"><label>PONTOS POSITIVOS</label><textarea name="positive_points"></textarea></div><div class="field"><label>PONTOS NEGATIVOS</label><textarea name="negative_points"></textarea></div><div class="field"><label>ACOES realizadas</label><textarea name="actions_performed"></textarea></div><div class="field"><label>Justificativa (parcial/nao realizado)</label><textarea name="justification"></textarea></div><div class="field"><label>Evidencias</label><input class="input" name="evidence_ref"></div><button class="btn primary">Salvar relatorio</button></form>`);const reportForm=document.querySelector('#educator-report-form');decorateEduGoalForm(reportForm,p.plan_type==='cfdh_transversal'?'cfdh_transversal':p.plan_type==='cfdh_estrutural'?'cfdh_estrutural':p.plan_type==='evento'?'evento_programacao':'acompanhamento_oficina');reportForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatorio salvo');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelectorAll('[data-educator-delete]').forEach(btn=>btn.addEventListener('click',async()=>{if(!confirm('Excluir este registro?'))return;try{await deleteEducatorRecord(btn.dataset.educatorDelete);toast('Registro excluido');await render()}catch(err){toast(err.message,'danger')}}));

}
