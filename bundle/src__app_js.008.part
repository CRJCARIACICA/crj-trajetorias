

async function bindCfdhShared(){
  const rr=route(),month=rr.params.get('month')||currentMonth(),planId=rr.params.get('plan')||'',view=rr.params.get('view')||'planejamento';
  document.querySelector('[data-cfdh-month]')?.addEventListener('change',e=>nav('cfdh?month='+e.target.value));

  document.querySelector('[data-new-cfdh-plan]')?.addEventListener('click',async()=>{
    try{
      const themes=await listCfdhThemes();
      modal('Novo circuito CFDH','<form id="new-cfdh-plan-form" class="stack">'+
        '<div class="notice info"><b>Primeiro defina o circuito.</b><br>Depois o sistema abrirá o planejamento por ações. Se for estrutural, oficinas ficarão indisponíveis. Se for transversal, será possível selecionar várias oficinas.</div>'+
        '<div class="form-grid"><div class="field"><label>Modalidade</label><select name="plan_type" required><option value="cfdh_estrutural">CFDH estrutural</option><option value="cfdh_transversal">CFDH transversal</option></select></div><div class="field"><label>Quantidade inicial de ações</label><input class="input" type="number" min="1" max="60" name="cfdh_action_count" value="1" required></div></div>'+
        '<div class="field"><label>Tema mensal</label><select name="cfdh_theme_code"><option value="">Selecione</option>'+themes.map(t=>'<option value="'+t.code+'">'+esc(t.code+'. '+t.theme)+'</option>').join('')+'</select></div>'+
        '<div class="field"><label>Outro tema / adaptação territorial</label><input class="input" name="cfdh_theme_custom"></div>'+
        '<div class="field"><label>Título do circuito</label><input class="input" name="activity_title" required></div>'+
        '<div class="field"><label>Objetivo geral</label><textarea name="description_objective" required></textarea></div>'+
        '<button class="btn primary">Criar e estruturar ações</button></form>');
      document.querySelector('#new-cfdh-plan-form')?.addEventListener('submit',async e=>{
        e.preventDefault();const p=parseForm(e.target),btn=e.target.querySelector('button[type="submit"]');btn.disabled=true;btn.textContent='Criando...';
        try{
          const created=await createEducatorPlan({...p,planned_start:month+'-01',status:'planejado',workshop_id:null});
          document.querySelector('#modal')?.remove();
          nav('cfdh?month='+month+'&plan='+created.id);
          await render();
        }catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent='Criar e estruturar ações'}
      });
    }catch(err){toast(err.message,'danger')}
  });

  if(!planId)return;

  let bundle;
  try{
    const [b,themes,classification]=await Promise.all([getCfdhPlanBundle(planId),listCfdhThemes(),listMethodologyClassificationCatalog()]);
    bundle=b;bundle.themes=themes;bundle.classification=classification;
  }catch(err){toast(err.message,'danger');return}

  const planForm=document.querySelector('#cfdh-plan-editor');
  if(planForm){
    const actionsBox=document.querySelector('[data-cfdh-actions]'),preview=document.querySelector('[data-cfdh-plan-preview]'),alertsBox=document.querySelector('[data-cfdh-alerts]'),workspace=document.querySelector('[data-cfdh-plan-workspace]');

    const selectedWorkshopIds=()=>[...planForm.querySelectorAll('[name="cfdh_workshop_id"]:checked')].map(x=>x.value);
    const collectActions=()=>[...planForm.querySelectorAll('[data-cfdh-action-card]')].map((card,i)=>{
      const v=n=>card.querySelector('[name="'+n+'"]')?.value||'';
      const axis=v('axis_code'),item=v('item_code'),cat=bundle.classification||[];
      return {
        id:card.dataset.actionId||null,action_number:i+1,
        workshop_id:v('workshop_id')||null,schedule_mode:v('schedule_mode')||'structural',
        workshop_calendar_id:v('workshop_calendar_id')||null,
        scheduled_date:v('scheduled_date'),start_time:v('start_time')||null,end_time:v('end_time')||null,
        planned_duration_hours:Number(v('planned_duration_hours')||0),
        location_type:v('location_type')||null,location_other:v('location_other')||null,
        title:v('title')||('Ação '+(i+1)),objective:v('objective')||'',activities:v('activities')||'',resources:v('resources')||'',
        nucleus_code:v('nucleus_code')||'',axis_code:axis||'',item_code:item||null,
        item_label:cat.find(x=>x.axis_code===axis&&x.item_code===item)?.item_label||'',
        execution_status:(bundle.actions.find(x=>x.id===card.dataset.actionId)?.execution_status)||'planejada'
      };
    });
    const collectPlan=()=>({
      ...bundle.plan,
      plan_type:planForm.querySelector('[name="plan_type"]')?.value||bundle.plan.plan_type,
      cfdh_theme_code:planForm.querySelector('[name="cfdh_theme_code"]')?.value||null,
      cfdh_theme_custom:planForm.querySelector('[name="cfdh_theme_custom"]')?.value||'',
      activity_title:planForm.querySelector('[name="activity_title"]')?.value||'',
      description_objective:planForm.querySelector('[name="description_objective"]')?.value||'',
      cfdh_action_count:Number(planForm.querySelector('[name="cfdh_action_count"]')?.value||0),
      expected_participants:planForm.querySelector('[name="expected_participants"]')?.value||null,
      team_text:planForm.querySelector('[name="team_text"]')?.value||'',
      partners:planForm.querySelector('[name="partners"]')?.value||'',
      mobilization_plan:planForm.querySelector('[name="mobilization_plan"]')?.value||'',
      expected_results:planForm.querySelector('[name="expected_results"]')?.value||'',
      cfdh_monthly_notes:planForm.querySelector('[name="cfdh_monthly_notes"]')?.value||''
    });
    const draftBundle=()=>({...bundle,plan:collectPlan(),workshop_ids:collectPlan().plan_type==='cfdh_transversal'?selectedWorkshopIds():[],actions:collectActions()});
    const refresh=()=>{
      const d=draftBundle();
      if(preview)preview.innerHTML=cfdhPlanPreviewHtml(d,d);
      if(alertsBox){
        const alerts=cfdhPlanAlerts(d);
        alertsBox.innerHTML=alerts.length?alerts.map(x=>'<div class="notice warn compact">⚠ '+esc(x)+'</div>').join(''):'<div class="notice success compact">Planejamento sem pendências estruturais.</div>';
      }
    };
    const bindActionCards=()=>{
      planForm.querySelectorAll('[data-cfdh-action-card]').forEach(card=>{
        const nucleus=card.querySelector('[data-cfdh-nucleus]'),axis=card.querySelector('[data-cfdh-axis]'),item=card.querySelector('[data-cfdh-item]');
        const rebuildAxis=()=>{
          const rows=bundle.classification.filter(x=>x.nucleus_code===nucleus.value),axes=[...new Map(rows.map(x=>[x.axis_code,{code:x.axis_code,name:x.axis_name}])).values()];
          axis.innerHTML='<option value="">Selecione</option>'+axes.map(x=>'<option value="'+x.code+'">'+esc(x.name)+'</option>').join('');
          item.innerHTML='<option value="">Selecione o Eixo</option>';item.required=false;refresh();
        };
        const rebuildItem=()=>{
          const rows=bundle.classification.filter(x=>x.axis_code===axis.value&&x.item_code);
          item.innerHTML='<option value="">'+(rows.length?'Selecione o Item':'Sem subdivisão por Item')+'</option>'+rows.map(x=>'<option value="'+x.item_code+'">'+esc(x.item_code)+') '+esc(x.item_label)+'</option>').join('');
          item.required=rows.length>0;refresh();
        };
        nucleus?.addEventListener('change',rebuildAxis);axis?.addEventListener('change',rebuildItem);
        const workshop=card.querySelector('[data-cfdh-action-workshop]'),calendar=card.querySelector('[data-cfdh-calendar-entry]'),modeEl=card.querySelector('[data-cfdh-schedule-mode]');
        const rebuildCalendar=()=>{
          if(!calendar)return;
          const rows=bundle.calendar.filter(x=>x.workshop_id===workshop?.value);
          calendar.innerHTML='<option value="">Selecione uma data</option>'+rows.map(d=>'<option value="'+d.id+'">'+fmtDate(d.scheduled_date)+' · '+esc(String(d.start_time||'').slice(0,5))+'–'+esc(String(d.end_time||'').slice(0,5))+'</option>').join('');
          const date=card.querySelector('[name="scheduled_date"]'),start=card.querySelector('[name="start_time"]'),end=card.querySelector('[name="end_time"]');
          if(modeEl?.value==='workshop_planned'){if(date)date.value='';if(start)start.value='';if(end)end.value=''}
          refresh();
        };
        workshop?.addEventListener('change',rebuildCalendar);
        calendar?.addEventListener('change',()=>{
          const d=bundle.calendar.find(x=>x.id===calendar.value),date=card.querySelector('[name="scheduled_date"]'),start=card.querySelector('[name="start_time"]'),end=card.querySelector('[name="end_time"]'),loc=card.querySelector('[name="location_type"]'),other=card.querySelector('[name="location_other"]');
          if(d){date.value=d.scheduled_date||'';start.value=String(d.start_time||'').slice(0,5);end.value=String(d.end_time||'').slice(0,5);if(d.location_type)loc.value=d.location_type;if(d.location_other)other.value=d.location_other}
          refresh();
        });
        modeEl?.addEventListener('change',()=>{
          const atypical=modeEl.value==='atypical',plannedWrap=card.querySelector('[data-cfdh-planned-date-wrap]'),atypicalWrap=card.querySelector('[data-cfdh-atypical-wrap]');
          plannedWrap?.classList.toggle('hidden',atypical);atypicalWrap?.classList.toggle('hidden',!atypical);
          const date=card.querySelector('[name="scheduled_date"]'),start=card.querySelector('[name="start_time"]'),end=card.querySelector('[name="end_time"]');
          for(const el of [date,start,end])if(el){el.readOnly=!atypical;if(atypical&&el===date&&calendar)calendar.value=''}
          refresh();
        });
        card.querySelector('[name="planned_duration_hours"]')?.addEventListener('input',e=>{
          const pill=card.querySelector('[data-cfdh-count-status]'),ok=Number(e.target.value||0)>=2;
          if(pill){pill.textContent=ok?'Contabilizável':'Menos de 2h';pill.className='pill '+(ok?'success':'warn')}
          refresh();
        });
        card.addEventListener('input',refresh);card.addEventListener('change',refresh);
      });
    };
    const renderActions=(actions)=>{
      const d={...bundle,plan:collectPlan(),workshop_ids:collectPlan().plan_type==='cfdh_transversal'?selectedWorkshopIds():[],actions};
      bundle.workshop_ids=d.workshop_ids;
      actionsBox.innerHTML=actions.map((a,i)=>cfdhActionEditorCard(d,{...a,action_number:i+1},i)).join('');
      bindActionCards();refresh();
    };
    const resizeActions=()=>{
      const wanted=Math.max(1,Math.min(60,Number(planForm.querySelector('[data-cfdh-action-count]')?.value||1))),current=collectActions();
      if(current.length<wanted){
        for(let i=current.length;i<wanted;i++)current.push({action_number:i+1,title:'Ação '+(i+1),planned_duration_hours:2,schedule_mode:collectPlan().plan_type==='cfdh_estrutural'?'structural':'workshop_planned',scheduled_date:'',start_time:'',end_time:'',nucleus_code:'',axis_code:'',item_code:null});
      }else if(current.length>wanted){
        const removed=current.slice(wanted);
        if(removed.some(x=>x.id&&['realizada','parcial'].includes(bundle.actions.find(a=>a.id===x.id)?.execution_status))){toast('Ação já executada não pode ser removida.','danger');planForm.querySelector('[data-cfdh-action-count]').value=current.length;return}
        current.splice(wanted);
      }
      renderActions(current);
    };
    if(!bundle.actions.length)resizeActions(); else bindActionCards();

    planForm.querySelector('[data-cfdh-action-count]')?.addEventListener('change',resizeActions);
    planForm.querySelector('[data-cfdh-type]')?.addEventListener('change',e=>{
      const structural=e.target.value==='cfdh_estrutural';
      document.querySelector('[data-cfdh-workshops-block]')?.classList.toggle('hidden',structural);
      if(structural)planForm.querySelectorAll('[name="cfdh_workshop_id"]').forEach(x=>x.checked=false);
      const actions=collectActions().map(a=>({...a,workshop_id:structural?null:a.workshop_id,schedule_mode:structural?'structural':(a.schedule_mode==='structural'?'workshop_planned':a.schedule_mode),workshop_calendar_id:structural?null:a.workshop_calendar_id}));
      renderActions(actions);
    });
    planForm.querySelectorAll('[name="cfdh_workshop_id"]').forEach(x=>x.addEventListener('change',()=>{
      const selected=selectedWorkshopIds(),actions=collectActions().map(a=>selected.includes(a.workshop_id)?a:{...a,workshop_id:null,workshop_calendar_id:null,scheduled_date:a.schedule_mode==='atypical'?a.scheduled_date:'',start_time:a.schedule_mode==='atypical'?a.start_time:'',end_time:a.schedule_mode==='atypical'?a.end_time:''});
      renderActions(actions);
    }));
    planForm.querySelector('[data-cfdh-auto-distribute]')?.addEventListener('click',()=>{
      const selected=selectedWorkshopIds();
      if(!selected.length){toast('Selecione ao menos uma oficina antes de distribuir.','warn');return}
      const used=new Map(),actions=collectActions().map((a,i)=>{
        const workshop_id=selected[i%selected.length],available=bundle.calendar.filter(x=>x.workshop_id===workshop_id),idx=used.get(workshop_id)||0,d=available[idx]||null;used.set(workshop_id,idx+1);
        if(d)return {...a,workshop_id,schedule_mode:'workshop_planned',workshop_calendar_id:d.id,scheduled_date:d.scheduled_date,start_time:String(d.start_time||'').slice(0,5),end_time:String(d.end_time||'').slice(0,5),location_type:d.location_type||a.location_type,location_other:d.location_other||a.location_other};
        return {...a,workshop_id,schedule_mode:'atypical',workshop_calendar_id:null,scheduled_date:'',start_time:'',end_time:''};
      });
      renderActions(actions);
      toast('Ações distribuídas entre oficinas e datas disponíveis. Complete os dias atípicos sinalizados.');
    });
    document.querySelector('[data-toggle-cfdh-plan-preview]')?.addEventListener('click',e=>{workspace?.classList.toggle('preview-open');e.currentTarget.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
    planForm.addEventListener('input',refresh);planForm.addEventListener('change',refresh);
    planForm.addEventListener('submit',async e=>{
      e.preventDefault();
      if(!planForm.reportValidity())return;
      const draft=draftBundle(),alerts=cfdhPlanAlerts(draft).filter(x=>!/avaliação|presença nominal|relatório/i.test(x));
      const blocking=alerts.filter(x=>!/menor que 2h|Distribuição sugerida/i.test(x));
      if(blocking.length){toast('Complete as pendências do planejamento antes de salvar.','danger');refresh();return}
      const btn=planForm.querySelector('[type="submit"]'),original=btn.textContent;btn.disabled=true;btn.textContent='Salvando e sincronizando...';
      try{
        const saved=await saveCfdhPlanBundle(planId,{plan:draft.plan,workshop_ids:draft.workshop_ids,actions:draft.actions});
        toast('Planejamento CFDH salvo e sincronizado');
        nav('cfdh?month='+month+'&plan='+planId);await render();
      }catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=original}
    });
    refresh();
  }

  document.querySelectorAll('[data-cfdh-plan-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';try{await downloadCfdhPlan(btn.dataset.cfdhPlanPdf,'pdf');toast('PDF do planejamento CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-plan-docx]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';try{await downloadCfdhPlan(btn.dataset.cfdhPlanDocx,'docx');toast('DOCX do planejamento CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-plan-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{const b=await getCfdhPlanBundle(btn.dataset.cfdhPlanPrint),themes=await listCfdhThemes(),classification=await listMethodologyClassificationCatalog();b.themes=themes;b.classification=classification;openPrintableDocument('Planejamento CFDH · '+(b.plan.activity_title||''),cfdhPlanPreviewHtml(b))}catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-cfdh-execute]').forEach(btn=>btn.addEventListener('click',()=>{
    const a=bundle.actions.find(x=>x.id===btn.dataset.cfdhExecute);if(!a)return;
    modal('Execução · Ação '+a.action_number,'<form id="cfdh-execution-form" class="stack"><div class="notice info"><b>'+esc(a.title||'Ação CFDH')+'</b><br>'+fmtDate(a.scheduled_date)+' · planejado '+Number(a.planned_duration_hours||0).toLocaleString('pt-BR')+'h.</div><div class="field"><label>Situação da execução</label><select name="execution_status"><option value="realizada" '+(a.execution_status==='realizada'?'selected':'')+'>Realizada</option><option value="parcial" '+(a.execution_status==='parcial'?'selected':'')+'>Parcial</option><option value="cancelada" '+(a.execution_status==='cancelada'?'selected':'')+'>Cancelada</option></select></div><div class="form-grid three"><div class="field"><label>Data real</label><input class="input" type="date" name="actual_date" value="'+esc(a.actual_date||a.scheduled_date||'')+'"></div><div class="field"><label>Início real</label><input class="input" type="time" name="actual_start" value="'+esc(String(a.actual_start||a.start_time||'').slice(0,5))+'"></div><div class="field"><label>Término real</label><input class="input" type="time" name="actual_end" value="'+esc(String(a.actual_end||a.end_time||'').slice(0,5))+'"></div></div><div class="field"><label>Duração real (h)</label><input class="input" type="number" min="0" step="0.25" name="actual_duration_hours" value="'+esc(a.actual_duration_hours??a.planned_duration_hours??'')+'"><small>Menos de 2h fica registrado, mas não entra na contagem operacional mínima configurada.</small></div><div class="field"><label>Descrição do que foi executado</label><textarea name="execution_description" required>'+esc(a.execution_description||'')+'</textarea></div><div class="field"><label>Observações / diferenças do planejado</label><textarea name="execution_notes">'+esc(a.execution_notes||'')+'</textarea></div><button class="btn primary">Salvar execução</button></form>');
    document.querySelector('#cfdh-execution-form')?.addEventListener('submit',async e=>{e.preventDefault();try{await updateCfdhActionExecution(a.id,parseForm(e.target));document.querySelector('#modal')?.remove();toast('Execução CFDH registrada');await render()}catch(err){toast(err.message,'danger')}});
  }));

  document.querySelectorAll('[data-cfdh-open-checkin]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const x=await openCfdhCheckin(btn.dataset.cfdhOpenCheckin),url=new URL('checkin.html',location.href);url.searchParams.set('cfdh',x.public_token);
      modal('Lista de presença · CFDH','<div class="stack"><div class="notice success"><b>Lista CFDH aberta.</b><br>Somente jovens com pelo menos Formulário Inicial parcial podem participar. Quem ainda não possuir trajetória poderá iniciar o Formulário Inicial parcial e se inscrever no circuito pela própria lista.</div><input class="input" value="'+esc(url.href)+'" readonly data-cfdh-checkin-url><div class="actions"><a class="btn primary" href="'+esc(url.href)+'" target="_blank">Abrir lista</a><button class="btn secondary" data-copy-cfdh-checkin>Copiar link</button></div></div>');
      document.querySelector('[data-copy-cfdh-checkin]')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(url.href);toast('Link CFDH copiado')});
    }catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-cfdh-list-preview]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const s=await getCfdhAttendanceSheet(btn.dataset.cfdhListPreview);
      modal('Pré-visualização · Lista CFDH','<div class="methodology-preview-modal">'+methodologyAttendancePreviewHtml({activity:(s.activity||'CFDH')+' · '+(s.action_title||''),location:s.location,date:s.date,start_time:String(s.start_time||'').slice(0,5),end_time:String(s.end_time||'').slice(0,5),participants:s.participants||[]})+'</div>');document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }catch(err){toast(err.message,'danger')}
  }));
  const exportCfdhList=async(actionId,format,btn)=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{const sub=await createCfdhAttendanceSubmission(actionId);await downloadFormSubmission(sub.id,format);toast(String(format).toUpperCase()+' da lista CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  };
  document.querySelectorAll('[data-cfdh-list-pdf]').forEach(btn=>btn.addEventListener('click',()=>exportCfdhList(btn.dataset.cfdhListPdf,'pdf',btn)));
  document.querySelectorAll('[data-cfdh-list-docx]').forEach(btn=>btn.addEventListener('click',()=>exportCfdhList(btn.dataset.cfdhListDocx,'docx',btn)));
  document.querySelectorAll('[data-cfdh-list-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{const s=await getCfdhAttendanceSheet(btn.dataset.cfdhListPrint);openPrintableDocument('Lista CFDH · '+(s.action_title||''),methodologyAttendancePreviewHtml({activity:(s.activity||'CFDH')+' · '+(s.action_title||''),location:s.location,date:s.date,start_time:String(s.start_time||'').slice(0,5),end_time:String(s.end_time||'').slice(0,5),participants:s.participants||[]}))}catch(err){toast(err.message,'danger')}
  }));

  const reportForm=document.querySelector('#cfdh-report-editor');
  if(reportForm){
    const preview=document.querySelector('[data-cfdh-report-preview]'),workspace=document.querySelector('[data-cfdh-report-workspace]');
    const refresh=()=>{if(preview)preview.innerHTML=cfdhReportPreviewHtml(bundle,cfdhReportDraft(bundle,reportForm))};
    reportForm.addEventListener('input',refresh);reportForm.addEventListener('change',refresh);
    document.querySelector('[data-toggle-cfdh-report-preview]')?.addEventListener('click',e=>{workspace?.classList.toggle('preview-open');e.currentTarget.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
    reportForm.addEventListener('submit',async e=>{e.preventDefault();const btn=reportForm.querySelector('[type="submit"]'),o=btn.textContent;btn.disabled=true;btn.textContent='Salvando...';try{await createEducatorReport(cfdhReportDraft(bundle,reportForm));toast('Relatório CFDH salvo');nav('cfdh?month='+month+'&plan='+planId+'&view=relatorio');await render()}catch(err){toast(err.message,'danger');btn.disabled=false;btn.textContent=o}});
    refresh();
  }
  document.querySelectorAll('[data-cfdh-report-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadCfdhReport(btn.dataset.cfdhReportPdf,'pdf');toast('PDF do relatório CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-report-docx]').forEach(btn=>btn.addEventListener('click',async()=>{const o=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadCfdhReport(btn.dataset.cfdhReportDocx,'docx');toast('DOCX do relatório CFDH gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=o}}));
  document.querySelectorAll('[data-cfdh-report-print]').forEach(btn=>btn.addEventListener('click',()=>openPrintableDocument('Relatório CFDH · '+(bundle.plan.activity_title||''),cfdhReportPreviewHtml(bundle,reportForm?cfdhReportDraft(bundle,reportForm):bundle.report))));
}

async function bindEducatorPageV2(){
  const monthEl=document.querySelector('[data-educator-filter-month]'),userEl=document.querySelector('[data-educator-filter-user]'),view=route().params.get('view')||'responsabilidades';if(!monthEl&&!document.querySelector('[data-educator-new]')&&!document.querySelector('[data-new-educator-plan]'))return;
  const apply=()=>{const p=new URLSearchParams();if(monthEl?.value)p.set('month',monthEl.value);if(userEl?.value)p.set('user',userEl.value);p.set('view',view);nav('educador?'+p.toString())};monthEl?.addEventListener('change',apply);userEl?.addEventListener('change',apply);
  const filterUser=route().params.get('user'),planUser=filterUser==='all'?null:(filterUser||state.user?.id||null);
  const [youth,workshops,provisional,plans]=await Promise.all([listYouth(''),listWorkshops(),listProvisionalPeople(),listEducatorPlans(route().params.get('month')||currentMonth(),planUser)]);
  const reportForm=document.querySelector('#workshop-monthly-report-form');
  if(reportForm){
    const planId=reportForm.dataset.planId;
    try{
      const bundle=await getWorkshopMonthlyReportBundle(planId),preview=document.querySelector('[data-workshop-report-preview]'),workspace=document.querySelector('[data-workshop-report-workspace]'),toggle=document.querySelector('[data-toggle-workshop-report-preview]');
      const refresh=()=>{if(preview)preview.innerHTML=workshopReportPreviewHtml(bundle,workshopReportDraft(bundle,reportForm))};
      reportForm.addEventListener('input',refresh);reportForm.addEventListener('change',refresh);
      toggle?.addEventListener('click',()=>{workspace?.classList.toggle('preview-open');toggle.textContent=workspace?.classList.contains('preview-open')?'Ocultar':'Abrir prévia'});
      reportForm.addEventListener('submit',async e=>{
        e.preventDefault();
        const btn=reportForm.querySelector('[type="submit"]'),original=btn?.textContent;
        if(btn){btn.disabled=true;btn.textContent='Salvando...'}
        try{
          const payload=workshopReportDraft(bundle,reportForm);
          const saved=await saveWorkshopMonthlyReport(payload);
          toast('Relatório salvo e vinculado à execução registrada');
          const q=new URLSearchParams(route().params);q.set('report',planId);nav('educador?'+q.toString());await render();
        }catch(err){toast(err.message,'danger');if(btn){btn.disabled=false;btn.textContent=original||'Salvar relatório'}}
      });
      refresh();
    }catch(err){toast(err.message,'danger')}
  }

  document.querySelectorAll('[data-workshop-report-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyReport(btn.dataset.workshopReportPdf,'pdf');toast('PDF do relatório gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-workshop-report-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyReport(btn.dataset.workshopReportDocx,'docx');toast('DOCX do relatório gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-workshop-report-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const bundle=await getWorkshopMonthlyReportBundle(btn.dataset.workshopReportPrint);
      let draft=bundle.report||workshopReportDraft(bundle);
      const active=document.querySelector('#workshop-monthly-report-form');
      if(active?.dataset.planId===btn.dataset.workshopReportPrint)draft=workshopReportDraft(bundle,active);
      openPrintableDocument('Relatório · '+(bundle.workshop?.name||'Oficina'),workshopReportPreviewHtml(bundle,draft));
    }catch(err){toast(err.message,'danger')}
  }));

  const referralButtons=document.querySelectorAll('[data-referral-preview],[data-referral-pdf],[data-referral-docx],[data-referral-print]');
  if(referralButtons.length){
    const [team,receipts,monthRecords]=await Promise.all([listTeam(),listEducatorReferralReceipts(),listEducatorRecords(route().params.get('month')||currentMonth(),planUser)]);
    const teamMap=new Map(team.map(x=>[x.id,x])),youthMap=new Map(youth.map(x=>[x.id,x])),workshopMap=new Map(workshops.map(x=>[x.id,x]));
    const findRecord=id=>monthRecords.find(x=>x.id===id);
    document.querySelectorAll('[data-referral-preview]').forEach(btn=>btn.addEventListener('click',()=>{
      const rec=findRecord(btn.dataset.referralPreview);if(!rec)return;
      modal('Pré-visualização do encaminhamento','<div class="methodology-preview-modal">'+educatorReferralPreviewHtml(rec,receipts,teamMap,youthMap,workshopMap)+'</div>');
      document.querySelector('#modal .modal')?.classList.add('modal-wide');
    }));
    document.querySelectorAll('[data-referral-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
      const original=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadEducatorReferral(btn.dataset.referralPdf,'pdf');toast('PDF do encaminhamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
    }));
    document.querySelectorAll('[data-referral-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
      const original=btn.textContent;btn.disabled=true;btn.textContent='...';try{await downloadEducatorReferral(btn.dataset.referralDocx,'docx');toast('DOCX do encaminhamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
    }));
    document.querySelectorAll('[data-referral-print]').forEach(btn=>btn.addEventListener('click',()=>{
      const rec=findRecord(btn.dataset.referralPrint);if(!rec)return;
      openPrintableDocument('Encaminhamento · '+(rec.title||'Educador'),educatorReferralPreviewHtml(rec,receipts,teamMap,youthMap,workshopMap));
    }));
  }

  document.querySelectorAll('[data-educator-new]').forEach(btn=>btn.addEventListener('click',()=>{const initial=btn.dataset.educatorNew||'acolhimento_educativo',types=['acolhimento_educativo','demanda_identificada','encaminhamento_interno','acompanhamento_oficina','mediacao_convivencia','ficaadica_orientacao','trampo_labpoca','mobilizacao','evento_programacao','passeio_visita','atividade_externa','mostra','estudo_caso','outra_acao_educativa'];modal('Registrar contribuicao do Educador',`<form id="educator-record-form" class="stack"><div class="form-grid"><div class="field"><label>Data</label><input class="input" type="date" name="record_date" value="${new Date().toISOString().slice(0,10)}" required></div><div class="field"><label>Tipo ${eduGoalInfo(initial)}</label><select name="record_type" required>${types.map(k=>`<option value="${k}" ${k===initial?'selected':''}>${esc(eduTypeLabel(k))}</option>`).join('')}</select></div></div><div class="field"><label>Jovem / participante ${eduGoalInfo('cadastro')}</label>${eduPersonSearchHtml()}<small>A busca filtra em tempo real e elimina nomes nao compativeis.</small></div><div class="field"><label>Oficina relacionada</label><select name="workshop_id"><option value="">Nenhuma</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>Titulo / sintese</label><input class="input" name="title"></div><div class="field"><label>Descricao objetiva</label><textarea name="description" required></textarea></div><div class="form-grid"><div class="field"><label>Duracao em horas</label><input class="input" type="number" name="duration_hours" min="0" max="24" step="0.25" value="0"></div><div class="field"><label>Nº de participantes</label><input class="input" type="number" name="participants_count" min="0"></div></div><div class="field"><label>Encaminhar para ${eduGoalInfo('encaminhamento_interno')}</label><select name="referral_target"><option value="">Sem encaminhamento</option><option value="equipe_tecnica">Equipe Tecnica</option><option value="coordenacao">Coordenacao Geral</option><option value="articulacao">Articulacao</option><option value="administrativo">Administrativo</option><option value="oficina">Oficineiro da oficina</option><option value="rede_externa">Orientacao para rede externa</option></select><small>O destinatario recebe as especificidades e a ciencia volta ao Educador ao visualizar.</small></div><div class="field"><label>Evidencia / referencia</label><input class="input" name="evidence_ref"></div><div class="field"><label>Observacao interna</label><textarea name="notes"></textarea></div><button class="btn primary">Salvar contribuicao</button></form>`);const form=document.querySelector('#educator-record-form');bindEduPersonSearch(form,youth,provisional);decorateEduGoalForm(form,initial);form?.querySelector('[name="record_type"]')?.addEventListener('change',e=>decorateEduGoalForm(form,e.target.value));form?.addEventListener('submit',async e=>{e.preventDefault();const p=parseForm(e.target);if(['demanda_identificada','encaminhamento_interno'].includes(p.record_type)&&!p.youth_id&&!p.provisional_person_id){toast('Selecione o jovem/participante.','danger');return}try{await createEducatorRecord(p);document.querySelector('#modal')?.remove();toast(p.referral_target?'Registro salvo e encaminhamento enviado':'Contribuicao registrada');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelector('[data-new-educator-plan]')?.addEventListener('click',()=>{modal('Novo planejamento',`<form id="educator-plan-form" class="stack"><div class="field"><label>Tipo</label><select name="plan_type" required><option value="evento">Evento / programação</option></select></div><div class="field"><label>Oficina vinculada</label><select name="workshop_id"><option value="">Nao se aplica</option>${workshops.filter(w=>w.active).map(w=>`<option value="${w.id}">${esc(w.name)}</option>`).join('')}</select></div><div class="field"><label>ATIVIDADE / titulo</label><input class="input" name="activity_title" required></div><div class="field"><label>DESCRICAO / objetivo</label><textarea name="description_objective" required></textarea></div><div class="form-grid"><div class="field"><label>Nucleo</label><input class="input" name="nucleus"></div><div class="field"><label>Eixo</label><input class="input" name="axis"></div></div><div class="form-grid"><div class="field"><label>Nº de jovens previsto</label><input class="input" type="number" name="expected_participants" min="0"></div><div class="field"><label>Duracao prevista (h)</label><input class="input" type="number" step="0.25" name="planned_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial</label><input class="input" type="date" name="planned_start"></div><div class="field"><label>Data final</label><input class="input" type="date" name="planned_end"></div></div><div class="field"><label>Equipe prevista</label><input class="input" name="team_text"></div><div class="field"><label>Parceiros</label><input class="input" name="partners"></div><div class="field"><label>Mobilizacao / divulgacao planejada</label><textarea name="mobilization_plan"></textarea></div><div class="field"><label>Acoes planejadas</label><textarea name="planned_actions"></textarea></div><div class="field"><label>Resultados esperados</label><textarea name="expected_results"></textarea></div><div class="field"><label>Recursos necessarios</label><textarea name="resources"></textarea></div><div class="notice">Planejamento nao contabiliza execucao ate que o relatorio ou a sessao seja registrado.</div><button class="btn primary">Salvar planejamento</button></form>`);const planForm=document.querySelector('#educator-plan-form');decorateEduGoalForm(planForm,'evento_programacao');planForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorPlan(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Planejamento salvo');await render()}catch(err){toast(err.message,'danger')}})});

  document.querySelectorAll('[data-edu-workshop-plan-open]').forEach(btn=>btn.addEventListener('click',()=>{
    const month=route().params.get('month')||currentMonth();
    nav('oficinas?view=planejamento&month='+month+'&plan='+btn.dataset.eduWorkshopPlanOpen);
  }));
  document.querySelectorAll('[data-edu-workshop-plan-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanPdf,'pdf');toast('PDF do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='Gerando...';
    try{await downloadWorkshopMonthlyPlan(btn.dataset.eduWorkshopPlanDocx,'docx');toast('DOCX do planejamento gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-workshop-plan-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorWorkshopPlan(btn.dataset.eduWorkshopPlanPrint)}catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-edu-list-pdf]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListPdf,'pdf');toast('PDF da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-docx]').forEach(btn=>btn.addEventListener('click',async()=>{
    const original=btn.textContent;btn.disabled=true;btn.textContent='...';
    try{await downloadWorkshopPlannedAttendance(btn.dataset.eduListDocx,'docx');toast('DOCX da lista de presença gerado')}catch(err){toast(err.message,'danger')}finally{btn.disabled=false;btn.textContent=original}
  }));
  document.querySelectorAll('[data-edu-list-print]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{await printEducatorPlannedAttendance(btn.dataset.plan,btn.dataset.eduListPrint)}catch(err){toast(err.message,'danger')}
  }));


  document.querySelectorAll('[data-workshop-monthly-report]').forEach(btn=>btn.addEventListener('click',async()=>{
    try{
      const planId=btn.dataset.workshopMonthlyReport;
      const [planBundle,reports,ws]=await Promise.all([getWorkshopMonthlyPlan(planId),listWorkshopMonthlyReports(),listWorkshops()]);
      const plan=planBundle.plan,workshop=ws.find(x=>x.id===plan.workshop_id)||{},existing=reports.find(x=>x.plan_id===planId)||{};
      let html='<form id="workshop-monthly-report-form" class="stack"><input type="hidden" name="plan_id" value="'+planId+'">';
      html+='<div class="notice info"><b>'+esc(workshop.name||'Oficina')+'</b><br>Relatório vinculado ao planejamento de '+esc(String(plan.plan_month||'').slice(0,7).split('-').reverse().join('/'))+'.</div>';
      html+='<div class="form-grid"><div class="field"><label>Data do relatório</label><input class="input" type="date" name="report_date" value="'+esc(existing.report_date||new Date().toISOString().slice(0,10))+'" required></div><div class="field"><label>Situação da execução</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Não realizado</option></select></div></div>';
      html+='<div class="field"><label>Descrição do que foi executado</label><textarea name="actual_description" required>'+esc(existing.actual_description||'')+'</textarea></div>';
      html+='<div class="form-grid"><div class="field"><label>Participantes alcançados</label><input class="input" type="number" min="0" name="actual_participants" value="'+esc(existing.actual_participants??'')+'"></div><div class="field"><label>Carga horária executada</label><input class="input" type="number" min="0" step="0.25" name="actual_duration_hours" value="'+esc(existing.actual_duration_hours??'')+'"></div></div>';
      html+='<div class="field"><label>Pontos positivos</label><textarea name="positive_points">'+esc(existing.positive_points||'')+'</textarea></div><div class="field"><label>Dificuldades</label><textarea name="difficulties">'+esc(existing.difficulties||'')+'</textarea></div><div class="field"><label>Ações realizadas / ajustes</label><textarea name="actions_performed">'+esc(existing.actions_performed||'')+'</textarea></div><div class="field"><label>Justificativa, quando parcial ou não realizado</label><textarea name="justification">'+esc(existing.justification||'')+'</textarea></div><div class="field"><label>Evidência / referência</label><input class="input" name="evidence_ref" value="'+esc(existing.evidence_ref||'')+'"></div><button class="btn primary">Salvar relatório da oficina</button></form>';
      modal('Relatório mensal da oficina',html);
      const form=document.querySelector('#workshop-monthly-report-form');
      if(form?.querySelector('[name="execution_status"]'))form.querySelector('[name="execution_status"]').value=existing.execution_status||'realizado';
      form?.addEventListener('submit',async e=>{e.preventDefault();try{await saveWorkshopMonthlyReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatório da oficina salvo');await render()}catch(err){toast(err.message,'danger')}});
    }catch(err){toast(err.message,'danger')}
  }));

  document.querySelectorAll('[data-report-plan]').forEach(btn=>btn.addEventListener('click',()=>{const p=plans.find(x=>x.id===btn.dataset.reportPlan);if(!p)return;modal('Relatorio de execucao',`<form id="educator-report-form" class="stack"><input type="hidden" name="plan_id" value="${p.id}"><div class="notice"><b>${esc(p.activity_title)}</b><br>Planejado: ${esc(p.description_objective||'')}<br>${fmtDate(p.planned_start)} · ${p.expected_participants??'—'} jovens · ${p.planned_duration_hours||0}h</div><div class="field"><label>Situacao</label><select name="execution_status"><option value="realizado">Realizado</option><option value="parcial">Parcial</option><option value="nao_realizado">Nao realizado</option></select></div><div class="field"><label>DESCRICAO do que efetivamente aconteceu</label><textarea name="actual_description" required></textarea></div><div class="form-grid"><div class="field"><label>Nº real de jovens</label><input class="input" type="number" name="actual_participants" min="0"></div><div class="field"><label>Duracao real (h)</label><input class="input" type="number" step="0.25" name="actual_duration_hours" min="0"></div></div><div class="form-grid"><div class="field"><label>Data inicial real</label><input class="input" type="date" name="actual_start" value="${esc(p.planned_start||'')}"></div><div class="field"><label>Data final real</label><input class="input" type="date" name="actual_end" value="${esc(p.planned_end||p.planned_start||'')}"></div></div><div class="field"><label>MOBILIZACAO / divulgacao realizada</label><textarea name="mobilization_actual"></textarea></div><div class="field"><label>PONTOS POSITIVOS</label><textarea name="positive_points"></textarea></div><div class="field"><label>PONTOS NEGATIVOS</label><textarea name="negative_points"></textarea></div><div class="field"><label>ACOES realizadas</label><textarea name="actions_performed"></textarea></div><div class="field"><label>Justificativa (parcial/nao realizado)</label><textarea name="justification"></textarea></div><div class="field"><label>Evidencias</label><input class="input" name="evidence_ref"></div><button class="btn primary">Salvar relatorio</button></form>`);const reportForm=document.querySelector('#educator-report-form');decorateEduGoalForm(reportForm,p.plan_type==='cfdh_transversal'?'cfdh_transversal':p.plan_type==='cfdh_estrutural'?'cfdh_estrutural':p.plan_type==='evento'?'evento_programacao':'acompanhamento_oficina');reportForm?.addEventListener('submit',async e=>{e.preventDefault();try{await createEducatorReport(parseForm(e.target));document.querySelector('#modal')?.remove();toast('Relatorio salvo');await render()}catch(err){toast(err.message,'danger')}})}));
  document.querySelectorAll('[data-educator-delete]').forEach(btn=>btn.addEventListener('click',async()=>{if(!confirm('Excluir este registro?'))return;try{await deleteEducatorRecord(btn.dataset.educatorDelete);toast('Registro excluido');await render()}catch(err){toast(err.message,'danger')}}));

}
