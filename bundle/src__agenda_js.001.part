
function technicianChecklist(data,selected=[]){
  const technical=data.profiles.filter(x=>TECH_ROLES.includes(x.role));
  return `<div class="check-grid tech-select-grid">${technical.map(p=>`<label class="check"><input type="checkbox" name="technician_ids" value="${p.id}" ${selected.includes(p.id)?'checked':''}><span><b>${esc(p.display_name)}</b><small>${esc(roleLabel(p.role))}</small></span></label>`).join('')}</div>`;
}
function locationFields(selected='crj',details=''){
  return `<div class="field"><label>Local</label><select name="location_type" data-location-select required><option value="crj" ${selected==='crj'?'selected':''}>CRJ</option><option value="visita_domiciliar" ${selected==='visita_domiciliar'?'selected':''}>Visita domiciliar</option><option value="outro" ${selected==='outro'?'selected':''}>Outro</option></select></div><div class="field ${selected==='outro'?'':'hidden'}" data-location-other><label>Descreva o local</label><input class="input" name="location_details" value="${esc(details||'')}" placeholder="Informe onde será realizado"></div>`;
}
function bindLocationFields(root=document){
  const select=root.querySelector?.('[data-location-select]');
  const other=root.querySelector?.('[data-location-other]');
  if(!select||!other)return;
  const sync=()=>{const show=select.value==='outro';other.classList.toggle('hidden',!show);const inp=other.querySelector('[name="location_details"]');if(inp)inp.required=show};
  select.addEventListener('change',sync);sync();
}
function requestForm(data,prefill={}){
  const technical=data.profiles.filter(x=>TECH_ROLES.includes(x.role));
  const specific=Boolean(prefill.user);
  return `<form id="agenda-request-form" class="stack">
    <div class="field"><label>Jovem</label><select name="youth_id"><option value="">Sem jovem vinculado</option>${data.youth.map(y=>`<option value="${y.id}" ${prefill.youth===y.id?'selected':''}>${esc(yname(y))} — ${esc(y.neighborhood||'')}</option>`).join('')}</select></div>
    <div class="form-grid"><div class="field"><label>Tipo</label><select name="request_type" required><option value="atendimento">Atendimento</option><option value="reuniao">Reunião</option><option value="estudo_caso">Estudo de caso</option><option value="acao">Outra ação</option><option value="outra">Outra</option></select></div><div class="field"><label>Enviar solicitação para</label><select name="target_mode" data-target-mode><option value="all" ${specific?'':'selected'}>Toda a Equipe Técnica</option><option value="specific" ${specific?'selected':''}>Um profissional específico</option></select></div></div>
    <div class="field ${specific?'':'hidden'}" data-specific-tech><label>Profissional específico</label><select name="target_user_id"><option value="">Selecione</option>${technical.map(p=>`<option value="${p.id}" ${prefill.user===p.id?'selected':''}>${esc(p.display_name)} — ${esc(roleLabel(p.role))}</option>`).join('')}</select><small>Quando direcionada a um profissional específico, somente ele poderá responder.</small></div>
    <div class="field"><label>Título / motivo</label><input class="input" name="title" required placeholder="Ex.: Atendimento inicial, reunião, estudo de caso"></div>
    <div class="form-grid three-time"><div class="field"><label>Dia</label><input class="input" type="date" name="date" value="${esc(prefill.date||'')}" required></div><div class="field"><label>Horário inicial</label><input class="input" type="time" name="start_time" value="${esc(prefill.start||'')}" required></div><div class="field"><label>Horário final</label><input class="input" type="time" name="end_time" value="${esc(prefill.end||'')}" required></div></div>
    <div class="form-grid">${locationFields('crj','')}</div>
    <div class="field"><label>Descrição opcional</label><textarea name="details" placeholder="Informação objetiva para organizar a agenda. Evite conteúdo técnico sensível."></textarea></div>
    <button class="btn primary">Enviar solicitação</button>
  </form>`;
}
function directForm(data,user,prefill={}){
  const selected=prefill.technicians?.length?prefill.technicians:[user.id];
  return `<form id="agenda-direct-form" class="stack">
    <div class="field"><label>Jovem</label><select name="youth_id" ${prefill.event_id?'disabled':''}><option value="">Sem jovem vinculado</option>${data.youth.map(y=>`<option value="${y.id}" ${prefill.youth===y.id?'selected':''}>${esc(yname(y))} — ${esc(y.neighborhood||'')}</option>`).join('')}</select></div>
    <div class="field"><label>Tipo</label><select name="event_type" ${prefill.event_id?'disabled':''} required><option value="atendimento" ${prefill.event_type==='atendimento'?'selected':''}>Atendimento</option><option value="reuniao" ${prefill.event_type==='reuniao'?'selected':''}>Reunião</option><option value="estudo_caso" ${prefill.event_type==='estudo_caso'?'selected':''}>Estudo de caso</option><option value="acao_externa" ${prefill.event_type==='acao_externa'?'selected':''}>Ação externa</option><option value="demanda" ${prefill.event_type==='demanda'?'selected':''}>Demanda</option><option value="outra" ${prefill.event_type==='outra'?'selected':''}>Outra</option></select></div>
    <div class="field"><label>Responsável(is) pelo atendimento</label><small>Marque um profissional para atendimento individual ou adicione outro técnico para atendimento conjunto.</small>${technicianChecklist(data,selected)}</div>
    <div class="field"><label>Título</label><input class="input" name="title" value="${esc(prefill.title||'')}" required></div>
    <div class="form-grid three-time"><div class="field"><label>Dia</label><input class="input" type="date" name="date" value="${esc(prefill.date||'')}" required></div><div class="field"><label>Horário inicial</label><input class="input" type="time" name="start_time" value="${esc(prefill.start_time||'')}" required></div><div class="field"><label>Horário final</label><input class="input" type="time" name="end_time" value="${esc(prefill.end_time||'')}" required></div></div>
    <div class="form-grid">${locationFields(prefill.location_type||'crj',prefill.location_details||'')}</div>
    <div class="field"><label>Descrição opcional</label><textarea name="description" placeholder="Informação objetiva para agenda.">${esc(prefill.description||'')}</textarea></div>
    <button class="btn primary">${prefill.event_id?'Salvar alteração / adiamento':'Confirmar agendamento'}</button>
  </form>`;
}
function responseForm(requestId,mode,date,start,end,techId=''){
  const isReject=mode==='reject';
  return `<form class="stack" data-response-form="${mode}" data-request-id="${requestId}" data-tech-id="${techId}">
    ${isReject?'':`<div class="form-grid three-time"><div class="field"><label>Dia</label><input class="input" type="date" name="date" value="${esc(date||'')}" required></div><div class="field"><label>Horário inicial</label><input class="input" type="time" name="start_time" value="${esc(start||'')}" required></div><div class="field"><label>Horário final</label><input class="input" type="time" name="end_time" value="${esc(end||'')}" required></div></div>`}
    <div class="field"><label>${isReject?'Justificativa da recusa':'Justificativa / observação opcional'}</label><textarea name="justification" ${isReject?'required':''}></textarea></div>
    <button class="btn primary">${isReject?'Confirmar recusa':'Enviar contraproposta'}</button>
  </form>`;
}
async function rpc(name,args){
  const c=await db(),{data,error}=await c.rpc(name,args);
  if(error)throw error;return data;
}
function selectedTechIds(form){
  return [...form.querySelectorAll('[name="technician_ids"]:checked')].map(x=>x.value);
}
function bindTargetMode(form){
  const mode=form.querySelector('[data-target-mode]'),box=form.querySelector('[data-specific-tech]');
  if(!mode||!box)return;
  const sync=()=>{const specific=mode.value==='specific';box.classList.toggle('hidden',!specific);const s=box.querySelector('[name="target_user_id"]');if(s)s.required=specific};
  mode.addEventListener('change',sync);sync();
}

export async function bindAgendaPage(user,{toast,rerender}){
  const data=window.__CRJ_AGENDA_DATA__;
  if(!data)return;
  const c=await db();

  document.querySelector('#agenda-filter')?.addEventListener('submit',e=>{
    e.preventDefault();const fd=new FormData(e.target),p=new URLSearchParams();
    for(const k of ['team','user','type','from','to']){const v=fd.get(k);if(v)p.set(k,v)}
    location.hash='agenda?'+p.toString();
  });
  document.querySelectorAll('[data-week]').forEach(b=>b.addEventListener('click',()=>{
    const p=params();p.set('from',b.dataset.week);p.set('to',dateISO(addDays(new Date(b.dataset.week+'T12:00:00'),6)));location.hash='agenda?'+p.toString();
  }));

  const openRequest=(prefill={})=>{
    modal('Solicitar atendimento / ação da Equipe Técnica',requestForm(data,prefill));
    const form=document.querySelector('#agenda-request-form');
    bindTargetMode(form);bindLocationFields(form);
    form?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(e.target);
      if(fd.get('end_time')<=fd.get('start_time')){toast('O horário final deve ser posterior ao inicial.','danger');return}
      try{
        await rpc('agenda_create_request_v2',{
          p_youth_id:fd.get('youth_id')||null,
          p_request_type:fd.get('request_type'),
          p_title:fd.get('title'),
          p_details:fd.get('details')||null,
          p_target_mode:fd.get('target_mode'),
          p_target_user_id:fd.get('target_mode')==='specific'?(fd.get('target_user_id')||null):null,
          p_start:toIso(fd.get('date'),fd.get('start_time')),
          p_end:toIso(fd.get('date'),fd.get('end_time')),
          p_location_type:fd.get('location_type'),
          p_location_details:fd.get('location_details')||null
        });
        document.querySelector('#agenda-modal')?.remove();toast('Solicitação enviada à Equipe Técnica');await rerender();
      }catch(err){toast(err.message,'danger')}
    });
  };
  document.querySelector('[data-agenda-action="request"]')?.addEventListener('click',()=>openRequest());
  document.querySelectorAll('[data-slot-user]').forEach(b=>b.addEventListener('click',()=>openRequest({user:b.dataset.slotUser,date:b.dataset.slotDate,start:b.dataset.slotStart,end:b.dataset.slotEnd})));

  const openDirect=(prefill={})=>{
    modal(prefill.event_id?'Editar / adiar agendamento':'Agendamento direto da Equipe Técnica',directForm(data,user,prefill));
    const form=document.querySelector('#agenda-direct-form');
    bindLocationFields(form);
    form?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(e.target),techIds=selectedTechIds(e.target);
      if(!techIds.length){toast('Selecione pelo menos um técnico responsável.','danger');return}
      if(fd.get('end_time')<=fd.get('start_time')){toast('O horário final deve ser posterior ao inicial.','danger');return}
      try{
        if(prefill.event_id){
          await rpc('agenda_update_event_v2',{
            p_event_id:prefill.event_id,
            p_title:fd.get('title'),
            p_description:fd.get('description')||null,
            p_technician_ids:techIds,
            p_start:toIso(fd.get('date'),fd.get('start_time')),
            p_end:toIso(fd.get('date'),fd.get('end_time')),
            p_location_type:fd.get('location_type'),
            p_location_details:fd.get('location_details')||null,
            p_note:'Alteração registrada pela Equipe Técnica'
          });
          toast('Agendamento atualizado');
        }else{
          await rpc('agenda_create_direct_event_v2',{
            p_youth_id:fd.get('youth_id')||null,
            p_event_type:fd.get('event_type'),
            p_title:fd.get('title'),
            p_description:fd.get('description')||null,
            p_technician_ids:techIds,
            p_start:toIso(fd.get('date'),fd.get('start_time')),
            p_end:toIso(fd.get('date'),fd.get('end_time')),
            p_location_type:fd.get('location_type'),
            p_location_details:fd.get('location_details')||null
          });
          toast('Agendamento confirmado');
        }
        document.querySelector('#agenda-modal')?.remove();await rerender();
      }catch(err){toast(err.message,'danger')}
    });
  };
  document.querySelector('[data-agenda-action="direct"]')?.addEventListener('click',()=>openDirect());

  document.querySelector('[data-agenda-action="availability"]')?.addEventListener('click',()=>{
    modal('Definir disponibilidade fixa',`<form id="availability-form" class="stack"><div class="field"><label>Dia da semana</label><select name="weekday">${WEEKDAYS.map((d,i)=>`<option value="${i}">${d}</option>`).join('')}</select></div><div class="form-grid"><div class="field"><label>Início</label><input class="input" type="time" name="start_time" required></div><div class="field"><label>Fim</label><input class="input" type="time" name="end_time" required></div></div><div class="field"><label>Duração padrão dos horários</label><select name="slot_minutes"><option value="30">30 min</option><option value="45">45 min</option><option value="60" selected>60 min</option><option value="90">90 min</option><option value="120">120 min</option></select></div><button class="btn primary">Salvar disponibilidade</button></form>`);
    document.querySelector('#availability-form')?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(e.target);
      if(fd.get('end_time')<=fd.get('start_time')){toast('O horário final deve ser posterior ao inicial.','danger');return}
      const {error}=await c.from('staff_availability').insert({
        user_id:user.id,weekday:Number(fd.get('weekday')),start_time:fd.get('start_time'),
        end_time:fd.get('end_time'),slot_minutes:Number(fd.get('slot_minutes')),
        valid_from:dateISO(new Date()),valid_until:null
      });
      if(error){toast(error.message,'danger');return}
      document.querySelector('#agenda-modal')?.remove();toast('Disponibilidade salva');await rerender();
    });
  });

  document.querySelector('[data-agenda-action="exception"]')?.addEventListener('click',()=>{
    modal('Adicionar excepcionalidade',`<form id="exception-form" class="stack"><div class="form-grid"><div class="field"><label>Dia</label><input class="input" type="date" name="exception_date" value="${dateISO(new Date())}" required></div><div class="field"><label>Tipo</label><select name="exception_type"><option value="ausencia">Ausência</option><option value="acao_externa">Ação externa</option><option value="demanda">Demanda</option><option value="outra">Outra</option></select></div></div><label class="check"><input type="checkbox" name="all_day" value="1"><span>Dia inteiro</span></label><div class="form-grid"><div class="field"><label>Horário inicial</label><input class="input" type="time" name="start_time"></div><div class="field"><label>Horário final</label><input class="input" type="time" name="end_time"></div></div><div class="field"><label>Título opcional</label><input class="input" name="title"></div><div class="field"><label>Descrição opcional</label><textarea name="description"></textarea></div><label class="check"><input type="checkbox" name="blocks_schedule" value="1" checked><span>Bloquear este período para novos agendamentos</span></label><button class="btn primary">Salvar excepcionalidade</button></form>`);
    document.querySelector('#exception-form')?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(e.target),all=fd.get('all_day')==='1';
      if(!all&&(!fd.get('start_time')||!fd.get('end_time'))){toast('Informe os horários ou marque dia inteiro.','danger');return}
      if(!all&&fd.get('end_time')<=fd.get('start_time')){toast('O horário final deve ser posterior ao inicial.','danger');return}
      const {error}=await c.from('schedule_exceptions').insert({
        user_id:user.id,exception_date:fd.get('exception_date'),exception_type:fd.get('exception_type'),
        all_day:all,start_time:all?null:fd.get('start_time'),end_time:all?null:fd.get('end_time'),
        title:fd.get('title')||null,description:fd.get('description')||null,
        blocks_schedule:fd.get('blocks_schedule')==='1'
      });
      if(error){toast(error.message,'danger');return}
      document.querySelector('#agenda-modal')?.remove();toast('Excepcionalidade salva');await rerender();
    });
  });

  document.querySelectorAll('[data-delete-availability]').forEach(b=>b.addEventListener('click',async()=>{
    if(!confirm('Remover este horário fixo?'))return;
    const {error}=await c.from('staff_availability').delete().eq('id',b.dataset.deleteAvailability);
    if(error)toast(error.message,'danger');else{toast('Horário removido');await rerender()}
  }));
  document.querySelectorAll('[data-delete-exception]').forEach(b=>b.addEventListener('click',async()=>{
    if(!confirm('Remover esta excepcionalidade?'))return;
    const {error}=await c.from('schedule_exceptions').delete().eq('id',b.dataset.deleteException);
    if(error)toast(error.message,'danger');else{toast('Excepcionalidade removida');await rerender()}
  }));

  document.querySelectorAll('[data-tech-approve]').forEach(b=>b.addEventListener('click',async()=>{
    if(!confirm('Confirmar este atendimento na sua agenda?'))return;
    try{
      await rpc('agenda_technical_respond_v2',{p_request_id:b.dataset.techApprove,p_action:'approve',p_start:null,p_end:null,p_justification:null});
      toast('Sua participação foi confirmada');await rerender();
    }catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-tech-reject]').forEach(b=>b.addEventListener('click',()=>{
    modal('Recusar solicitação',responseForm(b.dataset.techReject,'reject','','','',user.id));bindTechnicalResponse();
  }));
  document.querySelectorAll('[data-tech-counter]').forEach(b=>b.addEventListener('click',()=>{
    const r=data.requests.find(x=>x.id===b.dataset.techCounter),t=targetFor(data,r.id,user.id),p=localParts(t?.proposed_start||r.current_start),e=localParts(t?.proposed_end||r.current_end);
    modal('Sugerir outro horário',responseForm(r.id,'counter',p.date,p.time,e.time,user.id));bindTechnicalResponse();
  }));
  function bindTechnicalResponse(){
    const form=document.querySelector('[data-response-form]');if(!form)return;
    form.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(form),mode=form.dataset.responseForm;
      try{
        await rpc('agenda_technical_respond_v2',{
          p_request_id:form.dataset.requestId,p_action:mode,
          p_start:mode==='counter'?toIso(fd.get('date'),fd.get('start_time')):null,
          p_end:mode==='counter'?toIso(fd.get('date'),fd.get('end_time')):null,
          p_justification:fd.get('justification')||null
        });
        document.querySelector('#agenda-modal')?.remove();toast(mode==='reject'?'Sua recusa foi registrada':'Contraproposta enviada');await rerender();
      }catch(err){toast(err.message,'danger')}
    });
  }

  document.querySelectorAll('[data-target-accept]').forEach(b=>b.addEventListener('click',async()=>{
    if(!confirm('Aceitar o horário sugerido por este profissional?'))return;
    try{
      await rpc('agenda_requester_reply_target',{p_request_id:b.dataset.targetAccept,p_technician_user_id:b.dataset.tech,p_action:'accept',p_start:null,p_end:null,p_justification:null});
      toast('Horário confirmado com este profissional');await rerender();
    }catch(err){toast(err.message,'danger')}
  }));
  document.querySelectorAll('[data-target-counter]').forEach(b=>b.addEventListener('click',()=>{
    const r=data.requests.find(x=>x.id===b.dataset.targetCounter),t=targetFor(data,r.id,b.dataset.tech),sp=localParts(t?.proposed_start||r.current_start),ep=localParts(t?.proposed_end||r.current_end);
    modal('Propor outro horário para este profissional',responseForm(r.id,'requester-counter',sp.date,sp.time,ep.time,b.dataset.tech));
    const form=document.querySelector('[data-response-form]');
    form?.addEventListener('submit',async e=>{
      e.preventDefault();const fd=new FormData(form);
      try{
        await rpc('agenda_requester_reply_target',{
          p_request_id:r.id,p_technician_user_id:b.dataset.tech,p_action:'counter',
          p_start:toIso(fd.get('date'),fd.get('start_time')),p_end:toIso(fd.get('date'),fd.get('end_time')),
          p_justification:fd.get('justification')||null
        });
        document.querySelector('#agenda-modal')?.remove();toast('Nova proposta enviada somente para este profissional');await rerender();
      }catch(err){toast(err.message,'danger')}
    });
  }));
  document.querySelectorAll('[data-target-cancel]').forEach(b=>b.addEventListener('click',async()=>{
    if(!confirm('Encerrar a solicitação somente para este profissional? Os demais aceites e solicitações serão mantidos.'))return;
    try{
      await rpc('agenda_requester_reply_target',{
        p_request_id:b.dataset.targetCancel,p_technician_user_id:b.dataset.tech,p_action:'cancel',
        p_start:null,p_end:null,p_justification:'Encerrado pelo solicitante para este profissional'
      });
      toast('Solicitação encerrada apenas para este profissional');await rerender();
    }catch(err){toast(err.message,'danger')}
  }));

  const openEvent=eventId=>{
    const event=data.events.find(x=>x.id===eventId);
    if(!event){toast('Agendamento não encontrado neste período.','danger');return}
    modal(event.title,eventDetailHtml(data,event,user));
    document.querySelector('[data-edit-event]')?.addEventListener('click',()=>{
      const ev=data.events.find(x=>x.id===eventId),sp=localParts(ev.starts_at),ep=localParts(ev.ends_at);
      openDirect({
        event_id:ev.id,youth:ev.youth_id,event_type:ev.event_type,title:ev.title,
        date:sp.date,start_time:sp.time,end_time:ep.time,
        location_type:ev.location_type||'crj',location_details:ev.location_details||'',
        description:ev.description||'',technicians:eventTechIds(data,ev.id)
      });
    });
    document.querySelector('[data-cancel-event]')?.addEventListener('click',()=>{
      modal('Cancelar agendamento',`<form id="cancel-event-form" class="stack"><div class="notice warn">O cancelamento ficará registrado no histórico do compromisso e notificará os envolvidos.</div><div class="field"><label>Justificativa opcional</label><textarea name="justification"></textarea></div><button class="btn danger">Confirmar cancelamento</button></form>`);
      document.querySelector('#cancel-event-form')?.addEventListener('submit',async e=>{
        e.preventDefault();const fd=new FormData(e.target);
        try{
          await rpc('agenda_cancel_event_v2',{p_event_id:eventId,p_justification:fd.get('justification')||null});
          document.querySelector('#agenda-modal')?.remove();toast('Agendamento cancelado');await rerender();
        }catch(err){toast(err.message,'danger')}
      });
    });
  };
  document.querySelectorAll('[data-open-event]').forEach(b=>b.addEventListener('click',()=>openEvent(b.dataset.openEvent)));

  document.querySelector('[data-mark-notifications]')?.addEventListener('click',async()=>{
    const {error}=await c.from('staff_notifications').update({read_at:new Date().toISOString()}).is('read_at',null);
    if(error)toast(error.message,'danger');else{toast('Notificações marcadas como lidas');await rerender()}
  });

  const quick=params();
  const quickMode=quick.get('new'),quickYouth=quick.get('youth');
  if(quickMode==='request'){
    openRequest({youth:quickYouth||''});
  }else if(quickMode==='direct'&&isTech(user)){
    openDirect({youth:quickYouth||''});
  }
  if(quickMode){
    quick.delete('new');quick.delete('youth');
    history.replaceState(null,'','#agenda'+(quick.toString()?'?'+quick.toString():''));
  }
}
