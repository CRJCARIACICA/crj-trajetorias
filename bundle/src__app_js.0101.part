
// CRUD mensal global — base, navegação e edição de documentos.
(()=>{
const GMC_ROUTES=new Set(['dashboard','jovens','jovem','formularios','formulario','oficinas','oficina','educador','cfdh','equipe-tecnica','agenda','metas','lancamento-geral','equipe','controlador-acesso','articulacao']);
const GMC_FORM_LABELS={'formulario-inicial':'Formulário Inicial','lista-presenca-contato':'Lista de Presença e Contato','acompanhamento':'Acompanhamento','pvida':'PVida','outras-demandas':'Outras Demandas','ptrampo':'PTrampo','avaliacao-atividades':'Avaliação das Atividades','relatorio-mobilizacao':'Relatório de Mobilização','emprestimo':'Empréstimo','emprestimo-canhoto':'Canhoto de Empréstimo','cfdh-planejamento':'CFDH — Planejamento','cfdh-avaliacao-jovens':'CFDH — Avaliação Jovens','cfdh-avaliacao-equipe':'CFDH — Avaliação Equipe'};
const gmcEsc=(v='')=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const gmcNowMonth=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).format(new Date());
let gmcScheduled=false,gmcProfile=null;
function gmcClient(){return apiMode()==='live'?supabaseClient():null}
function gmcRoute(){const raw=(location.hash||'#dashboard').slice(1),[path,q='']=raw.split('?');return {parts:path.split('/').filter(Boolean),params:new URLSearchParams(q)}}
function gmcTop(){return gmcRoute().parts[0]||'dashboard'}
function gmcMonth(){return gmcRoute().params.get('month')||gmcNowMonth()}
function gmcRange(m=gmcMonth()){const [y,mo]=m.split('-').map(Number);return {start:`${y}-${String(mo).padStart(2,'0')}-01`,end:new Date(Date.UTC(y,mo,1)).toISOString().slice(0,10)}}
function gmcShift(m,d){const [y,mo]=m.split('-').map(Number),x=new Date(Date.UTC(y,mo-1+d,1));return `${x.getUTCFullYear()}-${String(x.getUTCMonth()+1).padStart(2,'0')}`}
function gmcSetMonth(m){const r=gmcRoute();r.params.set('month',m);location.hash=`#${r.parts.join('/')}${r.params.toString()?'?'+r.params.toString():''}`}
function gmcTarget(raw){if(!raw||/^https?:/i.test(raw))return raw;const clean=String(raw).replace(/^#/,'');const [path,q='']=clean.split('?'),parts=path.split('/').filter(Boolean);if(!GMC_ROUTES.has(parts[0]||''))return raw;const p=new URLSearchParams(q);if(!p.has('month'))p.set('month',gmcMonth());return `${path}?${p.toString()}`}
function gmcToast(m,t='success'){try{toast(m,t)}catch(e){console.warn(m,e)}}
async function gmcResolveProfile(){for(let i=0;i<60&&apiMode()!=='live';i++)await new Promise(r=>setTimeout(r,100));if(!gmcClient())return;const {data:{user}}=await gmcClient().auth.getUser();if(!user)return;const q=await gmcClient().from('profiles').select('id,role,active').eq('id',user.id).maybeSingle();if(q.error)throw q.error;gmcProfile=q.data||null}
function gmcStyle(){if(document.querySelector('#global-month-crud-style'))return;const s=document.createElement('style');s.id='global-month-crud-style';s.textContent=`.gmc-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;border:1px solid #d6e4df;background:#f8fbfa;border-radius:14px;padding:10px 12px;margin-bottom:14px}.gmc-month{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.gmc-toolbar small{display:block;color:var(--muted,#687671)}.gmc-panel{border:1px solid #dce6e3;background:#fff;border-radius:14px;padding:13px;margin:14px 0}.gmc-list{display:grid;gap:8px;margin-top:10px}.gmc-row{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border:1px solid #e4ebe8;border-radius:11px;padding:10px;background:#fbfdfc}.gmc-row span,.gmc-row small{display:block}.gmc-row small{color:var(--muted,#687671)}.gmc-actions{display:flex;gap:6px;flex-wrap:wrap}.gmc-danger{border-color:#e3b8b8!important;color:#913737!important}.gmc-trash{border-style:dashed;background:#fffdf8}.gmc-edit-banner{margin-bottom:12px}.gmc-tech-trash{margin-top:10px;padding-top:10px;border-top:1px dashed #d5dfdc}@media(max-width:700px){.gmc-row{display:grid}.gmc-month{width:100%}}`;document.head.appendChild(s)}
function gmcToolbar(){const r=gmcTop();if(!GMC_ROUTES.has(r)||['formulario','jovem','oficina'].includes(r))return;const c=document.querySelector('.content');if(!c||c.querySelector('[data-gmc-toolbar]'))return;const master=['jovens','equipe'].includes(r),d=document.createElement('div');d.className='gmc-toolbar';d.dataset.gmcToolbar='1';d.innerHTML=`<div><b>Mês de referência</b><small>${master?'Cadastro-base permanente; atividades e contribuições usam o mês selecionado.':'Criar, editar, excluir e consultar registros dentro do período selecionado.'}</small></div><div class="gmc-month"><button class="btn" data-gmc-prev>‹</button><input class="input" type="month" data-gmc-month value="${gmcEsc(gmcMonth())}"><button class="btn" data-gmc-next>›</button><button class="btn secondary" data-gmc-now>Mês atual</button></div>`;c.prepend(d);d.querySelector('[data-gmc-prev]').onclick=()=>gmcSetMonth(gmcShift(gmcMonth(),-1));d.querySelector('[data-gmc-next]').onclick=()=>gmcSetMonth(gmcShift(gmcMonth(),1));d.querySelector('[data-gmc-now]').onclick=()=>gmcSetMonth(gmcNowMonth());d.querySelector('[data-gmc-month]').onchange=e=>gmcSetMonth(e.target.value)}
function gmcPreserve(){document.querySelectorAll('.sidebar a[href^="#"]').forEach(a=>{const x=gmcTarget(a.getAttribute('href'));a.setAttribute('href','#'+x)});document.querySelectorAll('[data-nav]').forEach(x=>{if(x.dataset.nav)x.dataset.nav=gmcTarget(x.dataset.nav)})}
function gmcFormObject(f){const fd=new FormData(f),o={};for(const [k,v] of fd.entries()){if(o[k]!==undefined)o[k]=Array.isArray(o[k])?[...o[k],v]:[o[k],v];else o[k]=v}f.querySelectorAll('input[type=checkbox]').forEach(i=>{if(!(i.name in o))o[i.name]=[]});return o}
function gmcApplyValues(f,v){for(const [n,val] of Object.entries(v||{})){const nodes=[...f.querySelectorAll(`[name="${CSS.escape(n)}"]`)];for(const x of nodes){if(x.type==='checkbox'){const a=Array.isArray(val)?val.map(String):[String(val??'')];x.checked=a.includes(String(x.value))}else if(x.type==='radio')x.checked=String(x.value)===String(val??'');else x.value=val??''}}f.dispatchEvent(new Event('input',{bubbles:true}));f.dispatchEvent(new Event('change',{bubbles:true}))}
async function gmcSubmissionEdit(){const r=gmcRoute(),id=r.params.get('submission');if(r.parts[0]!=='formulario'||!id||!gmcClient())return;const f=document.querySelector('#dynamic-form');if(!f||f.dataset.gmcSubmissionEdit)return;const q=await gmcClient().from('methodology_form_submissions').select('id,payload').eq('id',id).maybeSingle();if(q.error||!q.data)return;f.dataset.gmcSubmissionEdit='1';gmcApplyValues(f,q.data.payload||{});const card=f.querySelector('.methodology-form-editor');if(card){const b=document.createElement('div');b.className='notice warn gmc-edit-banner';b.innerHTML='<b>Editando registro existente.</b><br>Salvar altera este mesmo item e não cria uma duplicata.';card.prepend(b)}f.addEventListener('submit',async e=>{e.preventDefault();e.stopImmediatePropagation();const u=await gmcClient().from('methodology_form_submissions').update({payload:gmcFormObject(f),updated_at:new Date().toISOString()}).eq('id',id).select('id').maybeSingle();if(u.error)return gmcToast(u.error.message,'danger');gmcToast('Documento atualizado');location.hash=`#formularios?month=${gmcMonth()}`},true)}
