mpanhar'}</span></div>`}

async function pageYouth(){
  const q=route().params.get('q')||''; const rows=await listYouth(q);
  return `<div class="page-head"><div><h2>Jovens</h2><p>Um cadastro central para acompanhar toda a trajetória dentro do CRJ.</p></div><div class="actions"><button class="btn primary" data-nav="novo-jovem">+ Novo jovem</button></div></div>
  <form id="search-youth" class="toolbar"><input class="input search" name="q" value="${esc(q)}" placeholder="Buscar por nome ou bairro"><button class="btn">Buscar</button></form>
  <div class="table-wrap"><table class="table"><thead><tr><th>Jovem</th><th>Idade</th><th>Bairro</th><th>Situação</th><th></th></tr></thead><tbody>${
    rows.map(y=>`<tr>
      <td><div class="name">${esc(y.preferred_name||y.full_name)}</div><div class="muted">${esc(y.full_name)}</div></td>
      <td>${age(y.birth_date)}</td>
      <td>${esc(y.neighborhood||'—')}</td>
      <td><div class="stack" style="gap:5px"><span class="pill success">${esc(y.status||'ativo')}</span><span class="pill ${y.initial_form_status==='provisorio'?'warn':'info'}">${y.initial_form_status==='provisorio'?`Formulário Inicial parcial · ${(y.initial_form_pending_fields||[]).length} pendência(s)`:'Formulário Inicial completo'}</span></div></td>
      <td><button class="btn ${y.initial_form_status==='provisorio'?'primary':''}" data-nav="jovem/${y.id}">${y.initial_form_status==='provisorio'?'Completar trajetória':'Abrir trajetória'}</button></td>
    </tr>`).join('')||`<tr><td colspan="5" class="empty">Nenhum jovem encontrado.</td></tr>`
  }</tbody></table></div>`;
}

async function pageNewYouth(){
  const provisionalId=route().params.get('provisional');
  let values={};
  if(provisionalId){
    const p=await getProvisionalPerson(provisionalId);
    if(p) values={full_name:p.full_name||'',birth_date:p.birth_date||'',cpf:p.cpf||'',email:p.email||'',phone:p.phone||'',neighborhood:p.neighborhood||''};
  }
  return formPageHtml(FORM_MAP['formulario-inicial'],null,true,values,false);
}

function technicalWriter(){
  return ['coordenacao_geral','assistente_social','psicologo','terapeuta_ocupacional'].includes(state.user?.role);
}
function isTechnicalForm(slug){
  return ['acompanhamento','pvida','ptrampo','outras-demandas'].includes(slug);
}
function isCfdhSharedForm(slug){
  return ['cfdh-planejamento','cfdh-avaliacao-jovens'].includes(slug);
}
function isWorkshopEducationForm(slug){
  return ['avaliacao-atividades','cfdh-avaliacao-equipe'].includes(slug);
}
function canWriteMethodologyForm(slug){
  if(isTechnicalForm(slug))return technicalWriter();
  if(isCfdhSharedForm(slug))return permitted('cfdh_shared');
  if(isWorkshopEducationForm(slug))return permitted('workshop_education_docs');
  return true;
}
async function youthPrefill(youthId){
  const [{core,demographics},forms]=await Promise.all([getYouth(youthId),listFormSubmissions(youthId)]);
  const initial=forms.find(x=>x.form_slug==='formulario-inicial');
  return {...(initial?.payload||{}),...(demographics||{}),...(core||{})};
}
function technicalSystemFields(form,youthId,values={}){
  if(!youthId || !isTechnicalForm(form.slug)) return '';
  return `<div class="section"><div class="section-title">Registro do atendimento no sistema</div><div class="notice" style="margin-bottom:14px">Este bloco organiza a abertura na trajetória e não substitui os campos oficiais do formulário metodológico.</div><div class="form-grid"><div class="field"><label>Data do atendimento</label><input class="input" type="date" name="_service_date" value="${esc(values._service_date||new Date().toISOString().slice(0,10))}" required></div><div class="field"><label>Duração aproximada (horas)</label><input class="input" type="number" min="0.25" step="0.25" name="_duration_hours" value="${esc(values._duration_hours||'1')}"></div><div class="field full"><label>Resumo da abertura / observação técnica</label><textarea name="_technical_note" placeholder="Resumo breve do atendimento, quando necessário.">${esc(values._technical_note||'')}</textarea></div></div></div>`;
}
function formPageHtml(form,youthId,isNew=false,values={},isEdit=false){
  const prefilled=youthId&&!isEdit?'<div class="notice" style="margin-bottom:16px">Os dados compatíveis foram pré-preenchidos a partir do cadastro do jovem. Revise antes de salvar. Alterar este formulário não altera automaticamente o cadastro-base.</div>':'';
  const editInfo=isEdit?'<div class="notice warn" style="margin-bottom:16px">Você está completando o mesmo Formulário Inicial do jovem. Ao salvar, o sistema atualiza a ficha, o Anexo 1 atual e recalcula automaticamente as pendências.</div>':'';
  return `<div class="page-head"><div><h2>${esc(form.title)} ${form.slug==='formulario-inicial'?eduGoalInfo('cadastro'):''}</h2><p>${esc(form.description)}</p></div><div class="actions"><button class="btn secondary" type="button" data-toggle-methodology-preview>Ocultar pré-visualização</button><button class="btn" data-back>Voltar</button></div></div>
  <form id="dynamic-form" data-slug="${form.slug}" data-youth="${youthId||''}" data-new="${isNew?'1':'0'}" data-edit="${isEdit?'1':'0'}" data-provisional="${isNew?(route().params.get('provisional')||''):''}">
    <div class="methodology-form-workspace preview-open" data-methodology-workspace>
      <div class="card methodology-form-editor">
        ${prefilled}${editInfo}${technicalSystemFields(form,youthId,values)}
        ${form.sections.map(s=>`<div class="section"><div class="section-title">${esc(s.title)}</div><div class="form-grid">${s.fields.map(f=>fieldHtml(f,values[f.key])).join('')}</div></div>`).join('')}
        <div class="actions" style="margin-top:22px"><button class="btn primary">${isEdit?'Salvar alterações':'Salvar documento'}</button></div>
      </div>
      <aside class="methodology-preview-pane" data-methodology-preview-pane>
        <div class="methodology-preview-toolbar"><div><b>Pré-visualização do anexo</b><span>Atualização em tempo real</span></div><span class="pill info">${esc(form.annex)}</span></div>
        <div class="methodology-preview-scroll" data-methodology-preview>${methodologyPreviewHtml(form,values)}</div>
      </aside>
    </div>
  </form>`;
}
async function pageEditYouth(id){
  if(!permitted('editar_cadastro')) return '<div class="notice danger">Seu perfil não possui permissão para editar o cadastro-base do jovem.</div>';
  const values=await youthPrefill(id);
  return formPageHtml(FORM_MAP['formulario-inicial'],id,false,values,true);
}
async function pageForm(slug,youthId){
  const f=FORM_MAP[slug];
  if(!f)return `<div class="notice danger">Formulário não encontrado.</div>`;
  if(!canWriteMethodologyForm(slug)){
    if(isCfdhSharedForm(slug))return '<div class="notice danger">Este documento de CFDH é compartilhado entre Educadores, Equipe Técnica e Coordenação Geral.</div>';
    if(isWorkshopEducationForm(slug))return '<div class="notice danger">Este documento de avaliação de oficina é exclusivo dos Educadores e da Coordenação Geral.</div>';
    return '<div class="notice danger">Este documento é restrito à Equipe Técnica e à Coordenação Geral.</div>';
  }
  if(f.youthRequired&&!youthId)return `<div class="page-head"><div><h2>${esc(f.title)}</h2><p>Este documento precisa estar vinculado a um jovem.</p></div></div><div class="notice">Abra a ficha do jovem em <b>Jovens → Abrir trajetória</b> e utilize uma das ações disponíveis.</div><div class="actions" style="margin-top:16px"><button class="btn primary" data-nav="jovens">Selecionar jovem</button></div>`;
  const values=youthId?await youthPrefill(youthId):{};
  if(slug==='lista-presenca-contato'&&route().params.get('context')==='uso-livre'){
    values.activity=values.activity||'Uso livre';
    values.date=values.date||new Date().toISOString().slice(0,10);
  }
  return formPageHtml(f,youthId,false,values,false);
}


const AUDIT_FIELD_LABELS={
  preferred_name:'Nome preferido',full_name:'Nome completo',birth_date:'Data de nascimento',cpf:'CPF',
  reference_person:'Pessoa de referência',reference_phone:'Telefone da referência',street:'Rua / endereço',
  address_extra:'Complemento / referência',neighborhood:'Bairro',municipality:'Município',housing:'Situação da moradia',
  household_size:'Pessoas no domicílio',phone:'Telefone',email:'E-mail',status:'Situação do cadastro',
  race:'Raça/cor',traditional_community:'Comunidade tradicional',traditional_community_which:'Qual comunidade tradicional',
  gender_identity:'Identidade de gênero',sexual_orientation:'Orientação sexual',disability:'Pessoa com deficiência',
  disability_which:'Deficiência informada',studies:'Estuda atualmente',last_grade:'Última série concluída',
  school_name:'Escola',school_grade:'Série/ano',education_level:'Nível de ensino',
  education_modality:'Modalidade de ensino',education_modality_other:'Outra modalidade',household_income:'Renda domiciliar',
  interests:'Interesses no CRJ',heard_from:'Como conheceu o CRJ',heard_from_other:'Outra origem',
  preferred_shifts:'Turnos de interesse',filled_by:'Responsável pelo preenchimento',
  title:'Título',details:'Descrição',event_type:'Tipo de evento',event_date:'Data do evento',visibility:'Visibilidade',
  form_slug:'Tipo de formulário',documento:'Documento',trajetoria:'Trajetória',cadastro:'Cadastro',perfil:'Perfil'
};
function auditFieldLabel(key){
  return AUDIT_FIELD_LABELS[key]||String(key||'Campo').replace(/^_/,'').replace(/_/g,' ').replace(/^./,x=>x.toUpperCase());
}
function auditValue(v){
  if(v===null||v===undefined||v==='')return 'vazio';
  if(Array.isArray(v))return v.length?v.join(', '):'vazio';
  if(typeof v==='object')return Object.entries(v).map(([k,x])=>`${auditFieldLabel(k)}: ${auditValue(x)}`).join(' · ');
  if(typeof v==='boolean')return v?'Sim':'Não';
  return String(v);
}
function auditEntityName(a){
  if(a.entity_type==='methodology_form_submissions') return FORM_MAP[a.entity_label]?.title||a.entity_label||'Documento metodológico';
  if(a.entity_type==='young_people') return 'Cadastro principal';
  if(a.entity_type==='youth_demographics') return 'Perfil sociodemográfico e interesses';
  if(a.entity_type==='journey_events') return a.entity_label||'Registro da trajetória';
  return a.entity_label||a.entity_type;
}
function auditChangesHtml(a){
  const entries=Object.entries(a.changed_fields||{});
  if(!entries.length)return '<div class="muted" style="margin-top:7px">Sem campos detalhados.</div>';
  return `<div style="display:grid;gap:7px;margin-top:10px">${entries.map(([key,change])=>{
    const before=change?.before,after=change?.after;
    if(a.action==='created') return `<div style="padding:8px 10px;background:#f7faf9;border:1px solid var(--line);border-radius:10px"><strong>${esc(auditFieldLabel(key))}</strong><span class="muted"> · ${esc(auditValue(after))}</span></div>`;
    return `<div style="padding:8px 10px;background:#f7faf9;border:1px solid var(--line);border-radius:10px"><strong>${esc(auditFieldLabel(key))}</strong><div class="muted" style="margin-top:4px"><span style="text-decoration:line-through">${esc(auditValue(before))}</span> → <span style="color:var(--ink);font-weight:700">${esc(auditValue(after))}</span></div></div>`;
  }).join('')}</div>`;
}


function journeyEventTitle(e){
  const raw=String(e?.title||'');
  if(raw.startsWith('Formulário: ')){
    const slug=raw.slice('Formulário: '.length).trim();
    return FORM_MAP[slug]?.title||raw;
  }
  return raw;
}

function auditTooltipHtml(a){
  const changes=Object.entries(a.changed_fields||{}).map(([key,change])=>{
    const before=auditValue(change?.before), after=auditValue(change?.after);
    return `<div class="audit-tooltip-change"><b>${esc(auditFieldLabel(key))}</b><span>${esc(before)} → ${esc(after)}</span></div>`;
  }).join('')||'<div class="muted">Sem detalhamento de campos.</div>';
  return `<span class="audit-hover" tabindex="0">✎ Alteração
    <span class="audit-tooltip" role="tooltip">
      <span class="audit-tooltip-title">${esc(auditEntityName(a))}</span>
      <span class="audit-tooltip-meta">${esc(a.actor_name||'Sistema')} · ${esc(roleLabel(a.actor_role))}</span>
      <span class="audit-tooltip-meta">${esc(fmtDateTime(a.event_at))}</span>
      <span class="audit-tooltip-list">${changes}</span>
    </span>
  </span>`;
}

async function pageYouthProfile(id){
  const [{core:y,demographics:d},timeline,forms,workshops,audit]=await Promise.all([
    getYouth(id),listTimeline(id),listFormSubmissions(id),listWorkshops(),listYouthAudit(id)
  ]);
  if(!y)return `<div class="notice danger">Jovem não encontrado.</div>`;
  const pendingCount=Array.isArray(y.initial_form_pending_fields)?y.initial_form_pending_fields.length:0;
  const initialPending=y.initial_form_status==='provisorio'?`<div class="notice warn" style="margin-bottom:16px"><b>Formulário Inicial provisório</b><br>Este jovem possui o próprio Formulário Inicial parcialmente preenchido. Há ${pendingCount} pendência(s) significativa(s). Complete o mesmo Anexo 1 para manter a trajetória sem duplicação.<div class="actions" style="margin-top:10px"><button class="btn primary" data-nav="editar-jovem/${id}">Completar Formulário Inicial</button></div></div>`:'';

  const auditEdits=audit.filter(a=>a.action==='updated');
  const journeyItems=[
    ...timeline.map(e=>({
      at:new Date(e.event_date).getTime(),
      html:`<div class="timeline-item"><div class="timeline-date">${fmtDate(e.event_date)}</div><div class="timeline-body"><strong>${esc(journeyEventTitle(e))}</strong><span class="muted">${esc(e.details||e.event_type||'')}</span></div></div>`
    })),
    ...auditEdits.map(a=>({
      at:new Date(a.event_at).getTime(),
      html:`<div class="timeline-item timeline-edit"><div class="timeline-date">${fmtDate(a.event_at)}</div><div class="timeline-body"><strong>${esc(auditEntityName(a))}</strong><div style="margin-top:6px">${auditTooltipHtml(a)}</div></div></div>`
    }))
  ].sort((a,b)=>b.at-a.at).map(x=>x.html).join('');

  const technicalActions=technicalWriter()?`<div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:14px"><div><h3 style="margin:0">Aberturas técnicas</h3><p>Registros vinculados ao jovem conforme os formulários da metodologia.</p></div><span class="pill info">Equipe Técnica</span></div><div class="actions"><button class="btn secondary" data-nav="formulario/acompanhamento/${id}">Acompanhamento</button><button class="btn secondary" data-nav="formulario/pvida/${id}">PVida</button><button class="btn secondary" data-nav="formulario/ptrampo/${id}">PTrampo</button><button class="btn secondary" data-nav="formulario/outras-demandas/${id}">Outras Demandas</button></div></div>`:'';

  const auditHtml=audit.map(a=>`<div style="padding:14px 0;border-bottom:1px solid var(--line)">
    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap">
      <div>
        <strong>${esc(auditEntityName(a))}</strong>
        <div class="muted" style="margin-top:3px">${esc(a.actor_name||'Sistema')} · ${esc(roleLabel(a.actor_role))}</div>
      </div>
      <div style="text-align:right">
        <span class="pill ${a.action==='updated'?'warn':'info'}">${a.action==='updated'?'Alterado':'Criado'}</span>
        <div class="muted" style="margin-top:5px;font-size:12px">${esc(fmtDateTime(a.event_at))}</div>
      </div>
    </div>
    ${auditChangesHtml(a)}
  </div>`).join('')||'<div class="empty">Ainda não há alterações registradas neste histórico.</div>';

  return `<div class="page-head"><div><h2>${esc(y.preferred_name||y.full_name)}</h2><p>${esc(y.full_name)} · ${age(y.birth_date)} anos · ${esc(y.neighborhood||'Bairro não informado')}</p></div><div class="actions">${permitted('editar_cadastro')?`<button class="btn" data-nav="editar-jovem/${id}">Editar cadastro</button>`:''}${permitted('agenda')?`<button class="btn secondary" data-nav="agenda?new=${['assistente_social','psicologo','terapeuta_ocupacional'].includes(state.user?.role)?'direct':'request'}&youth=${id}">${['assistente_social','psicologo','terapeuta_ocupacional'].includes(state.user?.role)?'Agendar atendimento':'Solicitar agenda técnica'}</button>`:''}${permitted('atendimentos')?'<button class="btn secondary" data-action="new-service">+ Atendimento</button>':''}<button class="btn primary" data-action="new-youth-form">+ Formulário</button></div></div>
  ${initialPending}
  <div class="grid three"><div class="card"><h3>Cadastro</h3><p><strong>Nascimento:</strong> ${fmtDate(y.birth_date)}</p><p><strong>CPF:</strong> ${esc(y.cpf||'—')}</p><p><strong>Bairro:</strong> ${esc(y.neighborhood||'—')}</p><p><strong>Município:</strong> ${esc(y.municipality||'—')}</p><p><strong>Contato:</strong> ${esc(y.phone||'—')}</p></div><div class="card"><h3>Perfil e interesses</h3>${d?`<p><strong>Raça/cor:</strong> ${esc(d.race||'—')}</p><p><strong>Escolaridade:</strong> ${esc(d.education_level||'—')}</p><p><strong>Interesses:</strong> ${esc((d.interests||[]).join(', ')||'—')}</p>`:`<p class="muted">Dados não preenchidos ou sem permissão de visualização.</p>`}</div><div class="card"><h3>Oficinas</h3><div class="stack">${workshops.map(w=>`<button class="btn" data-enroll="${w.id}">Inscrever em ${esc(w.name)} ${eduGoalInfo('inscricao_oficina')}</button>`).join('')||'<span class="muted">Nenhuma oficina cadastrada.</span>'}</div></div></div>
  ${technicalActions}
  <div class="grid two" style="margin-top:16px"><div class="card"><h3>Trajetória no CRJ</h3><div class="timeline">${journeyItems||'<div class="empty">Ainda não há eventos.</div>'}</div></div><div class="card"><h3>Documentos metodológicos</h3>${forms.map(f=>{const exportable=true;return `<div style="padding:10px 0;border-bottom:1px solid var(--line)"><div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start"><div><strong>${esc(FORM_MAP[f.form_slug]?.title||f.form_slug)}</strong><br><span class="muted">${fmtDate(f.submitted_at)}</span></div>${exportable?`<div class="actions"><button class="btn" data-download-form="${f.id}" data-format="pdf">PDF</button><button class="btn" data-download-form="${f.id}" data-format="docx">DOCX</button></div>`:''}</div></div>`}).join('')||'<div class="empty">Nenhum formulário vinculado.</div>'}</div></div>
  <div class="card" style="margin-top:16px"><div class="page-head" style="margin-bottom:4px"><div><h3 style="margin:0">Histórico de alterações</h3><p>Auditoria do cadastro, documentos e registros da trajetória. Mostra quem alterou, quando e quais itens mudaram.</p></div><span class="pill">${audit.length} registro(s)</span></div>${auditHtml}</div>`;
}

async function pageForms(){
  return `<div class="page-head"><div><h2>Formulários da Metodologia</h2><p>Os 13 anexos foram convertidos em formulários digitais. Documentos individuais devem ser abertos pela trajetória do jovem para reaproveitar o cadastro e manter o vínculo correto.</p></div></div><div class="grid three">${FORMS.map(f=>{
    const technical=isTechnicalForm(f.slug),cfdh=isCfdhSharedForm(f.slug),workshopEdu=isWorkshopEducationForm(f.slug),allowed=canWriteMethodologyForm(f.slug);
    let action='';
    if(f.slug==='formulario-inicial') action='<button class="btn primary" data-nav="novo-jovem">Cadastrar jovem</button>';
    else if(f.youthRequired) action=allowed?'<button class="btn primary" data-nav="jovens">Abrir pela trajetória</button>':'<button class="btn" disabled>Sem permissão para preencher</button>';
    else if(f.slug==='lista-presenca-contato') action='<div class="actions"><button class="btn primary" data-nav="formulario/lista-presenca-contato">Preencher lista</button><button class="btn secondary" data-nav="formulario/lista-presenca-contato?context=uso-livre">Uso livre</button></div>';
    else action=allowed?`<button class="btn primary" data-nav="formulario/${f.slug}">Preencher</button>`:'<button class="btn" disabled>Somente visualização / sem permissão</button>';
    return `<div class="card"><div class="actions"><span class="pill">${esc(f.annex)}</span>${technical?'<span class="pill info">Equipe Técnica</span>':''}${cfdh?'<span class="pill success">Educadores + Equipe Técnica</span>':''}${workshopEdu?'<span class="pill warn">Exclusivo Educadores</span>':''}</div><h3 style="margin-top:12px">${esc(f.title)}</h3><p class="muted">${esc(f.description)}</p>${action}</div>`;
  }).join('')}</div>`;
}


const WORKSHOP_WEEKDAYS=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
function workshopTypeLabel(v){return ({permanente:'Permanente',temporaria:'Temporária',pontual:'Pontual'})[v]||'Não definido'}
function workshopScheduleLabel(w){
  if(w?.schedule_mode==='semanal_fixa'){
    const days=(w.fixed_weekdays||[]).map(n=>WORKSHOP_WEEKDAYS[Number(n)]).filter(Boolean).join(', ');
    return 'Semanal fixa'+(days?' · '+days:'');
  }
  return 'Calendário flexível';
}
function workshopLocationLabel(w){
  if(!w)return 'Local não definido';
  if((w.location_type==='Outro'||w.location_type==='Externa')&&w.location_other)return w.location_type==='Externa'?'Externa · '+w.location_other:w.location_other;
  return w.location_type||'Local não definido';
}
function workshopPeriodLabel(w){
  if(w.workshop_type==='pontual')return w.planned_start_date?fmtDate(w.planned_start_date):'Data ainda não definida';
  if(w.planned_start_date&&w.planned_end_date)return fmtDate(w.planned_start_date)+' a '+fmtDate(w.planned_end_date);
  if(w.planned_start_date)return 'A partir de '+fmtDate(w.planned_start_date);
  return 'Período não definido';
}
function workshopTabs(view){
  return '<div class="tabs workshop-tabs">'+[
    ['oficinas','Oficinas'],['calendario','Calendário'],['planejamento','Planejamento'],['oficineiros','Oficineiros']
  ].map(x=>'<button class="tab '+(view===x[0]?'active':'')+'" data-nav="oficinas?view='+x[0]+'">'+x[1]+'</button>').join('')+'</div>';
}
function workshopCalendarGrid(entries,month){
  const [y,m]=month.split('-').map(Number);
  const first=new Date(Date.UTC(y,m-1,1)),last=new Date(Date.UTC(y,m,0));
  const mondayIndex=(first.getUTCDay()+6)%7;
  const cells=[];
  for(let i=0;i<mondayIndex;i++)cells.push('<div class="calendar-day outside"></div>');
  const byDate=new Map();
  for(const e of entries){
    const arr=byDate.get(e.scheduled_date)||[];arr.push(e);byDate.set(e.scheduled_date,arr);
  }
  for(let d=1;d<=last.getUTCDate();d++){
    const ds=y+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    const list=byDate.get(ds)||[];
    cells.push('<div class="calendar-day"><div class="calendar-day-number">'+d+'</div>'+
      list.map(e=>{
        const w=e.workshops||{};
        const loc=workshopLocationLabel({location_type:e.location_type||w.location_type,location_other:e.location_other||w.location_other});
        const cls=e.status==='realizada'?'done':e.status==='cancelada'?'cancelled':'planned';
        return '<div class="calendar-event '+cls+'"><b>'+esc(String(e.start_time||'').slice(0,5))+' '+esc(w.name||'Oficina')+'</b><span>'+esc(loc)+'</span><small>'+esc(e.status||'planejada')+'</small><div class="calendar-event-actions">'+
          (e.status==='planejada'?'<button class="btn ghost" data-calendar-session="'+e.id+'" data-workshop="'+e.workshop_id+'">Registrar aula</button><button class="btn ghost danger" data-calendar-cancel="'+e.id+'">Cancelar</button>':'')+
        '</div></div>';
      }).join('')+'</div>');
  }
  return '<div class="calendar-week-head">'+['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'].map(x=>'<div>'+x+'</div>').join('')+'</div><div class="calendar-month-grid">'+cells.join('')+'</div>';
}
function workshopInstructorEvidencePreviewHtml(i,month){
  const m=i.metrics||{};
  const rows=(i.recent_classes||[]).map(s=>'<tr><td>'+esc(fmtDate(s.session_date))+'</td><td>'+esc(s.workshop_name||'')+'</td><td>'+esc(String(s.start_time||'').slice(0,5))+'–'+esc(String(s.end_time||'').slice(0,5))+'</td><td>'+Number(s.duration_hours||0).toLocaleString('pt-BR')+'h</td><td>'+(s.confirmed?'Sim':'Não')+'</td><td>'+Number(s.attendance_count||0)+'</td></tr>').join('');
  const rec=(i.records||[]).slice(0,12).map(r=>'<div class="methodology-row"><b>'+esc(r.record_type==='solicitacao'?'Solicitação':r.record_type==='observacao_desempenho'?'Observação de desempenho':'Informação relevante')+' · '+esc(fmtDate(r.record_date))+'</b><div class="methodology-answer">'+esc(r.description||'')+(r.response?'<br><b>Retorno:</b> '+esc(r.response):'')+'</div></div>').join('');
  return '<div class="methodology-paper instructor-evidence-paper">'+
    '<div class="methodology-annex-title">CRJ CARIACICA · CONTROLE OPERACIONAL DE OFICINEIRO(A)</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div>'+
    '<div class="methodology-inner-title">RESUMO DE EXECUÇÃO DE OFICINEIRO(A)</div>'+
    '<div class="methodology-row"><b>1. Oficineiro(a):</b><span class="methodology-inline-answer">'+esc(i.display_name||'')+'</span></div>'+
    '<div class="methodology-row"><b>2. Período:</b><span class="methodology-inline-answer">'+esc(month.split('-').reverse().join('/'))+'</span></div>'+
    '<div class="methodology-row"><b>3. Oficinas vinculadas:</b><span class="methodology-inline-answer">'+esc((i.workshops||[]).map(w=>w.name).join(', ')||'Nenhuma')+'</span></div>'+
    '<table class="methodology-planning-table instructor-kpi-table"><thead><tr><th>Aulas registradas</th><th>Aulas com lista</th><th>Horas registradas</th><th>Horas comprovadas</th><th>Registros de participação</th><th>Acompanhamentos</th></tr></thead><tbody><tr><td>'+Number(m.classes_registered||0)+'</td><td>'+Number(m.classes_with_attendance||0)+'</td><td>'+Number(m.hours_registered||0).toLocaleString('pt-BR')+'h</td><td>'+Number(m.hours_confirmed||0).toLocaleString('pt-BR')+'h</td><td>'+Number(m.participation_records||0)+'</td><td>'+Number(m.workshop_followups||0)+'</td></tr></tbody></table>'+
    '<div class="methodology-section-title">RESUMO DE AULAS EXECUTADAS</div>'+
    '<table class="methodology-planning-table"><thead><tr><th>Data</th><th>Oficina</th><th>Horário</th><th>Carga</th><th>Lista</th><th>Participações</th></tr></thead><tbody>'+(rows||'<tr><td colspan="6">Nenhuma aula no período.</td></tr>')+'</tbody></table>'+
    '<div class="methodology-section-title">SOLICITAÇÕES E INFORMAÇÕES RELEVANTES</div>'+(rec||'<div class="methodology-row">Sem registros no período.</div>')+
    '<div class="methodology-system-note">Documento operacional preparado para futura geração de evidência. A carga horária comprovada considera aulas com ao menos um registro nominal em lista de presença.</div>'+
  '</div>';
}

function workshopLessonDurationHours(l){
  if(!l?.start_time||!l?.end_time)return 0;
  const a=String(l.start_time).slice(0,5).split(':').map(Number),b=String(l.end_time).slice(0,5).split(':').map(Number);
  return Math.max(0,((b[0]*60+b[1])-(a[0]*60+a[1]))/60);
}
function workshopPlanPreviewHtml(bundle,workshop,teamMap){
  const plan=bundle?.plan||{},lessons=(bundle?.lessons||[]).filter(x=>x.included!==false);
  const month=String(plan.plan_month||'').slice(0,7).split('-').reverse().join('/');
  const instructor=teamMap?.get(plan.instructor_user_id)||'Não definido';
  const educator=teamMap?.get(plan.educator_user_id)||'Não definido';
  const rows=lessons.map(l=>{
    const loc=workshopLocationLabel({location_type:l.location_type,location_other:l.location_other});
    return '<tr>'+
      '<td><b>Aula '+Number(l.lesson_number||0)+'</b><br>'+esc(fmtDate(l.scheduled_date))+'<br>'+esc(String(l.start_time||'').slice(0,5))+'–'+esc(String(l.end_time||'').slice(0,5))+'<br><small>'+esc(loc)+'</small></td>'+
      '<td>'+esc(l.theme||('Aula '+l.lesson_number))+'</td>'+
      '<td>'+esc(l.objective||'')+'</td>'+
      '<td>'+esc(l.proposed_activities||'')+'</td>'+
      '<td>'+esc(l.resources||'')+'</td>'+
      '<td>'+workshopLessonDurationHours(l).toLocaleString('pt-BR')+'h</td>'+
      '<td>'+esc(l.cfdh_transversal||'')+'</td>'+
    '</tr>';
  }).join('');
  return '<div class="methodology-paper methodology-paper-landscape workshop-plan-paper">'+
    '<div class="methodology-annex-title">CRJ CARIACICA · PLANEJAMENTO MENSAL DE OFICINA</div>'+
    '<div class="methodology-institutional-header"><img src="'+METHODOLOGY_HEADER_DATA+'" alt="Cabeçalho institucional"></div>'+
    '<div class="methodology-inner-title">PLANEJAMENTO DA OFICINA</div>'+
    '<div class="methodology-row"><b>Oficina:</b><span class="methodology-inline-answer">'+esc(workshop?.name||'')+'</span></div>'+
    '<div class="methodology-row"><b>Mês de referência:</b><span class="methodology-inline-answer">'+esc(month)+'</span></div>'+
    '<div class="methodology-row"><b>Oficineiro(a):</b><span class="methodology-inline-answer">'+esc(instructor)+'</span></div>'+
    '<div class="methodology-row"><b>Educador(a) de referência:</b><span class="methodology-inline-answer">'+esc(educator)+'</span></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Objetivo geral:</b><div class="methodology-answer">'+esc(plan.general_objective||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Metodologia geral:</b><div class="methodology-answer">'+esc(plan.general_methodology||'')+'</div></div>'+
    '<table class="methodology-planning-table workshop-plan-table"><thead><tr><th>Aula / data / horário / local</th><th>Tema</th><th>Objetivo</th><th>Atividades propostas</th><th>Recursos necessários</th><th>Carga horária</th><th>CFDH transversal</th></tr></thead><tbody>'+(rows||'<tr><td colspan="7">Nenhuma aula prevista no calendário deste mês.</td></tr>')+'</tbody></table>'+
    '<div class="methodology-row methodology-row-tall"><b>Resultados esperados:</b><div class="methodology-answer">'+esc(plan.expected_results||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Recursos gerais:</b><div class="methodology-answer">'+esc(plan.general_resources||'')+'</div></div>'+
    '<div class="methodology-row methodology-row-tall"><b>Observações:</b><div class="methodology-answer">'+esc(plan.observations||'')+'</div></div>'+
    '<div class="methodology-system-note">As datas, horários e locais são vinculados ao calendário da oficina. Conteúdo pedagógico pode ser complementado sem romper esse vínculo.</div>'+
  '</div>';
}
function workshopPlanEditorHtml(bundle,workshop,teamMap){
  const plan=bundle.plan,lessons=(bundle.lessons||[]).filter(x=>x.included!==false);
  const lessonCards=lessons.map(l=>{
    const loc=workshopLocationLabel({location_type:l.location_type,location_other:l.location_other});
    return '<div class="card workshop-plan-lesson" data-plan-lesson="'+l.id+'">'+
      '<div class="page-head compact"><div><span class="pill info">Aula '+l.lesson_number+'</span><h4>'+esc(fmtDate(l.scheduled_date))+' · '+esc(String(l.start_time||'').slice(0,5))+'–'+esc(String(l.end_time||'').slice(0,5))+'</h4><p>'+esc(loc)+' · '+workshopLessonDurationHours(l).toLocaleString('pt-BR')+'h</p></div></div>'+
      '<div class="field"><label>Tema</label><input class="input" name="theme" value="'+esc(l.theme||('Aula '+l.lesson_number))+'"></div>'+
      '<div class="field"><label>Objetivo</label><textarea name="objective">'+esc(l.objective||'')+'</textarea></div>'+
      '<div class="field"><label>Atividades propostas</label><textarea name="proposed_activities">'+esc(l.proposed_activities||'')+'</textarea></div>'+
      '<div class="form-grid"><div class="field"><label>Recursos necessários</label><textarea name="resources">'+esc(l.resources||'')+'</textarea></div><div class="field"><label>CFDH transversal / tema de direitos humanos</label><textarea name="cfdh_transversal">'+esc(l.cfdh_transversal||'')+'</textarea></div></div>'+
      '<div class="field"><label>Observações da aula planejada</label><textarea name="observations">'+esc(l.observations||'')+'</textarea></div>'+
    '</div>';
  }).join('');
  return '<div class="page-head"><div><h2>Planejamento · '+esc(workshop.name)+'</h2><p>'+esc(String(plan.plan_month||'').slice(0,7).split('-').reverse().join('/'))+' · '+lessons.length+' aula(s) prevista(s) a partir do calendário.</p></div><div class="actions"><button class="btn secondary" data-sync-workshop-plan="'+plan.id+'" data-workshop="'+workshop.id+'">Sincronizar com calendário</button><button class="btn" data-nav="oficinas?view=planejamento&month='+esc(String(plan.plan_month||'').slice(0,7))+'">Voltar</button></div></div>'+
    '<form id="workshop-plan-form" data-plan-id="'+plan.id+'" data-workshop-id="'+workshop.id+'">'+
      '<div class="methodology-form-workspace preview-open" data-workshop-plan-workspace>'+
        '<div class="methodology-form-editor stack">'+
          '<div class="card"><div class="form-grid"><div class="field"><label>Objetivo geral da oficina no mês</label><textarea name="general_objective">'+esc(plan.general_objective||'')+'</textarea></div><div class="field"><label>Metodologia geral</label><textarea name="general_methodology">'+esc(plan.general_methodology||'')+'</textarea></div></div><div class="form-grid"><div class="field"><label>Resultados esperados</label><textarea name="expected_results">'+esc(plan.expected_results||'')+'</textarea></div><div class="field"><label>Recursos gerais</label><textarea name="general_resources">'+esc(plan.general_resources||'')+'</textarea></div></div><div class="field"><label>Observações gerais</label><textarea name="observations">'+esc(plan.observations||'')+'</textarea></div></div>'+
          (lessonCards||'<div class="notice warn">O calendário desta oficina não possui aulas previstas neste mês. Adicione datas no calendário e sincronize novamente.</div>')+
          '<div class="card"><div class="actions"><select name="status"><option value="rascunho">Rascunho</option><option value="finalizado">Finalizado</option></select><button class="btn primary">Salvar planejamento</button></div></div>'+
        '</div>'+
        '<aside class="methodology-preview-pane"><div class="methodology-preview-toolbar"><div><b>Pré-visualização do planejamento</b><span>Atualização em tempo real</span></div><button type="button" class="btn ghost" data-toggle-workshop-plan-preview>Ocultar</button></div><div class="methodology-preview-scroll" data-workshop-plan-preview>'+workshopPlanPreviewHtml(bundle,workshop,teamMap)+'</div></aside>'+
      '</div>'+
    '</form>';
}

async function pageWorkshops(){
  const view=route().params.get('view')||'oficinas';
  if(view==='calendario'){
    const month=route().params.get('month')||currentMonth();
    const [yy,mm]=month.split('-').map(Number),start=month+'-01',end=new Date(Date.UTC(yy,mm,1)).toISOString().slice(0,10);
    const [ws,entries]=await Promise.all([listWorkshops(),listWorkshopCalendar(start,end)]);
    return '<div class="page-head"><div><h2>Oficinas e presenças</h2><p>Calendário planejado das oficinas, separado das aulas efetivamente executadas.</p></div><div class="actions"><button class="btn primary" data-new-calendar-entry>+ Adicionar data</button></div></div>'+
      workshopTabs(view)+
      '<div class="toolbar"><label class="field month-filter"><span>Mês</span><input class="input" type="month" data-workshop-month value="'+esc(month)+'"></label><span class="muted">'+entries.length+' atividade(s) planejada(s) no mês</span></div>'+
      '<div class="card workshop-calendar-card">'+workshopCalendarGrid(entries,month)+'</div>'+
      '<div class="card" style="margin-top:16px"><h3>Regras fixas cadastradas</h3>'+ws.filter(w=>w.schedule_mode==='semanal_fixa').map(w=>'<div class="agenda-row"><div><b>'+esc(w.name)+'</b><span>'+esc(workshopScheduleLabel(w))+' · '+esc(workshopPeriodLabel(w))+' · '+esc(String(w.start_time||'').slice(0,5))+(w.end_time?'–'+esc(String(w.end_time).slice(0,5)):'')+'</span></div><button class="btn" data-generate-workshop-calendar="'+w.id+'">Gerar / atualizar calendário</button></div>').join('')||'<div class="empty">Nenhuma oficina com semana fixa.</div>'+'</div>';
  }

  if(view==='planejamento'){
    const month=route().params.get('month')||currentMonth(),planId=route().params.get('plan')||'',canPlan=permitted('workshop_education_docs');
    const [ws,team]=await Promise.all([listWorkshops(),listTeam()]);
    const teamMap=new Map(team.map(x=>[x.id,x.display_name]));
    if(planId){
      const bundle=await getWorkshopMonthlyPlan(planId);
      const workshop=ws.find(x=>x.id===bundle.plan.workshop_id);
      if(!workshop)return '<div class="notice danger">Oficina vinculada ao planejamento não encontrada.</div>';
      if(state.user?.role==='oficineiro'&&workshop.oficineiro_user_id!==state.user.id)return '<div class="notice danger">Este planejamento pertence a outra oficina.</div>';
      if(!canPlan)return workshopTabs(view)+'<div class="notice info">Planejamento de oficina é preenchido exclusivamente por Educadores. Seu perfil possui acesso somente para consulta.</div><div class="methodology-preview-modal">'+workshopPlanPreviewHtml(bundle,workshop,teamMap)+'</div>';
      return workshopTabs(view)+workshopPlanEditorHtml(bundle,workshop,teamMap);
    }
    let visible=ws.filter(w=>w.active);
    if(state.user?.role==='oficineiro')visible=visible.filter(w=>w.oficineiro_user_id===state.user.id);
    const plans=await listWorkshopMonthlyPlans(month);
    const byWorkshop=new Map(plans.map(p=>[p.workshop_id,p]));
    return '<div class="page-head"><div><h2>Planejamento mensal das oficinas</h2><p>O sistema usa o calendário da oficina para criar automaticamente uma linha de planejamento para cada aula prevista no mês.</p></div>'+(canPlan?'':'<span class="pill warn">Somente Educadores preenchem</span>')+'</div>'+
      workshopTabs(view)+
      '<div class="toolbar"><label class="field month-filter"><span>Mês de referência</span><input class="input" type="month" data-workshop-month value="'+esc(month)+'"></label><span class="notice info compact">Tema inicial: Aula 1, Aula 2... · Datas, horários e locais ficam vinculados ao calendário.</span></div>'+
      '<div class="grid three workshop-planning-grid">'+visible.map(w=>{
        const p=byWorkshop.get(w.id);
        return '<div class="card workshop-plan-summary"><div class="actions"><span class="pill info">'+esc(workshopTypeLabel(w.workshop_type))+'</span>'+(p?'<span class="pill '+(p.status==='finalizado'?'success':'warn')+'">'+esc(p.status)+'</span>':'<span class="pill">Não criado</span>')+'</div><h3>'+esc(w.name)+'</h3><p class="muted">'+esc(workshopScheduleLabel(w))+' · '+esc(workshopLocationLabel(w))+'</p><p><b>Oficineiro(a):</b> '+esc(teamMap.get(w.oficineiro_user_id)||'Não definido')+'<br><b>Educador(a):</b> '+esc(teamMap.get(w.educator_user_id)||'Não definido')+'</p><div class="actions">'+(p?'<button class="btn '+(canPlan?'primary':'secondary')+'" data-workshop-plan-open="'+p.id+'">'+(canPlan?'Abrir planejamento':'Visualizar planejamento')+'</button>'+(canPlan?'<button class="btn secondary" data-workshop-plan-generate="'+w.id+'">Sincronizar calendário</button>':''):(canPlan?'<button class="btn primary" data-workshop-plan-generate="'+w.id+'">Gerar planejamento do mês</button>':'<span class="pill warn">Aguardando planejamento do Educador</span>'))+'</div></div>';
      }).join('')||'<div class="card empty">Nenhuma oficina ativa disponível para planejamento.</div>'+'</div>';
  }

  if(view==='oficineiros'){
    const month=route().params.get('month')||currentMonth();
    let [dashboards,profiles]=await Promise.all([listWorkshopInstructorDashboard(month),listWorkshopInstructorProfiles()]);
    const management=['coordenacao_geral','coordenacao_articulacao','articulador','educador','administrativo','monitoramento'].includes(state.user?.role);
    if(state.user?.role==='oficineiro'){dashboards=dashboards.filter(i=>i.id===state.user.id);profiles=profiles.filter(i=>i.id===state.user.id)}
    const profilesHtml='<div class="card instructor-registry"><div class="page-head compact"><div><h3>Cadastro dos oficineiros</h3><p>Dados profissionais e referência de carga horária.</p></div>'+(management?'<button class="btn primary" data-new-instructor-account>+ Cadastrar oficineiro</button>':'')+'</div><div class="grid three">'+profiles.map(p=>'<div class="instructor-profile-card"><div><b>'+esc(p.display_name)+'</b><span>'+esc(p.specialty||'Especialidade não informada')+'</span></div><small>'+esc(p.phone||'Sem telefone')+' · '+esc(p.email||'Sem e-mail')+'</small><small>Referência semanal: '+(p.contracted_weekly_hours==null?'—':Number(p.contracted_weekly_hours).toLocaleString('pt-BR')+'h')+'</small>'+(management?'<button class="btn ghost" data-edit-instructor-profile="'+p.id+'">Editar cadastro</button>':'')+'</div>').join('')||'<div class="empty">Nenhum oficineiro cadastrado.</div>'+'</div></div>';
    return '<div class="page-head"><div><h2>Oficinas e presenças</h2><p>Desempenho operacional, carga horária comprovada, aulas executadas, solicitações e informações relevantes dos oficineiros.</p></div></div>'+
      workshopTabs(view)+
      profilesHtml+
      '<div class="toolbar" style="margin-top:16px"><label class="field month-filter"><span>Período</span><input class="input" type="month" data-workshop-month value="'+esc(month)+'"></label><span class="notice info compact">Horas comprovadas = aulas do período com pelo menos um registro na lista de presença.</span></div>'+
      '<div class="stack instructor-dashboard">'+dashboards.map(i=>{
        const m=i.metrics||{};
        const open=(i.records||[]).filter(r=>r.status==='aberta'||r.status==='em_analise').length;
        return '<div class="card instructor-card"><div class="page-head instructor-head"><div><h3>'+esc(i.display_name)+'</h3><p>'+esc((i.workshops||[]).map(w=>w.name).join(' · ')||'Sem oficina vinculada')+'</p></div><div class="actions"><span class="pill '+(open?'warn':'success')+'">'+open+' pendência(s)</span><button class="btn" data-instructor-evidence="'+i.id+'">Prévia de evidência</button>'+((['coordenacao_geral','coordenacao_articulacao','articulador','educador','administrativo','monitoramento'].includes(state.user?.role)||(state.user?.role==='oficineiro'&&state.user?.id===i.id))?'<button class="btn primary" data-instructor-record="'+i.id+'">+ Solicitação / informação</button>':'')+'</div></div>'+
          '<div class="grid cards instructor-kpis"><div class="kpi"><div class="label">Aulas registradas</div><div class="value">'+m.classes_registered+'</div><div class="meta">'+m.classes_with_attendance+' com lista</div></div><div class="kpi"><div class="label">Horas registradas</div><div class="value">'+Number(m.hours_registered||0).toLocaleString('pt-BR')+'h</div><div class="meta">sessões lançadas</div></div><div class="kpi"><div class="label">Horas comprovadas</div><div class="value">'+Number(m.hours_confirmed||0).toLocaleString('pt-BR')+'h</div><div class="meta">com lista nominal</div></div><div class="kpi"><div class="label">Participações</div><div class="value">'+m.participation_records+'</div><div class="meta">'+m.workshop_followups+' acompanhamento(s) de oficina</div></div></div>'+
          '<div class="grid two" style="margin-top:14px"><div><h4>Últimas aulas do período</h4>'+(i.recent_classes||[]).slice(0,6).map(s=>'<div class="agenda-row"><div><b>'+esc(fmtDate(s.session_date))+' · '+esc(s.workshop_name)+'</b><span>'+Number(s.duration_hours||0).toLocaleString('pt-BR')+'h · '+Number(s.attendance_count||0)+' participação(ões)</span></div><span class="pill '+(s.confirmed?'success':'warn')+'">'+(s.confirmed?'Lista registrada':'Sem lista')+'</span></div>').join('')||'<div class="empty">Nenhuma aula registrada no mês.</div>'+'</div><div><h4>Solicitações e informações</h4>'+(i.records||[]).slice(0,8).map(r=>'<div class="instructor-record-row"><div><b>'+esc(r.record_type==='solicitacao'?'Solicitação':r.record_type==='observacao_desempenho'?'Desempenho':'Informação relevante')+'</b><span>'+esc(fmtDate(r.record_date))+' · '+esc(r.description||'')+'</span></div><button class="btn ghost" data-instructor-record-edit="'+r.id+'" data-instructor="'+i.id+'">'+esc(r.status||'aberta')+'</button></div>').join('')||'<div class="empty">Nenhum registro.</div>'+'</div></div>'+
        '</div>';
      }).join('')||'<div class="card empty">Nenhum oficineiro cadastrado ou vinculado a oficinas.</div>'+'</div>';
  }

  const [ws,team]=await Promise.all([listWorkshops(),listTeam()]);
  const names=new Map(team.map(x=>[x.id,x.display_name]));
  return '<div class="page-head"><div><h2>Oficinas e presenças</h2><p>Cadastro, planejamento, execução, calendário, responsáveis e listas de presença.</p></div><div class="actions"><button class="btn primary" data-action="new-workshop">+ Nova oficina '+eduGoalInfo('planejamento_oficina')+'</button></div></div>'+
    workshopTabs(view)+
    '<div class="grid three">'+ws.map(w=>'<div class="card workshop-card"><div class="actions"><span class="pill '+(w.active?'success':'danger')+'">'+(w.active?'Ativa':'Inativa')+'</span><span class="pill info">'+esc(workshopTypeLabel(w.workshop_type))+'</span></div><h3 style="margin-top:12px">'+esc(w.name)+'</h3><p class="muted">'+esc(w.category||'Sem categoria')+'</p>'+
      '<div class="workshop-card-meta"><span><b>Agenda</b>'+esc(workshopScheduleLabel(w))+'</span><span><b>Período</b>'+esc(workshopPeriodLabel(w))+'</span><span><b>Horário</b>'+esc(String(w.start_time||'').slice(0,5))+(w.end_time?'–'+esc(String(w.end_time).slice(0,5)):'Não definido')+'</span><span><b>Local</b>'+esc(workshopLocationLabel(w))+'</span><span><b>Oficineiro(a)</b>'+esc(names.get(w.oficineiro_user_id)||'Não vinculado')+'</span><span><b>Educador(a)</b>'+esc(names.get(w.educator_user_id)||'Não vinculado')+'</span></div>'+
      '<div class="actions" style="margin-top:14px"><button class="btn primary" data-nav="oficina/'+w.id+'">Acompanhar turma '+eduGoalInfo('acompanhamento_oficina')+'</button><button class="btn" data-edit-workshop="'+w.id+'">Editar cadastro</button><button class="btn" data-action="session" data-workshop="'+w.id+'">Registrar aula '+eduGoalInfo('aula')+'</button>'+(w.schedule_mode==='semanal_fixa'?'<button class="btn secondary" data-generate-workshop-calendar="'+w.id+'">Gerar calendário</button>':'')+'</div></div>').join('')||'<div class="card empty">Nenhuma oficina.</div>'+'</div>';
}


