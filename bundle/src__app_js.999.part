
// Developer preview bridge — native layout + permission simulation for enabled profiles.
// This does not change the real profile role and does not grant database write permissions.
const __developerPreviewRealPermitted = permitted;
const __developerPreviewRealLayout = layout;
const __developerPreviewScopePermissions = {
  geral: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','metas','agenda','editar_cadastro','jovem_sensivel','atendimentos','acompanhamentos','pvida','ptrampo','encaminhamentos','beneficios','articulacao','equipe','validar','lancamento_geral','relatorios','educador_area','technical_area','document_settings','workshop_education_docs','cfdh_shared'],
  coordenacao: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','metas','agenda','editar_cadastro','jovem_sensivel','atendimentos','acompanhamentos','pvida','ptrampo','encaminhamentos','beneficios','articulacao','equipe','validar','lancamento_geral','relatorios','educador_area','technical_area','document_settings','workshop_education_docs','cfdh_shared'],
  articulacao: ['dashboard','jovens','jovem_core','editar_cadastro','forms_operacionais','articulacao','presencas','oficinas','lancamento_geral','agenda','atendimentos','encaminhamentos','beneficios','relatorios'],
  educadores: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','metas','agenda','editar_cadastro','atendimentos','encaminhamentos','beneficios','lancamento_geral','relatorios','educador_area','workshop_education_docs','cfdh_shared'],
  equipe_tecnica: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','metas','agenda','editar_cadastro','jovem_sensivel','atendimentos','acompanhamentos','pvida','ptrampo','encaminhamentos','beneficios','lancamento_geral','relatorios','technical_area','cfdh_shared'],
  administrativo: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','beneficios','metas','equipe','lancamento_geral','relatorios','agenda'],
  controlador_acesso: ['dashboard','forms_operacionais','agenda'],
  monitoramento: ['dashboard','jovens','jovem_core','forms_operacionais','oficinas','presencas','metas','agenda','jovem_sensivel','atendimentos','acompanhamentos','pvida','ptrampo','encaminhamentos','beneficios','articulacao','equipe','validar','lancamento_geral','relatorios','educador_area','technical_area','document_settings'],
  oficineiros: ['dashboard','oficinas','presencas','forms_operacionais','agenda'],
};
function __developerPreviewScope(){
  if(!state.user?.developer_preview_enabled)return null;
  try{
    const raw=sessionStorage.getItem('crj_developer_preview');
    if(!raw)return null;
    const parsed=JSON.parse(raw);
    return parsed?.enabled && __developerPreviewScopePermissions[parsed.scope] ? parsed.scope : null;
  }catch{return null}
}
permitted = function(permission){
  const scope=__developerPreviewScope();
  if(scope)return __developerPreviewScopePermissions[scope].includes(permission);
  return __developerPreviewRealPermitted(permission);
};
layout = function(content){
  let html=__developerPreviewRealLayout(content);
  if(!state.user?.developer_preview_enabled)return html;
  const scope=__developerPreviewScope();
  const label=scope ? `◉ Desenvolvedor · ${scope.replaceAll('_',' ')}` : '◉ Visualizar como desenvolvedor';
  const helper=scope ? 'Clique para trocar ou sair' : 'Geral ou por equipe';
  const control=`<button type="button" class="dev-view-button${scope?' active':''}" data-developer-view-button="1">${label}<br><small style="font-weight:600;opacity:.82">${helper}</small></button>`;
  return html.replace('</div></aside>',`${control}</div></aside>`);
};

// Vínculos de metas/etapas na área do Controlador de Acessos.
// Segue o mesmo padrão visual de evidência/apoio/contagem usado pela Articulação.
(async()=>{
  const {apiMode:acApiMode,supabaseClient:acSupabaseClient}=await import('./api.js?v=20261004-2');
  const esc=v=>String(v??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]));
  const onRoute=()=>location.hash.split('?')[0]==='#controlador-acesso';
  const localDate=()=>new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
  let acProfile=null,acTimer=null,acBusy=false,acCache=null,acCacheAt=0;
  const FALLBACK={
    presence:[
      {goal_stage:'2.1',indicator_code:'M2.1_ATENDIMENTOS',relation_mode:'count',counts_toward_indicator:true,quantity:1,rationale:'A presença diária no uso livre registra atendimento nominal. A regra do Controlador evita duplicidade por troca de sala ou renovação de permanência no mesmo dia.'},
      {goal_stage:'2.3',indicator_code:'M2.3_ACESSO_PERCENTUAL',relation_mode:'evidence',counts_toward_indicator:false,rationale:'A entrada registrada comprova acesso efetivo ao CRJ. Como a meta é percentual, o registro compõe a base de acesso do período sem somar um ponto percentual isoladamente.'}
    ],
    daily:[
      {goal_stage:'2.1',indicator_code:'M2.1_ATENDIMENTOS',relation_mode:'evidence',counts_toward_indicator:false,rationale:'A Lista de Presença e Contato diária consolida a evidência dos atendimentos nominais. A contagem acontece nos registros individuais.'},
      {goal_stage:'2.3',indicator_code:'M2.3_ACESSO_PERCENTUAL',relation_mode:'evidence',counts_toward_indicator:false,rationale:'A lista diária comprova o acesso efetivo de jovens ao CRJ e sustenta a aferição da Etapa 2.3.'}
    ],
    booking:[{goal_stage:'6.1',indicator_code:'M6.1_EMPRESTIMOS',relation_mode:'count',counts_toward_indicator:true,quantity:1,rationale:'Cada agendamento de sala ou empréstimo de equipamento corresponde ao indicador de empréstimos/agendamentos da Etapa 6.1. O Anexo 9 é a evidência documental vinculada.'}],
    appointment:[{goal_stage:'2.1',indicator_code:'M2.1_ATENDIMENTOS',relation_mode:'support',counts_toward_indicator:false,rationale:'A solicitação do Controlador encaminha o jovem para a Equipe Técnica. Ela apoia a Etapa 2.1, mas só vira atendimento contabilizado quando o atendimento é efetivamente realizado.'}]
  };
  function style(){if(document.querySelector('#ac-method-style'))return;const s=document.createElement('style');s.id='ac-method-style';s.textContent=`
    .ac-method-wrap{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 2px;align-items:center}.ac-method-chip{position:relative;display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;border:1px solid #cfe2db;background:#eef7f4;font-size:10px;line-height:1.2;color:#0b5b4c;cursor:help;outline:none}.ac-method-chip.count{background:#e9f7ef;border-color:#aad8bb;color:#175b3c}.ac-method-chip.evidence{background:#f5f2ff;border-color:#d7cef5;color:#4b3a87}.ac-method-chip.support{background:#fff8e8;border-color:#ead7a9;color:#7b5a12}.ac-method-tip{display:none;position:absolute;z-index:2147483500;left:0;top:calc(100% + 7px);width:min(390px,84vw);padding:11px 12px;border-radius:11px;background:#14201d;color:#fff;box-shadow:0 12px 34px rgba(0,0,0,.26);font-size:11px;line-height:1.45;text-align:left;white-space:normal}.ac-method-chip:hover .ac-method-tip,.ac-method-chip:focus .ac-method-tip{display:block}.ac-method-tip .ref{display:block;margin-top:6px;color:#c4d8d1;font-size:10px}.ac-method-row{margin-top:5px}.ac-method-inline{display:inline-flex;margin-left:7px;vertical-align:middle}.ac-method-inline .ac-method-wrap{display:inline-flex;margin:0}@media(max-width:680px){.ac-method-tip{left:auto;right:0;width:min(360px,88vw)}}`;
    document.head.appendChild(s)}
  async function profile(){for(let i=0;i<60&&acApiMode()!=='live';i++)await new Promise(r=>setTimeout(r,120));if(acApiMode()!=='live')return null;const cl=acSupabaseClient(),{data:{user}}=await cl.auth.getUser();if(!user)return null;const q=await cl.from('profiles').select('id,role,active').eq('id',user.id).maybeSingle();if(q.error)throw q.error;return q.data||null}
  const status=r=>r.counts_toward_indicator?'SOMA AO INDICADOR':r.relation_mode==='evidence'?'EVIDÊNCIA DIRETA':'APOIA A META';
  const mode=r=>r.counts_toward_indicator?'count':(r.relation_mode||'evidence');
  const meta=r=>{const s=String(r.goal_stage||'');return s?`Meta ${s.split('.')[0]} · Etapa ${s}`:'Vínculo metodológico'};
  function chips(rows,catalog){if(!rows?.length)return '';return `<span class="ac-method-wrap">${rows.map(r=>{const i=catalog.get(r.indicator_code)||{};return `<span class="ac-method-chip ${esc(mode(r))}" tabindex="0">ⓘ ${esc(meta(r))}<span class="ac-method-tip"><b>${esc(status(r))}</b><br>${r.indicator_code?`${esc(r.indicator_code)}${i.label?' · '+esc(i.label):''}<br>`:''}${esc(r.rationale||'Vínculo metodológico registrado.')}${r.quantity!=null?`<span class="ref">Quantidade de referência: ${esc(r.quantity)}</span>`:''}${i.target!=null?`<span class="ref">Meta: ${esc(i.target)} ${esc(i.unit||'')} · ${esc(i.periodicity||'')}</span>`:''}</span></span>`}).join('')}</span>`}
  async function load(){const now=Date.now();if(acCache&&now-acCacheAt<5000)return acCache;const cl=acSupabaseClient(),today=localDate();const [iq,lq,bq,rq]=await Promise.all([
    cl.from('indicator_catalog').select('code,label,goal_stage,target,unit,periodicity').in('code',['M2.1_ATENDIMENTOS','M2.3_ACESSO_PERCENTUAL','M6.1_EMPRESTIMOS']),
    cl.from('access_daily_lists').select('id,list_date').order('list_date',{ascending:false}).limit(31),
    cl.from('access_resource_bookings').select('id,status,scheduled_start').order('scheduled_start',{ascending:false}).limit(120),
    cl.from('appointment_requests').select('id,updated_at').eq('requested_by',acProfile.id).order('updated_at',{ascending:false}).limit(40)
  ]);for(const q of [iq,lq,bq,rq])if(q.error)throw q.error;const lists=lq.data||[],todayList=lists.find(x=>x.list_date===today);let presence=[];if(todayList){const pq=await cl.from('access_presence_records').select('id,entry_at').eq('list_id',todayList.id).order('entry_at');if(pq.error)throw pq.error;presence=pq.data||[]}
    const groups={presence,daily:lists,booking:bq.data||[],appointment:rq.data||[]},sources={presence:'access_presence_records',daily:'access_daily_lists',booking:'access_resource_bookings',appointment:'appointment_requests'},links={};for(const [k,rows] of Object.entries(groups)){const ids=rows.map(x=>x.id);const m=new Map();if(ids.length){const q=await cl.from('record_methodology_links').select('source_id,goal_stage,indicator_code,relation_mode,counts_toward_indicator,quantity,rationale').eq('source_type',sources[k]).in('source_id',ids).order('created_at');if(q.error)throw q.error;for(const x of q.data||[]){const a=m.get(x.source_id)||[];a.push(x);m.set(x.source_id,a)}}links[k]=m}acCache={catalog:new Map((iq.data||[]).map(x=>[x.code,x])),groups,links};acCacheAt=now;return acCache}
  const card=(root,text)=>[...root.querySelectorAll('.ac-card')].find(x=>[...x.querySelectorAll('h3')].some(h=>String(h.textContent||'').includes(text)));
  function block(host,html,key){if(!host||!html||host.querySelector(`[data-ac-method="${key}"]`))return;const d=document.createElement('div');d.className='ac-method-row';d.dataset.acMethod=key;d.innerHTML=html;host.appendChild(d)}
  function inline(el,html,key){if(!el||!html||el.parentElement?.querySelector(`[data-ac-method="${key}"]`))return;const s=document.createElement('span');s.className='ac-method-inline';s.dataset.acMethod=key;s.innerHTML=html;el.insertAdjacentElement('afterend',s)}
  const linked=(data,k,id)=>data.links[k]?.get(id)||FALLBACK[k]||[];
  async function decorate(){if(acBusy||!onRoute()||!acProfile?.active)return;const root=document.querySelector('[data-access-controller-page]')||document.querySelector('.content');if(!root)return;acBusy=true;try{style();const data=await load(),cat=data.catalog;
      root.querySelectorAll('[data-ac-manual-presence]').forEach((b,i)=>inline(b,chips(FALLBACK.presence,cat),`action-pres-${i}`));root.querySelectorAll('[data-ac-new-appointment]').forEach((b,i)=>inline(b,chips(FALLBACK.appointment,cat),`action-app-${i}`));root.querySelectorAll('[data-ac-new-booking]').forEach((b,i)=>inline(b,chips(FALLBACK.booking,cat),`action-book-${i}`));
      const lc=card(root,'Lista de Presença');if(lc)block(lc,chips(FALLBACK.daily,cat),'daily-summary');const pc=card(root,'Presenças de hoje');if(pc){block(pc.querySelector('.ac-head')||pc,chips(FALLBACK.presence,cat),'presence-summary');[...pc.querySelectorAll('tbody tr')].filter(x=>!x.querySelector('.ac-empty')).forEach((tr,i)=>{const r=data.groups.presence[i];if(r)block(tr.querySelector('td'),chips(linked(data,'presence',r.id),cat),`presence-${r.id}`)})}
      const ac=card(root,'Abertura de agendamento');if(ac)block(ac,chips(FALLBACK.appointment,cat),'appointment-summary');const rc=card(root,'Solicitações abertas por você');if(rc)[...rc.querySelectorAll('.ac-row')].forEach((row,i)=>{const r=data.groups.appointment[i];if(r)block(row.querySelector('div')||row,chips(linked(data,'appointment',r.id),cat),`appointment-${r.id}`)});
      for(const t of ['Agendar sala','Empréstimo de equipamentos']){const x=card(root,t);if(x)block(x,chips(FALLBACK.booking,cat),`booking-summary-${t}`)}const bc=card(root,'Agendamentos e empréstimos');if(bc)[...bc.querySelectorAll('.ac-row')].forEach((row,i)=>{const r=data.groups.booking[i];if(r)block(row.querySelector('div')||row,chips(linked(data,'booking',r.id),cat),`booking-${r.id}`)});
      const dc=card(root,'Listas diárias');if(dc)[...dc.querySelectorAll('.ac-doc')].forEach((x,i)=>{const r=data.groups.daily[i];if(r)block(x,chips(linked(data,'daily',r.id),cat),`doc-list-${r.id}`)});const ed=card(root,'Anexos de empréstimos');if(ed)[...ed.querySelectorAll('.ac-doc')].forEach((x,i)=>{const r=data.groups.booking[i];if(!r)return;const evidence=linked(data,'booking',r.id).map(v=>({...v,relation_mode:'evidence',counts_toward_indicator:false,quantity:null,rationale:'O Anexo 9 e o canhoto são evidência documental do agendamento/empréstimo da Etapa 6.1. A contagem pertence ao registro operacional, evitando duplicidade pelo documento.'}));block(x,chips(evidence,cat),`doc-book-${r.id}`)});
    }catch(e){console.warn('Vínculos metodológicos do Controlador indisponíveis:',e)}finally{acBusy=false}}
  const schedule=()=>{clearTimeout(acTimer);acTimer=setTimeout(decorate,180)};
  try{acProfile=await profile();if(!acProfile?.active)return;style();new MutationObserver(schedule).observe(document.body,{childList:true,subtree:true});window.addEventListener('hashchange',()=>{acCache=null;acCacheAt=0;schedule()});window.addEventListener('focus',()=>{acCache=null;acCacheAt=0;schedule()});schedule()}catch(e){console.warn('Falha ao iniciar orientação metodológica do Controlador:',e)}
})();
