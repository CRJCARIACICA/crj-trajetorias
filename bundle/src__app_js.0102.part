
async function gmcFormsPanel(){if(gmcTop()!=='formularios'||!gmcClient())return;const c=document.querySelector('.content');if(!c||c.querySelector('[data-gmc-forms]'))return;const {start,end}=gmcRange(),q=await gmcClient().from('methodology_form_submissions').select('id,form_slug,youth_id,submitted_at,record_state,source_type').gte('submitted_at',start).lt('submitted_at',end).order('submitted_at',{ascending:false}).limit(200);if(q.error)throw q.error;const ids=[...new Set((q.data||[]).map(x=>x.youth_id).filter(Boolean))];let ys=[];if(ids.length){const y=await gmcClient().from('young_people').select('id,full_name,preferred_name').in('id',ids);if(!y.error)ys=y.data||[]}const ym=new Map(ys.map(x=>[x.id,x])),trashQ=await gmcClient().rpc('list_deleted_methodology_documents'),trash=(trashQ.error?[]:trashQ.data||[]).filter(x=>String(x.deleted_at||'').slice(0,7)===gmcMonth()),p=document.createElement('div');p.className='gmc-panel';p.dataset.gmcForms='1';const rows=(q.data||[]).map(x=>{const y=ym.get(x.youth_id),generated=!!x.source_type&&x.source_type!=='manual',target=`formulario/${x.form_slug}${x.youth_id?'/'+x.youth_id:''}?submission=${x.id}&month=${gmcMonth()}`;return `<div class="gmc-row"><div><b>${gmcEsc(GMC_FORM_LABELS[x.form_slug]||x.form_slug)}</b><span>${gmcEsc(y?.preferred_name||y?.full_name||'Documento coletivo')}</span><small>${new Date(x.submitted_at).toLocaleString('pt-BR')} · ${gmcEsc(x.record_state||'')}</small></div><div class="gmc-actions">${generated?'<span class="pill info">editar na origem</span>':`<button class="btn" data-gmc-edit-form="${gmcEsc(target)}">Editar</button><button class="btn gmc-danger" data-gmc-delete-form="${x.id}">Excluir</button>`}</div></div>`}).join('')||'<div class="empty">Nenhum documento neste mês.</div>';const tr=trash.map(x=>`<div class="gmc-row gmc-trash"><div><b>${gmcEsc(GMC_FORM_LABELS[x.form_slug]||x.form_slug)}</b><span>${gmcEsc(x.youth_name||'Documento coletivo')}</span><small>Excluído em ${new Date(x.deleted_at).toLocaleString('pt-BR')} · restauração por 24h</small></div><div class="gmc-actions"><button class="btn secondary" data-gmc-restore-form="${x.id}">Restaurar</button></div></div>`).join('');p.innerHTML=`<div class="page-head" style="margin-bottom:0"><div><h3>Registros de ${gmcMonth().split('-').reverse().join('/')}</h3><p>Editar, excluir e restaurar documentos do mês.</p></div><span class="pill">${(q.data||[]).length} documento(s)</span></div><div class="gmc-list">${rows}${tr?`<b>Lixeira do mês</b>${tr}`:''}</div>`;(c.querySelector('.page-head')||c).insertAdjacentElement(c.querySelector('.page-head')?'afterend':'beforeend',p);p.querySelectorAll('[data-gmc-edit-form]').forEach(b=>b.onclick=()=>location.hash='#'+b.dataset.gmcEditForm);p.querySelectorAll('[data-gmc-delete-form]').forEach(b=>b.onclick=async()=>{if(!confirm('Excluir este documento? Ele poderá ser restaurado por 24 horas.'))return;const r=await gmcClient().rpc('soft_delete_methodology_document',{p_id:b.dataset.gmcDeleteForm});if(r.error)return gmcToast(r.error.message,'danger');gmcToast('Documento enviado para a lixeira');gmcSchedule()});p.querySelectorAll('[data-gmc-restore-form]').forEach(b=>b.onclick=async()=>{const r=await gmcClient().rpc('restore_methodology_document',{p_id:b.dataset.gmcRestoreForm});if(r.error)return gmcToast(r.error.message,'danger');gmcToast('Documento restaurado');gmcSchedule()})}
async function gmcAggregatePanel(){if(gmcTop()!=='lancamento-geral'||!gmcClient())return;const c=document.querySelector('.content');if(!c||c.querySelector('[data-gmc-aggregate]'))return;const {start,end}=gmcRange(),[r,cat,t]=await Promise.all([gmcClient().from('aggregate_records').select('*').gte('record_date',start).lt('record_date',end).order('record_date',{ascending:false}),gmcClient().from('indicator_catalog').select('code,label').eq('active',true).order('code'),gmcClient().from('aggregate_record_trash').select('id,payload,deleted_at,expires_at,restored_at').is('restored_at',null).gte('expires_at',new Date().toISOString()).order('deleted_at',{ascending:false})]);if(r.error)throw r.error;const cm=new Map((cat.data||[]).map(x=>[x.code,x])),p=document.createElement('div');p.className='gmc-panel';p.dataset.gmcAggregate='1';const rows=(r.data||[]).map(x=>`<div class="gmc-row"><div><b>${gmcEsc(x.indicator_code)} · ${gmcEsc(cm.get(x.indicator_code)?.label||'Indicador')}</b><span>${Number(x.quantity||0).toLocaleString('pt-BR')} · ${new Date(x.record_date+'T12:00:00').toLocaleDateString('pt-BR')}</span><small>${gmcEsc(x.description||'Sem descrição')}</small></div><div class="gmc-actions"><button class="btn" data-gmc-edit-aggregate="${x.id}">Editar</button><button class="btn gmc-danger" data-gmc-delete-aggregate="${x.id}">Excluir</button></div></div>`).join('')||'<div class="empty">Nenhum lançamento neste mês.</div>';const tr=(t.error?[]:t.data||[]).filter(x=>String(x.payload?.record_date||'').slice(0,7)===gmcMonth()).map(x=>`<div class="gmc-row gmc-trash"><div><b>${gmcEsc(x.payload?.indicator_code||'Lançamento')}</b><span>${Number(x.payload?.quantity||0).toLocaleString('pt-BR')}</span><small>Excluído em ${new Date(x.deleted_at).toLocaleString('pt-BR')}</small></div><div class="gmc-actions"><button class="btn secondary" data-gmc-restore-aggregate="${x.id}">Restaurar</button></div></div>`).join('');p.innerHTML=`<div class="page-head" style="margin-bottom:0"><div><h3>Lançamentos de ${gmcMonth().split('-').reverse().join('/')}</h3><p>Crie acima e gerencie os itens do mês abaixo.</p></div></div><div class="gmc-list">${rows}${tr?`<b>Lixeira do mês</b>${tr}`:''}</div>`;c.appendChild(p);const byId=new Map((r.data||[]).map(x=>[x.id,x]));p.querySelectorAll('[data-gmc-edit-aggregate]').forEach(b=>b.onclick=()=>{const x=byId.get(b.dataset.gmcEditAggregate);if(!x)return;const qty=prompt('Quantidade',x.quantity);if(qty===null)return;const desc=prompt('Descrição / justificativa',x.description||'');gmcClient().from('aggregate_records').update({quantity:Number(qty),description:desc||null}).eq('id',x.id).select('id').maybeSingle().then(z=>{if(z.error)gmcToast(z.error.message,'danger');else{gmcToast('Lançamento atualizado');gmcSchedule()}})});p.querySelectorAll('[data-gmc-delete-aggregate]').forEach(b=>b.onclick=async()=>{if(!confirm('Excluir este lançamento? Ele poderá ser restaurado por 24 horas.'))return;const z=await gmcClient().rpc('soft_delete_aggregate_record',{p_id:b.dataset.gmcDeleteAggregate});if(z.error)return gmcToast(z.error.message,'danger');gmcToast('Lançamento enviado para a lixeira');gmcSchedule()});p.querySelectorAll('[data-gmc-restore-aggregate]').forEach(b=>b.onclick=async()=>{const z=await gmcClient().rpc('restore_aggregate_record',{p_trash_id:b.dataset.gmcRestoreAggregate});if(z.error)return gmcToast(z.error.message,'danger');gmcToast('Lançamento restaurado');gmcSchedule()});const f=document.querySelector('#aggregate-form [name=date]');if(f&&gmcMonth()!==gmcNowMonth())f.value=gmcMonth()+'-01'}
